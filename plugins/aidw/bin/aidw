function computeApprovalHash(p, change, push, opts = {}) {
  return hashOf(packageDigests(p, change, opts.as, opts.version), push === void 0 ? change.data.approval?.push : push);
}
function packageDigests(p, change, as, version = packageVersionOf(change)) {
  const entries = [];
  const add = (file, content) => {
    if (!(0, import_node_fs6.existsSync)(file)) return;
    const text2 = content ?? normalize((0, import_node_fs6.readFileSync)(file, "utf8"));
    entries.push({ path: rel(p, file), digest: sha256(text2) });
  };
  for (const name of packageFilesFor(version)) add((0, import_node_path8.join)(change.dir, name));
  for (const f of walkFiles((0, import_node_path8.join)(change.dir, "specs"))) add(f);
  for (const f of baseSpecFiles(p, change)) add(f);
  const tasksFile = (0, import_node_path8.join)(change.dir, "tasks.yaml");
  if ((0, import_node_fs6.existsSync)(tasksFile)) add(tasksFile, canonicalTasks((0, import_node_fs6.readFileSync)(tasksFile, "utf8")));
  add(p.constitution);
  for (const dir of FROZEN_PROJECT_DIRS(p)) for (const f of walkFiles(dir)) add(f);
  const out = new Map(entries.map((e) => [e.path, e.digest]));
  const listed = (path) => out.has(path) || isPackageRel(p, change, path, version);
  for (const [path, digest] of as ?? []) {
    if (!listed(path)) continue;
    if (digest === null) out.delete(path);
    else out.set(path, digest);
  }
  return out;
}
function isPackageRel(p, change, path, version = packageVersionOf(change)) {
  const low = (x) => x.toLowerCase();
  const file = low(path);
  const under = (dir2) => file.startsWith(`${low(rel(p, dir2))}/`);
  if (file === low(rel(p, p.constitution)) || FROZEN_PROJECT_DIRS(p).some(under)) return true;
  if (baseSpecFiles(p, change).some((b) => low(rel(p, b)) === file)) return true;
  const dir = low(rel(p, change.dir));
  if (!file.startsWith(`${dir}/`)) return false;
  const r = file.slice(dir.length + 1);
  return r === "tasks.yaml" || packageFilesFor(version).includes(r) || r.startsWith("specs/") && r.endsWith(".md");
}
function hashOf(digests, bound) {
  const files = [...digests.keys()].sort((a, b) => a < b ? -1 : a > b ? 1 : 0);
  const binding = bound ? `approval.push
${sha256(JSON.stringify(bound))}
` : "";
  const manifest = files.map((f) => `${f}
${digests.get(f)}
`).join("") + binding;
  return { hash: `sha256:${sha256(manifest)}`, files };
}
function fileDigest(p, change, file) {
  if (!(0, import_node_fs6.existsSync)(file)) return null;
  const text2 = normalize((0, import_node_fs6.readFileSync)(file, "utf8"));
  return sha256(file === (0, import_node_path8.join)(change.dir, "tasks.yaml") ? canonicalTasks(text2) : text2);
}
function approvalStatus(p, change) {
  const open = openDeviationDigests(change);
  const actual = computeApprovalHash(p, change, void 0, open ? { as: open } : {}).hash;
  const approval = change.data.approval;
  const expected = typeof approval?.hash === "string" ? approval.hash : void 0;
  if (!expected) return { status: "none", actual };
  return { status: expected === actual ? "valid" : "drift", expected, actual };
}

