      if (parts[2] === AIDW_DIR) return deny("the worktree's .aidw/ is a stale copy; aidw state lives in the main checkout and is the orchestrator's");
      const st2 = gateState(p);
      return st2.open ? allow("analysis approved (task worktree)") : deny(closedReason(st2));
    }
    if (role === "implementer" && (0, import_node_path19.dirname)(file) === p.run && REPORT_FILE.test((0, import_node_path19.basename)(file))) return allow("implementer note for the reviewer");
    if (role === "implementer" && insideAnyCase(p.aidw, file) && !inside2((0, import_node_path19.join)(p.run, "shots"), file)) {
