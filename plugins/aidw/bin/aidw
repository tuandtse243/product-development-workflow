    suffixes: [".tsbuildinfo"]
  },
  python: { dirs: ["__pycache__", ".venv", "venv", ".pytest_cache", ".mypy_cache", ".ruff_cache", ".tox"], files: [], suffixes: [".pyc"] }
};
var escape = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
var all = Object.values(STACK_JUNK);
var GENERATED_PATH = new RegExp(
  `(^|/)(${all.flatMap((s) => s.dirs).map(escape).join("|")})/|(^|/)(${all.flatMap((s) => s.files).map(escape).join("|")})$|(${all.flatMap((s) => s.suffixes).map(escape).join("|")})$`
);
var ENV_FILE = /(^|\/)\.env(?:\.(?!example$)[\w.-]+)?$/;
var JUNK_PATH = { test: (f) => GENERATED_PATH.test(f) || ENV_FILE.test(f) };
var isGeneratedPath = (f) => GENERATED_PATH.test(f);
function stagedJunk(cwd) {
  const r = git(cwd, ["diff", "--cached", "--name-only"]);
  return r.ok ? r.out.split("\n").filter((f) => JUNK_PATH.test(f)) : [];
}
var junkMessage = (files) => `refusing to commit dependency or build output (${files.slice(0, 3).join(", ")}${files.length > 3 ? ", ..." : ""}): the project has no .gitignore covering it. Add node_modules/, .next/, *.tsbuildinfo, next-env.d.ts, .env and the like to .gitignore, run \`git rm -r -q --cached <path>\` for anything already tracked, then retry`;
function headCommit(cwd) {
  const r = git(cwd, ["rev-parse", "--verify", "-q", "HEAD"]);
  return r.ok && r.out ? r.out : null;
}
function changedSince(cwd, base2) {
  if (!isGitRepo(cwd)) return null;
  const files = /* @__PURE__ */ new Set();
  const diff = base2 ? git(cwd, ["diff", "--name-only", base2]) : git(cwd, ["diff", "--name-only", "--cached"]);
  if (!diff.ok) return null;
  for (const f of diff.out.split("\n")) if (f) files.add(f);
  if (!base2) {
    for (const f of git(cwd, ["diff", "--name-only"]).out.split("\n")) if (f) files.add(f);
  }
  for (const f of git(cwd, ["ls-files", "--others", "--exclude-standard"]).out.split("\n")) if (f) files.add(f);
  return [...files].sort();
}

// src/tamper.ts
var import_node_fs2 = require("node:fs");
var import_node_path3 = require("node:path");
var CODE_FILE = /\.(?:[cm]?[jt]sx?|vue|svelte|astro|py)$/i;
var MAX_FILE = 1024 * 1024;
var SNAPSHOT = /(?:^|\/)__snapshots__\/|\.snap$|-snapshots\/[^/]+\.(?:png|txt)$|\.ambr$/;
var SKIPPED = /\.(?:skip|fixme)\s*\(|\b(?:xit|xtest|xdescribe)\s*\(|@(?:pytest\.mark\.skip|unittest\.skip)|\bpytest\.skip\s*\(/;
var FOCUSED = /\.only\s*\(|\b(?:fit|fdescribe)\s*\(/;
var DIRECTIVE = /(?:eslint-disable(?:-next-line|-line)?|oxlint-disable(?:-next-line|-line)?|biome-ignore|@ts-ignore|@ts-nocheck|@ts-expect-error|#\s*noqa|#\s*type:\s*ignore|#\s*pyright:\s*ignore)(.*)$/;
var AS_ANY = /\bas\s+any\b(.*)$/;
function hasReason(rest, needsComment) {
  let text2 = rest;
  if (needsComment) {
    const at = text2.search(/\/\/|\/\*/);
    if (at < 0) return false;
    text2 = text2.slice(at);
  }
  const words = text2.replace(/\*\/|-->|\{\/\*|\*\/\}/g, " ").split(/[\s,:()[\]]+/).filter((w) => /^[A-Za-z][A-Za-z']+$/.test(w) && !/^[A-Z]+\d+$/.test(w));
  return words.length >= 2;
}
function addedLines(dir, base2, file) {
  const full = (0, import_node_path3.join)(dir, file);
  if (!(0, import_node_fs2.existsSync)(full) || (0, import_node_fs2.statSync)(full).size > MAX_FILE) return [];
  const whole = () => (0, import_node_fs2.readFileSync)(full, "utf8").split(/\r?\n/).map((text2, i) => ({ line: i + 1, text: text2 }));
  if (!base2 || !git(dir, ["cat-file", "-e", `${base2}:${file}`]).ok) return whole();
  const diff = git(dir, ["diff", "-U0", "--no-color", base2, "--", file]);
  if (!diff.ok) return whole();
  const out = [];
  let n = 0;
  for (const l of diff.out.split("\n")) {
    const hunk = /^@@ -\d+(?:,\d+)? \+(\d+)/.exec(l);
    if (hunk) n = Number(hunk[1]);
    else if (l.startsWith("+") && !l.startsWith("+++")) out.push({ line: n++, text: l.slice(1) });
  }
  return out;
}
var testTitles = (text2) => [...text2.matchAll(/\b(?:test|it|describe)(?:\.\w+)*\s*\(\s*(["'`])((?:\\.|(?!\1).)+)\1/g)].map((m) => m[2]);
function deletedTests(dir, base2, changed, isTest) {
  if (!base2) return [];
  const r = git(dir, ["diff", "--name-status", "-M", base2]);
  if (!r.ok) return [];
  const gone = r.out.split("\n").map((l) => l.split("	")).filter(([status, file]) => status === "D" && file && isTest(file) && !(0, import_node_fs2.existsSync)((0, import_node_path3.join)(dir, file))).map(([, file]) => file);
  if (!gone.length) return [];
  const text2 = (f) => {
    try {
      return (0, import_node_fs2.statSync)((0, import_node_path3.join)(dir, f)).size > MAX_FILE ? null : (0, import_node_fs2.readFileSync)((0, import_node_path3.join)(dir, f), "utf8");
    } catch {
      return null;
    }
  };
  const elsewhere = changed.filter((f) => isTest(f) && (0, import_node_fs2.existsSync)((0, import_node_path3.join)(dir, f))).map((f) => (text2(f) ?? "").trim());
  const together = elsewhere.join("\n");
  return gone.filter((file) => {
    const old = git(dir, ["show", `${base2}:${file}`]);
    if (!old.ok) return true;
    if (elsewhere.some((t) => t === old.out.trim())) return false;
    const titles = testTitles(old.out);
    return !(titles.length > 0 && titles.every((t) => together.includes(t)));
  });
}
function tamperEvidence(dir, base2, changed, opts) {
  if (changed === null) return null;
  const blocked = [];
  const justified = [];
  if (!opts.removesTests) for (const file of deletedTests(dir, base2, changed, opts.isTest)) blocked.push({ kind: "deleted-test", file });
  for (const file of changed) {
    if (!CODE_FILE.test(file)) continue;
    const test = opts.isTest(file);
    for (const { line, text: text2 } of addedLines(dir, base2, file)) {
      const at = { file, line, text: text2.trim().slice(0, 160) };
      if (test && FOCUSED.test(text2)) blocked.push({ kind: "focused-test", ...at });
      if (test && SKIPPED.test(text2)) blocked.push({ kind: "skipped-test", ...at });
      const directive = DIRECTIVE.exec(text2);
      const cast = directive ? null : AS_ANY.exec(text2);
      if (!directive && !cast) continue;
      const ok = directive ? hasReason(directive[1] ?? "", false) : hasReason(cast?.[1] ?? "", true);
      (ok ? justified : blocked).push({ kind: "suppression", ...at });
    }
  }
  const snapshots = base2 ? changed.filter((f) => SNAPSHOT.test(f) && git(dir, ["cat-file", "-e", `${base2}:${f}`]).ok) : [];
  return { blocked, justified, ...snapshots.length ? { snapshots } : {} };
}
var LABEL = {
  "deleted-test": "test file deleted",
  "skipped-test": "test skipped",
  "focused-test": "test focused with .only",
  suppression: "check switched off without a reason on the same line"
};
function tamperProblems(e) {
  if (!e) return [];
  const out = [];
  for (const kind of Object.keys(LABEL)) {
    const found = e.blocked.filter((f) => f.kind === kind);
    if (!found.length) continue;
    const where = found.slice(0, 5).map((f) => f.line ? `${f.file}:${f.line}` : f.file);
    out.push(`${LABEL[kind]}: ${where.join(", ")}${found.length > 5 ? `, and ${found.length - 5} more` : ""}`);
  }
  return out;
}

// src/diffcover.ts
function parseLcov(text2) {
  const out = /* @__PURE__ */ new Map();
  let lines = null;
  for (const raw of text2.split(/\r?\n/)) {
    if (raw.startsWith("SF:")) {
      const file = raw.slice(3).trim();
      lines = out.get(file) ?? /* @__PURE__ */ new Map();
      out.set(file, lines);
    } else if (raw.startsWith("DA:") && lines) {
      const [n, hits] = raw.slice(3).split(",");
      const line = Number(n);
      if (Number.isInteger(line)) lines.set(line, Math.max(lines.get(line) ?? 0, Number(hits) || 0));
    } else if (raw === "end_of_record") lines = null;
  }
  return out;
}
function diffCoverage(dir, base2, lcov) {
  const root = git(dir, ["rev-parse", "--show-toplevel"]).out || dir;
  const files = [];
  for (const [name, lines] of parseLcov(lcov)) {
    const file = ((0, import_node_path4.isAbsolute)(name) ? (0, import_node_path4.relative)(root, name) : name).split(import_node_path4.sep).join("/");
    if (file.startsWith("..")) continue;
    const added = addedLines(root, base2, file).map((l) => l.line).filter((n) => lines.has(n));
    if (!added.length) continue;
    const uncovered = added.filter((n) => (lines.get(n) ?? 0) === 0);
    files.push({ file, total: added.length, covered: added.length - uncovered.length, uncovered });
  }
  files.sort((a, b) => a.file.localeCompare(b.file));
  const total = files.reduce((n, f) => n + f.total, 0);
  const covered = files.reduce((n, f) => n + f.covered, 0);
  return { base: base2, total, covered, percent: total === 0 ? 100 : Math.round(covered / total * 1e3) / 10, files };
}
function trunkBase(dir) {
  for (const ref of ["origin/main", "main", "origin/master", "master"]) {
    const r = git(dir, ["merge-base", "HEAD", ref]);
    if (r.ok && r.out) return r.out;
  }
  return null;
}
var ranges = (nums) => {
  const out = [];
  for (let i = 0; i < nums.length; i++) {
    let j = i;
    while (nums[j + 1] === nums[j] + 1) j++;
    out.push(i === j ? String(nums[i]) : `${nums[i]}-${nums[j]}`);
    i = j;
  }
  return out.join(", ");
};
function coverageReport(c, min) {
  const head = `coverage of added lines: ${c.percent}% (${c.covered} of ${c.total}), minimum ${min}%`;
  const gaps = c.files.filter((f) => f.uncovered.length).map((f) => `  ${f.file}: lines ${ranges(f.uncovered)} are not covered`);
  return [head, ...gaps].join("\n");
}

