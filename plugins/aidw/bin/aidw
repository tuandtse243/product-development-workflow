  }
  if (branch) git(p.project, ["branch", "-q", "-D", branch]);
}
function snapshotBase(p, id, taskId, base2) {
  const dir = worktreeDir(p, id, taskId);
  (0, import_node_fs22.rmSync)(dir, { recursive: true, force: true });
  (0, import_node_fs22.mkdirSync)(dir, { recursive: true });
  const r = (0, import_node_child_process4.spawnSync)("sh", ["-c", 'git archive --format=tar "$0" | tar -x -C "$1"', base2, dir], { cwd: p.project, encoding: "utf8" });
  if (r.status !== 0) {
    (0, import_node_fs22.rmSync)(dir, { recursive: true, force: true });
    throw new OpError(`could not copy the base commit: ${(r.stderr || r.error?.message || `exit ${r.status}`).trim()}`);
  }
  const source = (0, import_node_path27.join)(p.project, "node_modules");
  if ((0, import_node_fs22.existsSync)(source) && !isSymlink((0, import_node_path27.join)(dir, "node_modules"))) {
    try {
      (0, import_node_fs22.symlinkSync)(source, (0, import_node_path27.join)(dir, "node_modules"), "dir");
    } catch {
    }
  }
