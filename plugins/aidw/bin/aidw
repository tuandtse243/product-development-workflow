function frameworkPacks(root) {
  const dir = (0, import_node_path15.join)(root, "stacks");
  if (!(0, import_node_fs13.existsSync)(dir)) return [];
  const out = [];
  for (const name of (0, import_node_fs13.readdirSync)(dir).filter((n) => n.endsWith(".md")).sort()) {
    const m = /^---\n([\s\S]*?)\n---\n/.exec((0, import_node_fs13.readFileSync)((0, import_node_path15.join)(dir, name), "utf8"));
    if (!m) continue;
    let head;
    try {
      head = import_yaml8.default.parse(m[1]);
    } catch {
      continue;
    }
    const h = head;
    if (typeof h?.framework === "string" && Array.isArray(h.roles)) out.push({ id: name.slice(0, -3), framework: h.framework, roles: h.roles.map(String), file: (0, import_node_path15.join)(dir, name) });
  }
  return out;
}
function packsFor(root, stack, role) {
  const found = stack.framework ?? "";
  return frameworkPacks(root).filter((p) => p.roles.includes(role) && found.toLowerCase().startsWith(p.framework.toLowerCase()));
}

