  child.unref();
  (0, import_node_fs42.writeFileSync)(pidFile(p), String(child.pid));
  return { pid: child.pid, log };
}
function stopRunner(p) {
  const pid = runnerPid(p);
  if (!pid) return null;
  try {
    process.kill(-pid, "SIGTERM");
  } catch {
    process.kill(pid, "SIGTERM");
  }
  (0, import_node_fs42.rmSync)(pidFile(p), { force: true });
  return pid;
}

