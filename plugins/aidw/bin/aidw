function loadAgents() {
  const root = bundledRoot();
  const file = root ? (0, import_node_path6.join)(root, "workflows", "product.yaml") : "";
  const data = file && (0, import_node_fs6.existsSync)(file) ? import_yaml4.default.parse((0, import_node_fs6.readFileSync)(file, "utf8")) : null;
  const stages = Array.isArray(data?.stages) ? data.stages : [];
  const agents = stages.map((s) => s?.agents).find(isRecord2);
  const layer = isRecord2(agents?.["layer-review"]) ? agents["layer-review"] : {};
  const [implement, review, triage, ui, security] = [agents?.implement, agents?.review, agents?.triage, layer.ui, layer.security];
  for (const v of [implement, review, triage, ui, security]) {
    if (typeof v !== "string" || !ROLE_ID.test(v)) throw new Error(`the Agents are missing: ${file || "plugin root not found"} needs a stage with agents: implement, review, triage and layer-review ui and security`);
  }
  return { implement: `aidw:${implement}`, taskReview: `aidw:${review}`, triage: `aidw:${triage}`, layerReview: { ui: `aidw:${ui}`, security: `aidw:${security}` } };
}
var oneOf = (list5, v) => typeof v === "string" && list5.includes(v);
var rosterFile = (root) => (0, import_node_path6.join)(root, "roster.yaml");
var roleDir = (root, id) => (0, import_node_path6.join)(root, "roles", id);
var read = (file) => (0, import_node_fs6.readFileSync)(file, "utf8");
function loadRoster(root) {
  const data = import_yaml4.default.parse(read(rosterFile(root)));
  const departments = isRecord2(data) && isRecord2(data.departments) ? data.departments : {};
  const roles = isRecord2(data) && isRecord2(data.roles) ? data.roles : {};
  return { departments, roles };
}
function parseRoleText(text) {
  const m = /^---\n([\s\S]*?)\n---\n?([\s\S]*)$/.exec(text);
  if (!m) return null;
  let header2;
  try {
    header2 = import_yaml4.default.parse(m[1] ?? "");
  } catch {
    return null;
  }
  return isRecord2(header2) ? { header: header2, body: (m[2] ?? "").trim() } : null;
}
function loadRole(root, id) {
  const file = (0, import_node_path6.join)(roleDir(root, id), "role.md");
  if (!(0, import_node_fs6.existsSync)(file)) return null;
  const parsed = parseRoleText(read(file));
  if (!parsed) return null;
  const h = parsed.header;
  const rulesFile = (0, import_node_path6.join)(roleDir(root, id), "rules.md");
  const includes = Array.isArray(h.includes) ? h.includes.map(String) : [];
  return {
    id: String(h.id ?? ""),
    description: String(h.description ?? ""),
    mode: h.mode,
    tier: h.tier,
    access: h.access,
    tools: Array.isArray(h.tools) ? h.tools.map(String) : [],
    ...typeof h.max_turns === "number" ? { max_turns: h.max_turns } : {},
    skills: skillIndex(h.skills),
    includes,
    body: parsed.body,
    shared: includes.map((f) => (0, import_node_fs6.existsSync)((0, import_node_path6.join)(root, f)) ? read((0, import_node_path6.join)(root, f)).trim() : ""),
    rules: (0, import_node_fs6.existsSync)(rulesFile) ? read(rulesFile).trim() : ""
  };
}
function skillIndex(raw) {
  if (!Array.isArray(raw)) return [];
  return raw.flatMap((e) => isRecord2(e) ? Object.entries(e).map(([name, when]) => ({ name, when: String(when) })) : []);
}
function loadTiers(root, platform = "claude-code") {
  const file = (0, import_node_path6.join)(root, "tiers.yaml");
  const data = (0, import_node_fs6.existsSync)(file) ? import_yaml4.default.parse(read(file)) : null;
  return isRecord2(data) && isRecord2(data[platform]) ? data[platform] : {};
}
function renderAgent(role, tiers) {
  const model = tiers[role.tier];
  const head = [
    `name: ${role.id}`,
    `description: ${import_yaml4.default.stringify(role.description, { lineWidth: 0 }).trim()}`,
    `# GENERATED from roles/${role.id}/ (role.md, rules.md) by \`aidw roster --write\`. Do not edit this file.`,
    `tools: ${role.tools.join(", ")}`,
    ...model && model !== "inherit" ? [`model: ${model}`] : [],
    ...role.max_turns ? [`maxTurns: ${role.max_turns}`] : []
  ];
  const shared = role.shared.filter(Boolean).map((t) => `

${t}`).join("");
  const rules = role.rules ? `

## Rules

${role.rules}` : "";
  const skills = role.skills.length ? `

## Skills (load only when the work needs one)

Read a skill with \`aidw plugin-path roles/${role.id}/skills/<name>.md\`.

${role.skills.map((s) => `- \`${s.name}\`: ${s.when}`).join("\n")}` : "";
  return `---
${head.join("\n")}
---

${role.body}${shared}${rules}${skills}
`;
}
function profiledRoles(root) {
  const dir = (0, import_node_path6.join)(root, "roles");
  if (!(0, import_node_fs6.existsSync)(dir)) return [];
  return (0, import_node_fs6.readdirSync)(dir).filter((n) => (0, import_node_fs6.statSync)((0, import_node_path6.join)(dir, n)).isDirectory()).sort();
}
function generateAgents(root) {
  const roster = loadRoster(root);
  const tiers = loadTiers(root);
  const out = {};
  for (const [id, entry] of Object.entries(roster.roles)) {
    if (entry?.status !== "active") continue;
    const role = loadRole(root, id);
    if (role) out[`${id}.md`] = renderAgent(role, tiers);
  }
  return out;
}
function writeAgents(root) {
  const dir = (0, import_node_path6.join)(root, "agents");
  (0, import_node_fs6.mkdirSync)(dir, { recursive: true });
  const files = generateAgents(root);
  for (const name of (0, import_node_fs6.readdirSync)(dir)) if (!(name in files)) (0, import_node_fs6.rmSync)((0, import_node_path6.join)(dir, name), { recursive: true });
  for (const [name, content] of Object.entries(files)) (0, import_node_fs6.writeFileSync)((0, import_node_path6.join)(dir, name), content);
  return Object.keys(files).sort();
}
function checkRoster(root) {
  const d = new Diags();
  const rf = "roster.yaml";
  if (!(0, import_node_fs6.existsSync)(rosterFile(root))) {
    d.error(rf, "not found");
    return d;
  }
  let roster;
  try {
    roster = loadRoster(root);
  } catch (e) {
    d.error(rf, `not valid YAML: ${e.message}`);
    return d;
  }
  const ids = Object.keys(roster.roles);
  if (ids.length === 0) d.error(rf, 'expected a "roles:" mapping');
  for (const id of ids) {
    const e = roster.roles[id];
    if (!ROLE_ID.test(id)) d.error(rf, `role id "${id}" must be lower-case kebab-case`);
    if (!isRecord2(e)) {
      d.error(rf, `role ${id} is not a mapping`);
      continue;
    }
    if (typeof e.department !== "string" || !(e.department in roster.departments)) d.error(rf, `role ${id}: unknown department "${String(e.department)}"`);
    if (!oneOf(ROLE_STATUSES, e.status)) d.error(rf, `role ${id}: status must be ${ROLE_STATUSES.join(" or ")}`);
    if (e.status === "active" && e.carried_by !== void 0) d.error(rf, `role ${id} is active, so it cannot have carried_by`);
    if (e.status === "planned") {
      const by = e.carried_by;
      if (typeof by !== "string" || !by) d.error(rf, `role ${id} is planned, so it needs carried_by`);
      else if (by !== "cli" && !/^skill:[a-z0-9-]+$/.test(by) && roster.roles[by]?.status !== "active") {
        d.error(rf, `role ${id}: carried_by "${by}" must be an active role, "cli" or "skill:<name>"`);
      }
    }
  }
  const profiled = profiledRoles(root);
  for (const id of profiled) {
    const file = `roles/${id}/role.md`;
    if (!(id in roster.roles)) d.error(file, `role "${id}" has a folder but is not in roster.yaml`);
    const path = (0, import_node_path6.join)(roleDir(root, id), "role.md");
    if (!(0, import_node_fs6.existsSync)(path)) {
      d.error(file, "not found");
      continue;
    }
    const parsed = parseRoleText(read(path));
    if (!parsed) {
      d.error(file, 'expected a valid YAML header between --- lines (quote any value that contains ": ")');
      continue;
    }
    const h = parsed.header;
    if (h.id !== id) d.error(file, `header id "${String(h.id)}" must equal the folder name "${id}"`);
    if (typeof h.description !== "string" || !h.description.trim()) d.error(file, "header needs a description");
    if (!oneOf(RUN_MODES, h.mode)) d.error(file, `mode must be ${RUN_MODES.join(" or ")}`);
    if (!oneOf(TIERS, h.tier)) d.error(file, `tier must be ${TIERS.join(", ")}`);
    if (!oneOf(ACCESS, h.access)) d.error(file, `access must be one of ${ACCESS.join(", ")}`);
    if (!Array.isArray(h.tools) || h.tools.length === 0 || !h.tools.every((t) => typeof t === "string")) d.error(file, "tools must be a non-empty list of tool names");
    if (h.max_turns !== void 0 && !(Number.isInteger(h.max_turns) && Number(h.max_turns) > 0)) d.error(file, "max_turns must be a positive integer");
    if (!parsed.body) d.error(file, "the profile has no text after its header");
    if (h.skills !== void 0) {
      const list5 = Array.isArray(h.skills) ? h.skills : null;
      if (!list5 || !list5.every((e) => isRecord2(e) && Object.keys(e).length === 1 && typeof Object.values(e)[0] === "string")) {
        d.error(file, 'skills must be a list of one-entry mappings: "- <skill-name>: <when to load it>"');
      } else {
        for (const s of skillIndex(h.skills)) {
          if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(s.name)) d.error(file, `skill name "${s.name}" must be kebab-case`);
          else if (!(0, import_node_fs6.existsSync)((0, import_node_path6.join)(roleDir(root, id), "skills", `${s.name}.md`))) d.error(file, `skill "${s.name}" has no file roles/${id}/skills/${s.name}.md`);
        }
      }
    }
    if (h.includes !== void 0) {
      if (!Array.isArray(h.includes) || !h.includes.every((f) => typeof f === "string")) d.error(file, "includes must be a list of plugin-relative file paths");
      else for (const f of h.includes) if (f.includes("..") || !(0, import_node_fs6.existsSync)((0, import_node_path6.join)(root, f))) d.error(file, `includes: "${f}" not found in the plugin`);
    }
    for (const k of ["department", "status", "carried_by"]) if (k in h) d.error(file, `"${k}" belongs in roster.yaml, not in the profile`);
  }
  for (const id of ids) {
    if (roster.roles[id]?.status === "active" && !profiled.includes(id)) d.warn(rf, `role ${id} is active but has no profile yet (roles/${id}/role.md)`);
  }
  if (d.errors.length) return d;
  const expected = generateAgents(root);
  const dir = (0, import_node_path6.join)(root, "agents");
  const present = (0, import_node_fs6.existsSync)(dir) ? (0, import_node_fs6.readdirSync)(dir) : [];
  for (const [name, content] of Object.entries(expected)) {
    const file = (0, import_node_path6.join)(dir, name);
    if (!(0, import_node_fs6.existsSync)(file)) d.error(`agents/${name}`, "missing: run `npm run build` (or `aidw roster --write`)");
    else if (read(file) !== content) d.error(`agents/${name}`, "out of date with its role folder: run `npm run build` (agent files are generated, never edited)");
  }
  for (const name of present) if (!(name in expected)) d.error(`agents/${name}`, "not generated from a role: agents/ holds only generated files");
  return d;
}
function implementerOf(root, role) {
  if (!role) return null;
  try {
    const entry = loadRoster(root).roles[role];
    if (!entry) return null;
    if (entry.status === "active") return roleAccess(root, role) === "write" ? role : null;
    const by = entry.carried_by;
    return by && by !== role ? implementerOf(root, by) : null;
  } catch {
    return null;
  }
}
var agentForTask = (root, role) => `aidw:${implementerOf(root, role) ?? DEFAULT_TASK_ROLE}`;
var accessCache = /* @__PURE__ */ new Map();
function roleAccess(root, id) {
  if (!ROLE_ID.test(id)) return null;
  const key = `${root}\0${id}`;
  const hit = accessCache.get(key);
  if (hit !== void 0) return hit;
  let access = null;
  try {
    const role = loadRole(root, id);
    if (role && oneOf(ACCESS, role.access)) access = role.access;
  } catch {
    access = null;
  }
  accessCache.set(key, access);
  return access;
}
function rosterTable(root) {
  const roster = loadRoster(root);
  const lines = [];
  for (const [dep, title] of Object.entries(roster.departments)) {
    lines.push(title);
    for (const [id, e] of Object.entries(roster.roles)) {
      if (e?.department !== dep) continue;
      const role = e.status === "active" ? loadRole(root, id) : null;
      const detail = e.status === "planned" ? `carried by ${e.carried_by}` : role ? `${role.mode}, ${role.tier}, ${role.access}` : "no profile yet";
      lines.push(`  ${id.padEnd(20)} ${e.status.padEnd(8)} ${detail}`);
    }
  }
  return `${lines.join("\n")}
`;
}

