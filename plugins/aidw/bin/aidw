function addedPackages(dir, base2, changed) {
  const out = [];
  const read4 = (f) => (0, import_node_fs33.existsSync)((0, import_node_path38.join)(dir, f)) ? (0, import_node_fs33.readFileSync)((0, import_node_path38.join)(dir, f), "utf8") : null;
  const before = (f) => base2 ? atBase(dir, base2, f) : null;
  for (const file of changed) {
    const name = file.split("/").pop() ?? "";
    if (name === "package.json" && !file.includes("node_modules/")) {
      const old = npmDeps(before(file));
      for (const [pkg, spec] of npmDeps(read4(file))) {
        if (old.has(pkg) || /^(?:workspace:|file:|link:|git\+|https?:|npm:|catalog:)/.test(spec)) continue;
        out.push({ ecosystem: "npm", name: pkg, version: installedNpmVersion(dir, file, pkg) ?? (EXACT.test(spec) ? spec : null), manifest: file });
      }
    } else if (/^requirements(?:[-.][\w.-]+)?\.txt$/.test(name)) {
      const old = pyRequirements(before(file));
      for (const [pkg, version] of pyRequirements(read4(file))) if (!old.has(pkg)) out.push({ ecosystem: "pypi", name: pkg, version, manifest: file });
    } else if (name === "uv.lock") {
      const project = read4((0, import_node_path38.join)((0, import_node_path38.dirname)(file), "pyproject.toml").replace(/^\.\//, "")) ?? "";
      const old = uvLock(before(file));
      for (const [pkg, version] of uvLock(read4(file))) {
        const named = new RegExp(`["']${pkg.replace(/[-_.]+/g, "[-_.]+")}(?![\\w.-])`, "i").test(project);
        if (!old.has(pkg) && named) out.push({ ecosystem: "pypi", name: pkg, version, manifest: file });
      }
    }
  }
  return out;
}
var minReleaseAgeDays = (env = process.env) => {
  const n = Number(env.AIDW_MIN_RELEASE_AGE_DAYS);
  return Number.isFinite(n) && n >= 0 && env.AIDW_MIN_RELEASE_AGE_DAYS !== void 0 && env.AIDW_MIN_RELEASE_AGE_DAYS !== "" ? n : 3;
};
function packageEvidence(dir, base2, changed, opts = {}) {
  const env = opts.env ?? process.env;
  if (changed === null || env.AIDW_SKIP_INSTALL_CHECK === "1") return null;
  const added = addedPackages(dir, base2, changed);
  if (!added.length) return null;
  const minDays = minReleaseAgeDays(env);
  const now9 = opts.now ?? Date.now();
  const ev = { checked: [], blocked: [], unproven: [] };
  let down = 0;
  for (const a of added) {
    const label2 = `${a.name}${a.version ? `@${a.version}` : ""}`;
    if (!a.version) {
      ev.unproven.push(`${label2}: no exact version (not installed and not pinned in ${a.manifest})`);
      continue;
    }
    const r = down >= 3 ? { status: "error", error: "lookup skipped after earlier failures" } : lookup(a.ecosystem, a.name, a.version);
    if (r.status === "error") {
      down++;
      ev.unproven.push(`${label2}: ${r.error ?? "lookup failed"}`);
      continue;
    }
    ev.checked.push(label2);
    if (r.status === "not-found") {
      ev.blocked.push({ name: a.name, version: a.version, problem: "not-found", detail: "this version is not known to the public registry index: the name may be invented, or the version is hours old" });
      continue;
    }
    const age = r.publishedAt ? (now9 - Date.parse(r.publishedAt)) / 864e5 : Number.POSITIVE_INFINITY;
    if (age < minDays) ev.blocked.push({ name: a.name, version: a.version, problem: "too-new", detail: `published ${age.toFixed(1)} days ago; the minimum is ${minDays}` });
    if (r.advisories?.length) ev.blocked.push({ name: a.name, version: a.version, problem: "vulnerable", detail: `known advisories: ${r.advisories.slice(0, 4).join(", ")}${r.advisories.length > 4 ? `, and ${r.advisories.length - 4} more` : ""}` });
  }
  return ev;
}
function packageProblems(e) {
  return (e?.blocked ?? []).map((f) => `unsafe package ${f.name}@${f.version}: ${f.detail}`);
}

