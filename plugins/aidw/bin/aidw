var statusOf3 = (t) => String(t.status ?? "pending");
function readEvidence2(change, taskId) {
  const f = (0, import_node_path19.join)(change.dir, "evidence", `${taskId}.json`);
  if (!(0, import_node_fs17.existsSync)(f)) return null;
