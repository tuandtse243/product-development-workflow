  for (const n of names2) {
    const e = registry[n];
    if (e && typeof e.path === "string" && typeof e.owner === "string" && artifactExists(p, id, e.path)) owners.add(e.owner);
  }
  return [...owners].sort();
}
function taskConsultable(p, id, task, pluginRoot2) {
  const role = agentRoleOf(pluginRoot2, task);
  const authors = contractAuthors(p, id, task, pluginRoot2);
  return { role, roles: consultsOf(pluginRoot2, role).filter((r) => authors.includes(r)) };
}
var agentRoleOf = (pluginRoot2, t) => implementerOf(pluginRoot2, typeof t.role === "string" ? t.role : void 0) ?? defaultTaskRole();
function section(body, heading) {
  const m = new RegExp(`^##\\s+${heading}\\s*$`, "im").exec(body);
  if (!m) return "";
  const rest = body.slice(m.index + m[0].length);
  const end = /^##\s+/m.exec(rest);
  return (end ? rest.slice(0, end.index) : rest).trim();
}
function parseRequest(text2, file) {
  const m = /^---\n([\s\S]*?)\n---\n?([\s\S]*)$/.exec(text2.replace(/\r\n/g, "\n"));
  if (!m) throw new OpError(`${file}: a request starts with a front matter between --- lines (from, task or stage, to)`);
  let head;
  try {
    head = import_yaml11.default.parse(m[1] ?? "");
  } catch (e) {
    throw new OpError(`${file}: the front matter is not valid YAML: ${e.message}`);
  }
  if (!isRecord6(head)) throw new OpError(`${file}: the front matter must be a mapping`);
  const s = (k) => head[k] === void 0 || head[k] === null ? void 0 : String(head[k]).trim();
  const body = m[2] ?? "";
  const r = {
    from: s("from") ?? "",
    to: s("to") ?? "",
    ...s("task") ? { task: s("task") } : {},
    ...s("stage") ? { stage: s("stage") } : {},
    ...s("consultation") ? { consultation: s("consultation") } : {},
    ...s("brief") ? { brief: s("brief") } : {},
    question: section(body, "Question"),
    progress: section(body, "Progress")
  };
  if (!r.from) throw new OpError(`${file}: "from:" (the asking Role) is missing`);
  if (!r.to) throw new OpError(`${file}: "to:" (the Role asked) is missing`);
  if (!r.question) throw new OpError(`${file}: the "## Question" section is missing or empty`);
  if (!r.progress) throw new OpError(`${file}: the "## Progress" section is missing or empty (done so far, next step, files touched): a fresh Agent continues from it`);
  return r;
}
function changeOfRequest(p, file, given) {
  const r = (0, import_node_path18.relative)(p.changes, file);
  if (r && !r.startsWith("..") && !(0, import_node_path18.isAbsolute)(r)) {
    const parts = r.split(import_node_path18.sep);
    if (parts.length === 3 && parts[1] === CONSULT_DIR) return parts[0];
  }
  return given;
}
var isAfterGate = (p, change) => {
  const st = stateOf(change);
  return !!st && machineOf(p, change).approvalRequired.has(st);
};
var who = (c) => `${c.from} (${c.task ?? `stage ${c.stage}`})`;
function requestConsultation(p, id, requestFile, pluginRoot2) {
  const change = loadChange(p, id);
  const file = (0, import_node_path18.resolve)(p.project, requestFile);
  if (RECORDED_FILE.test((0, import_node_path18.basename)(file))) throw new OpError(`${rel(p, file)} is the recorded copy of a Consultation, not a new request: the asker writes its own request file (<task>.request.md or <stage>-<role>.request.md)`);
  const text2 = readText(file);
  if (text2 === null) throw new OpError(`no request at ${file}`);
  const req = parseRequest(text2, rel(p, file));
  const list8 = loadConsultations(change);
  const same = list8.find((c2) => readText((0, import_node_path18.join)(change.dir, c2.request))?.trim() === text2.trim());
  if (same) {
    (0, import_node_fs15.rmSync)(file, { force: true });
    throw new OpError(`this request is already recorded as ${same.id} (${same.status}); continue with \`aidw next\``);
  }
  const roster = loadRoster(pluginRoot2);
  const answering = list8.find((c2) => c2.status === "open" && c2.to === req.from);
  if (req.consultation || answering) {
    throw new OpError(`a consulted Agent cannot consult (depth 1, ADR-0013): ${req.from} is answering ${req.consultation ?? answering?.id}. It answers from what exists, or writes STATUS: cannot-answer`);
  }
  if (roster.roles[req.from]?.status !== "active") throw new OpError(`"${req.from}" is not an active Role`);
  if (roster.roles[req.to]?.status !== "active") throw new OpError(`"${req.to}" is not an active Role`);
  if (!consultsOf(pluginRoot2, req.from).includes(req.to)) {
    const may = consultsOf(pluginRoot2, req.from);
    throw new OpError(`${req.from} does not consult ${req.to}: its role.md declares ${may.length ? `consults: [${may.join(", ")}]` : "no consults"}`);
  }
  if (!!req.task === !!req.stage) throw new OpError(`${rel(p, file)}: name exactly one of "task:" (in the build) or "stage:" (before the gate)`);
  const afterGate = isAfterGate(p, change);
  let run2;
  let origin;
  if (req.task) {
    if (!afterGate) throw new OpError(`change "${id}" is not approved: before the gate an Agent asks from its stage ("stage:"), not from a task`);
    const text3 = readText((0, import_node_path18.join)(change.dir, "tasks.yaml"));
    const task = text3 === null ? void 0 : parseTasks(text3).tasks.find((t) => t.id === req.task);
    if (!task) throw new OpError(`task "${req.task}" not found in ${id}/tasks.yaml`);
    if (String(task.status ?? "pending") !== "running") throw new OpError(`task ${req.task} is not running (it is "${String(task.status ?? "pending")}"): only the Agent running a task asks for it`);
    const role = agentRoleOf(pluginRoot2, task);
    if (role !== req.from) throw new OpError(`task ${req.task} is run by ${role}, not ${req.from}`);
    if (!contractAuthors(p, id, task, pluginRoot2).includes(req.to)) {
      throw new OpError(`${req.to} wrote no contract that ${req.task} builds against: in the build ${req.from} asks only the authors of the Artifacts its brief reads (${contractAuthors(p, id, task, pluginRoot2).join(", ") || "none"})`);
    }
    run2 = `task:${req.task}#${taskRun(task)}`;
    const brief2 = (0, import_node_path18.join)(briefsDir(p, id), `${req.task}.implement.md`);
    if ((0, import_node_fs15.existsSync)(brief2)) origin = (0, import_node_path18.relative)(p.aidw, brief2).split(import_node_path18.sep).join("/");
  } else {
    if (afterGate) throw new OpError(`change "${id}" is past the Approval Gate: an Agent asks from the task it runs ("task:")`);
    const w = workflowOfChange(p, change, pluginRoot2);
    const stage = w.stages.find((s) => s.id === req.stage);
    if (!stage) throw new OpError(`workflow "${w.id}" has no stage "${req.stage}"`);
    if (!stage.roles.includes(req.from)) throw new OpError(`${req.from} has no part in stage ${req.stage} (its roles: ${stage.roles.join(", ")})`);
    run2 = `stage:${req.stage}:${req.from}`;
  }
  if (req.brief) {
    const b = (0, import_node_path18.resolve)(p.project, req.brief);
    const r = (0, import_node_path18.relative)(briefsDir(p, id), b);
    if (!r || r.startsWith("..") || (0, import_node_path18.isAbsolute)(r)) throw new OpError(`${rel(p, file)}: "brief:" must be a file under ${rel(p, briefsDir(p, id))}/`);
    origin = (0, import_node_path18.relative)(p.aidw, b).split(import_node_path18.sep).join("/");
  }
  const waiting = list8.find((c2) => c2.run === run2 && c2.status === "open");
  if (waiting) throw new OpError(`the Agent run ${run2} is waiting for ${waiting.id}: it ended its turn with that question, so this request is not from it`);
  const used = list8.filter((c2) => c2.run === run2).length;
  if (used >= MAX_CONSULTATIONS_PER_RUN) {
    throw new OpError(`${req.from} already asked ${used} question(s) in this run (${run2}): at most ${MAX_CONSULTATIONS_PER_RUN} Consultations per Agent run (ADR-0013). It goes on from what it has and says what is still open`);
  }
  const n = list8.length + 1;
  const cid = `C${String(n).padStart(2, "0")}`;
  const dir = (0, import_node_path18.join)(change.dir, CONSULT_DIR);
  (0, import_node_fs15.mkdirSync)(dir, { recursive: true });
  const kept = (0, import_node_path18.join)(dir, `${cid}.request.md`);
  const c = {
    id: cid,
    from: req.from,
    to: req.to,
    ...req.task ? { task: req.task } : {},
    ...req.stage ? { stage: req.stage } : {},
    run: run2,
    request: `${CONSULT_DIR}/${cid}.request.md`,
    answer: `${CONSULT_DIR}/${cid}.answer.md`,
    brief: `run/briefs/${id}/${cid}.consult.md`,
    ...origin ? { origin } : {},
    after_gate: afterGate,
    status: "open",
    at: now()
  };
  (0, import_node_fs15.writeFileSync)(kept, text2);
  const brief = consultBrief(p, change, c, req, used, pluginRoot2);
  saveConsultations(change, [...list8, c]);
  (0, import_node_fs15.rmSync)(file, { force: true });
  return { consultation: c, brief, agent: `aidw:${req.to}` };
}
function consultBrief(p, change, c, req, used, pluginRoot2) {
  let registry = null;
  try {
    registry = loadArtifacts(pluginRoot2);
  } catch {
    registry = null;
  }
  const own = Object.entries(registry ?? {}).filter(([, e]) => e?.owner === c.to && typeof e.path === "string" && artifactExists(p, change.id, e.path)).map(([name, e]) => `- \`${(0, import_node_path18.join)(p.aidw, e.path.replace(/<id>/g, change.id))}\`${e.part ? ` (${e.part})` : ""}: ${name}`);
  const answer = (0, import_node_path18.join)(change.dir, c.answer);
  const lines = [
    `# Consultation brief: ${c.id} - ${who(c)} asks ${c.to}`,
    "",
    `Change \`${change.id}\` \xB7 ${c.after_gate ? "after the Approval Gate (the package is approved)" : "before the Approval Gate"} \xB7 question ${used + 1} of at most ${MAX_CONSULTATIONS_PER_RUN} in the asker's run`,
    "",
    `You are the ${c.to} Role, consulted by another Agent through the orchestrator. You answer one question; you do not take over the asker's work.`,
    "",
    "## Question",
    "",
    req.question,
    "",
    "## What the asker has done (context only)",
    "",
    req.progress,
    "",
    "## Read first (read only what the answer needs)",
    "",
    `- \`${(0, import_node_path18.join)(change.dir, c.request)}\`: the request as the asker wrote it`,
    ...c.origin ? [`- \`${(0, import_node_path18.resolve)(p.aidw, c.origin)}\`: the brief the asker works from`] : [],
    ...own,
    "",
    "## Rules",
    "",
    "- You cannot consult another Role (depth 1). Answer from the Artifacts and the code that exist; if you cannot, say so.",
    "- Never guess. An answer the asker builds on must come from an Artifact, the code or a stated reason.",
    ...c.after_gate ? [
      "- The package is approved: do not edit an approved Artifact. If the only right answer changes something approved, write `STATUS: changes-approved` and the smallest change that keeps the purpose of the requirement and adds no scope; the change itself is made through the Deviation path (ADR-0014). Nobody asks the user."
    ] : ["- Before the gate you may correct an Artifact you own when the question shows a hole in it; say which one in your answer."],
    `- Write your whole answer to \`${answer}\` with the Write tool (the one file this Consultation adds). Its first line is exactly one of \`STATUS: answered\`, \`STATUS: cannot-answer\`, \`STATUS: changes-approved\`.`,
    "- Reply with just that first line.",
    ""
  ];
  const path = (0, import_node_path18.join)(p.aidw, c.brief);
  (0, import_node_fs15.mkdirSync)((0, import_node_path18.dirname)(path), { recursive: true });
  (0, import_node_fs15.writeFileSync)(path, lines.join("\n"));
  return path;
}
function parseAnswerStatus(text2) {
  const first = text2.split(/\r?\n/).find((l) => l.trim()) ?? "";
  const m = /^\s*STATUS:\s*([a-z-]+)\s*$/i.exec(first);
  const s = m?.[1]?.toLowerCase();
  return s && ANSWER_STATUSES.includes(s) ? s : null;
}
function find(change, cid) {
  const list8 = loadConsultations(change);
  const i = list8.findIndex((c) => c.id === cid);
  if (i < 0) throw new OpError(`no Consultation ${cid} in ${change.id}/${CONSULT_RECORD}`);
  return { list: list8, i, c: list8[i] };
}
function recordAnswer(p, id, cid, pluginRoot2) {
  const change = loadChange(p, id);
  const { list: list8, i, c } = find(change, cid);
  if (c.status !== "open") throw new OpError(`${cid} is already ${c.status}`);
  const answerFile = (0, import_node_path18.join)(change.dir, c.answer);
  const text2 = readText(answerFile);
  if (text2 === null) throw new OpError(`no answer at ${answerFile}: the consulted Agent did not write it. Spawn a fresh ${c.to} with the brief ${(0, import_node_path18.join)(p.aidw, c.brief)}`);
  const outcome = parseAnswerStatus(text2);
  if (!outcome) throw new OpError(`${answerFile} does not start with "STATUS: answered", "STATUS: cannot-answer" or "STATUS: changes-approved"; spawn a fresh ${c.to} with the brief once more`);
  let status = "answered";
  if (outcome !== "answered") {
    if (c.after_gate) status = "needs-deviation";
    else status = outcome === "cannot-answer" ? "unanswered" : "answered";
  }
  const updated = {
    ...c,
    status,
    outcome,
    answered_at: now(),
    resume: `run/briefs/${id}/${cid}.resume.md`,
    // ADR-0014: the author Role changes its Artifact as a Deviation (`aidw deviation open --consultation`, src/deviation.ts);
    // closing it sets `recorded`. `aidw next` asks for the Deviation before the asker resumes.
    ...status === "needs-deviation" ? { route: "deviation", deviation: "pending" } : {}
  };
  writeResumeBrief(p, change, updated, pluginRoot2);
  list8[i] = updated;
  saveConsultations(change, list8);
  return { consultation: updated, resume: (0, import_node_path18.join)(p.aidw, updated.resume) };
}
function originalBrief(p, change, c, pluginRoot2) {
  if (c.origin) {
    const file = (0, import_node_path18.isAbsolute)(c.origin) ? c.origin : (0, import_node_fs15.existsSync)((0, import_node_path18.join)(p.aidw, c.origin)) ? (0, import_node_path18.join)(p.aidw, c.origin) : (0, import_node_path18.join)(p.project, c.origin);
    const text2 = readText(file);
    if (text2 !== null) return [`(from \`${file}\`)`, "", text2.trim()];
  }
  if (c.stage) {
    try {
      const s = workflowOfChange(p, change, pluginRoot2).stages.find((x) => x.id === c.stage);
      if (s) {
        return [
          `Stage \`${s.id}\` (${s.title}) of change \`${change.id}\`, as the ${c.from} Role: follow your Role's procedure for this stage.`,
          `It reads: ${s.reads.join(", ") || "nothing"}. It writes: ${s.writes.join(", ") || "nothing"}.`
        ];
      }
    } catch {
    }
  }
  return [`(the original brief was not kept: continue ${c.task ? `task ${c.task}` : `stage ${c.stage}`} from the progress note)`];
}
function writeResumeBrief(p, change, c, pluginRoot2) {
  const req = parseRequest(readText((0, import_node_path18.join)(change.dir, c.request)) ?? "", c.request);
  const answer = (0, import_node_path18.join)(change.dir, c.answer);
  const left = MAX_CONSULTATIONS_PER_RUN - loadConsultations(change).filter((x) => x.run === c.run).length;
  const outcomeText = c.status === "answered" ? [`${c.to} answered. Read \`${answer}\` first and build on it.`] : c.status === "unanswered" ? [
    `${c.to} could not answer (\`${answer}\` says why). Do not guess: record the question as an open question in your Artifact (Risks and assumptions), with your recommendation, and go on with the rest. The user sees it at the Approval Gate.`
  ] : [
    `${c.to} could not answer without changing something approved (\`${answer}\` says what). Do not guess and do not ask the user: after the Approval Gate the Role that wrote it decides, as a Deviation (ADR-0014).`,
    `Build what the approved package states. If the task cannot be finished without the answer, write that to your report file, naming ${c.id}, and say in your reply that the task is blocked by ${c.id}.`
  ];
  const lines = [
    `# Resume brief: ${c.from} continues ${c.task ? `task ${c.task}` : `stage ${c.stage}`} after Consultation ${c.id}`,
    "",
    `Change \`${change.id}\`. An Agent of your Role started this work, asked ${c.to} a question and ended its turn. You continue it in a fresh context: do not start over.`,
    "",
    "## The answer",
    "",
    ...outcomeText,
    "",
    "## Progress note left by the Agent that asked",
    "",
    req.progress,
    "",
    "## The question it asked",
    "",
    req.question,
    "",
    "## Consultations left in this run",
    "",
    left > 0 ? `${left}: ask again only about something new, never the same question.` : "None: go on from what you have and say in your reply what is still open.",
    "",
    "## Original brief",
    "",
    ...originalBrief(p, change, c, pluginRoot2),
    ""
  ];
  const path = (0, import_node_path18.join)(p.aidw, c.resume);
  (0, import_node_fs15.mkdirSync)((0, import_node_path18.dirname)(path), { recursive: true });
  (0, import_node_fs15.writeFileSync)(path, lines.join("\n").replace(/\n{3,}/g, "\n\n"));
}
function deviationRecorded(p, id, cid, d) {
  const change = loadChange(p, id);
  const { list: list8, i, c } = find(change, cid);
  list8[i] = { ...c, deviation: "recorded", deviation_id: d.id };
  saveConsultations(change, list8);
  if (!c.resume) return;
  const path = (0, import_node_path18.join)(p.aidw, c.resume);
  const text2 = readText(path);
  if (text2 === null) return;
  const files = (d.changed ?? []).map((f) => `\`${(0, import_node_path18.join)(p.project, f)}\``).join(", ");
  (0, import_node_fs15.writeFileSync)(
    path,
    `${text2.trimEnd()}

## Deviation ${d.id}: the approved package changed

${d.roles.join(" and ")} changed ${files} after this question (${d.reason}). The CLI checked and recorded it. Read those files again and build on them: where this brief says to build what the approved package states, the package now means the changed one.${d.rerun?.length ? ` Tasks that run again because of it: ${d.rerun.join(", ")}.` : ""}
`
  );
}
function deviationAbandoned(p, id, cid, did) {
  const change = loadChange(p, id);
  const { list: list8, i, c } = find(change, cid);
  list8[i] = { ...c, deviation: "abandoned", deviation_id: did };
  saveConsultations(change, list8);
}
function resumeConsultation(p, id, cid) {
  const change = loadChange(p, id);
  const { list: list8, i, c } = find(change, cid);
  if (c.status === "open") throw new OpError(`${cid} has no answer yet: run \`aidw consult answer ${cid}\` after ${c.to} wrote it`);
  if (c.status === "resumed") throw new OpError(`${cid} was already resumed`);
  const deviating = openDeviation(change);
  if (deviating?.consultation === cid) throw new OpError(`Deviation ${deviating.id} for ${cid} is still open: \`aidw deviation close\` (or abandon) before the asker resumes`);
  const updated = { ...c, status: "resumed", resumed_at: now() };
  list8[i] = updated;
  saveConsultations(change, list8);
  return { consultation: updated, resume: (0, import_node_path18.join)(p.aidw, c.resume), agent: `aidw:${c.from}` };
}
function taskAnswers(change, taskId) {
  return loadConsultations(change).filter((c) => c.task === taskId && c.status !== "open");
}
function consultNextText(p, id, c) {
  if (c.status === "open" && (0, import_node_fs15.existsSync)((0, import_node_path18.join)(p.changes, id, c.answer))) return `consultation ${c.id}: ${c.to} wrote its answer; run \`aidw consult answer ${c.id} --change ${id}\` (do not spawn it again)`;
  return c.status === "open" ? `consultation ${c.id}: ${who(c)} asks ${c.to}; spawn aidw:${c.to} with: Consultation brief: ${(0, import_node_path18.join)(p.aidw, c.brief)}. Read it and answer as it says. (If you already spawned it and it has not replied, wait.) Then \`aidw consult answer ${c.id} --change ${id}\`` : `consultation ${c.id} is ${c.status}: resume ${who(c)} with \`aidw consult resume ${c.id} --change ${id}\``;
}
function consultWrite(p, file, agent, role) {
  const low = (x) => x.toLowerCase();
  const dir = (0, import_node_path18.dirname)(file);
  if (low((0, import_node_path18.basename)(dir)) !== CONSULT_DIR || low((0, import_node_path18.dirname)((0, import_node_path18.dirname)(dir))) !== low(p.changes)) return null;
  const id = (0, import_node_path18.basename)((0, import_node_path18.dirname)(dir));
  const exact = (0, import_node_fs15.existsSync)((0, import_node_path18.join)(p.changes, id)) && dir === (0, import_node_path18.join)(p.changes, id, CONSULT_DIR);
  const name = (0, import_node_path18.basename)(file);
  let change = null;
  try {
    change = exact ? loadChange(p, id) : null;
  } catch {
    change = null;
  }
  if (RECORDED_FILE.test(name)) {
    const m = /^(C\d+)\.answer\.md$/.exec(name);
    const c = m && change ? loadConsultations(change).find((x) => x.id === m[1] && x.status === "open") : void 0;
    if (c && c.to === agent) return { allow: true, reason: `the consulted Role's answer to ${c.id}` };
    return { allow: false, reason: "only the Role consulted in an open Consultation writes its answer (C<NN>.answer.md); the other C<NN> files are the CLI's" };
  }
  if (role === "implementer") {
    const m = /^(.+)\.request\.md$/.exec(name);
    const text2 = change && m ? readText((0, import_node_path18.join)(change.dir, "tasks.yaml")) : null;
    const task = text2 && m ? parseTasks(text2).tasks.find((t) => t.id === m[1]) : void 0;
    if (task && String(task.status ?? "pending") === "running") return { allow: true, reason: "implementer question to another Role (Consultation)" };
    return { allow: false, reason: "an implementer writes only <task>.request.md, for the task it runs, directly in consult/ of its change" };
  }
  return null;
}
var stageConsultationsInFlight = (change, stage) => loadConsultations(change).filter((c) => c.stage && c.status !== "resumed" && (!stage || c.stage === stage));
function unansweredSection(change) {
  const list8 = loadConsultations(change).filter((c) => !c.after_gate && c.outcome === "cannot-answer");
  if (!list8.length) return null;
  const question = (c) => {
    try {
      return parseRequest(readText((0, import_node_path18.join)(change.dir, c.request)) ?? "", c.request).question.replace(/\s+/g, " ").trim();
    } catch {
      return "(the request could not be read)";
    }
  };
  return {
    id: "unanswered-consultations",
    title: "Questions no Role could answer",
    body: "An Agent asked another Role these questions while drafting the package and got no answer. Each is recorded as an open question in the asker's Artifact. Approve with them, or mark this section for a change.",
    points: list8.map((c) => `**${c.id}** ${c.from} asked ${c.to} (stage \`${c.stage}\`): ${question(c)}`),
    html: ""
  };
}

// src/gate.ts
var OPEN_STATES = /* @__PURE__ */ new Set(["approved", "executing", "verifying", "converging", "deploying"]);
var GRANT_STATES = /* @__PURE__ */ new Set([...OPEN_STATES, "delivered"]);
function gateState(p) {
  const st = { open: false, drift: [], frozen: [], delivered: false, summary: "" };
  const parts = [];
  for (const id of listChangeIds(p)) {
    let state = null;
    try {
      const c = loadChange(p, id);
      state = stateOf(c);
      const machine = machineOf(p, c);
      if (state && machine.approvalRequired.has(state)) {
        const a = approvalStatus(p, c).status;
        if (a === "drift") st.drift.push(id);
        if (a === "valid" && OPEN_STATES.has(state)) st.open = true;
        if (a === "valid" && state === "delivered") st.delivered = true;
        if (state !== "escalated") st.frozen.push(id);
      }
    } catch {
    }
    parts.push(`${id}=${state ?? "?"}`);
  }
  st.summary = parts.length ? parts.join(", ") : "no changes";
  return st;
}
function approvedForBuild(p, id) {
  try {
    const c = loadChange(p, id);
    const state = stateOf(c);
    return !!state && OPEN_STATES.has(state) && approvalStatus(p, c).status === "valid";
  } catch {
    return false;
  }
}
function inside2(parent, child) {
