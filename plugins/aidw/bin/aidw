// src/pydetect.ts
var import_node_fs23 = require("node:fs");
var import_node_path28 = require("node:path");
var norm = (name) => name.toLowerCase().replace(/[_.]+/g, "-");
var REQ2 = /^([A-Za-z0-9][A-Za-z0-9._-]*)\s*(?:\[[^\]]*\])?\s*(?:(?:==|>=|~=|<=|>|<|!=|===)\s*([0-9][0-9A-Za-z.*+!-]*))?/;
function parseRequirement(s) {
  const m = REQ2.exec(s.trim());
  if (!m) return null;
  const rest = s.trim().slice(m[0].length).trim();
  if (rest && !/^[;,<>=!~]/.test(rest) && !rest.startsWith("@")) return null;
  return [norm(m[1]), m[2] ?? ""];
}
var SECTION_ARRAYS = /^(project|project\.optional-dependencies|dependency-groups|tool\.uv|tool\.pdm\.dev-dependencies)$/;
var POETRY_SECTION = /^tool\.poetry(\.group\.[^.]+)?\.(dev-)?dependencies$/;
function fromPyproject(text2, out) {
  let section2 = "";
  let inArray = false;
  for (const raw of text2.split("\n")) {
    const line = raw.trim();
    const head = /^\[+\s*([^\]]+?)\s*\]+\s*(#.*)?$/.exec(line);
    if (!inArray && head) {
      section2 = head[1];
      continue;
    }
    if (POETRY_SECTION.test(section2)) {
      const m = /^([A-Za-z0-9][A-Za-z0-9._-]*)\s*=\s*(.*)$/.exec(line);
      if (m && norm(m[1]) !== "python") {
        const v = /["']\^?~?[>=<]*\s*([0-9][0-9A-Za-z.*+-]*)/.exec(m[2]);
        out[norm(m[1])] ??= v?.[1] ?? "";
      }
      continue;
    }
    if (!SECTION_ARRAYS.test(section2)) continue;
    const key = /^([\w.-]+)\s*=\s*\[/.exec(line)?.[1];
    if (!inArray && key && (section2 === "project" ? key === "dependencies" : section2 === "tool.uv" ? key === "dev-dependencies" : true)) inArray = true;
    if (!inArray) continue;
    for (const s of line.matchAll(/"([^"]+)"|'([^']+)'/g)) {
      const r = parseRequirement(s[1] ?? s[2]);
      if (r) out[r[0]] ??= r[1];
    }
    if (line.replace(/"[^"]*"|'[^']*'/g, "").includes("]")) inArray = false;
  }
}
function fromRequirements(text2, out) {
  for (const raw of text2.split("\n")) {
    const line = raw.replace(/\s+#.*$/, "").trim();
    if (!line || line.startsWith("#") || line.startsWith("-") || /^(https?|git\+)/.test(line)) continue;
    const r = parseRequirement(line);
    if (r) out[r[0]] ??= r[1];
  }
}
function read3(file) {
  try {
    return (0, import_node_fs23.readFileSync)(file, "utf8");
  } catch {
    return "";
  }
}
function detectPython(dir) {
  const pyproject = (0, import_node_fs23.existsSync)((0, import_node_path28.join)(dir, "pyproject.toml")) ? read3((0, import_node_path28.join)(dir, "pyproject.toml")) : null;
  const reqFiles = (0, import_node_fs23.readdirSync)(dir).filter((f) => /^requirements([-_.][\w.-]+)?\.txt$/.test(f));
  const hasPipfile = (0, import_node_fs23.existsSync)((0, import_node_path28.join)(dir, "Pipfile"));
  if (pyproject === null && !reqFiles.length && !hasPipfile) return null;
  const deps = {};
