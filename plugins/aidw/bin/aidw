var ARTIFACT_VALIDATORS = ["aidw validate", "aidw analyze", "aidw plan", "aidw plan-review", "none"];
var NAME = /^[a-z0-9]+(-[a-z0-9]+)*$/;
var isRecord4 = (v) => !!v && typeof v === "object" && !Array.isArray(v);
var artifactsFile = (root) => (0, import_node_path14.join)(root, "artifacts.yaml");
function loadArtifacts(root) {
  const file = artifactsFile(root);
  if (!(0, import_node_fs12.existsSync)(file)) return null;
  const data = import_yaml8.default.parse((0, import_node_fs12.readFileSync)(file, "utf8"));
  return isRecord4(data) ? data : {};
