      ...outside.length ? [`- Files changed outside Touches: ${outside.map((f) => `\`${f}\``).join(", ")}. Decide whether each is justified.`] : [],
      ...lastCheckpoint?.tamper?.justified.length ? [`- Checks the task switched off, each with a stated reason: ${lastCheckpoint.tamper.justified.map((f) => `\`${f.file}:${f.line}\``).join(", ")}. Read each reason: if fixing the code was possible, the verdict is \`fix\`.`] : [],
      ...lastCheckpoint?.tamper?.snapshots?.length ? [`- Stored snapshots this task rewrote or removed: ${lastCheckpoint.tamper.snapshots.map((f) => `\`${f}\``).join(", ")}. Read the diff of each: a snapshot updated to match wrong output is a \`fix\`.`] : [],
      ...lastCheckpoint?.config?.watched.length ? [`- Configuration of the checks changed by this task: ${lastCheckpoint.config.watched.map((f) => `\`${f}\``).join(", ")}. Read the diff of each: a lowered threshold, a removed rule or a narrower include is a \`fix\`.`] : [],
      ...lastCheckpoint?.packages?.checked.length ? [`- Packages added (each exists, is old enough and has no known advisory): ${lastCheckpoint.packages.checked.map((x) => `\`${x}\``).join(", ")}. Judge whether each is needed.`] : [],
      ...lastCheckpoint?.packages?.unproven.length ? [`- Packages aidw could NOT check: ${lastCheckpoint.packages.unproven.join("; ")}. Check that each is a real, established package.`] : [],
      ...design?.screenshots.length ? [`- Screenshots (open each with Read): ${design.screenshots.map((f) => `\`${(0, import_node_path39.join)(p.project, f)}\``).join(", ")}`] : [],
      ...design?.hardcoded_colors.length ? [`- Color literals that are not tokens, in changed files: ${design.hardcoded_colors.map((f) => `\`${f}\``).join(", ")}. Each needs a reason or becomes a token.`] : [],
      "",
      "## Checklist",
      "",
      "1. Every scenario is implemented as the spec says, and its test really asserts the THEN outcome (not a placeholder, not mocked away).",
      "2. Behavior matches the requirement text; nothing outside this task's scope was added.",
      "3. Constitution, architecture and ADRs are followed.",
      ...decisions.length ? ["4. Every **Decision to honor** below is kept exactly (names, keys, formats, tools). A silent deviation is a blocking issue."] : [],
      ...tokens.length ? ["5. Design: look at every screenshot. Each token is used where its **Use** says (e.g. the accent color really appears on what it names), the layout matches the design direction, and no stray colors. A visible mismatch is a blocking issue."] : [],
      ...isSecuritySensitive(t) ? ["6. Security: authorization on every path, input validation, secrets handling, data exposure (security skill below)."] : [],
      "7. Tests are independent: each one sets up its own data and passes alone and in any order. A test that only passes after another test ran (shared in-memory state, a list the previous test filled) is a blocking issue: it breaks when the tests are reordered or run in parallel.",
      ...touchesUi(t) ? ["8. Accessibility beyond what axe finds (axe misses names that are wrong rather than missing, keyboard traps and focus order): controls have readable accessible names, a keyboard user can reach and operate them, dialogs and menus move and return focus, and state is not shown by color alone."] : [],
      "",
      "## Verdict",
      "",
      "Your verdict starts with exactly one line: `VERDICT: pass` or `VERDICT: fix`.",
      "For `fix`, follow with numbered blocking issues: file, problem, expected fix. Only blocking issues justify `fix`;",
      "put anything else under `Non-blocking:`. Be concrete: the implementer will get your notes verbatim.",
      `**Write the whole verdict to \`${(0, import_node_path39.join)(p.run, `review-${taskId}.md`)}\` with the Write tool** (the only file you may write), then reply with just its first line, \`VERDICT: pass\` or \`VERDICT: fix\`. The orchestrator reads the file; keeping your reply short saves its context.`,
      "",
      ...shared
    ];
  }
  const text2 = [...header2, ...body].join("\n").replace(/\n{3,}/g, "\n\n");
  const dir = (0, import_node_path39.join)(p.run, "briefs", id);
  (0, import_node_fs34.mkdirSync)(dir, { recursive: true });
  const path = (0, import_node_path39.join)(dir, `${taskId}.${kind}.md`);
  (0, import_node_fs34.writeFileSync)(path, text2);
  return { kind, task: taskId, path, text: text2, skills };
}
var TRIAGE_CAUSES = ["implementation", "environment", "plan", "spec", "architecture"];
var isRecord8 = (v) => !!v && typeof v === "object" && !Array.isArray(v);
var triageFile = (p, taskId) => (0, import_node_path39.join)(p.run, `triage-${taskId}.md`);
function parseTriage(text2) {
  const m = /^\s*CAUSE:\s*([a-z]+)\s*\n?([\s\S]*)$/.exec(text2);
  if (!m || !TRIAGE_CAUSES.includes(m[1])) return null;
  return { cause: m[1], diagnosis: (m[2] ?? "").trim() };
}
function readTriage(p, taskId) {
  const text2 = readText(triageFile(p, taskId));
  return text2 === null ? null : parseTriage(text2);
}
function buildTriageBrief(p, id, taskId) {
  const tf = loadTasks(p, id);
  const t = tf.tasks[indexOf(tf, taskId)];
  if (statusOf3(t) !== "failed" || attemptsOf(t) < maxAttemptsOf(t)) throw new OpError(`task ${taskId} is "${statusOf3(t)}" with ${attemptsOf(t)} of ${maxAttemptsOf(t)} attempts: triage is for a failed task that ran out of attempts`);
  if (t.triage !== void 0) throw new OpError(`task ${taskId} was already triaged: one triage per task`);
  (0, import_node_fs34.rmSync)(triageFile(p, taskId), { force: true });
  const ev = readEvidence2(tf.change, t);
  const reqs = requirementsAfterChange(p, id);
  const scenarioIds = list5(t.scenarios);
  const reqIds = [.../* @__PURE__ */ new Set([...list5(t.specs), ...scenarioIds.map((s) => s.split("/").slice(0, -1).join("/"))])];
  const reqBlocks = reqIds.map((r) => reqs.get(r) ? `<!-- ${r} -->
${reqs.get(r).raw.trim()}` : `<!-- ${r}: not found in specs after this change -->`);
  const attempts2 = ev.checkpoints.map((c, i) => {
    const failed = c.verify.find((v) => v.exit !== 0);
    return [
      `### Checkpoint ${i + 1}: ${c.ok ? "passed" : "failed"}`,
      ...c.missing_scenarios.length ? [`- Missing scenario tests: ${c.missing_scenarios.map((s) => `\`${s}\``).join(", ")}`] : [],
      ...failed ? [`- \`${failed.command}\` failed${failed.timedOut ? " (timed out)" : ` with exit ${failed.exit}`}:`, "", "```", failed.tail, "```"] : []
    ].join("\n");
  });
  const reviews = ev.reviews.map((r, i) => `### Review ${i + 1}: ${r.verdict}
${r.notes.trim()}`);
  const out = triageFile(p, taskId);
  const pointers = [
    pointer2(p, p.constitution, "engineering principles"),
    pointer2(p, (0, import_node_path39.join)(p.architecture, "overview.md"), "architecture"),
    pointer2(p, (0, import_node_path39.join)(p.requirements, `${id}.md`), "requirements"),
    pointer2(p, (0, import_node_path39.join)(tf.change.dir, "tasks.yaml"), "the plan (this task and its neighbours)")
  ].filter((x) => x !== null);
  const text2 = [
    `# Triage brief: ${taskId} - ${String(t.title ?? "")}`,
    "",
    `Change \`${id}\` \xB7 role ${String(t.role ?? "?")} \xB7 ${attemptsOf(t)} of ${maxAttemptsOf(t)} attempts used, all unsuccessful.`,
    "",
    "You are the Software Architect in a fresh context, asked once to say WHY this task keeps failing. You did not write this code. You may read files and run read-only commands; you edit nothing. Write only the file named at the end.",
    "",
    "## Task",
    "",
    `- Scenarios: ${scenarioIds.length ? scenarioIds.map((s) => `\`${s}\``).join(", ") : "(none)"}`,
    `- Touches: ${list5(t.touches).map((g) => `\`${g}\``).join(", ")}`,
    `- Verify: ${list5(t.verify).map((v) => `\`${v}\``).join(", ")}`,
    `- Depends on: ${list5(t.depends_on).join(", ") || "nothing"}`,
    ...t.notes ? [`- Last note: ${String(t.notes)}`] : [],
    "",
    "## Requirements the task was held to (spec text after this change)",
    "",
    ...reqBlocks.length ? ["```markdown", reqBlocks.join("\n\n"), "```"] : ["(none)"],
    "",
    "## What happened",
    "",
    ...attempts2.length ? attempts2 : ["(no checkpoint recorded)"],
    ...reviews.length ? ["", ...reviews] : [],
    "",
    "## Read if you need it",
    "",
    ...pointers,
    `- the task's changes: \`git diff ${typeof t.base === "string" ? t.base : "HEAD"}\``,
    "",
    "## Decide the cause: exactly one",
    "",
    "- `implementation`: the plan, spec and architecture are sound and the code is wrong or incomplete. A fresh attempt with your diagnosis can fix it.",
    "- `environment`: the machine, not the code: a missing binary, package registry, credential, port, browser, permission or network. Say the exact thing the user must fix.",
    "- `plan`: the task cannot succeed as planned (wrong `touches`, missing dependency, scope too big or too small, `verify` that cannot pass).",
    "- `spec`: a scenario contradicts another, cannot be observed or tested, or asks for something the requirement text does not support.",
    "- `architecture`: the approved architecture or a Decision to honor cannot be met together with the requirements.",
    "",
    "Judge from the evidence above, not from the number of failures. Prefer `implementation` only when you can say concretely what to change.",
    "",
    "## Answer",
    "",
    `**Write the answer to \`${out}\` with the Write tool** (the only file you may write): the first line is exactly \`CAUSE: <one of implementation, environment, plan, spec, architecture>\`, then the diagnosis: the evidence that shows it (file, command, error), and what must change. For \`implementation\` say what to do differently; for \`environment\` the exact fix for the user; for \`plan\`, \`spec\` or \`architecture\` what the user must decide. Reply with only the first line.`,
    ""
  ].join("\n");
  const dir = (0, import_node_path39.join)(p.run, "briefs", id);
  (0, import_node_fs34.mkdirSync)(dir, { recursive: true });
  const path = (0, import_node_path39.join)(dir, `${taskId}.triage.md`);
  (0, import_node_fs34.writeFileSync)(path, text2);
  return { path, text: text2 };
}
function recordTriage(p, id, taskId, text2) {
  const tf = loadTasks(p, id);
  requireExecuting(p, tf.change);
  const i = indexOf(tf, taskId);
  const t = tf.tasks[i];
  if (statusOf3(t) !== "failed" || attemptsOf(t) < maxAttemptsOf(t)) throw new OpError(`task ${taskId} is "${statusOf3(t)}" with ${attemptsOf(t)} of ${maxAttemptsOf(t)} attempts: triage is for a failed task that ran out of attempts`);
  if (t.triage !== void 0) throw new OpError(`task ${taskId} was already triaged: one triage per task`);
  const parsed = parseTriage(text2);
  if (!parsed) throw new OpError(`the triage answer must start with "CAUSE: ${TRIAGE_CAUSES.join("|")}"; spawn the triage Agent once more`);
  const { cause, diagnosis } = parsed;
  const gist = diagnosis.split("\n").find((l) => l.trim()) ?? "";
  setField(tf, i, "triage", { cause, at: now6() });
  if (cause === "implementation") {
    setField(tf, i, "notes", `triage: implementation, one more attempt: ${gist}`.slice(0, 500));
  } else {
    setField(tf, i, "status", "escalated");
    setField(tf, i, "notes", `triage: ${cause}. ${gist} (full diagnosis: .aidw/run/triage-${taskId}.md)`.slice(0, 500));
  }
  saveTasks(tf);
  return { task: taskId, cause, outcome: cause === "implementation" ? "retry" : "escalate", diagnosis };
}

// src/browser.ts
var import_node_child_process7 = require("node:child_process");
var import_node_crypto6 = require("node:crypto");
var import_node_fs35 = require("node:fs");
var import_node_os = require("node:os");
var import_node_path40 = require("node:path");
var browserFile = (p) => (0, import_node_path40.join)(p.run, "browser.json");
function readBrowser(p) {
  try {
    const r = JSON.parse((0, import_node_fs35.readFileSync)(browserFile(p), "utf8"));
    return typeof r.port === "number" && typeof r.url === "string" && typeof r.pid === "number" ? r : null;
  } catch {
    return null;
  }
}
var usesOwnBrowser = (env, p) => !!env.E2E_CDP_URL && env.E2E_CDP_URL !== readBrowser(p)?.url;
function browserEnv(p) {
  const r = readBrowser(p);
  return r ? { E2E_CDP_URL: r.url, E2E_CDP_PORT: String(r.port) } : {};
}
var profileDir = (p, home = (0, import_node_os.homedir)()) => (0, import_node_path40.join)(home, ".aidw-chrome", (0, import_node_crypto6.createHash)("sha1").update(p.project).digest("hex").slice(0, 10));
function usableProfile(p, home, tmp) {
  for (const dir of [profileDir(p, home), (0, import_node_path40.join)(tmp, "aidw-chrome", (0, import_node_crypto6.createHash)("sha1").update(p.project).digest("hex").slice(0, 10))]) {
    try {
      (0, import_node_fs35.mkdirSync)(dir, { recursive: true });
      return dir;
    } catch {
    }
  }
  throw new BrowserError("cannot create a browser profile under the home directory or the temp directory");
}
var CHROME_CANDIDATES = [
  "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
  "/Applications/Chromium.app/Contents/MacOS/Chromium",
  "/usr/bin/google-chrome",
  "/usr/bin/google-chrome-stable",
  "/usr/bin/chromium",
  "/usr/bin/chromium-browser"
];
var realBrowserDeps = {
  probe: (url) => {
    const r = (0, import_node_child_process7.spawnSync)("curl", ["-sS", "-m", "3", `${url}/json/version`], { encoding: "utf8", timeout: 6e3 });
    if (r.status !== 0) return null;
    try {
      const b = JSON.parse(r.stdout).Browser;
      return typeof b === "string" ? b : null;
    } catch {
      return null;
    }
  },
  launch: (bin, args, log) => {
    const fd = (0, import_node_fs35.openSync)(log, "w");
    try {
      const child = (0, import_node_child_process7.spawn)(bin, args, { detached: true, stdio: ["ignore", fd, fd] });
      let failed = false;
      child.on("error", () => {
        failed = true;
      });
      child.unref();
      return failed ? null : child.pid ?? null;
    } finally {
      (0, import_node_fs35.closeSync)(fd);
    }
  },
  alive: (pid) => {
    try {
      process.kill(pid, 0);
      return true;
    } catch (e) {
      return e.code === "EPERM";
    }
  },
  kill: (pid) => {
    try {
      process.kill(pid, "SIGTERM");
      return true;
    } catch (e) {
      return e.code !== "EPERM";
    }
  },
  sleep: (ms) => void Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms),
  chrome: (env) => env.AIDW_CHROME ? env.AIDW_CHROME : CHROME_CANDIDATES.find((c) => (0, import_node_fs35.existsSync)(c)) ?? null,
  home: (0, import_node_os.homedir)()
};
var BrowserError = class extends Error {
};
function browserStatus(p, deps = realBrowserDeps) {
  const record = readBrowser(p);
  if (!record) return { running: false, record: null };
  const browser = deps.probe(record.url);
  if (browser) return { running: true, record, browser };
  return { running: false, record, stale: deps.alive(record.pid) ? `pid ${record.pid} is alive but ${record.url} does not answer` : `pid ${record.pid} has exited` };
}
function activePort(profile) {
  try {
    const first = (0, import_node_fs35.readFileSync)((0, import_node_path40.join)(profile, "DevToolsActivePort"), "utf8").split("\n")[0] ?? "";
    const n = Number(first.trim());
    return Number.isInteger(n) && n > 0 ? n : null;
  } catch {
    return null;
  }
}
function startBrowser(p, opts = {}, deps = realBrowserDeps) {
  const current = browserStatus(p, deps);
  if (current.running) return { ...current, started: false };
  const bin = deps.chrome(opts.env ?? process.env);
  if (!bin) throw new BrowserError("no Chrome found: install Google Chrome or Chromium, or set AIDW_CHROME to its binary");
  const profile = usableProfile(p, deps.home, deps.tmp ?? (0, import_node_os.tmpdir)());
  try {
    (0, import_node_fs35.rmSync)((0, import_node_path40.join)(profile, "DevToolsActivePort"), { force: true });
  } catch {
  }
  if (current.record && deps.alive(current.record.pid)) {
    if (!deps.kill(current.record.pid)) throw new BrowserError(`pid ${current.record.pid} is still running but does not answer, and this session may not stop it: run \`aidw browser stop\` in your own terminal`);
  }
  const headless = !opts.headed;
  const args = [
    "--remote-debugging-port=0",
    "--remote-debugging-address=127.0.0.1",
    `--user-data-dir=${profile}`,
    "--no-first-run",
    "--no-default-browser-check",
    ...headless ? ["--headless=new"] : [],
    "about:blank"
  ];
  const log = (0, import_node_path40.join)(profile, "chrome.log");
  const pid = deps.launch(bin, args, log);
  if (pid === null) throw new BrowserError(`could not start ${bin}: the sandbox may block launching a browser; run \`aidw browser start\` in your own terminal`);
  const deadline = (opts.timeoutMs ?? 2e4) / 250;
  for (let i = 0; i < deadline; i++) {
    const port = activePort(profile);
    if (port) {
      const url = `http://127.0.0.1:${port}`;
      const browser = deps.probe(url);
      if (browser) {
        const record = { port, url, pid, profile, headless, started_at: (/* @__PURE__ */ new Date()).toISOString() };
        (0, import_node_fs35.mkdirSync)(p.run, { recursive: true });
        (0, import_node_fs35.writeFileSync)(browserFile(p), `${JSON.stringify(record, null, 2)}
`);
        return { running: true, record, browser, started: true };
      }
    }
    if (!deps.alive(pid)) break;
    deps.sleep(250);
  }
  if (deps.alive(pid)) deps.kill(pid);
  throw new BrowserError(`Chrome did not open a debugging port.${whyChromeFailed(log)} Run \`aidw browser start\` in your own terminal (profile ${profile}, log ${log}).`);
}
function whyChromeFailed(log) {
  let text2 = "";
  try {
    text2 = (0, import_node_fs35.readFileSync)(log, "utf8");
  } catch {
    return "";
  }
  if (/Permission denied|Operation not permitted|bootstrap_check_in/.test(text2)) return " The sandbox of this session does not let Chrome start (macOS denies it registering its processes).";
  if (/ProcessSingleton|profile directory/.test(text2)) return " Another Chrome is using this profile: close it.";
  const last = text2.split("\n").map((l) => l.trim()).filter(Boolean).pop();
  return last ? ` Chrome said: ${last.slice(0, 160)}` : "";
}
function stopBrowser(p, deps = realBrowserDeps) {
  const record = readBrowser(p);
  if (!record) return "none";
  if (deps.alive(record.pid) && !deps.kill(record.pid)) return "denied";
  (0, import_node_fs35.rmSync)(browserFile(p), { force: true });
  try {
    (0, import_node_fs35.rmSync)((0, import_node_path40.join)(record.profile, "DevToolsActivePort"), { force: true });
  } catch {
  }
  return "stopped";
}

// src/mock.ts
var import_node_child_process8 = require("node:child_process");
var import_node_fs36 = require("node:fs");
var import_node_http = require("node:http");
var import_node_os2 = require("node:os");
var import_node_path41 = require("node:path");
var realFontDeps = {
  get: (url) => {
    const r = (0, import_node_child_process8.spawnSync)("curl", ["-sSfL", "-m", "30", url], { maxBuffer: 64 * 1024 * 1024, timeout: 4e4 });
    return r.status === 0 && r.stdout ? Buffer.from(r.stdout) : null;
  },
  home: (0, import_node_os2.homedir)()
};
var FONT_SUBSETS = ["latin", "latin-ext", "vietnamese"];
var fontId = (family) => family.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
function fetchFont(family, opts, deps = realFontDeps) {
  const id = fontId(family);
  if (!id) throw new OpError('font: give a family name, for example "Big Shoulders Display"');
  const raw = deps.get(`https://api.fontsource.org/v1/fonts/${id}`);
  if (!raw) throw new OpError(`font: "${family}" is not on Fontsource (looked for id "${id}"), or the network is unreachable`);
  let meta;
  try {
    meta = JSON.parse(raw.toString("utf8"));
  } catch {
    throw new OpError(`font: Fontsource returned something that is not JSON for "${id}"`);
  }
  if (!/^OFL/i.test(meta.license ?? "")) {
    throw new OpError(`font: ${meta.family} is licensed ${meta.license || "under an unknown licence"}, not OFL; a mock may only use OFL fonts`);
  }
  const weights = opts.weights?.length ? opts.weights : meta.weights.filter((w) => w === 400 || w === 700);
  const missing = weights.filter((w) => !meta.weights.includes(w));
  if (missing.length) throw new OpError(`font: ${meta.family} has no weight ${missing.join(", ")} (it has ${meta.weights.join(", ")})`);
  const styles = ["normal", ...opts.italic && meta.styles.includes("italic") ? ["italic"] : []];
  const subsets = FONT_SUBSETS.filter((s) => meta.subsets.includes(s));
  if (!subsets.length) throw new OpError(`font: ${meta.family} has none of the subsets ${FONT_SUBSETS.join(", ")}`);
  const dir = (0, import_node_path41.join)(opts.to, meta.id);
  (0, import_node_fs36.mkdirSync)(dir, { recursive: true });
  const cache2 = usableCache(deps.home, `${meta.id}@${meta.npmVersion}`);
  const files = [];
  const rules = [];
  let cached = 0;
  for (const w of weights) {
    for (const style of styles) {
      for (const subset of subsets) {
        const url = meta.variants[String(w)]?.[style]?.[subset]?.url.woff2;
        if (!url) continue;
        const name = `${subset}-${w}-${style}.woff2`;
        const target = (0, import_node_path41.join)(dir, name);
        const hit = cache2 && (0, import_node_fs36.existsSync)((0, import_node_path41.join)(cache2, name));
        if (hit) {
          (0, import_node_fs36.copyFileSync)((0, import_node_path41.join)(cache2, name), target);
          cached++;
        } else {
          const body = deps.get(url);
          if (!body) throw new OpError(`font: could not download ${url}`);
          (0, import_node_fs36.writeFileSync)(target, body);
          if (cache2) {
            try {
              (0, import_node_fs36.writeFileSync)((0, import_node_path41.join)(cache2, name), body);
            } catch {
            }
          }
        }
        files.push((0, import_node_path41.join)(meta.id, name));
        const range = meta.unicodeRange?.[subset];
        rules.push(
          `@font-face {
  font-family: "${meta.family}";
  font-style: ${style};
  font-weight: ${w};
  font-display: swap;
  src: url("./${meta.id}/${name}") format("woff2");${range ? `
  unicode-range: ${range};` : ""}
}`
        );
      }
    }
  }
  if (!files.length) throw new OpError(`font: Fontsource lists no woff2 file for ${meta.family} at weight ${weights.join(", ")}`);
  const css = `/* ${meta.family} ${meta.version}, ${meta.license}, from Fontsource (${meta.source ?? "source not stated"}) */
${rules.join("\n")}
`;
  (0, import_node_fs36.writeFileSync)((0, import_node_path41.join)(opts.to, `${meta.id}.css`), css);
  (0, import_node_fs36.writeFileSync)(
    (0, import_node_path41.join)(dir, "SOURCE.md"),
    `# ${meta.family}

- Licence: ${meta.license} (SIL Open Font License). Redistribution with the mock is allowed; the font may not be sold on its own.
- Version: ${meta.version} (Fontsource package ${meta.npmVersion})
- Upstream: ${meta.source ?? "not stated"}
- Metadata: https://api.fontsource.org/v1/fonts/${meta.id}
- Files: ${files.map((f) => f.slice(meta.id.length + 1)).join(", ")}
`
  );
  return { family: meta.family, id: meta.id, license: meta.license, version: meta.version, weights, styles, subsets, files, css: `${meta.id}.css`, cached };
}
