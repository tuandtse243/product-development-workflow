  let n = 0;
  let names;
  try {
    names = (0, import_node_fs12.readdirSync)(dir);
  } catch {
    return 0;
  }
  for (const name of names) {
    if (budget.left-- <= 0) break;
    if (SKIP2.has(name) || name.startsWith(".")) continue;
    const full = (0, import_node_path14.join)(dir, name);
    let st;
    try {
      st = (0, import_node_fs12.statSync)(full);
    } catch {
      continue;
    }
    if (st.isDirectory()) n += countCode(full, budget);
