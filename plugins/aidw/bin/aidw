var START = String.raw`(?:^|[;&|(\n\x60{]\s*|\b(?:then|do|else)\s+)(?:(?:sudo|xargs|exec|env|time|command|builtin|nohup|nice)(?:\s+-\S+(?:\s+\d+)?)*\s+|timeout(?:\s+-\S+)*\s+\S+\s+|[A-Za-z_]\w*=\S*\s+)*`;
function maskQuoted(command) {
  const c = command.replace(/(["'])([\w./+@=-]+)\1/g, "$2");
  let out = "";
  for (let i = 0; i < c.length; i++) {
    const ch = c[i];
    if (ch === "\\" && i + 1 < c.length) {
      out += ch + c[++i];
      continue;
    }
    if (ch !== "'" && ch !== '"') {
      out += ch;
      continue;
    }
    const end = ch === "'" ? c.indexOf("'", i + 1) : closingDoubleQuote(c, i + 1);
    const stop = end < 0 ? c.length : end;
    const body = c.slice(i + 1, stop);
    const target = /(?:^|[^<>])>{1,2}\s*$/.test(out);
    out += ch + (target ? body : ch === '"' ? maskDouble(body) : body.replace(/[^]/g, "_")) + (end < 0 ? "" : ch);
    i = stop;
  }
  return out;
}
function closingDoubleQuote(c, from) {
  for (let i = from; i < c.length; i++) {
    if (c[i] === "\\") i++;
    else if (c[i] === '"') return i;
  }
  return -1;
}
function maskDouble(body) {
  let out = "";
  for (let i = 0; i < body.length; i++) {
    if (body.startsWith("$(", i)) {
      let depth = 0;
      let j = i;
      for (; j < body.length; j++) {
        if (body[j] === "(") depth++;
        else if (body[j] === ")" && --depth === 0) break;
      }
      out += body.slice(i, j + 1);
      i = j;
    } else if (body[i] === "`") {
      const j = body.indexOf("`", i + 1);
      const k = j < 0 ? body.length - 1 : j;
      out += body.slice(i, k + 1);
      i = k;
    } else out += "_";
  }
  return out;
}
var INLINE_CODE = [
  ...INTERPRETERS.map((i) => ({
