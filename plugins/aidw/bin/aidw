var COMMIT_TYPES = ["feat", "fix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore", "revert"];
var HEADER_MAX = 72;
var DEFAULT_SCOPE = "config";
var ORIGIN_TYPE = { converge: "test", quality: "fix", integration: "fix" };
var isType = (v) => typeof v === "string" && COMMIT_TYPES.includes(v);
function typeProblem(t) {
  if (t.type === void 0 && ORIGIN_TYPE[String(t.origin)]) return null;
  if (!isType(t.type)) return `needs "type": one of ${COMMIT_TYPES.join(", ")} (Conventional Commits)`;
  if (t.breaking !== void 0 && typeof t.breaking !== "boolean") return '"breaking" must be true or false';
  return null;
}
function scopeOf(t) {
  if (t.origin === "quality" && KEBAB_SEGMENT.test(String(t.layer ?? ""))) return String(t.layer);
  if (typeof t.scope === "string" && KEBAB_SEGMENT.test(t.scope)) return t.scope;
  const spec = Array.isArray(t.specs) ? String(t.specs[0] ?? "") : "";
  const cap = spec.split("/").slice(0, -1).join("-").toLowerCase();
  return KEBAB_SEGMENT.test(cap) ? cap : DEFAULT_SCOPE;
}
var DANGLING = /* @__PURE__ */ new Set(["a", "an", "the", "and", "or", "but", "for", "to", "of", "in", "on", "at", "by", "with", "from", "into", "as", "than", "that", "so", "its", "their", "is", "are"]);
function subjectOf(title, max) {
  let s = title.replace(/\s+/g, " ").trim().replace(/[.\s]+$/, "");
  const first = /^\S+/.exec(s)?.[0] ?? "";
  if (first && !/[A-Z].*[A-Z]/.test(first) && !/\d/.test(first)) s = first.toLowerCase() + s.slice(first.length);
  if (s.length > max) {
    const cut = s.slice(0, max);
    const at = cut.lastIndexOf(" ");
    s = (at > max / 2 ? cut.slice(0, at) : cut).replace(/[.,;:\s-]+$/, "");
    for (let words = s.split(" "); words.length > 2 && DANGLING.has(words[words.length - 1].toLowerCase()); words = s.split(" ")) {
      s = words.slice(0, -1).join(" ").replace(/[.,;:\s-]+$/, "");
    }
  }
  return s || "update";
}
function header(type, scope, subject, breaking = false) {
  const head = `${type}(${scope})${breaking ? "!" : ""}: `;
  return head + subjectOf(subject, HEADER_MAX - head.length);
}
var firstLine = (s) => (s.split("\n").find((l) => l.trim()) ?? "").replace(/\s+/g, " ").trim().slice(0, 200);
function taskCommitMessage(t, changeId, evidence) {
  const type = isType(t.type) ? t.type : ORIGIN_TYPE[String(t.origin)] ?? "chore";
  const quality = t.origin === "quality" && KEBAB_SEGMENT.test(String(t.layer ?? ""));
  const subject = quality ? `resolve the ${String(t.layer)} layer findings` : String(t.title ?? "");
  const h = header(type, scopeOf(t), subject, t.breaking === true);
  const why = quality ? firstLine(String(t.problem ?? "")) : "";
  return `${h}

${why ? `${why}

` : ""}Change: ${changeId}
Task: ${t.id}
Evidence: ${evidence}`;
}
function aidwCommitMessage(subject, footer) {
  return `${header("chore", "aidw", subject)}

${footer}`;
}
