    stack[role] = version && /^\d/.test(version) ? `${name} ${version}` : name;
  }
  const py = detectPython(dir);
  for (const { dep, role, name } of PY_DEPS) {
    const hit = py ? Object.keys(py.deps).find((d) => dep.test(d)) : void 0;
    if (!hit || stack[role]) continue;
    const v = py?.deps[hit] ?? "";
    stack[role] = v && role !== "database" ? `${name} ${v}` : name;
  }
  if (py?.configured.ruff && !stack.linter) stack.linter = "Ruff";
  if (py?.configured.pytest && !stack["unit tests"]) stack["unit tests"] = "pytest";
  if (py?.configured.mypy && !stack.types) stack.types = "mypy";
  for (const { file, role, name } of FILES) if (!stack[role] && (0, import_node_fs24.existsSync)((0, import_node_path29.join)(dir, file))) stack[role] = name;
  const languages = /* @__PURE__ */ new Set();
  if (pkg) languages.add(depNames.includes("typescript") || (0, import_node_fs24.existsSync)((0, import_node_path29.join)(dir, "tsconfig.json")) ? "TypeScript" : "JavaScript");
  for (const { file, lang } of LANG_FILES) if ((0, import_node_fs24.existsSync)((0, import_node_path29.join)(dir, file))) languages.add(lang);
  const pm = packageManager(dir, pkg);
