    if (REMOTE_NAME.test(remote) && BRANCH_NAME.test(base2)) push = { remote, base: base2 };
  }
  if (raw.envelope !== void 0 && typeof raw.envelope !== "boolean") d.error(file, '"grants.envelope" must be true or false');
  const runs = raw.agent_runs;
  if (runs !== void 0 && runs !== null && !(Number.isInteger(runs) && Number(runs) >= 1)) d.error(file, '"grants.agent_runs" must be a positive integer (leave it out for 3 per planned task)');
  return { push, envelope: raw.envelope === true, agentRuns: Number.isInteger(runs) && Number(runs) >= 1 ? Number(runs) : null };
}
