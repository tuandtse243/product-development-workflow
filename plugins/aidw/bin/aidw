    const author = f ? d.authors?.[f] : void 0;
    if (author && agent === author && f && (0, import_node_path19.join)(p.project, f) === file) return allow(`Deviation ${d.id}: ${author} changes what it wrote`);
    return deny(`Deviation ${d.id} of ${id} lets only ${author ?? "its author Role"} edit ${rel(p, file)}: no other Agent and not the Orchestrator edits it while it is open`);
  }
