var idPattern = (id) => new RegExp(`(^|[^a-z0-9/-])${id.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}(?![a-z0-9/-])`);
function fromJunit(id, tests) {
  const re = idPattern(id);
  const hits = tests.filter((t) => re.test(t.name));
  if (!hits.length) return { status: "missing", where: [] };
  const status = hits.some((t) => t.status === "fail") ? "fail" : hits.some((t) => t.status === "pass") ? "pass" : "skipped";
  return { status, where: hits.map((t) => `${t.name} (${t.status})`) };
}
function fromPresence(id, files) {
  const re = idPattern(id);
  const where = [];
  let live = false;
  for (const { file, lines } of files) {
    lines.forEach((line, n) => {
      if (!re.test(line)) return;
      const skipped = SKIPPED_LINE.test(line);
      if (!skipped) live = true;
      where.push(`${file}:${n + 1}${skipped ? " (skipped)" : ""}`);
    });
  }
  return { status: live ? "pass" : where.length ? "skipped" : "missing", where };
}
function scenarioResults(p, id) {
  const change = loadChange(p, id);
  const config = loadQuality(p, change);
  const { summary } = pendingLayers(p, id);
  const tasks = loadTasks(p, id).tasks;
  const head = headCommit(p.project);
  const ids = [...idsAfterChange(p, id).changed.scenarios].sort();
  const withReports = config.layers.filter((l) => l.reports.length);
  const scenarios = {};
  if (withReports.length) {
    const tests = withReports.flatMap((l) => isFresh(summary.layers[l.name], tasks, head) ? summary.layers[l.name]?.tests ?? [] : []);
    for (const s of ids) scenarios[s] = fromJunit(s, tests);
    return { mode: "junit", scenarios };
  }
  const files = testFiles(p.project).map((f) => ({ file: f, lines: (0, import_node_fs17.readFileSync)((0, import_node_path22.join)(p.project, f), "utf8").split(/\r?\n/) }));
  for (const s of ids) scenarios[s] = fromPresence(s, files);
  return { mode: "presence", scenarios };
}
function converge(p, id) {
  const change = loadChange(p, id);
  if (stateOf(change) !== "converging") throw new OpError(`change "${id}" is "${String(change.data.state)}"; aidw converge runs in state converging`);
  if (approvalStatus(p, change).status !== "valid") throw new OpError(`approval drift in "${id}": escalate and re-approve`);
  const { pending } = pendingLayers(p, id);
  if (pending.length) throw new OpError(`quality layers not passing on the current code: ${pending.join(", ")}; run \`aidw verify\` first`);
  const { mode, scenarios } = scenarioResults(p, id);
  const gaps = Object.entries(scenarios).filter(([, r]) => r.status !== "pass").map(([s]) => s);
  const tf = loadTasks(p, id);
  const config = loadQuality(p, change);
  const record = { at: now2(), head: headCommit(p.project), mode, ok: gaps.length === 0, scenarios, added: [], escalated: [] };
  const coveredBefore = (s) => tf.tasks.some((t) => t.origin === "converge" && Array.isArray(t.scenarios) && t.scenarios.includes(s));
  record.escalated = gaps.filter(coveredBefore);
  const fresh = gaps.filter((s) => !coveredBefore(s));
  if (record.escalated.length) {
    writeRecord(change, record);
    transition(p, id, "escalated", { reason: `converge: still no passing test after a converge task for ${record.escalated.join(", ")}` });
    return { ...record, summary: `escalated: ${record.escalated.length} scenario(s) still without a passing test after a converge task` };
  }
  if (fresh.length) {
    const testLayers = config.layers.filter((l) => l.name !== "code");
    const verify2 = (testLayers.length ? testLayers : config.layers).flatMap((l) => [...l.setup, ...l.run]);
    let n = tf.tasks.filter((t) => t.origin === "converge").length;
    const seq = tf.doc.get("tasks");
    const byCapability = /* @__PURE__ */ new Map();
    for (const s of fresh) {
      const cap = s.split("/").slice(0, -1).join("/");
      byCapability.set(cap, [...byCapability.get(cap) ?? [], s]);
    }
    for (const [cap, ids] of byCapability) {
      n += 1;
      const taskId = `C${String(n).padStart(2, "0")}`;
      const problems = ids.map((s) => {
        const r = scenarios[s];
        return r.status === "missing" ? `- ${s}: no test found (${mode} evidence). Write a test named with the id that asserts its THEN outcome, and make it pass.` : `- ${s}: its test is ${r.status === "fail" ? "failing" : "skipped"}: ${r.where.join("; ")}. Make it a real, passing test.`;
      });
      seq.add(
        tf.doc.createNode({
          id: taskId,
          title: ids.length === 1 ? `Cover scenario ${ids[0]}` : `Cover ${ids.length} scenarios of ${cap}`,
          role: defaultTaskRole(),
          origin: "converge",
          specs: [cap],
          scenarios: ids,
          depends_on: [],
          touches: ["**"],
          verify: verify2,
          problem: `Converge found scenario(s) of ${cap} without a passing test:
${problems.join("\n")}`,
          status: "pending"
        })
      );
      record.added.push(taskId);
    }
    saveTasksDoc(tf);
    writeRecord(change, record);
    transition(p, id, "executing", {});
    return { ...record, summary: `${fresh.length} scenario gap(s): converge task(s) ${record.added.join(", ")} added; change is executing again` };
  }
  writeRecord(change, record);
  return { ...record, summary: `all ${Object.keys(scenarios).length} scenario(s) have a passing test (${mode} evidence)` };
}
function writeRecord(change, record) {
  const f = convergeFile(change);
  (0, import_node_fs17.mkdirSync)((0, import_node_path22.join)(change.dir, "evidence"), { recursive: true });
  let runs = [];
  if ((0, import_node_fs17.existsSync)(f)) {
    try {
      runs = JSON.parse((0, import_node_fs17.readFileSync)(f, "utf8")).runs ?? [];
    } catch {
      runs = [];
    }
  }
  (0, import_node_fs17.writeFileSync)(f, `${JSON.stringify({ runs: [...runs, record] }, null, 2)}
`);
}
function lastConverge(change) {
  const f = convergeFile(change);
  if (!(0, import_node_fs17.existsSync)(f)) return null;
  try {
    return (JSON.parse((0, import_node_fs17.readFileSync)(f, "utf8")).runs ?? []).at(-1) ?? null;
  } catch {
    return null;
  }
}
function convergePassed(p, id) {
  const change = loadChange(p, id);
  const last = lastConverge(change);
  if (!last) return { ok: false, reason: "run `aidw converge` first" };
  if (!last.ok) return { ok: false, reason: "the last converge found gaps" };
  const tasks = loadTasks(p, id).tasks;
  const fresh = isFresh({ status: "pass", at: last.at, head: last.head, runs: [] }, tasks, headCommit(p.project));
  return fresh ? { ok: true } : { ok: false, reason: "code changed after the last converge; run `aidw converge` again" };
}

// src/design.ts
var import_node_fs18 = require("node:fs");
var import_node_path23 = require("node:path");
var import_yaml12 = __toESM(require_dist(), 1);
var TOKEN_KINDS = ["color", "font", "size", "space", "radius", "shadow", "motion", "other"];
var tokensFile = (p) => (0, import_node_path23.join)(p.design, "tokens.yaml");
function parseTokens(text2, file, d) {
  let data;
  try {
    data = import_yaml12.default.parse(text2);
  } catch (e) {
    d.error(file, `invalid YAML: ${e.message}`);
    return [];
  }
  const list8 = data?.tokens;
  if (!Array.isArray(list8) || list8.length === 0) {
    d.error(file, "must contain a non-empty `tokens:` list");
    return [];
  }
  const out = [];
  const seen = /* @__PURE__ */ new Set();
  list8.forEach((raw, i) => {
    const t = raw ?? {};
    const where = `tokens[${i}]`;
    const name = typeof t.name === "string" ? t.name.trim() : "";
    if (!/^[a-z][a-z0-9-]*$/.test(name)) return d.error(file, `${where}: name must be kebab-case`);
    if (seen.has(name)) return d.error(file, `${where}: duplicate token "${name}"`);
    seen.add(name);
    const kind = String(t.kind ?? "");
    if (!TOKEN_KINDS.includes(kind)) return d.error(file, `${where} (${name}): kind must be one of ${TOKEN_KINDS.join(", ")}`);
    const value = t.value === void 0 || t.value === null ? "" : String(t.value).trim();
    if (!value) return d.error(file, `${where} (${name}): value is required`);
    const use = typeof t.use === "string" ? t.use.trim() : "";
    if (use.length < 8) return d.error(file, `${where} (${name}): \`use\` must say where the token is used (the reviewer checks it)`);
    const token = { name, kind, value, use };
    if (t.dark !== void 0 && t.dark !== null && String(t.dark).trim()) token.dark = String(t.dark).trim();
    if (typeof t.why === "string" && t.why.trim()) token.why = t.why.trim();
    if (kind === "color") {
      for (const v of [token.value, token.dark].filter((x) => !!x)) {
        if (!normalizeColor(v)) d.error(file, `${where} (${name}): "${v}" is not a color literal (hex, rgb(), hsl() or oklch())`);
      }
    }
    out.push(token);
  });
  if (out.length === 0) d.error(file, "needs at least one token");
  else if (!out.some((t) => t.kind === "color")) d.warn(file, "no color token: reviewers cannot check color use (fine when the change reuses the existing design; do not invent a color to have one)");
  return out;
}
function loadTokens(p) {
  const d = new Diags();
  const f = tokensFile(p);
  if (!(0, import_node_fs18.existsSync)(f)) return { tokens: [], diags: d, exists: false };
  return { tokens: parseTokens((0, import_node_fs18.readFileSync)(f, "utf8"), rel(p, f), d), diags: d, exists: true };
}
var HEX = /#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})\b/g;
var FUNC = /\b(?:rgba?|hsla?|oklch|oklab|lab|lch)\([^()]*\)/gi;
function normalizeColor(v) {
  const s = v.trim().toLowerCase();
  let m = /^#([0-9a-f]{3,4})$/.exec(s);
  if (m) return `#${[...m[1]].map((c) => c + c).join("")}`.replace(/^(#[0-9a-f]{6})ff$/, "$1");
  m = /^#([0-9a-f]{6}|[0-9a-f]{8})$/.exec(s);
  if (m) return `#${m[1]}`.replace(/^(#[0-9a-f]{6})ff$/, "$1");
  m = /^rgba?\(\s*(\d{1,3})[\s,]+(\d{1,3})[\s,]+(\d{1,3})(?:\s*[,/]\s*([\d.]+%?))?\s*\)$/.exec(s);
  if (m) {
    const hex = [m[1], m[2], m[3]].map((n) => Math.min(255, Number(n)).toString(16).padStart(2, "0")).join("");
    const a = m[4];
    if (a === void 0 || a === "1" || a === "100%") return `#${hex}`;
    const alpha = a.endsWith("%") ? Number(a.slice(0, -1)) / 100 : Number(a);
    return `#${hex}${Math.round(alpha * 255).toString(16).padStart(2, "0")}`;
  }
  if (/^(?:hsla?|oklch|oklab|lab|lch)\([^()]*\)$/.test(s)) return s.replace(/\s+/g, " ").replace(/\(\s+/, "(").replace(/\s+\)/, ")");
  return null;
}
function colorLiterals(text2) {
  const out = [];
  for (const m of text2.matchAll(HEX)) {
    const n = normalizeColor(m[0]);
    if (n) out.push(n);
  }
  for (const m of text2.matchAll(FUNC)) {
    const n = normalizeColor(m[0]);
    if (n) out.push(n);
  }
  return out;
}
var STYLE_FILE = /\.(css|scss|sass|less|pcss|tsx|jsx|ts|js|mjs|cjs|vue|svelte|astro|html)$/;
var SKIP = /* @__PURE__ */ new Set(["node_modules", ".git", ".aidw", ".next", ".nuxt", ".svelte-kit", "dist", "build", "out", "coverage", "test-results", "playwright-report", ".turbo", ".vercel"]);
var TEST = /(^|\/)(__tests__|tests?|e2e)\/|\.(test|spec)\.[a-z]+$/;
var MAX_FILE2 = 512 * 1024;
function styleFiles(project) {
  const out = [];
  const walk = (dir, prefix) => {
    let entries;
    try {
      entries = (0, import_node_fs18.readdirSync)(dir, { withFileTypes: true });
    } catch {
      return;
    }
    for (const e of entries) {
      if (e.isDirectory()) {
        if (!SKIP.has(e.name) && !e.name.startsWith(".")) walk((0, import_node_path23.join)(dir, e.name), `${prefix}${e.name}/`);
      } else if (e.isFile() && STYLE_FILE.test(e.name)) {
        const r = `${prefix}${e.name}`;
        if (!TEST.test(r)) out.push(r);
      }
    }
  };
  walk(project, "");
  return out.sort();
}
function read2(project, f) {
  try {
    const full = (0, import_node_path23.join)(project, f);
    return (0, import_node_fs18.statSync)(full).size > MAX_FILE2 ? "" : (0, import_node_fs18.readFileSync)(full, "utf8");
  } catch {
    return "";
  }
}
function missingTokens(project, tokens, files = styleFiles(project)) {
  const colors = /* @__PURE__ */ new Set();
  let text2 = "";
  for (const f of files) {
    const t = read2(project, f);
    text2 += `
${t.toLowerCase()}`;
    for (const c of colorLiterals(t)) colors.add(c);
  }
  const missing = [];
  for (const t of tokens) {
    if (t.kind === "color") {
      for (const v of [t.value, t.dark].filter((x) => !!x)) {
        if (!colors.has(normalizeColor(v) ?? v)) missing.push(`${t.name}${v === t.dark ? " (dark)" : ""} ${v}`);
      }
    } else if (t.kind === "font") {
      const family = t.value.split(",")[0]?.replace(/["']/g, "").trim().toLowerCase() ?? "";
      if (family && !text2.includes(family)) missing.push(`${t.name} ${t.value}`);
    }
  }
  return missing;
}
function hardcodedColors(project, files, tokens) {
  const allowed = /* @__PURE__ */ new Set(["#000000", "#ffffff", "#00000000"]);
  for (const t of tokens) {
    if (t.kind !== "color") continue;
    for (const v of [t.value, t.dark]) if (v) allowed.add(normalizeColor(v) ?? v);
  }
  const out = [];
  for (const f of files) {
    if (!STYLE_FILE.test(f) || TEST.test(f)) continue;
    const found = [...new Set(colorLiterals(read2(project, f)))].filter((c) => !allowed.has(c));
    for (const c of found) out.push(`${f}: ${c}`);
    if (out.length >= 30) break;
  }
  return out;
}
var IMAGE = /\.(png|jpe?g|webp)$/i;
var shotsDir = (p, id, taskId) => (0, import_node_path23.join)(p.run, "shots", id, taskId);
function taskShots(p, id, taskId, since) {
  const dir = shotsDir(p, id, taskId);
  if (!(0, import_node_fs18.existsSync)(dir)) return [];
  const after = since ? Date.parse(since) : 0;
  const out = [];
  const walk = (d) => {
    for (const e of (0, import_node_fs18.readdirSync)(d, { withFileTypes: true })) {
      const full = (0, import_node_path23.join)(d, e.name);
      if (e.isDirectory()) walk(full);
      else if (IMAGE.test(e.name) && (0, import_node_fs18.statSync)(full).mtimeMs >= after - 1e3) out.push(rel(p, full));
    }
  };
  walk(dir);
  return out.sort();
}
function tokensTable(tokens) {
  const esc2 = (s) => s.replace(/\|/g, "\\|").replace(/\n/g, " ");
  return [
    "| Token | Kind | Value | Dark | Use |",
    "|---|---|---|---|---|",
    ...tokens.map((t) => `| \`${t.name}\` | ${t.kind} | \`${esc2(t.value)}\` | ${t.dark ? `\`${esc2(t.dark)}\`` : ""} | ${esc2(t.use)}${t.why ? ` (why: ${esc2(t.why)})` : ""} |`)
  ];
}

