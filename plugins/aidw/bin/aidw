      "For `fix`, follow with numbered blocking issues: file, problem, expected fix. Only blocking issues justify `fix`;",
      "put anything else under `Non-blocking:`. Be concrete: the implementer will get your notes verbatim.",
      `**Write the whole verdict to \`${(0, import_node_path17.join)(p.run, `review-${taskId}.md`)}\` with the Write tool** (the only file you may write), then reply with just its first line, \`VERDICT: pass\` or \`VERDICT: fix\`. The orchestrator reads the file; keeping your reply short saves its context.`,
      "",
      ...shared
    ];
  }
  const text = [...header2, ...body].join("\n").replace(/\n{3,}/g, "\n\n");
  const dir = (0, import_node_path17.join)(p.run, "briefs", id);
  (0, import_node_fs15.mkdirSync)(dir, { recursive: true });
  const path = (0, import_node_path17.join)(dir, `${taskId}.${kind}.md`);
  (0, import_node_fs15.writeFileSync)(path, text);
  return { kind, task: taskId, path, text, skills };
}
var TRIAGE_CAUSES = ["implementation", "environment", "plan", "spec", "architecture"];
var isRecord5 = (v) => !!v && typeof v === "object" && !Array.isArray(v);
var triageFile = (p, taskId) => (0, import_node_path17.join)(p.run, `triage-${taskId}.md`);
function parseTriage(text) {
  const m = /^\s*CAUSE:\s*([a-z]+)\s*\n?([\s\S]*)$/.exec(text);
  if (!m || !TRIAGE_CAUSES.includes(m[1])) return null;
  return { cause: m[1], diagnosis: (m[2] ?? "").trim() };
}
function readTriage(p, taskId) {
  const text = readText(triageFile(p, taskId));
  return text === null ? null : parseTriage(text);
}
function buildTriageBrief(p, id, taskId) {
  const tf = loadTasks(p, id);
  const t = tf.tasks[indexOf(tf, taskId)];
  if (statusOf2(t) !== "failed" || attemptsOf(t) < maxAttemptsOf(t)) throw new OpError(`task ${taskId} is "${statusOf2(t)}" with ${attemptsOf(t)} of ${maxAttemptsOf(t)} attempts: triage is for a failed task that ran out of attempts`);
  if (t.triage !== void 0) throw new OpError(`task ${taskId} was already triaged: one triage per task`);
  const ev = readEvidence(tf.change, t);
  const reqs = requirementsAfterChange(p, id);
  const scenarioIds = list3(t.scenarios);
  const reqIds = [.../* @__PURE__ */ new Set([...list3(t.specs), ...scenarioIds.map((s) => s.split("/").slice(0, -1).join("/"))])];
  const reqBlocks = reqIds.map((r) => reqs.get(r) ? `<!-- ${r} -->
${reqs.get(r).raw.trim()}` : `<!-- ${r}: not found in specs after this change -->`);
  const attempts = ev.checkpoints.map((c, i) => {
    const failed = c.verify.find((v) => v.exit !== 0);
    return [
      `### Checkpoint ${i + 1}: ${c.ok ? "passed" : "failed"}`,
      ...c.missing_scenarios.length ? [`- Missing scenario tests: ${c.missing_scenarios.map((s) => `\`${s}\``).join(", ")}`] : [],
      ...failed ? [`- \`${failed.command}\` failed${failed.timedOut ? " (timed out)" : ` with exit ${failed.exit}`}:`, "", "```", failed.tail, "```"] : []
    ].join("\n");
  });
  const reviews = ev.reviews.map((r, i) => `### Review ${i + 1}: ${r.verdict}
${r.notes.trim()}`);
  const out = triageFile(p, taskId);
  const pointers = [
    pointer(p, p.constitution, "engineering principles"),
    pointer(p, (0, import_node_path17.join)(p.architecture, "overview.md"), "architecture"),
    pointer(p, (0, import_node_path17.join)(p.requirements, `${id}.md`), "requirements"),
    pointer(p, (0, import_node_path17.join)(tf.change.dir, "tasks.yaml"), "the plan (this task and its neighbours)")
  ].filter((x) => x !== null);
  const text = [
    `# Triage brief: ${taskId} - ${String(t.title ?? "")}`,
    "",
    `Change \`${id}\` \xB7 role ${String(t.role ?? "?")} \xB7 ${attemptsOf(t)} of ${maxAttemptsOf(t)} attempts used, all unsuccessful.`,
    "",
    "You are the Software Architect in a fresh context, asked once to say WHY this task keeps failing. You did not write this code. You may read files and run read-only commands; you edit nothing. Write only the file named at the end.",
    "",
    "## Task",
    "",
    `- Scenarios: ${scenarioIds.length ? scenarioIds.map((s) => `\`${s}\``).join(", ") : "(none)"}`,
    `- Touches: ${list3(t.touches).map((g) => `\`${g}\``).join(", ")}`,
    `- Verify: ${list3(t.verify).map((v) => `\`${v}\``).join(", ")}`,
    `- Depends on: ${list3(t.depends_on).join(", ") || "nothing"}`,
    ...t.notes ? [`- Last note: ${String(t.notes)}`] : [],
    "",
    "## Requirements the task was held to (spec text after this change)",
    "",
    ...reqBlocks.length ? ["```markdown", reqBlocks.join("\n\n"), "```"] : ["(none)"],
    "",
    "## What happened",
    "",
    ...attempts.length ? attempts : ["(no checkpoint recorded)"],
    ...reviews.length ? ["", ...reviews] : [],
    "",
    "## Read if you need it",
    "",
    ...pointers,
    `- the task's changes: \`git diff ${typeof t.base === "string" ? t.base : "HEAD"}\``,
    "",
    "## Decide the cause: exactly one",
    "",
    "- `implementation`: the plan, spec and architecture are sound and the code is wrong or incomplete. A fresh attempt with your diagnosis can fix it.",
    "- `environment`: the machine, not the code: a missing binary, package registry, credential, port, browser, permission or network. Say the exact thing the user must fix.",
    "- `plan`: the task cannot succeed as planned (wrong `touches`, missing dependency, scope too big or too small, `verify` that cannot pass).",
    "- `spec`: a scenario contradicts another, cannot be observed or tested, or asks for something the requirement text does not support.",
    "- `architecture`: the approved architecture or a Decision to honor cannot be met together with the requirements.",
    "",
    "Judge from the evidence above, not from the number of failures. Prefer `implementation` only when you can say concretely what to change.",
    "",
    "## Answer",
    "",
    `**Write the answer to \`${out}\` with the Write tool** (the only file you may write): the first line is exactly \`CAUSE: <one of implementation, environment, plan, spec, architecture>\`, then the diagnosis: the evidence that shows it (file, command, error), and what must change. For \`implementation\` say what to do differently; for \`environment\` the exact fix for the user; for \`plan\`, \`spec\` or \`architecture\` what the user must decide. Reply with only the first line.`,
    ""
  ].join("\n");
  const dir = (0, import_node_path17.join)(p.run, "briefs", id);
  (0, import_node_fs15.mkdirSync)(dir, { recursive: true });
  const path = (0, import_node_path17.join)(dir, `${taskId}.triage.md`);
  (0, import_node_fs15.writeFileSync)(path, text);
  return { path, text };
}
function recordTriage(p, id, taskId, text) {
  const tf = loadTasks(p, id);
  requireExecuting(p, tf.change);
  const i = indexOf(tf, taskId);
  const t = tf.tasks[i];
  if (statusOf2(t) !== "failed" || attemptsOf(t) < maxAttemptsOf(t)) throw new OpError(`task ${taskId} is "${statusOf2(t)}" with ${attemptsOf(t)} of ${maxAttemptsOf(t)} attempts: triage is for a failed task that ran out of attempts`);
  if (t.triage !== void 0) throw new OpError(`task ${taskId} was already triaged: one triage per task`);
  const parsed = parseTriage(text);
  if (!parsed) throw new OpError(`the triage answer must start with "CAUSE: ${TRIAGE_CAUSES.join("|")}"; spawn the triage Agent once more`);
  const { cause, diagnosis } = parsed;
  const gist = diagnosis.split("\n").find((l) => l.trim()) ?? "";
  setField(tf, i, "triage", { cause, at: now2() });
  if (cause === "implementation") {
    setField(tf, i, "notes", `triage: implementation, one more attempt: ${gist}`.slice(0, 500));
  } else {
    setField(tf, i, "status", "escalated");
    setField(tf, i, "notes", `triage: ${cause}. ${gist} (full diagnosis: .aidw/run/triage-${taskId}.md)`.slice(0, 500));
  }
  saveTasks(tf);
  return { task: taskId, cause, outcome: cause === "implementation" ? "retry" : "escalate", diagnosis };
}

// src/converge.ts
var convergeFile = (change) => (0, import_node_path18.join)(change.dir, "evidence", "converge.json");
var now3 = () => (/* @__PURE__ */ new Date()).toISOString();
var idPattern = (id) => new RegExp(`(^|[^a-z0-9/-])${id.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}(?![a-z0-9/-])`);
function fromJunit(id, tests) {
  const re = idPattern(id);
  const hits = tests.filter((t) => re.test(t.name));
  if (!hits.length) return { status: "missing", where: [] };
  const status = hits.some((t) => t.status === "fail") ? "fail" : hits.some((t) => t.status === "pass") ? "pass" : "skipped";
  return { status, where: hits.map((t) => `${t.name} (${t.status})`) };
}
function fromPresence(id, files) {
  const re = idPattern(id);
  const where = [];
  let live = false;
  for (const { file, lines } of files) {
    lines.forEach((line, n) => {
      if (!re.test(line)) return;
      const skipped = SKIPPED_LINE.test(line);
      if (!skipped) live = true;
      where.push(`${file}:${n + 1}${skipped ? " (skipped)" : ""}`);
    });
  }
  return { status: live ? "pass" : where.length ? "skipped" : "missing", where };
}
function scenarioResults(p, id) {
  const change = loadChange(p, id);
  const config = loadQuality(p, change);
  const { summary } = pendingLayers(p, id);
  const tasks = loadTasks(p, id).tasks;
  const head = headCommit(p.project);
  const ids = [...idsAfterChange(p, id).changed.scenarios].sort();
  const withReports = config.layers.filter((l) => l.reports.length);
  const scenarios = {};
  if (withReports.length) {
    const tests = withReports.flatMap((l) => isFresh(summary.layers[l.name], tasks, head) ? summary.layers[l.name]?.tests ?? [] : []);
    for (const s of ids) scenarios[s] = fromJunit(s, tests);
    return { mode: "junit", scenarios };
  }
  const files = testFiles(p.project).map((f) => ({ file: f, lines: (0, import_node_fs16.readFileSync)((0, import_node_path18.join)(p.project, f), "utf8").split(/\r?\n/) }));
  for (const s of ids) scenarios[s] = fromPresence(s, files);
  return { mode: "presence", scenarios };
}
function converge(p, id) {
  const change = loadChange(p, id);
  if (stateOf(change) !== "converging") throw new OpError(`change "${id}" is "${String(change.data.state)}"; aidw converge runs in state converging`);
  if (approvalStatus(p, change).status !== "valid") throw new OpError(`approval drift in "${id}": escalate and re-approve`);
  const { pending } = pendingLayers(p, id);
  if (pending.length) throw new OpError(`quality layers not passing on the current code: ${pending.join(", ")}; run \`aidw verify\` first`);
  const { mode, scenarios } = scenarioResults(p, id);
  const gaps = Object.entries(scenarios).filter(([, r]) => r.status !== "pass").map(([s]) => s);
  const tf = loadTasks(p, id);
  const config = loadQuality(p, change);
  const record = { at: now3(), head: headCommit(p.project), mode, ok: gaps.length === 0, scenarios, added: [], escalated: [] };
  const coveredBefore = (s) => tf.tasks.some((t) => t.origin === "converge" && Array.isArray(t.scenarios) && t.scenarios.includes(s));
  record.escalated = gaps.filter(coveredBefore);
  const fresh = gaps.filter((s) => !coveredBefore(s));
  if (record.escalated.length) {
    writeRecord(change, record);
    transition(p, id, "escalated", { reason: `converge: still no passing test after a converge task for ${record.escalated.join(", ")}` });
    return { ...record, summary: `escalated: ${record.escalated.length} scenario(s) still without a passing test after a converge task` };
  }
  if (fresh.length) {
    const testLayers = config.layers.filter((l) => l.name !== "code");
    const verify2 = (testLayers.length ? testLayers : config.layers).flatMap((l) => [...l.setup, ...l.run]);
    let n = tf.tasks.filter((t) => t.origin === "converge").length;
    const seq = tf.doc.get("tasks");
    const byCapability = /* @__PURE__ */ new Map();
    for (const s of fresh) {
      const cap = s.split("/").slice(0, -1).join("/");
      byCapability.set(cap, [...byCapability.get(cap) ?? [], s]);
    }
    for (const [cap, ids] of byCapability) {
      n += 1;
      const taskId = `C${String(n).padStart(2, "0")}`;
      const problems = ids.map((s) => {
        const r = scenarios[s];
        return r.status === "missing" ? `- ${s}: no test found (${mode} evidence). Write a test named with the id that asserts its THEN outcome, and make it pass.` : `- ${s}: its test is ${r.status === "fail" ? "failing" : "skipped"}: ${r.where.join("; ")}. Make it a real, passing test.`;
      });
      seq.add(
        tf.doc.createNode({
          id: taskId,
          title: ids.length === 1 ? `Cover scenario ${ids[0]}` : `Cover ${ids.length} scenarios of ${cap}`,
          role: DEFAULT_TASK_ROLE,
          origin: "converge",
          specs: [cap],
          scenarios: ids,
          depends_on: [],
          touches: ["**"],
          verify: verify2,
          problem: `Converge found scenario(s) of ${cap} without a passing test:
${problems.join("\n")}`,
          status: "pending"
        })
      );
      record.added.push(taskId);
    }
    saveTasksDoc(tf);
    writeRecord(change, record);
    transition(p, id, "executing", {});
    return { ...record, summary: `${fresh.length} scenario gap(s): converge task(s) ${record.added.join(", ")} added; change is executing again` };
  }
  writeRecord(change, record);
  return { ...record, summary: `all ${Object.keys(scenarios).length} scenario(s) have a passing test (${mode} evidence)` };
}
function writeRecord(change, record) {
  const f = convergeFile(change);
  (0, import_node_fs16.mkdirSync)((0, import_node_path18.join)(change.dir, "evidence"), { recursive: true });
  let runs = [];
  if ((0, import_node_fs16.existsSync)(f)) {
    try {
      runs = JSON.parse((0, import_node_fs16.readFileSync)(f, "utf8")).runs ?? [];
    } catch {
      runs = [];
    }
  }
  (0, import_node_fs16.writeFileSync)(f, `${JSON.stringify({ runs: [...runs, record] }, null, 2)}
`);
}
function lastConverge(change) {
  const f = convergeFile(change);
  if (!(0, import_node_fs16.existsSync)(f)) return null;
  try {
    return (JSON.parse((0, import_node_fs16.readFileSync)(f, "utf8")).runs ?? []).at(-1) ?? null;
  } catch {
    return null;
  }
}
function convergePassed(p, id) {
  const change = loadChange(p, id);
  const last = lastConverge(change);
  if (!last) return { ok: false, reason: "run `aidw converge` first" };
  if (!last.ok) return { ok: false, reason: "the last converge found gaps" };
  const tasks = loadTasks(p, id).tasks;
  const fresh = isFresh({ status: "pass", at: last.at, head: last.head, runs: [] }, tasks, headCommit(p.project));
  return fresh ? { ok: true } : { ok: false, reason: "code changed after the last converge; run `aidw converge` again" };
}

