var isStrList = (v) => Array.isArray(v) && v.every((x) => typeof x === "string");
function validateTasksText(text, file) {
  const d = new Diags();
  const { tasks, error } = parseTasks(text);
  if (error) {
    d.error(file, error);
    return d;
  }
  if (tasks.length === 0) d.error(file, "tasks list is empty");
  const ids = /* @__PURE__ */ new Set();
  for (const [i, t] of tasks.entries()) {
    const where = typeof t?.id === "string" ? `task ${t.id}` : `task #${i + 1}`;
    if (!t || typeof t !== "object") {
      d.error(file, `${where} is not a mapping`);
      continue;
    }
    if (typeof t.id !== "string" || !t.id) d.error(file, `${where} has no id`);
    else if (ids.has(t.id)) d.error(file, `duplicate task id "${t.id}"`);
    else ids.add(t.id);
    if (typeof t.title !== "string" || !t.title) d.error(file, `${where} has no title`);
    if (typeof t.role !== "string" || !t.role) d.error(file, `${where} has no role`);
    if (!isStrList(t.touches) || t.touches.length === 0) d.error(file, `${where} needs a non-empty "touches" list of file globs`);
    if (!isStrList(t.verify) || t.verify.length === 0) d.error(file, `${where} needs a non-empty "verify" list`);
    if (t.depends_on !== void 0 && !isStrList(t.depends_on)) d.error(file, `${where}: "depends_on" must be a list of task ids`);
    if (t.skills !== void 0 && !isStrList(t.skills)) d.error(file, `${where}: "skills" must be a list of vendored skill names`);
    if (t.max_attempts !== void 0 && !(Number.isInteger(t.max_attempts) && Number(t.max_attempts) >= 1)) {
      d.error(file, `${where}: "max_attempts" must be a positive integer`);
    }
    const tp = typeProblem(t);
    if (tp) d.error(file, `${where} ${tp}`);
    if (t.risk !== void 0 && t.risk !== "normal" && t.risk !== "high") d.error(file, `${where}: "risk" must be normal or high`);
    if (t.status !== void 0 && !TASK_STATUSES.includes(String(t.status))) {
      d.error(file, `${where}: unknown status "${String(t.status)}" (expected ${TASK_STATUSES.join(", ")})`);
    }
  }
  for (const t of tasks) {
    for (const dep of isStrList(t?.depends_on) ? t.depends_on : []) {
      if (!ids.has(dep)) d.error(file, `task ${t.id} depends on unknown task "${dep}"`);
      if (dep === t.id) d.error(file, `task ${t.id} depends on itself`);
    }
  }
  const cycle = findCycle(tasks);
  if (cycle) d.error(file, `dependency cycle: ${cycle.join(" -> ")}`);
  return d;
}
function findCycle(tasks) {
  const deps = /* @__PURE__ */ new Map();
  for (const t of tasks) if (typeof t?.id === "string") deps.set(t.id, isStrList(t.depends_on) ? t.depends_on : []);
  const state = /* @__PURE__ */ new Map();
  const stack = [];
  const visit = (id) => {
    if (state.get(id) === 2) return null;
    if (state.get(id) === 1) return [...stack.slice(stack.indexOf(id)), id];
    state.set(id, 1);
    stack.push(id);
    for (const dep of deps.get(id) ?? []) {
      if (!deps.has(dep)) continue;
      const c = visit(dep);
      if (c) return c;
    }
    stack.pop();
    state.set(id, 2);
    return null;
  };
  for (const id of deps.keys()) {
    const c = visit(id);
    if (c) return c;
  }
  return null;
}
function canonicalTasks(text) {
  const { tasks, error } = parseTasks(text);
  if (error) return text.replace(/\r\n?/g, "\n");
  const planned = tasks.filter((t) => !ADDED_ORIGINS.includes(String(t?.origin))).map((t) => {
    const copy = { ...t };
    for (const f of RUNTIME_FIELDS) delete copy[f];
    return copy;
  });
  return stableStringify(planned);
}
function planSha(t) {
  const copy = { ...t };
  for (const f of RUNTIME_FIELDS) delete copy[f];
  return (0, import_node_crypto.createHash)("sha256").update(stableStringify(copy)).digest("hex").slice(0, 16);
}
function stableStringify(v) {
  if (Array.isArray(v)) return `[${v.map(stableStringify).join(",")}]`;
  if (v && typeof v === "object") {
    const obj = v;
    return `{${Object.keys(obj).sort().map((k) => `${JSON.stringify(k)}:${stableStringify(obj[k])}`).join(",")}}`;
  }
  return JSON.stringify(v) ?? "null";
}

// src/approval.ts
var CHANGE_PACKAGE_FILES = ["intake.md", "analysis.md", "design.md", "quality.yaml", "decisions.yaml", "brief.md"];
var FROZEN_PROJECT_DIRS = (p) => [p.design, p.domain, p.architecture, p.requirements];
function baseSpecFiles(p, change) {
  const out = /* @__PURE__ */ new Set();
  for (const f of walkFiles((0, import_node_path3.join)(change.dir, "specs"))) {
    const cap = capabilityOf((0, import_node_path3.join)(change.dir, "specs"), f);
    if (!cap) continue;
    const main = (0, import_node_path3.join)(p.specs, ...cap.split("/"), "spec.md");
    if ((0, import_node_fs3.existsSync)(main)) out.add(main);
  }
  return [...out];
}
var sha256 = (s) => (0, import_node_crypto2.createHash)("sha256").update(s).digest("hex");
var normalize = (s) => s.replace(/\r\n?/g, "\n");
function computeApprovalHash(p, change) {
  const entries = [];
  const add = (file, content) => {
    if (!(0, import_node_fs3.existsSync)(file)) return;
    const text = content ?? normalize((0, import_node_fs3.readFileSync)(file, "utf8"));
    entries.push({ path: rel(p, file), digest: sha256(text) });
  };
  for (const name of CHANGE_PACKAGE_FILES) add((0, import_node_path3.join)(change.dir, name));
  for (const f of walkFiles((0, import_node_path3.join)(change.dir, "specs"))) add(f);
  for (const f of baseSpecFiles(p, change)) add(f);
  const tasksFile = (0, import_node_path3.join)(change.dir, "tasks.yaml");
  if ((0, import_node_fs3.existsSync)(tasksFile)) add(tasksFile, canonicalTasks((0, import_node_fs3.readFileSync)(tasksFile, "utf8")));
  add(p.constitution);
  for (const dir of FROZEN_PROJECT_DIRS(p)) for (const f of walkFiles(dir)) add(f);
  entries.sort((a, b) => a.path < b.path ? -1 : a.path > b.path ? 1 : 0);
  const manifest = entries.map((e) => `${e.path}
${e.digest}
`).join("");
  return { hash: `sha256:${sha256(manifest)}`, files: entries.map((e) => e.path) };
}
function approvalStatus(p, change) {
  const actual = computeApprovalHash(p, change).hash;
  const approval = change.data.approval;
  const expected = typeof approval?.hash === "string" ? approval.hash : void 0;
  if (!expected) return { status: "none", actual };
  return { status: expected === actual ? "valid" : "drift", expected, actual };
}

