var retryingShellRunner = (command, cwd, timeoutMs, env) => {
  const first = shellRunner(command, cwd, timeoutMs, env);
  if (first.exit === 0 || first.timedOut) return first;
  const second = shellRunner(command, cwd, timeoutMs, env);
  return second.exit === 0 ? { ...second, flaky: true } : first;
};
var ENVIRONMENT_FAILURE = /Operation not permitted|ERR_PNPM_STORE_DIR_OPEN_OPERATION_LOCK|Proxy Authentication Required|proxy CONNECT failed|502 Bad Gateway|Timeout exceeded while scanning|Failed to check for malicious packages|getaddrinfo (EAI_AGAIN|ENOTFOUND)/i;
var UNIT_TEST_COMMAND = /\b(vitest|jest|mocha|pytest|test)\b|go test|cargo test/;
var BROWSER_COMMAND = /playwright|cypress|\be2e\b/i;
var NOT_LOADABLE = /Cannot find module|ERR_MODULE_NOT_FOUND|Failed to resolve import|Failed to load url|ModuleNotFoundError|ImportError|does not provide an export named/i;
function proveRegression(p, id, t, dir, base2, changed, runner2, timeoutMs) {
  const files = (changed ?? []).filter((f) => TEST_FILE.test(f));
  if (!base2 || !isGitRepo(dir)) return { status: "unproven", reason: "there is no base commit to compare with", files };
  if (!files.length) return { status: "not-red", reason: "the task changed no test file: a fix needs a regression test that fails on the old code", files };
  const commands = list5(t.verify).filter((c) => UNIT_TEST_COMMAND.test(c) && !BROWSER_COMMAND.test(c));
  if (!commands.length) return { status: "unproven", reason: "no verify command runs unit tests, so the old code could not be checked", files };
  let wt;
  let via = "worktree";
  try {
    wt = ensureWorktree(p, id, `${String(t.id)}-red`, base2);
  } catch (e) {
    try {
      wt = { dir: snapshotBase(p, id, `${String(t.id)}-red`, base2) };
      via = "snapshot";
    } catch (e2) {
      return { status: "unproven", reason: `could not check out the base commit: ${e.message}; a plain copy failed too: ${e2.message}`, files };
    }
  }
  const wdir = (0, import_node_path39.join)(p.project, wt.dir);
  try {
    for (const f of files) {
      if (!(0, import_node_fs34.existsSync)((0, import_node_path39.join)(dir, f))) continue;
      (0, import_node_fs34.mkdirSync)((0, import_node_path39.dirname)((0, import_node_path39.join)(wdir, f)), { recursive: true });
      (0, import_node_fs34.copyFileSync)((0, import_node_path39.join)(dir, f), (0, import_node_path39.join)(wdir, f));
    }
    let last = { command: commands[0], exit: 0, tail: "" };
    for (const command of commands) {
      const r = runner2(command, wdir, Math.min(timeoutMs, 5 * 60 * 1e3));
      if (r.timedOut) return { status: "unproven", reason: `\`${command}\` timed out on the old code`, files, command, via };
      last = { command, exit: r.exit, tail: r.tail };
      if (r.exit !== 0) {
        if (NOT_LOADABLE.test(r.tail)) {
          return { status: "unproven", reason: "the new tests fail on the old code, but because something they import does not exist there yet, not necessarily because of the bug: check that the assertion itself fails", files, via, ...last };
        }
        return { status: "red", reason: "the new tests fail on the old code", files, via, ...last };
      }
    }
    return { status: "not-red", reason: "the new tests pass on the old code: they do not reproduce the bug", files, via, ...last };
  } finally {
    if (via === "worktree") removeWorktree(p, wt.dir, wt.branch);
    else removeSnapshot(p, wt.dir);
  }
}
function checkpoint(p, id, taskId, opts = {}) {
  const tf = loadTasks(p, id);
  requireExecuting(p, tf.change);
  const i = indexOf(tf, taskId);
  const t = tf.tasks[i];
  if (statusOf3(t) !== "running") throw new OpError(`task ${taskId} is "${statusOf3(t)}"; checkpoint needs a running task (aidw task start ${taskId})`);
  const dir = taskDir(p, t);
  const scenarios = findScenarioTests(dir, list5(t.scenarios));
  const missing = Object.entries(scenarios).filter(([, locs]) => locs.length === 0).map(([s]) => s);
  const base2 = typeof t.base === "string" ? t.base : null;
  const changed = changedSince(dir, base2)?.filter((f) => !f.startsWith(".aidw/")) ?? null;
  const touches = list5(t.touches);
  const outside = changed ? changed.filter((f) => !matchesAny(touches, f)) : [];
  const runner2 = opts.runner ?? retryingShellRunner;
  const timeoutMs = opts.timeoutMs ?? 15 * 60 * 1e3;
  const verify2 = [];
  for (const command of list5(t.verify)) {
    const started = Date.now();
    const r = runner2(command, dir, timeoutMs);
    verify2.push({ command, ms: Date.now() - started, ...r });
    if (r.exit !== 0) break;
  }
  const verifyOk = verify2.length === list5(t.verify).length && verify2.every((v) => v.exit === 0);
  const previous = readEvidence2(tf.change, t).checkpoints.at(-1)?.at;
  const design = designEvidence(p, id, t, changed, previous ?? (typeof t.started_at === "string" ? t.started_at : void 0));
  const designOk = !design || design.missing_tokens.length === 0 && design.screenshots.length > 0;
  const regression = t.type === "fix" && verifyOk ? proveRegression(p, id, t, dir, base2, changed, runner2, timeoutMs) : void 0;
  const regressionOk = !regression || regression.status !== "not-red";
  const tamper = tamperEvidence(dir, base2, changed, { isTest: (f) => TEST_FILE.test(f), removesTests: t.removes_tests === true });
  const tamperOk = !tamper || tamper.blocked.length === 0;
  const config = configEvidence(dir, base2, changed, t.type);
  const secrets = secretsInChanges(dir, base2, changed) ?? [];
  const packages = packageEvidence(dir, base2, changed);
  const guardsOk = tamperOk && !config?.locked.length && secrets.length === 0 && !packages?.blocked.length;
  const ok = verifyOk && missing.length === 0 && designOk && regressionOk && guardsOk;
  const record = {
    attempt: attemptsOf(t),
    at: now6(),
    ok,
    base: base2,
    scenarios,
    missing_scenarios: missing,
    verify: verify2,
    changed_files: changed,
    outside_touches: outside,
    ...tamper && (tamper.blocked.length || tamper.justified.length || tamper.snapshots?.length) ? { tamper } : {},
    ...config && (config.locked.length || config.watched.length) ? { config } : {},
    ...secrets.length ? { secrets } : {},
    ...packages ? { packages } : {},
    ...design ? { design } : {},
    ...regression ? { regression } : {}
  };
  const ev = readEvidence2(tf.change, t);
  ev.checkpoints.push(record);
  writeEvidence(tf.change, ev);
  const problems = [];
  if (missing.length) problems.push(`no test names scenario ${missing.join(", ")}`);
  const failed = verify2.find((v) => v.exit !== 0);
  if (failed) problems.push(`verify failed: \`${failed.command}\`${failed.timedOut ? " (timed out)" : ` (exit ${failed.exit})`}`);
  if (regression?.status === "not-red") problems.push(`no regression proof: ${regression.reason}`);
  problems.push(...tamperProblems(tamper));
  if (config?.locked.length) problems.push(`check configuration changed by a task that is not a tooling task: ${config.locked.join(", ")}`);
  if (secrets.length) problems.push(secretsProblem(secrets));
  problems.push(...packageProblems(packages));
  if (design?.missing_tokens.length) problems.push(`design tokens not in the code: ${design.missing_tokens.join(", ")}`);
  if (design && design.screenshots.length === 0) problems.push(`no fresh screenshot in ${rel(p, shotsDir(p, id, taskId))}`);
  const refused = failed && !failed.timedOut ? ENVIRONMENT_FAILURE.exec(failed.tail)?.[0] : void 0;
  if (refused) {
    const why = `environment: \`${failed.command}\` was refused by the machine (${refused}), not by the code`;
    setField(tf, i, "notes", `checkpoint blocked: ${why}`);
    saveTasks(tf);
    return { ...record, task: taskId, status: "blocked", problems: [why, ...problems.filter((x) => !x.startsWith("verify failed"))], evidence: rel(p, (0, import_node_path39.join)(tf.change.dir, evidenceRel(taskId))) };
  }
  setField(tf, i, "status", ok ? "review" : "failed");
  setField(tf, i, "evidence", evidenceRel(taskId));
  setField(tf, i, "notes", ok ? null : `checkpoint: ${problems.join("; ")}`);
  saveTasks(tf);
  return { ...record, task: taskId, status: ok ? "review" : "failed", problems, evidence: rel(p, (0, import_node_path39.join)(tf.change.dir, evidenceRel(taskId))) };
}
function dropToSequential(p, tf, i, why) {
  const t = tf.tasks[i];
  removeWorktree(p, typeof t.worktree === "string" ? t.worktree : void 0, typeof t.branch === "string" ? t.branch : void 0);
  for (const f of ["worktree", "branch", "base", "started_at", "conflict"]) setField(tf, i, f, null);
  setField(tf, i, "status", "pending");
  setField(tf, i, "attempts", 0);
  setField(tf, i, "sequential", true);
  setField(tf, i, "notes", `${why}; dropped, reruns sequentially on the latest code`.slice(0, 500));
  saveTasks(tf);
  closeConflict(tf.change, t.id, "dropped", why);
}
function dropConflictTask(p, id, taskId, why) {
