// src/diag.ts
var Diags = class {
  items = [];
  error(file, message, line) {
    this.items.push({ level: "error", file, message, ...line ? { line } : {} });
  }
  warn(file, message, line) {
    this.items.push({ level: "warning", file, message, ...line ? { line } : {} });
  }
  add(other) {
    this.items.push(...other.items);
  }
  get errors() {
    return this.items.filter((d) => d.level === "error");
  }
  get warnings() {
    return this.items.filter((d) => d.level === "warning");
  }
  failed(strict = false) {
    return this.errors.length > 0 || strict && this.warnings.length > 0;
  }
};
var OpError = class extends Error {
  constructor(message, diags) {
    super(message);
    this.diags = diags;
  }
};

// src/spec/parse.ts
var H1 = /^#(?!#)\s+(.*\S)\s*$/;
var H2 = /^##(?!#)\s+(.*\S)\s*$/;
var REQ = /^###(?!#)\s+Requirement:\s*(.*\S)\s*$/;
var SCEN = /^####(?!#)\s+Scenario:\s*(.*\S)\s*$/;
var WRONG_SCEN = /^(?:#{1,3}|#{5,})\s+Scenario:|^\s*[-*]\s+(?:\*\*)?Scenario\b/i;
var STEP = /^\s*[-*]\s+\*\*(GIVEN|WHEN|THEN|AND)\*\*/i;
var FENCE = /^\s*(```|~~~)/;
var DELTA_SECTION = /^(ADDED|MODIFIED|REMOVED|RENAMED)(?:\s+Requirements?)?$/i;
function normalizeKey(name) {
  return name.trim().replace(/\s+/g, " ");
}
function toLines(text2) {
  const out = [];
  let inFence = false;
  text2.replace(/\r\n?/g, "\n").split("\n").forEach((t, i) => {
    const isFence = FENCE.test(t);
    if (isFence) inFence = !inFence;
    out.push({ text: t, no: i + 1, fenced: inFence || isFence });
  });
  return out;
}
function joinTrim(lines) {
  return lines.map((l) => l.text).join("\n").replace(/\s+$/, "");
}
function isH2(l) {
  return l.fenced ? null : l.text.match(H2);
}
function nextH2(lines, from) {
  for (let i = from; i < lines.length; i++) {
    const l = lines[i];
    if (l && isH2(l)) return i;
  }
  return lines.length;
}
function parseRequirementBlocks(lines, start, end) {
  const headers = [];
  for (let i = start; i < end; i++) {
    const l = lines[i];
    if (l && !l.fenced && REQ.test(l.text)) headers.push(i);
  }
  const preamble = lines.slice(start, headers[0] ?? end);
  const blocks = headers.map((h, idx) => {
    const blockEnd = headers[idx + 1] ?? end;
    return parseBlock(lines.slice(h, blockEnd));
  });
  return { blocks, preamble };
}
function parseBlock(block) {
  const header2 = block[0];
  const name = (header2.text.match(REQ)?.[1] ?? "").trim();
  const issues = [];
  const scenarios = [];
  const descLines = [];
  let current = null;
  for (const l of block.slice(1)) {
    if (!l.fenced) {
      const sm = l.text.match(SCEN);
      if (sm) {
        current = { name: (sm[1] ?? "").trim(), line: l.no, hasTrigger: false, hasOutcome: false };
        scenarios.push(current);
        continue;
      }
      if (WRONG_SCEN.test(l.text)) {
        issues.push({
          level: "error",
          line: l.no,
          message: 'Scenario heading must be exactly "#### Scenario: <name>" (4 hashes)'
        });
      }
      const step = l.text.match(STEP);
      if (step && current) {
        const kw = (step[1] ?? "").toUpperCase();
        if (kw === "WHEN" || kw === "GIVEN") current.hasTrigger = true;
        if (kw === "THEN") current.hasOutcome = true;
      }
    }
    if (!current) descLines.push(l);
  }
  const raw = joinTrim(block);
  const removedMeta = extractRemovedMeta(raw);
  return {
    name,
    key: normalizeKey(name),
    line: header2.no,
    raw,
    description: joinTrim(descLines).trim(),
    scenarios,
    issues,
    ...removedMeta
  };
}
function extractRemovedMeta(raw) {
  const pick = (label2) => {
    const re = new RegExp(`(?:\\*\\*${label2}:?\\*\\*|^${label2})\\s*:?\\s*(.*\\S)`, "im");
    return raw.match(re)?.[1]?.trim();
  };
  const reason = pick("Reason");
  const migration = pick("Migration");
  return { ...reason ? { reason } : {}, ...migration ? { migration } : {} };
}
function parseSpec(text2) {
  const lines = toLines(text2);
  let title;
  for (const l of lines) {
    if (l.fenced) continue;
    const m = l.text.match(H1);
    if (m) {
      title = m[1];
      break;
    }
  }
  let purpose;
  let hasPurpose = false;
  let reqStart = -1;
  for (let i = 0; i < lines.length; i++) {
    const l = lines[i];
    const m = isH2(l);
    if (!m) continue;
    const heading = (m[1] ?? "").trim().toLowerCase();
    if (heading === "purpose") {
      hasPurpose = true;
      purpose = joinTrim(lines.slice(i + 1, nextH2(lines, i + 1))).trim();
    } else if (heading === "requirements" && reqStart < 0) {
      reqStart = i;
    }
  }
  if (reqStart < 0) {
    return {
      ...title ? { title } : {},
      ...purpose !== void 0 ? { purpose } : {},
      hasPurpose,
      hasRequirementsSection: false,
      requirements: [],
      prefix: `${joinTrim(lines)}

## Requirements`.replace(/^\s+/, ""),
      suffix: ""
    };
  }
  const reqEnd = nextH2(lines, reqStart + 1);
  const { blocks, preamble } = parseRequirementBlocks(lines, reqStart + 1, reqEnd);
  return {
    ...title ? { title } : {},
    ...purpose !== void 0 ? { purpose } : {},
    hasPurpose,
    hasRequirementsSection: true,
    requirements: blocks,
    prefix: joinTrim([...lines.slice(0, reqStart + 1), ...preamble]),
    suffix: joinTrim(lines.slice(reqEnd)).trim()
  };
}
function sections(text2) {
  const lines = toLines(text2);
  const out = [];
  for (let i = 0; i < lines.length; i++) {
    const l = lines[i];
    const m = isH2(l);
    if (!m) continue;
    out.push({ name: (m[1] ?? "").trim(), line: l.no, body: joinTrim(lines.slice(i + 1, nextH2(lines, i + 1))).trim() });
  }
  return out;
}
function slugify(name) {
  return name.toLowerCase().normalize("NFKD").replace(/[̀-ͯ]/g, "").replace(/đ/g, "d").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
}
function cleanRenameName(s) {
  return normalizeKey(
    s.replace(/`/g, "").replace(/^###\s+Requirement:\s*/i, "").trim()
  );
}
function parseDelta(text2) {
  const lines = toLines(text2);
  const out = { added: [], modified: [], removed: [], renamed: [], unknownSections: [], issues: [] };
  for (let i = 0; i < lines.length; i++) {
    const l = lines[i];
    const m = isH2(l);
    if (!m) continue;
    const heading = (m[1] ?? "").trim();
    const end = nextH2(lines, i + 1);
    if (heading.toLowerCase() === "purpose") {
      out.purpose = joinTrim(lines.slice(i + 1, end)).trim();
      continue;
    }
    const op = heading.match(DELTA_SECTION)?.[1]?.toUpperCase();
    if (!op) {
      out.unknownSections.push({ name: heading, line: l.no });
      continue;
    }
    if (op === "RENAMED") {
      let pending = null;
      for (const r of lines.slice(i + 1, end)) {
        if (r.fenced) continue;
        const from = r.text.match(/^\s*(?:[-*]\s*)?FROM:\s*(.*\S)\s*$/i);
        const to = r.text.match(/^\s*(?:[-*]\s*)?TO:\s*(.*\S)\s*$/i);
        if (from) {
          if (pending) out.issues.push({ level: "error", line: pending.line, message: "RENAMED: FROM without matching TO" });
          pending = { from: cleanRenameName(from[1] ?? ""), line: r.no };
        } else if (to) {
          if (!pending) {
            out.issues.push({ level: "error", line: r.no, message: "RENAMED: TO without preceding FROM" });
          } else {
            out.renamed.push({ from: pending.from, to: cleanRenameName(to[1] ?? ""), line: pending.line });
            pending = null;
          }
        }
      }
      if (pending) out.issues.push({ level: "error", line: pending.line, message: "RENAMED: FROM without matching TO" });
      continue;
    }
    const { blocks } = parseRequirementBlocks(lines, i + 1, end);
    if (op === "ADDED") out.added.push(...blocks);
    else if (op === "MODIFIED") out.modified.push(...blocks);
    else out.removed.push(...blocks);
  }
  return out;
}

// src/scope.ts
var SCOPE_ROUND_HEADING = "Scope round";
var SCOPE_QUESTIONS = ["vision", "scope", "mvp", "out"];
var APPENDIX = "appendix: discovery q&a";
var PLACEHOLDER = "TODO(aidw)";
function scopeRound(analysis) {
  const appendix = sections(analysis).find((s) => s.name.toLowerCase() === APPENDIX);
  if (!appendix) return null;
  const lines = appendix.body.split(/\r?\n/);
  const start = lines.findIndex((l) => /^###\s+(.+?)\s*#*\s*$/.exec(l)?.[1]?.toLowerCase() === SCOPE_ROUND_HEADING.toLowerCase());
  if (start < 0) return null;
  const end = lines.findIndex((l, i) => i > start && /^#{1,3}\s/.test(l));
  return lines.slice(start + 1, end < 0 ? void 0 : end).join("\n").trim();
}
function missingScopeAnswers(round) {
  return SCOPE_QUESTIONS.filter((id) => !new RegExp(`^\\s*(?:[-*]\\s+)?${id}\\b[^:\\n]*:\\s*\\S`, "im").test(round));
}
function checkScopeRound(change, analysis, file) {
  const d = new Diags();
  if (!checkBrief(change).errors.length) return d;
  const round = scopeRound(analysis);
  const how2 = `ask it on the \`scope\` Decision Page (kind: scope) and record the checked answer under "### ${SCOPE_ROUND_HEADING}" in "## Appendix: discovery Q&A"`;
  if (round === null || !round || round.includes(PLACEHOLDER)) {
    d.error(file, `the scope round is not recorded: ${how2}`);
    return d;
  }
  for (const id of missingScopeAnswers(round)) d.error(file, `the scope round has no answer for "${id}": ${how2}`);
  return d;
}
var BRIEF_FILE = "brief.md";
var BRIEF_SECTIONS = ["Vision", "Scope", "MVP", "Out of scope"];
var briefPath = (change) => (0, import_node_path.join)(change.dir, BRIEF_FILE);
function checkBrief(change) {
  const d = new Diags();
  const file = `changes/${change.id}/${BRIEF_FILE}`;
  if (!(0, import_node_fs.existsSync)(briefPath(change))) {
    d.error(file, "the product brief is missing");
    return d;
  }
  const found = sections((0, import_node_fs.readFileSync)(briefPath(change), "utf8"));
  for (const name of BRIEF_SECTIONS) {
    const s = found.find((x) => x.name.toLowerCase() === name.toLowerCase());
    if (!s) d.error(file, `missing section "## ${name}"`);
    else if (!s.body || s.body.includes(PLACEHOLDER)) d.error(file, `section "## ${name}" is empty or still a placeholder`, s.line);
  }
  return d;
}

// src/page.ts
var LAYOUTS = ["questions", "picks", "gate"];
var pagesDir = (p) => (0, import_node_path2.join)(p.run, "pages");
var pageDataFile = (p, name) => (0, import_node_path2.join)(pagesDir(p), `${name}.yaml`);
var pageHtmlFile = (p, name) => (0, import_node_path2.join)(pagesDir(p), `${name}.html`);
var PAGE_NAME = /^[a-z0-9][a-z0-9-]{0,63}$/;
var ID = /^[A-Za-z][\w.-]{0,39}$/;
var KEY = /^[A-Za-z0-9][\w.-]{0,39}$/;
var RESERVED = /* @__PURE__ */ new Set(["note", "picks"]);
var MAX_FRAGMENT = 6e4;
var FRAGMENT_RULES = [
  [/<\s*\/?\s*(script|iframe|frame|frameset|object|embed|applet|link|meta|base|form|template)\b/i, "the <$1> element"],
  [/\son[a-z]+\s*=/i, "an event handler attribute"],
  [/javascript\s*:/i, "a javascript: link"],
  [/@import/i, "a CSS @import"],
  [/(?:src|href|srcset|poster|action|data)\s*=\s*["']?\s*(?:[a-z][a-z0-9+.-]*:)?\/\//i, "a network address in an attribute"],
  [/url\(\s*["']?\s*(?:[a-z][a-z0-9+.-]*:)?\/\//i, "a network address in CSS url()"]
];
function checkFragment(html) {
  if (html.length > MAX_FRAGMENT) return `is ${html.length} characters; the limit is ${MAX_FRAGMENT}`;
  for (const [re, what] of FRAGMENT_RULES) {
    const m = re.exec(html);
    if (m) return `contains ${what.replace("$1", (m[1] ?? "").toLowerCase())}: the free slot takes static HTML, CSS and SVG only, with no script and nothing loaded from the network`;
  }
  return null;
}
var text = (v) => typeof v === "string" ? v.trim() : typeof v === "number" || typeof v === "boolean" ? String(v) : "";
var list = (v) => Array.isArray(v) ? v.map(text).filter(Boolean) : text(v) ? [text(v)] : [];
var obj = (v) => v && typeof v === "object" && !Array.isArray(v) ? v : {};
var rows = (v) => Array.isArray(v) ? v.map(obj) : [];
function unique(values, what, where, problems) {
  const seen = /* @__PURE__ */ new Set();
  for (const v of values) {
    if (seen.has(v)) problems.push(`${where}: ${what} "${v}" appears twice`);
    seen.add(v);
  }
}
function parsePage(name, source, extra = [], lead = []) {
  const problems = [];
  let raw = {};
  try {
    raw = obj((0, import_yaml.parse)(source));
  } catch (e) {
    problems.push(`not valid YAML: ${e.message.split("\n")[0]}`);
  }
  const layout = LAYOUTS.includes(text(raw.layout)) ? text(raw.layout) : "questions";
  if (raw.layout !== void 0 && text(raw.layout) !== layout) problems.push(`layout: "${text(raw.layout)}" is not one of ${LAYOUTS.join(", ")}`);
  const lang = text(raw.lang) === "vi" ? "vi" : "en";
  if (raw.lang !== void 0 && !["en", "vi"].includes(text(raw.lang))) problems.push(`lang: "${text(raw.lang)}" is not en or vi`);
  const page = {
    name,
    version: (0, import_node_crypto.createHash)("sha256").update(source).digest("hex").slice(0, 6),
    layout,
    title: text(raw.title),
    intro: text(raw.intro),
    lang,
    role: text(raw.role),
    kind: text(raw.kind),
    change: text(raw.change),
    questions: [],
    items: [],
    sections: []
  };
  if (!page.title) problems.push("title: missing");
  const slot = (v, where) => {
    const html = typeof v === "string" ? v : "";
    const bad = html ? checkFragment(html) : null;
    if (bad) problems.push(`${where}.html ${bad}`);
    return bad ? "" : html;
  };
  if (layout === "questions") {
    page.questions = rows(raw.questions).map((q, i) => {
      const id = text(q.id) || `Q${i + 1}`;
      const where = `questions[${id}]`;
      if (!ID.test(id) || RESERVED.has(id.toLowerCase())) problems.push(`${where}: id must start with a letter, use letters, digits, "-", "_" or ".", and not be "note" or "picks"`);
      const criteria = list(q.criteria);
      const options = rows(q.options).map((o, j) => {
        const key = text(o.key);
        const at = `${where}.options[${key || j + 1}]`;
        if (!KEY.test(key)) problems.push(`${at}: key is missing or not a short slug (letters, digits, "-", "_", ".")`);
        const facts = {};
        for (const [k, v] of Object.entries(obj(o.facts))) facts[k.trim()] = text(v);
        for (const k of Object.keys(facts)) if (!criteria.includes(k)) problems.push(`${at}.facts: "${k}" is not one of the question's criteria (${criteria.join(", ") || "none declared"})`);
        for (const c of criteria) if (!facts[c]) problems.push(`${at}.facts: no value for the criterion "${c}"; every option answers every criterion so the cards line up`);
        const opt = { key, name: text(o.name), summary: text(o.summary), pros: list(o.pros), cons: list(o.cons), facts, html: slot(o.html, at) };
        if (!opt.name) problems.push(`${at}: name is missing`);
        if (!opt.summary && !opt.pros.length && !opt.cons.length && !criteria.length) problems.push(`${at}: say what this option gives and costs (summary, pros, cons or facts)`);
        return opt;
      });
      const question = {
        id,
        title: text(q.title),
        body: text(q.body),
        example: text(q.example),
        multi: q.multi === true,
        optional: q.optional === true,
        criteria,
        recommend: list(q.recommend),
        suggest: text(q.suggest),
        why: text(q.why),
        decision: text(q.decision),
        html: slot(q.html, where),
        options
      };
      if (!question.title) problems.push(`${where}: title is missing`);
      if (options.length === 1) problems.push(`${where}: one option is not a choice; give at least two, or none for an open question`);
      unique(options.map((o) => o.key), "option key", where, problems);
      for (const r of question.recommend) if (!options.some((o) => o.key === r)) problems.push(`${where}.recommend: "${r}" is not an option key`);
      if (!question.multi && question.recommend.length > 1) problems.push(`${where}.recommend: several keys, but the question is not multi`);
      if (options.length && !question.recommend.length) problems.push(`${where}: recommend is missing; every choice carries the Role's recommended answer and why`);
      if (question.recommend.length && !question.why) problems.push(`${where}: why is missing; say in one or two sentences why that answer is recommended`);
      if (criteria.length === 1 || criteria.length > 4) problems.push(`${where}.criteria: give 2 to 4 criteria, or none`);
      return question;
    });
    if (!page.questions.length) problems.push("questions: missing or empty");
    unique(page.questions.map((q) => q.id), "question id", "questions", problems);
  }
  if (page.kind === "scope") {
    if (layout !== "questions") problems.push("kind: scope is a round of questions (layout: questions)");
    else
      for (const id of SCOPE_QUESTIONS) {
        const q = page.questions.find((x) => x.id === id);
        if (!q) problems.push(`kind: scope needs the question "${id}" (${SCOPE_QUESTIONS.join(", ")})`);
        else if (q.optional) problems.push(`kind: scope: the question "${id}" may not be optional; the round records an answer to each`);
        if (q && id === "scope" && (!q.multi || q.options.length < 2)) problems.push('kind: scope: the question "scope" is a multi choice with one option per capability (multi: true, options)');
      }
  }
  if (layout === "picks") {
    page.items = rows(raw.items).map((it, i) => {
      const key = text(it.key);
      const where = `items[${key || i + 1}]`;
      if (!KEY.test(key)) problems.push(`${where}: key is missing or not a short slug`);
      const item = { key, title: text(it.title), group: text(it.group), tag: text(it.tag), detail: text(it.detail), recommend: it.recommend === true, html: slot(it.html, where) };
      if (!item.title) problems.push(`${where}: title is missing`);
      return item;
    });
    if (!page.items.length) problems.push("items: missing or empty");
    unique(page.items.map((x) => x.key), "item key", "items", problems);
  }
  if (layout === "gate") {
    page.sections = [
      ...lead,
      ...rows(raw.sections).map((s, i) => {
        const id = text(s.id);
        const where = `sections[${id || i + 1}]`;
        if (!ID.test(id) || RESERVED.has(id.toLowerCase())) problems.push(`${where}: id is missing or not a short slug starting with a letter`);
        const section2 = { id, title: text(s.title), body: text(s.body), points: list(s.points), html: slot(s.html, where) };
        if (!section2.title) problems.push(`${where}: title is missing`);
        if (!section2.body && !section2.points.length && !section2.html) problems.push(`${where}: nothing to read; give body, points or html`);
        return section2;
      }),
      ...extra
    ];
    if (!page.sections.length) problems.push("sections: missing or empty");
    unique(page.sections.map((s) => s.id), "section id", "sections", problems);
  }
  return { page, problems };
}
