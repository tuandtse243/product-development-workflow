var claudeExec = (model) => (prompt, system) => {
  const cwd = (0, import_node_fs38.mkdtempSync)((0, import_node_path43.join)((0, import_node_os3.tmpdir)(), "aidw-eval-"));
  try {
    const args = ["-p", "--tools", "", "--setting-sources", "project", ...model ? ["--model", model] : [], ...system ? ["--append-system-prompt", system] : []];
    const r = (0, import_node_child_process9.spawnSync)("claude", args, { cwd, input: prompt, encoding: "utf8", timeout: 10 * 60 * 1e3, maxBuffer: 16 * 1024 * 1024 });
    if (r.error || r.status !== 0) throw new Error(`claude -p failed: ${r.error?.message ?? ((r.stderr || r.stdout || "").trim().slice(0, 500) || `exit ${r.status}`)}`);
    return r.stdout;
  } finally {
    (0, import_node_fs38.rmSync)(cwd, { recursive: true, force: true });
  }
};
function roleSystem(root, id) {
  const file = [(0, import_node_path43.join)(root, "agents", `${id}.md`), (0, import_node_path43.join)(root, "roles", id, "role.md")].find(import_node_fs38.existsSync);
  if (!file) throw new Error(`Role "${id}" has no agent file or role.md`);
  const body = (0, import_node_fs38.readFileSync)(file, "utf8").replace(/^---\n[\s\S]*?\n---\n/, "").trim();
  const dir = (0, import_node_path43.join)(root, "roles", id, "skills");
  const skills = (0, import_node_fs38.existsSync)(dir) ? (0, import_node_fs38.readdirSync)(dir).filter((n) => n.endsWith(".md")).sort().map((n) => `### Skill: ${n.slice(0, -3)}

${(0, import_node_fs38.readFileSync)((0, import_node_path43.join)(dir, n), "utf8").replace(/^---\n[\s\S]*?\n---\n/, "").trim()}`) : [];
  return skills.length ? `${body}

## Your skills, in full

The index above points at these files; here is their text.

${skills.join("\n\n")}` : body;
}
function buildGradePrompt(c, answer) {
  return [
    "You grade an answer against criteria. Judge only what the answer says; do not reward length or confidence.",
    "The answer was written without tools, so it could not really run, open or write anything. Grade an action (open a file, run a",
    "command, write a file, write a test before the code) as done when the Steps say plainly that it is done, in the right order,",
    "naming the file or the command; a result the answer could not have seen (a test's output) counts when it is stated as expected.",
    "Grade a criterion about the reply (its length or its format) against the Reply section only.",
    "",
    "## Situation",
    c.input,
    "",
    "## Answer",
    answer,
    "",
    "## Criteria",
    ...c.criteria.map((x, i) => `${i + 1}. ${x}`),
    "",
    'Reply with ONLY a JSON array, one object per criterion in order: [{"n":1,"pass":true,"reason":"one short sentence"}]. A "must not" criterion passes when the answer avoids it.'
  ].join("\n");
}
function parseGrade(text2, criteria) {
  let arr = [];
  const m = /\[[\s\S]*\]/.exec(text2);
  if (m) {
    try {
      const v = JSON.parse(m[0]);
      if (Array.isArray(v)) arr = v;
    } catch {
    }
  }
  return criteria.map((criterion, i) => {
    const e = arr.find((x) => typeof x === "object" && x !== null && x.n === i + 1);
    if (!e || typeof e.pass !== "boolean") return { criterion, pass: false, reason: "the grader gave no verdict for this criterion" };
    return { criterion, pass: e.pass, reason: typeof e.reason === "string" ? e.reason : "" };
  });
}
function answerPrompt(c) {
  return [
    c.input,
    "",
    "---",
    "Produce the deliverable for this task in full, as plain text, in two parts.",
    "## Steps: what you do, in the order you do it. Name each action (open a file, run a command, write a file) with the file or",
    "the command, and put the full content of each file you write inline: the test code, the changes, the configuration or the",
    "review verdict, exactly as you would hand them over. Nothing can be run here, so for a command say what you expect it to print.",
    "## Reply: the exact message you send back when you are done, in the format your role asks for.",
    "The brief above is complete and nothing is blocked: do not stop to ask a question or to report a missing input.",
    "Do not summarize and do not leave parts out."
  ].join("\n");
}
var MIN_ANSWER = 300;
function runCase(root, id, c, exec) {
  const system = roleSystem(root, id);
  let answer = exec(answerPrompt(c), system);
  if (answer.trim().length < MIN_ANSWER) answer = exec(answerPrompt(c), system);
  if (answer.trim().length < MIN_ANSWER) throw new Error(`no deliverable (the model replied: ${answer.trim().replace(/\s+/g, " ").slice(0, 160)})`);
  const criteria = parseGrade(exec(buildGradePrompt(c, answer)), c.criteria);
  return { role: id, name: c.name, pass: criteria.every((x) => x.pass), criteria, answer };
}
function attempt(root, id, c, exec) {
  try {
    return runCase(root, id, c, exec);
  } catch (e) {
    return { role: id, name: c.name, pass: false, criteria: [], answer: "", error: e.message.replace(/^claude -p failed: /, "") };
  }
}
function attempts(root, id, c, exec, n) {
  if (n <= 1) return attempt(root, id, c, exec);
  const rs = Array.from({ length: n }, () => attempt(root, id, c, exec));
  const graded = rs.filter((r) => !r.error);
  const passed = rs.filter((r) => r.pass).length;
  const failing = /* @__PURE__ */ new Map();
  for (const r of graded) for (const k of r.criteria.filter((x) => !x.pass)) {
    const e = failing.get(k.criterion);
    failing.set(k.criterion, { count: (e?.count ?? 0) + 1, reason: e?.reason ?? k.reason });
  }
  return {
    role: id,
    name: c.name,
    pass: passed === n,
    criteria: [...failing].map(([criterion, v]) => ({ criterion, pass: false, reason: `failed in ${v.count} of ${graded.length} graded runs: ${v.reason}` })),
    answer: (graded[graded.length - 1] ?? rs[rs.length - 1]).answer,
    ...graded.length === 0 ? { error: rs[0].error } : {},
    runs: { total: n, passed, errors: rs.length - graded.length }
  };
}
function runCases(root, role, caseName, exec, onCase, runs = 1) {
  const roster = loadRoster(root);
  const ids = role ? [role] : Object.entries(roster.roles).filter(([, e]) => e?.status === "active").map(([k]) => k);
  const out = [];
  for (const id of ids) {
    if (!roster.roles[id]) throw new Error(`"${id}" is not a Role in roster.yaml`);
    for (const c of loadEvalCases(root, id).cases) {
      if (caseName && c.name !== caseName) continue;
      const r = attempts(root, id, c, exec, runs);
      out.push(r);
      onCase?.(r);
    }
  }
  if (caseName && !out.length) throw new Error(`no case "${caseName}"${role ? ` for ${role}` : ""}`);
  return out;
}
function printResults(rs, showAnswers = false) {
  const lines = [];
  for (const r of rs) {
    if (showAnswers && r.answer) lines.push(`----- answer of ${r.role}/${r.name} -----
${r.answer.trim()}
-----`);
    const word = r.error ? "ERROR" : r.pass ? "PASS" : r.runs && r.runs.passed > 0 ? "FLAKY" : "FAIL";
    const tally = r.runs ? ` (${r.runs.passed}/${r.runs.total} runs${r.runs.errors ? `, ${r.runs.errors} error` : ""})` : "";
    lines.push(`${word} ${r.role}/${r.name}${tally}`.replace(/^(PASS|FAIL) /, "$1  "));
    if (r.error) lines.push(`      ${r.error.split("\n")[0]?.slice(0, 200)}`);
    for (const c of r.criteria.filter((x) => !x.pass)) lines.push(`      - ${c.criterion}
        ${c.reason}`);
  }
  const bad = rs.filter((r) => !r.pass).length;
  lines.push(`${rs.length - bad}/${rs.length} case(s) passed`);
  return lines.join("\n") + "\n";
}

// src/pause.ts
function runStopFailure(stdin, env) {
  let input = {};
  try {
    input = JSON.parse(stdin);
  } catch {
  }
  const project = findProject({ cwd: input.cwd ?? process.cwd(), env });
  if (!project) return [];
  const p = pathsFor(project);
  const details = typeof input.error_details === "string" && input.error_details.trim() ? `: ${input.error_details.trim()}` : "";
  const reason = `${String(input.error ?? input.error_type ?? "stop_failure")}${details}`.slice(0, 200);
  const paused = [];
  for (const id of listChangeIds(p)) {
    try {
      const change = loadChange(p, id);
      const state = stateOf(change);
      if (state && (machineOf(p, change).transitions[state] ?? []).includes("paused")) {
        transition(p, id, "paused", { reason });
        paused.push(id);
      }
    } catch {
    }
  }
  return paused;
}

// src/cost.ts
var import_node_fs39 = require("node:fs");
var import_node_os4 = require("node:os");
var import_node_path44 = require("node:path");
var emptyUsage = () => ({ input: 0, output: 0, cacheRead: 0, cacheWrite: 0 });
function addUsage(a, b) {
  return { input: a.input + b.input, output: a.output + b.output, cacheRead: a.cacheRead + b.cacheRead, cacheWrite: a.cacheWrite + b.cacheWrite };
}
var weighted = (u) => Math.round(u.input + u.cacheWrite * 1.25 + u.cacheRead * 0.1 + u.output * 5);
var AIDW_CALL = /(?:^|[\s;&|(/])aidw\s+([a-z][a-z-]*(?:\s+(?:start|retry))?)/g;
function readTranscript(file) {
  const byMessage = /* @__PURE__ */ new Map();
  const tools = {};
  const aidwCommands = {};
  const seenTool = /* @__PURE__ */ new Set();
  let firstAt = null;
  let lastAt = null;
  for (const raw of (0, import_node_fs39.readFileSync)(file, "utf8").split("\n")) {
    if (!raw.trim()) continue;
    let line;
    try {
      line = JSON.parse(raw);
    } catch {
      continue;
    }
    if (line.timestamp) {
      firstAt ??= line.timestamp;
      lastAt = line.timestamp;
    }
    if (line.type !== "assistant" || !line.message) continue;
    const u = line.message.usage;
    if (u) {
      const input = u.input_tokens ?? 0;
      const cacheRead = u.cache_read_input_tokens ?? 0;
      const cacheWrite = u.cache_creation_input_tokens ?? 0;
      byMessage.set(line.message.id ?? line.uuid ?? String(byMessage.size), { input, output: u.output_tokens ?? 0, cacheRead, cacheWrite, ctx: input + cacheRead + cacheWrite });
    }
    const content = line.message.content;
    if (!Array.isArray(content)) continue;
    for (const block of content) {
      if (block.type !== "tool_use" || !block.name) continue;
      if (block.id) {
        if (seenTool.has(block.id)) continue;
        seenTool.add(block.id);
      }
      tools[block.name] = (tools[block.name] ?? 0) + 1;
      if (block.name === "Bash" && typeof block.input?.command === "string") {
        for (const m of block.input.command.matchAll(AIDW_CALL)) {
          const sub = m[1].trim();
          aidwCommands[sub] = (aidwCommands[sub] ?? 0) + 1;
        }
      }
    }
  }
  let usage = emptyUsage();
  let max = 0;
  let sum = 0;
  let first = 0;
  let i = 0;
  for (const m of byMessage.values()) {
    usage = addUsage(usage, m);
    if (i === 0) first = m.ctx;
    max = Math.max(max, m.ctx);
    sum += m.ctx;
    i++;
  }
  return { file, turns: byMessage.size, usage, contextFirst: first, contextMax: max, contextAvg: i ? Math.round(sum / i) : 0, tools, aidwCommands, firstAt, lastAt };
}
var projectSlug = (projectDir) => projectDir.replace(/[^A-Za-z0-9]/g, "-");
function claudeHome(env) {
  return env.CLAUDE_CONFIG_DIR || (0, import_node_path44.join)(env.HOME || (0, import_node_os4.homedir)(), ".claude");
}
function transcriptDir(projectDir, env) {
  return (0, import_node_path44.join)(claudeHome(env), "projects", projectSlug(projectDir));
}
function readSessions(projectDir, env) {
  const dir = transcriptDir(projectDir, env);
  if (!(0, import_node_fs39.existsSync)(dir)) return [];
  const out = [];
  for (const name of (0, import_node_fs39.readdirSync)(dir)) {
    if (!name.endsWith(".jsonl")) continue;
    const id = name.slice(0, -".jsonl".length);
    const main = readTranscript((0, import_node_path44.join)(dir, name));
    if (main.turns === 0) continue;
    const subDir = (0, import_node_path44.join)(dir, id, "subagents");
    let subs = { count: 0, turns: 0, usage: emptyUsage(), roles: {} };
    if ((0, import_node_fs39.existsSync)(subDir)) {
      for (const f of (0, import_node_fs39.readdirSync)(subDir)) {
        if (!f.endsWith(".jsonl")) continue;
        const t = readTranscript((0, import_node_path44.join)(subDir, f));
        if (t.turns === 0) continue;
        let role = "subagent";
        try {
          role = String(JSON.parse((0, import_node_fs39.readFileSync)((0, import_node_path44.join)(subDir, f.replace(/\.jsonl$/, ".meta.json")), "utf8")).agentType ?? role);
        } catch {
        }
        const r = subs.roles[role] ?? { count: 0, turns: 0, usage: emptyUsage(), firstContext: 0 };
        subs.roles[role] = { count: r.count + 1, turns: r.turns + t.turns, usage: addUsage(r.usage, t.usage), firstContext: r.firstContext + t.contextFirst };
        subs = { count: subs.count + 1, turns: subs.turns + t.turns, usage: addUsage(subs.usage, t.usage), roles: subs.roles };
      }
    }
    out.push({ ...main, id, subagents: subs, repeatedSpawns: Math.max(0, (main.tools.Agent ?? 0) - subs.count) });
  }
  return out.sort((a, b) => (a.firstAt ?? "").localeCompare(b.firstAt ?? ""));
}
var kilo = (n) => n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${Math.round(n / 1e3)}K` : String(n);
function parallelSavings(tasks) {
  const iv = tasks.filter((t) => typeof t.merged_at === "string" || t.merged_at instanceof Date).map((t) => [new Date(String(t.started_at)).getTime(), new Date(String(t.finished_at)).getTime()]).filter(([a, b]) => Number.isFinite(a) && Number.isFinite(b) && b >= a).sort((x, y) => x[0] - y[0]);
  if (!iv.length) return null;
  const serialMs = iv.reduce((n, [a, b]) => n + (b - a), 0);
  let wallMs = 0;
  let [cs, ce] = iv[0];
  for (const [a, b] of iv.slice(1)) {
    if (a <= ce) ce = Math.max(ce, b);
    else {
      wallMs += ce - cs;
      [cs, ce] = [a, b];
    }
  }
  wallMs += ce - cs;
  return { wave: iv.length, serialMs, wallMs };
}
function formatCost(sessions) {
  if (!sessions.length) return "no Claude Code transcripts found for this project\n";
  const lines = [];
  let main = emptyUsage();
  let subs = emptyUsage();
  let turns = 0;
  let subTurns = 0;
  let spawns = 0;
  let repeated = 0;
  for (const s of sessions) {
    main = addUsage(main, s.usage);
    subs = addUsage(subs, s.subagents.usage);
    turns += s.turns;
    subTurns += s.subagents.turns;
    spawns += s.subagents.count;
    repeated += s.repeatedSpawns;
    const top = Object.entries(s.aidwCommands).sort((a, b) => b[1] - a[1]).slice(0, 5).map(([k, v]) => `${k} ${v}`).join(", ");
    lines.push(
      `session ${s.id.slice(0, 8)}  ${s.firstAt?.slice(0, 16).replace("T", " ") ?? "?"}`,
      `  ${s.turns} turns, context ${kilo(s.contextFirst)} -> ${kilo(s.contextMax)} (average ${kilo(s.contextAvg)}), cache read ${kilo(s.usage.cacheRead)}, output ${kilo(s.usage.output)}`,
      `  ${s.subagents.count} subagent(s), ${s.subagents.turns} turns, cache read ${kilo(s.subagents.usage.cacheRead)}${s.repeatedSpawns ? `; ${s.repeatedSpawns} Agent call(s) sent twice` : ""}`,
      ...top ? [`  aidw calls: ${top}`] : []
    );
  }
  const wMain = weighted(main);
  const wSubs = weighted(subs);
  const total = wMain + wSubs;
  const share = total ? Math.round(wMain / total * 100) : 0;
  lines.push(
    "",
    `total: ${sessions.length} session(s), ${turns} orchestrator turns + ${subTurns} subagent turns (${spawns} subagents)`,
    `  weighted cost ${kilo(total)} input-equivalent tokens (estimate for comparing runs): orchestrator ${share}%, subagents ${100 - share}%`
  );
  const roles = {};
  for (const s of sessions) {
    for (const [name, r] of Object.entries(s.subagents.roles)) {
      const x = roles[name] ?? { count: 0, turns: 0, usage: emptyUsage(), firstContext: 0 };
      roles[name] = { count: x.count + r.count, turns: x.turns + r.turns, usage: addUsage(x.usage, r.usage), firstContext: x.firstContext + r.firstContext };
    }
  }
  if (Object.keys(roles).length) {
    lines.push("  by role (share of the total):");
    lines.push(`    orchestrator   ${Math.round(share)}%`);
    for (const [name, r] of Object.entries(roles).sort((a, b) => weighted(b[1].usage) - weighted(a[1].usage))) {
      lines.push(`    ${name.replace(/^aidw:/, "").padEnd(14)} ${Math.round(weighted(r.usage) / (total || 1) * 100)}%  (${r.count} agent(s), ${r.turns} turns, first turn ${kilo(Math.round(r.firstContext / r.count))} tokens)`);
    }
  }
  const worst = sessions.reduce((a, b) => b.contextMax > a.contextMax ? b : a);
  const advice = [];
  if (worst.contextMax > 2e5) advice.push(`session ${worst.id.slice(0, 8)} grew to ${kilo(worst.contextMax)} per turn, and every turn re-reads it: run \`aidw run\` (a fresh session per task) or /clear between phases`);
  const impl = roles[AGENTS.implement];
  const rev = roles[AGENTS.taskReview];
  if (impl && rev && impl.firstContext / impl.count > 2 * (rev.firstContext / rev.count)) {
    advice.push(`an implementer's first turn is ${kilo(Math.round(impl.firstContext / impl.count))} tokens against ${kilo(Math.round(rev.firstContext / rev.count))} for a reviewer: tool schemas of MCP servers and plugins ride along in every turn; use \`aidw run\` (it drops MCP servers) or disable them for the run`);
  }
  if (repeated) advice.push(`${repeated} Agent call(s) were sent twice: a plugin hook rewrites the call (for example context-mode); disabling it for aidw runs saves one turn per spawn`);
  const chatty = sessions.flatMap((s) => Object.entries(s.aidwCommands)).filter(([k]) => k === "status" || k === "next");
  const chattyCalls = chatty.reduce((n, [, v]) => n + v, 0);
  if (chattyCalls > 12) advice.push(`${chattyCalls} separate \`aidw status\`/\`aidw next\` calls: each is a turn that re-reads the whole context`);
  if (advice.length) lines.push("", "what to look at:", ...advice.map((a) => `  - ${a}`));
  return `${lines.join("\n")}
`;
}

