function serveFolder(dir) {
  const root = (0, import_node_path41.resolve)(dir);
  const server = (0, import_node_http.createServer)((req, res) => {
    const path = decodeURIComponent((req.url ?? "/").split("?")[0]);
    const file = (0, import_node_path41.resolve)(root, `.${path === "/" ? "/index.html" : path}`);
    if (file !== root && !file.startsWith(root + import_node_path41.sep)) {
      res.writeHead(403).end();
      return;
    }
    if (!(0, import_node_fs36.existsSync)(file) || !(0, import_node_fs36.statSync)(file).isFile()) {
      res.writeHead(404).end();
      return;
    }
    res.writeHead(200, { "content-type": TYPES[(0, import_node_path41.extname)(file).toLowerCase()] ?? "application/octet-stream", "cache-control": "no-store" });
    res.end((0, import_node_fs36.readFileSync)(file));
  });
  return new Promise((ok, fail) => {
    server.once("error", fail);
    server.listen(0, "127.0.0.1", () => {
      const a = server.address();
      ok({ server, base: `http://127.0.0.1:${typeof a === "object" && a ? a.port : 0}` });
    });
  });
}
var Cdp = class _Cdp {
  constructor(ws) {
    this.ws = ws;
    ws.addEventListener("message", (ev) => {
      const m = JSON.parse(String(ev.data));
      if (m.id && this.waiting.has(m.id)) {
        const w = this.waiting.get(m.id);
        this.waiting.delete(m.id);
        if (m.error) w.fail(new Error(`${m.error.message}`));
        else w.ok(m.result);
      } else for (const l of this.listeners) l(m);
    });
  }
  id = 0;
  waiting = /* @__PURE__ */ new Map();
  listeners = [];
  static async connect(url) {
    if (typeof WebSocket === "undefined") throw new Error("this Node has no built-in WebSocket; mock shots need Node 22 or later");
    const ws = new WebSocket(url);
    await new Promise((ok, fail) => {
      ws.addEventListener("open", () => ok());
      ws.addEventListener("error", () => fail(new Error(`cannot connect to ${url}`)));
    });
    return new _Cdp(ws);
  }
  send(method, params2 = {}, sessionId) {
    const id = ++this.id;
    this.ws.send(JSON.stringify({ id, method, params: params2, ...sessionId ? { sessionId } : {} }));
    return new Promise((ok, fail) => this.waiting.set(id, { ok, fail }));
  }
  once(method, sessionId, timeoutMs) {
    return new Promise((ok) => {
      const t = setTimeout(done, timeoutMs);
      const self = this;
      function done() {
        clearTimeout(t);
        self.listeners = self.listeners.filter((l) => l !== listen);
        ok();
      }
      function listen(m) {
        if (m.method === method && m.sessionId === sessionId) done();
      }
      this.listeners.push(listen);
    });
  }
  close() {
    this.ws.close();
  }
};
async function runShotsWorker(req) {
  const shots = planShots(req.dir);
  const result = { written: [], errors: [] };
  const version = await fetch(`${req.cdp}/json/version`).then((r) => r.json());
  const cdp = await Cdp.connect(version.webSocketDebuggerUrl);
  const { server, base: base2 } = await serveFolder(req.dir);
  (0, import_node_fs36.mkdirSync)((0, import_node_path41.join)(req.dir, "shots"), { recursive: true });
  try {
    for (const shot of shots) {
      let targetId;
      try {
        ({ targetId } = await cdp.send("Target.createTarget", { url: "about:blank" }));
        const { sessionId } = await cdp.send("Target.attachToTarget", { targetId, flatten: true });
        const { width, height, mobile } = shot.viewport;
        await cdp.send("Page.enable", {}, sessionId);
        await cdp.send("Emulation.setDeviceMetricsOverride", { width, height, deviceScaleFactor: 1, mobile }, sessionId);
        await cdp.send("Emulation.setEmulatedMedia", { features: [{ name: "prefers-color-scheme", value: shot.theme }] }, sessionId);
        const loaded = cdp.once("Page.loadEventFired", sessionId, 15e3);
        await cdp.send("Page.navigate", { url: `${base2}/${encodeURIComponent(shot.page)}` }, sessionId);
        await loaded;
        await cdp.send("Runtime.evaluate", { expression: "document.fonts.ready.then(() => new Promise(r => setTimeout(r, 300)))", awaitPromise: true }, sessionId);
        const params2 = { format: "png" };
        if (req.full) {
          const m = await cdp.send("Page.getLayoutMetrics", {}, sessionId);
          const h = Math.ceil(m.cssContentSize?.height ?? m.contentSize.height);
          params2.captureBeyondViewport = true;
          params2.clip = { x: 0, y: 0, width, height: Math.max(height, Math.min(h, 12e3)), scale: 1 };
        }
        const { data } = await cdp.send("Page.captureScreenshot", params2, sessionId);
        (0, import_node_fs36.writeFileSync)((0, import_node_path41.join)(req.dir, shot.file), Buffer.from(data, "base64"));
        result.written.push(shot.file);
      } catch (e) {
        result.errors.push(`${shot.file}: ${e.message}`);
      } finally {
        if (targetId) await cdp.send("Target.closeTarget", { targetId }).catch(() => {
        });
      }
    }
  } finally {
    cdp.close();
    server.close();
  }
  return result;
}

// src/evals.ts
var import_node_fs37 = require("node:fs");
var import_node_path42 = require("node:path");
function loadEvalCases(root, id) {
  const d = new Diags();
  const dir = (0, import_node_path42.join)(roleDir(root, id), "evals");
  const cases = [];
  if (!(0, import_node_fs37.existsSync)(dir)) return { cases, diags: d };
  for (const f of (0, import_node_fs37.readdirSync)(dir).filter((n) => n.endsWith(".md")).sort()) {
    const file = `roles/${id}/evals/${f}`;
    const text2 = (0, import_node_fs37.readFileSync)((0, import_node_path42.join)(dir, f), "utf8");
    const head = /^---\ncase: ([a-z0-9-]+)\n---\n/.exec(text2);
    if (!head) {
      d.error(file, "a case starts with a front matter `case: <name>` (kebab-case)");
      continue;
    }
    if (head[1] !== f.slice(0, -3)) d.error(file, `case "${head[1]}" must equal the file name "${f.slice(0, -3)}"`);
    const section2 = (name) => {
      const m = new RegExp(`^## ${name}\\n([\\s\\S]*?)(?=^## |$(?![\\s\\S]))`, "m").exec(text2);
      return m ? m[1].trim() : null;
    };
    const input = section2("Input");
    const criteria = section2("Criteria");
    if (!input) d.error(file, 'missing or empty "## Input" (the situation the Agent is given)');
    if (criteria === null) d.error(file, 'missing "## Criteria"');
    const bullets = (criteria ?? "").split("\n").map((l) => l.trim()).filter(Boolean);
    const bad = bullets.filter((l) => !/^- must( not)? \S/.test(l));
    for (const l of bad) d.error(file, `criterion "${l.slice(0, 50)}" must be a bullet starting "- must" or "- must not"`);
    if (criteria !== null && !bullets.length) d.error(file, '"## Criteria" has no bullets');
    cases.push({ name: head[1], file, input: input ?? "", criteria: bullets.filter((l) => /^- must( not)? \S/.test(l)).map((l) => l.slice(2)) });
  }
  return { cases, diags: d };
}
function checkEvals(root) {
  const d = new Diags();
  if (!(0, import_node_fs37.existsSync)((0, import_node_path42.join)(root, "roster.yaml"))) return d;
  const roster = loadRoster(root);
  for (const [id, e] of Object.entries(roster.roles)) {
    if (!(0, import_node_fs37.existsSync)((0, import_node_path42.join)(roleDir(root, id), "role.md"))) continue;
    const r = loadEvalCases(root, id);
    d.add(r.diags);
    if (e?.status === "active" && r.cases.length === 0) d.error(`roles/${id}/evals`, "an active Role ships at least one eval case (roles/<id>/evals/<case>.md)");
  }
  return d;
}

