  const env = git(p.project, ["diff", `${base2}...${head}`, "--", ".env.example"]);
  const newVars = env.ok ? [...env.out.matchAll(/^\+([A-Z][A-Z0-9_]*)=/gm)].map((m) => m[1]) : [];
  if (newVars.length) out.push(`New environment variables to set before deploy: ${newVars.join(", ")}.`);
  const handoff = readText((0, import_node_path46.join)(loadAny(p, id).dir, "delivery", "handoff.md"));
  const section2 = handoff ? sections(handoff).find((s) => /^merge danger$/i.test(s.name)) : void 0;
