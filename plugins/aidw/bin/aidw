// src/policy.ts
var CMD = String.raw`(?:^|[;&|(]\s*|\b(?:sudo|xargs|exec|env)\s+)`;
var cmd = (body, flags = "") => new RegExp(`${CMD}(?:${body})`, flags);
var SECRET_PATHS = [
  { re: /(^|[\s"'=:/])~?\/?(?:[^\s"']*\/)?\.ssh(\/|\b)/, why: "SSH keys" },
  { re: /(^|[\s"'=:/])~?\/?(?:[^\s"']*\/)?\.aws(\/|\b)/, why: "AWS credentials" },
  { re: /(^|[\s"'=:/])~?\/?(?:[^\s"']*\/)?\.gnupg(\/|\b)/, why: "GPG keys" },
  { re: /(^|[\s"'=:/])~?\/?(?:[^\s"']*\/)?\.kube\/config\b/, why: "Kubernetes credentials" },
  { re: /(^|[\s"'=:/])~?\/?(?:[^\s"']*\/)?\.config\/gcloud(\/|\b)/, why: "Google Cloud credentials" },
  { re: /(^|[\s"'=:/])~?\/?(?:[^\s"']*\/)?\.docker\/config\.json\b/, why: "Docker registry credentials" },
  { re: /\bid_(rsa|ed25519|ecdsa)\b/, why: "private keys" }
];
var FORBIDDEN_COMMANDS = [
  { re: /\bsecurity\s+(find|dump)-(generic|internet)-password\b|\bsecurity\s+dump-keychain\b/, why: "reads the macOS keychain" },
  { re: /\brm\s+-[a-z]*r[a-z]*f?[a-z]*\s+(\/|~|\$HOME)(\s|$)/i, why: "deletes the home or root directory" }
];
var ASK_COMMANDS = [
  { re: /\bgit\s+push\b/, why: "pushes to a remote repository" },
  { re: cmd(String.raw`(?:npx\s+)?vercel\b[^|;&]*(?:--prod\b|\bpromote\b|\bdomains?\b|\balias\b)`), why: "changes Vercel production or domains" },
  {
    re: cmd(String.raw`(?:npx\s+)?vercel(?:\s+deploy)?(?:\s+--?[\w-]+(?:=\S+)?)*\s*(?:$|[;&|])`),
    why: "creates a Vercel deployment (tier 2: needs the approved allowlist)"
  },
  { re: /\bnetlify\s+deploy\b[^|;&]*--prod\b/, why: "deploys Netlify production" },
  { re: /\b(railway\s+up|fly\s+deploy|flyctl\s+deploy)\b/, why: "deploys to a hosting provider" },
  { re: /\bsupabase\s+(db\s+push|db\s+reset\s+[^|;&]*--linked|projects\s+(create|delete)|link)\b/, why: "changes a remote Supabase project" },
  { re: /\b(npm|pnpm|yarn)\s+publish\b/, why: "publishes a package" },
  { re: /\b(terraform\s+(apply|destroy)|pulumi\s+(up|destroy)|kubectl\s+(apply|delete)|docker\s+push)\b/, why: "changes infrastructure" },
  { re: /\bgh\s+(repo\s+(create|delete)|pr\s+merge|release\s+create)\b/, why: "changes GitHub state" },
  { re: /\bstripe\b[^|;&]*--live\b|\bsk_live_/, why: "uses live payment credentials" },
  { re: /\bdrop\s+(database|schema)\b/i, why: "drops a database" }
];
var WRITE_COMMANDS = [
  { re: /(^|[^0-9&<>=-])>{1,2}\s*(?!&|\/dev\/null\b)[^\s&|;]/, why: "redirects output into a file" },
  { re: cmd(String.raw`tee\b`), why: "writes files with tee" },
  { re: /\|\s*tee\b/, why: "writes files with tee" },
  { re: cmd(String.raw`sed\s+(?:-[a-zA-Z]*i|--in-place)`), why: "edits files in place" },
  { re: cmd(String.raw`(?:cp|mv|touch|mkdir|rm|rmdir|ln|chmod|install|rsync|unzip|tar\s+-?[a-z]*x)\b`), why: "modifies the filesystem" },
  { re: cmd(String.raw`(?:npm|pnpm|yarn|bun)\s+(?:i|install|add|create|init|dlx)\b|npx\s+(?:create-|degit|shadcn)`), why: "installs or scaffolds packages" },
  { re: cmd(String.raw`git\s+(?:clone|checkout\s+-b|switch\s+-c|apply|am|stash\s+pop|reset\s+--hard)\b`), why: "changes the working tree" }
];
function firstMatch(rules, text) {
  return rules.find((r) => r.re.test(text));
}
var APPROVE_COMMAND = /(^|[\s;&|(])(?:[^\s;&|]*\/)?aidw\s+approve\b/;
var AIDW_COMMAND = /^\s*(?:[^\s;&|]*\/)?aidw\s/;

// src/gate.ts
var OPEN_STATES = /* @__PURE__ */ new Set(["approved", "executing", "verifying", "converging", "deploying"]);
var FROZEN_STATES = new Set([...POST_APPROVAL].filter((s) => s !== "escalated"));
function gateState(p) {
  const st = { open: false, drift: [], frozen: [], summary: "" };
  const parts = [];
  for (const id of listChangeIds(p)) {
    let state = null;
    try {
      const c = loadChange(p, id);
      state = stateOf(c);
      if (state && POST_APPROVAL.has(state)) {
        const a = approvalStatus(p, c).status;
        if (a === "drift") st.drift.push(id);
        if (a === "valid" && OPEN_STATES.has(state)) st.open = true;
        if (FROZEN_STATES.has(state)) st.frozen.push(id);
      }
    } catch {
    }
    parts.push(`${id}=${state ?? "?"}`);
  }
  st.summary = parts.length ? parts.join(", ") : "no changes";
  return st;
}
function inside(parent, child) {
  const r = (0, import_node_path6.relative)(parent, child);
  return r === "" || r !== ".." && !r.startsWith(`..${import_node_path6.sep}`) && !(0, import_node_path6.isAbsolute)(r);
}
function isFrozenPackageFile(p, file, frozen) {
  if (inside(p.design, file) || file === p.constitution) return frozen.length > 0;
  for (const id of frozen) {
    const dir = (0, import_node_path6.join)(p.changes, id);
    if (!inside(dir, file)) continue;
    const r = (0, import_node_path6.relative)(dir, file).split(import_node_path6.sep).join("/");
    if (r === "intake.md" || r === "analysis.md" || r === "design.md" || r.startsWith("specs/")) return true;
  }
  return false;
}
var deny = (reason) => ({ decision: "deny", reason: `AIDW: ${reason}` });
var ask = (reason) => ({ decision: "ask", reason: `AIDW: ${reason}` });
var allow = (reason) => ({ decision: "allow", reason: `AIDW: ${reason}` });
function closedReason(st) {
  if (st.drift.length) {
    return `approval drift in ${st.drift.join(", ")}: the approved Analysis package changed. Escalate and re-approve before writing project files.`;
  }
  return `Analysis is not approved yet (${st.summary}). Only .aidw/ may be written before approval.`;
}
function decide(input, env) {
  const cwd = input.cwd ?? process.cwd();
  const project = findProject({ cwd, env });
  if (!project) return null;
  const p = pathsFor(project);
  const tool = input.tool_name ?? "";
  const ti = input.tool_input ?? {};
  if (tool === "Read") {
    const file = String(ti.file_path ?? "");
    const secret = firstMatch(SECRET_PATHS, file);
    return secret && !inside(project, (0, import_node_path6.resolve)(cwd, file)) ? deny(`reading ${secret.why} is forbidden (tier x)`) : null;
  }
  if (tool === "Write" || tool === "Edit" || tool === "MultiEdit" || tool === "NotebookEdit") {
    const raw = String(ti.file_path ?? ti.notebook_path ?? "");
    if (!raw) return null;
    const file = (0, import_node_path6.resolve)(cwd, raw);
    const secret = firstMatch(SECRET_PATHS, file);
    if (secret && !inside(project, file)) return deny(`writing ${secret.why} is forbidden (tier x)`);
    if (!inside(project, file)) return null;
    const st = gateState(p);
    if (inside(p.aidw, file)) {
      if (isFrozenPackageFile(p, file, st.frozen)) {
        return deny(
          "the approved Analysis package is frozen during execution. To change scope, transition the change to escalated and back to analyzing, then re-approve."
        );
      }
      return allow("aidw state directory");
    }
    return st.open ? allow("analysis approved") : deny(closedReason(st));
  }
  if (tool === "Bash") {
    const cmd2 = String(ti.command ?? "");
    const forbidden = firstMatch(FORBIDDEN_COMMANDS, cmd2) ?? firstMatch(SECRET_PATHS, cmd2);
    if (forbidden) return deny(`command ${forbidden.why}; forbidden (tier x)`);
    if (APPROVE_COMMAND.test(cmd2)) {
      return ask("approving the Analysis package is the user's decision. Approve only if you (the user) reviewed analysis.md.");
    }
    const risky = firstMatch(ASK_COMMANDS, cmd2);
    if (risky) return ask(`this command ${risky.why}; it needs your confirmation (tier 2/3)`);
    if (AIDW_COMMAND.test(cmd2)) return null;
    const writes = firstMatch(WRITE_COMMANDS, cmd2);
    if (writes) {
      const st = gateState(p);
      if (!st.open) return deny(`this command ${writes.why}. ${closedReason(st)} Use the Write tool for files in ${AIDW_DIR}/.`);
    }
    return null;
  }
  return null;
}
function toHookOutput(d) {
  if (!d) return "";
  return JSON.stringify({
    hookSpecificOutput: { hookEventName: "PreToolUse", permissionDecision: d.decision, permissionDecisionReason: d.reason }
  });
}
function runGate(stdin, env) {
  let input;
  try {
    input = JSON.parse(stdin);
  } catch {
    return "";
  }
  try {
    return toHookOutput(decide(input, env));
  } catch (e) {
    const project = findProject({ cwd: input.cwd ?? process.cwd(), env });
    return project ? toHookOutput(deny(`gate error, failing closed: ${e.message}`)) : "";
  }
}

// src/backstop.ts
function gitDirtyPaths(project) {
  try {
    const out = (0, import_node_child_process.execFileSync)("git", ["status", "--porcelain=v1", "-z", "--untracked-files=all"], {
      cwd: project,
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"]
    });
    const paths = [];
    const entries = out.split("\0").filter(Boolean);
    for (let i = 0; i < entries.length; i++) {
      const e = entries[i];
      const status = e.slice(0, 2);
      paths.push(e.slice(3));
      if (status.startsWith("R") || status.startsWith("C")) i++;
    }
    return paths;
  } catch {
    return null;
  }
}
var baselineFile = (p) => (0, import_node_path7.join)(p.run, "baseline.json");
function recordBaseline(p, dirty = gitDirtyPaths(p.project)) {
  if (dirty === null) return;
  (0, import_node_fs6.mkdirSync)(p.run, { recursive: true });
  const previous = readBaseline(p);
  const merged = [.../* @__PURE__ */ new Set([...previous, ...dirty.filter((f) => !isAidw(f))])].sort();
  (0, import_node_fs6.writeFileSync)(baselineFile(p), `${JSON.stringify({ paths: merged }, null, 2)}
`);
}
function readBaseline(p) {
  const f = baselineFile(p);
  if (!(0, import_node_fs6.existsSync)(f)) return [];
  try {
    const data = JSON.parse((0, import_node_fs6.readFileSync)(f, "utf8"));
    return Array.isArray(data.paths) ? data.paths.map(String) : [];
  } catch {
    return [];
  }
}
var isAidw = (f) => f === AIDW_DIR || f.startsWith(`${AIDW_DIR}/`);
function unexpectedChanges(dirty, baseline) {
  const base = new Set(baseline);
  return dirty.filter((f) => !isAidw(f) && !base.has(f)).sort();
}
function runBackstop(stdin, env, dirtyProvider = gitDirtyPaths) {
  let input = {};
  try {
    input = JSON.parse(stdin || "{}");
  } catch {
    return "";
  }
  const project = findProject({ cwd: input.cwd ?? process.cwd(), env });
  if (!project) return "";
  const p = pathsFor(project);
  if (gateState(p).open) return "";
  const dirty = dirtyProvider(project);
  if (!dirty) return "";
  const unexpected = unexpectedChanges(dirty, readBaseline(p));
  if (!unexpected.length) return "";
  const list = unexpected.slice(0, 20).map((f) => `  - ${f}`).join("\n");
  const more = unexpected.length > 20 ? `
  ... and ${unexpected.length - 20} more` : "";
  const reason = `AIDW backstop: the Analysis is not approved, yet these files outside ${AIDW_DIR}/ changed since the change was created:
${list}${more}
Do not delete or revert anything yourself: some of these may be the user's own edits. Tell the user which of these you created or modified in this session and ask how to proceed. Until approval, write only inside .aidw/.`;
  if (input.stop_hook_active) {
    return JSON.stringify({ systemMessage: reason });
  }
  return JSON.stringify({ decision: "block", reason });
}

