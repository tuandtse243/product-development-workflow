}
function indexOf(tf, taskId) {
  const i = tf.tasks.findIndex((t) => t.id === taskId);
  if (i < 0) throw new OpError(`task "${taskId}" not found in ${tf.change.id}/tasks.yaml`);
  return i;
}
function setField(tf, i, key, value) {
  if (value === void 0 || value === null) tf.doc.deleteIn(["tasks", i, key]);
  else tf.doc.setIn(["tasks", i, key], value);
}
var statusOf2 = (t) => String(t.status ?? "pending");
var attemptsOf = (t) => Number.isInteger(t.attempts) ? Number(t.attempts) : 0;
var maxAttemptsOf = (t) => (Number.isInteger(t.max_attempts) ? Number(t.max_attempts) : DEFAULT_MAX_ATTEMPTS) + (typeof t.triage === "object" && t.triage !== null && t.triage.cause === "implementation" ? 1 : 0);
function requireExecuting(p, change) {
  const state = stateOf(change);
  if (state !== "executing") {
    const hint = state === "approved" ? `run \`aidw transition ${change.id} executing\` first` : state === "paused" ? `run \`aidw transition ${change.id} resume\` first` : "tasks run only in state executing";
    throw new OpError(`change "${change.id}" is "${String(change.data.state)}": ${hint}`);
  }
  if (approvalStatus(p, change).status !== "valid") {
    throw new OpError(`approval drift in "${change.id}": escalate and re-approve before running tasks`);
  }
}
function nextAction(p, id) {
  const tf = loadTasks(p, id);
  requireExecuting(p, tf.change);
  const byId = new Map(tf.tasks.map((t) => [t.id, t]));
  const title = (t) => String(t.title ?? "");
  for (const t of tf.tasks) if (statusOf2(t) === "review") return { action: "review", task: t.id, title: title(t) };
  for (const t of tf.tasks) if (statusOf2(t) === "running") return { action: "implement", task: t.id, title: title(t), reason: "interrupted" };
  for (const t of tf.tasks) {
    if (statusOf2(t) === "escalated") return { action: "escalate", task: t.id, reason: `task ${t.id} is escalated: ${String(t.notes ?? "needs the user")}` };
  }
  for (const t of tf.tasks) {
    if (statusOf2(t) !== "failed") continue;
    if (attemptsOf(t) >= maxAttemptsOf(t)) {
      if (t.triage === void 0) return { action: "triage", task: t.id, title: title(t), reason: `task ${t.id} used ${attemptsOf(t)} of ${maxAttemptsOf(t)} attempts: ${String(t.notes ?? "")}` };
      return { action: "escalate", task: t.id, reason: `task ${t.id} failed ${attemptsOf(t)} of ${maxAttemptsOf(t)} attempts: ${String(t.notes ?? "")}` };
    }
    return { action: "implement", task: t.id, title: title(t), reason: "retry" };
  }
  const merged = pendingIntegration(tf.change, tf.tasks);
  if (merged.length) {
    const fix = tf.tasks.find((t) => t.origin === "integration" && statusOf2(t) === "pending");
    if (fix) return { action: "implement", task: fix.id, title: title(fix), reason: "new" };
    return { action: "integrate", tasks: merged.map((t) => t.id) };
  }
  const wave = planWave(tf.tasks, parallelConfig(p, tf.change).max);
  if (wave.length >= 2) return { action: "wave", tasks: wave.map((t) => ({ task: t.id, title: title(t) })) };
  if (wave[0]) return { action: "implement", task: wave[0].id, title: title(wave[0]), reason: "new" };
  const open = tf.tasks.filter((t) => statusOf2(t) !== "done");
  if (open.length === 0) return { action: "complete", done: tf.tasks.length };
  const waiting = open.map((t) => `${t.id} (${statusOf2(t)}${list3(t.depends_on).length ? `, needs ${list3(t.depends_on).join(", ")}` : ""})`);
  return { action: "escalate", reason: `no runnable task: ${waiting.join("; ")}` };
}
function startTask(p, id, taskId, opts = {}) {
  const tf = loadTasks(p, id);
  requireExecuting(p, tf.change);
  const i = indexOf(tf, taskId);
  const t = tf.tasks[i];
  const status = statusOf2(t);
  const byId = new Map(tf.tasks.map((x) => [x.id, x]));
  if (status === "pending") {
    const missing = list3(t.depends_on).filter((d) => statusOf2(byId.get(d) ?? { id: d }) !== "done");
    if (missing.length) throw new OpError(`task ${taskId} depends on unfinished task(s): ${missing.join(", ")}`);
  } else if (status !== "failed" && status !== "running") {
    throw new OpError(`task ${taskId} is "${status}"; only pending, failed or interrupted (running) tasks can start`);
  }
  const resumed = status === "running";
  const attempt = resumed ? Math.max(attemptsOf(t), 1) : attemptsOf(t) + 1;
  const max = maxAttemptsOf(t);
  if (attempt > max) {
    setField(tf, i, "status", "escalated");
    setField(tf, i, "notes", `attempts exhausted (${max}); last: ${String(t.notes ?? "unknown")}`);
    saveTasks(tf);
    throw new OpError(`task ${taskId} used all ${max} attempts; it is now escalated`);
  }
  const base = typeof t.base === "string" ? t.base : status === "pending" ? headCommit(p.project) : null;
  let worktree = typeof t.worktree === "string" ? t.worktree : void 0;
  if (opts.worktree && status === "pending" || worktree) {
    if (!base) throw new OpError(`task ${taskId} cannot run in a worktree: the project has no commit yet`);
    if (t.sequential === true && !worktree) throw new OpError(`task ${taskId} is marked sequential; start it without --worktree`);
    const wt = ensureWorktree(p, id, taskId, base);
    if (wt.created) {
      const setup = parallelConfig(p, tf.change).setup;
      const runner = opts.runner ?? shellRunner;
      for (const command of setup) {
        const r = runner(command, (0, import_node_path17.join)(p.project, wt.dir), 15 * 60 * 1e3);
        if (r.exit !== 0) {
          removeWorktree(p, wt.dir, wt.branch);
          setField(tf, i, "sequential", true);
          saveTasks(tf);
          throw new OpError(`worktree setup \`${command}\` failed for ${taskId} (exit ${r.exit}); ${taskId} is marked sequential and runs later on the main checkout:
${r.tail}`);
        }
      }
    }
    worktree = wt.dir;
    setField(tf, i, "worktree", wt.dir);
    setField(tf, i, "branch", wt.branch);
  }
  setField(tf, i, "status", "running");
  setField(tf, i, "attempts", attempt);
  if (!t.started_at) setField(tf, i, "started_at", now2());
  if (base) setField(tf, i, "base", base);
  saveTasks(tf);
  return { task: taskId, ...typeof t.role === "string" ? { role: t.role } : {}, attempt, maxAttempts: max, base, resumed, ...worktree ? { worktree } : {} };
}
function retryTask(p, id, taskId) {
  const tf = loadTasks(p, id);
  requireExecuting(p, tf.change);
  const i = indexOf(tf, taskId);
  const t = tf.tasks[i];
  if (statusOf2(t) !== "escalated" && statusOf2(t) !== "failed") {
    throw new OpError(`task ${taskId} is "${statusOf2(t)}"; only escalated or failed tasks can be retried`);
  }
  setField(tf, i, "status", "failed");
  setField(tf, i, "attempts", 0);
  setField(tf, i, "notes", `retry granted by the user; before: ${String(t.notes ?? "")}`.slice(0, 500));
  saveTasks(tf);
  return { task: taskId };
}
var SKIP_DIRS = /* @__PURE__ */ new Set(["node_modules", ".git", ".aidw", ".next", ".nuxt", ".svelte-kit", ".turbo", ".vercel", "dist", "build", "out", "coverage", "playwright-report", "test-results"]);
var TEST_FILE = /(^|\/)(__tests__|tests?|e2e|specs?)\/|\.(test|spec|e2e)\.[a-z0-9]+$/i;
var MAX_TEST_FILE = 1024 * 1024;
function walkProject(dir, root, out) {
  let names;
  try {
    names = (0, import_node_fs15.readdirSync)(dir);
  } catch {
    return;
  }
  for (const name of names.sort()) {
    if (SKIP_DIRS.has(name)) continue;
    const full = (0, import_node_path17.join)(dir, name);
    let st;
    try {
      st = (0, import_node_fs15.statSync)(full);
    } catch {
      continue;
    }
    if (st.isDirectory()) walkProject(full, root, out);
    else if (st.size <= MAX_TEST_FILE) out.push((0, import_node_path17.relative)(root, full).split(import_node_path17.sep).join("/"));
  }
}
function testFiles(project) {
  const all2 = [];
  walkProject(project, project, all2);
  return all2.filter((f) => TEST_FILE.test(f));
}
var SKIPPED_LINE = /\.(skip|todo|fixme)\s*\(|\b(xit|xtest|xdescribe)\s*\(/;
function findScenarioTests(project, ids) {
  const found = Object.fromEntries(ids.map((s) => [s, []]));
  if (!ids.length) return found;
  const patterns = ids.map((s) => [s, new RegExp(`(^|[^a-z0-9/-])${s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}(?![a-z0-9/-])`)]);
  for (const f of testFiles(project)) {
    const lines = (0, import_node_fs15.readFileSync)((0, import_node_path17.join)(project, f), "utf8").split(/\r?\n/);
    lines.forEach((line, n) => {
      if (SKIPPED_LINE.test(line)) return;
      for (const [s, re] of patterns) if (re.test(line)) found[s]?.push(`${f}:${n + 1}`);
    });
  }
  return found;
}
function designEvidence(p, id, t, changed, since) {
  if (!touchesUi(t)) return null;
  const { tokens, exists, diags } = loadTokens(p);
  if (!exists || diags.errors.length > 0 || tokens.length === 0) return null;
  const dir = taskDir(p, t);
  return {
    missing_tokens: missingTokens(dir, tokens),
    hardcoded_colors: hardcodedColors(dir, changed ?? [], tokens),
    screenshots: taskShots(p, id, t.id, since)
  };
}
var evidenceRel = (taskId) => `evidence/${taskId}.json`;
function readEvidence(change, t) {
