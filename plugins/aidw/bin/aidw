    if ((0, import_node_fs7.existsSync)(candidate) && (0, import_node_fs7.statSync)(candidate).isFile()) return { file: candidate };
  }
  let depth = parts.length - 1;
  while (depth > 0 && !(0, import_node_fs7.existsSync)((0, import_node_path9.join)(root, ...parts.slice(0, depth)))) depth--;
  const dir = (0, import_node_path9.join)(root, ...parts.slice(0, depth));
  const wanted = (parts[depth] ?? "").replace(/\.md$/, "").toLowerCase();
  const names2 = (0, import_node_fs7.existsSync)(dir) && (0, import_node_fs7.statSync)(dir).isDirectory() ? (0, import_node_fs7.readdirSync)(dir).filter((n) => !n.startsWith(".")) : [];
  const score = (n) => {
    const s = n.replace(/\.md$/, "").toLowerCase();
    return s === wanted ? 0 : s.includes(wanted) || wanted.includes(s) ? 1 : distance(s, wanted);
  };
  const suggestions = names2.map((n) => ({ n, d: score(n) })).filter((x) => x.d <= Math.max(3, Math.floor(wanted.length / 3))).sort((a, b) => a.d - b.d || a.n.localeCompare(b.n)).slice(0, 3).map((x) => [...parts.slice(0, depth), x.n].join("/"));
  return { tried: base2, suggestions };
}
function distance(a, b) {
  const row = Array.from({ length: b.length + 1 }, (_, j) => j);
  for (let i = 1; i <= a.length; i++) {
    let prev = row[0];
    row[0] = i;
    for (let j = 1; j <= b.length; j++) {
      const keep = row[j];
      row[j] = Math.min(row[j] + 1, row[j - 1] + 1, prev + (a[i - 1] === b[j - 1] ? 0 : 1));
      prev = keep;
    }
  }
  return row[b.length];
}

// src/machine.ts
var isRecord2 = (v) => !!v && typeof v === "object" && !Array.isArray(v);
function parseTransitions(raw) {
  if (!isRecord2(raw) || Object.keys(raw).length === 0) return null;
  const out = {};
  for (const [from, to] of Object.entries(raw)) {
    if (!isState(from) || !Array.isArray(to) || !to.every(isState)) return null;
    out[from] = to;
  }
  return out;
}
var stateList = (v) => Array.isArray(v) && v.every(isState) ? v : null;
function parseMachine(workflow, data) {
  if (!isRecord2(data)) return null;
  const transitions = parseTransitions(data.transitions);
  const approval = stateList(data.approval_required);
  const analysis = stateList(data.analysis_required);
  return transitions && approval && analysis ? { workflow, transitions, approvalRequired: new Set(approval), analysisRequired: new Set(analysis) } : null;
}
var cache = /* @__PURE__ */ new Map();
function machineById(workflow) {
  const hit = cache.get(workflow);
  if (hit) return hit;
  const root = bundledRoot();
  const file = root && /^[a-z][a-z0-9-]*$/.test(workflow) ? (0, import_node_path10.join)(root, "workflows", `${workflow}.yaml`) : "";
  if (!file || !(0, import_node_fs8.existsSync)(file)) return null;
  let data;
  try {
    data = import_yaml5.default.parse((0, import_node_fs8.readFileSync)(file, "utf8"));
  } catch {
    return null;
  }
  const m = parseMachine(workflow, data);
  if (m) cache.set(workflow, m);
  return m;
}
var defaultWorkflowId = (p) => projectKind(p) === "brownfield" ? "feature" : "product";
function workflowIdOf(p, change) {
  const named = change.data.workflow;
  if (typeof named === "string" && named) return named;
  return defaultWorkflowId(p);
}
function machineOf(p, change) {
  const id = workflowIdOf(p, change);
  const m = machineById(id);
  if (!m) throw new OpError(`the workflow "${id}" of change "${change.id}" has no valid state machine (workflows/${id}.yaml: transitions, approval_required, analysis_required)`);
  return m;
}
var statesOf = (m) => STATES.filter((s) => s in m.transitions);

// src/spec/merge.ts
function titleFromCapability(capability) {
  const last = capability.split("/").filter(Boolean).pop() ?? capability;
  return last.split("-").filter(Boolean).map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
}
function renameRaw(raw, to) {
  const nl = raw.indexOf("\n");
  const rest = nl < 0 ? "" : raw.slice(nl);
  return `### Requirement: ${to}${rest}`;
}
function render(prefix, blocks, suffix) {
  const parts = [prefix.replace(/\s+$/, "")];
  if (blocks.length) parts.push(blocks.join("\n\n"));
  if (suffix) parts.push(suffix);
  return `${parts.join("\n\n")}
`;
}
function conflictErrors(d) {
  const errors = [];
  const dupes = (label2, keys) => {
    const seen = /* @__PURE__ */ new Set();
    for (const k of keys) {
      if (seen.has(k)) errors.push(`${label2} lists "${k}" more than once`);
      seen.add(k);
    }
  };
  const added = d.added.map((b) => b.key);
  const modified = d.modified.map((b) => b.key);
  const removed = d.removed.map((b) => b.key);
  const renFrom = d.renamed.map((r) => r.from);
  const renTo = d.renamed.map((r) => r.to);
  dupes("ADDED", added);
  dupes("MODIFIED", modified);
  dupes("REMOVED", removed);
  dupes("RENAMED FROM", renFrom);
  dupes("RENAMED TO", renTo);
  const both = (a, b, msg) => {
    for (const k of a) if (b.includes(k)) errors.push(msg.replace("%s", k));
  };
  both(added, [...modified, ...removed, ...renFrom], 'requirement "%s" is ADDED and also modified, removed or renamed');
  both(modified, removed, 'requirement "%s" is both MODIFIED and REMOVED');
  both(modified, renFrom, 'MODIFIED "%s" uses the old name of a RENAMED requirement; use the new name');
  both(removed, renTo, 'requirement "%s" is renamed and then REMOVED');
  return errors;
}
function applyDelta(mainText, deltaText, capability) {
  const delta = parseDelta(deltaText);
  const summary = { added: [], modified: [], removed: [], renamed: [] };
  const errors = [...delta.issues.filter((i) => i.level === "error").map((i) => `line ${i.line}: ${i.message}`)];
  errors.push(...conflictErrors(delta));
  const created = mainText === null;
  const main = mainText === null ? null : parseSpec(mainText);
  if (created && (delta.modified.length || delta.removed.length || delta.renamed.length)) {
    errors.push(`capability "${capability}" has no main spec yet; only ADDED requirements are allowed`);
  }
  const reqs = (main?.requirements ?? []).map((r) => ({ key: r.key, raw: r.raw }));
  const indexOf2 = (key) => reqs.findIndex((r) => r.key === key);
  const caseHint = (key) => {
    const near = reqs.find((r) => r.key.toLowerCase() === key.toLowerCase());
    return near ? ` (did you mean "${near.key}"? header matching is exact)` : "";
  };
  for (const r of delta.renamed) {
    const i = indexOf2(r.from);
    if (i < 0) {
      errors.push(`RENAMED: requirement "${r.from}" not found${caseHint(r.from)}`);
      continue;
    }
    if (indexOf2(r.to) >= 0) {
      errors.push(`RENAMED: target name "${r.to}" already exists`);
      continue;
    }
    const cur = reqs[i];
    reqs[i] = { key: r.to, raw: renameRaw(cur.raw, r.to) };
    summary.renamed.push({ from: r.from, to: r.to });
  }
  for (const b of delta.removed) {
    const i = indexOf2(b.key);
    if (i < 0) {
      errors.push(`REMOVED: requirement "${b.key}" not found${caseHint(b.key)}`);
      continue;
    }
    reqs.splice(i, 1);
    summary.removed.push(b.key);
  }
  for (const b of delta.modified) {
    const i = indexOf2(b.key);
    if (i < 0) {
      errors.push(`MODIFIED: requirement "${b.key}" not found${caseHint(b.key)}`);
      continue;
    }
    reqs[i] = { key: b.key, raw: b.raw };
    summary.modified.push(b.key);
  }
  for (const b of delta.added) {
    if (indexOf2(b.key) >= 0) {
      errors.push(`ADDED: requirement "${b.key}" already exists; use MODIFIED`);
      continue;
    }
    reqs.push({ key: b.key, raw: b.raw });
    summary.added.push(b.key);
  }
  if (errors.length) return { ok: false, created, summary, errors };
  let prefix;
  let suffix = "";
  if (main) {
    prefix = main.prefix;
    suffix = main.suffix;
  } else {
    const purpose = delta.purpose?.trim() || "TBD - describe what this capability is for.";
    prefix = `# ${titleFromCapability(capability)}

## Purpose

${purpose}

## Requirements`;
  }
  return { ok: true, text: render(prefix, reqs.map((r) => r.raw), suffix), created, summary, errors };
}

// src/spec/validate.ts
var MAX_DESCRIPTION = 500;
var MIN_PURPOSE = 50;
function checkRequirement(r, file, d) {
  for (const i of r.issues) {
    if (i.level === "error") d.error(file, i.message, i.line);
    else d.warn(file, i.message, i.line);
  }
  if (!r.name) d.error(file, "Requirement heading has no name", r.line);
  if (!r.description) {
    d.warn(file, `Requirement "${r.name}" has no description before its first scenario`, r.line);
  } else {
    if (!/\b(SHALL|MUST)\b/.test(r.description)) {
      d.warn(file, `Requirement "${r.name}" should state its behavior with SHALL or MUST`, r.line);
    }
    if (r.description.length > MAX_DESCRIPTION) {
      d.warn(
        file,
        `Requirement "${r.name}" description is ${r.description.length} characters (max ${MAX_DESCRIPTION}); state one behavior per requirement`,
        r.line
      );
    }
  }
  if (r.scenarios.length === 0) {
    d.error(file, `Requirement "${r.name}" must have at least one "#### Scenario:"`, r.line);
  }
  const seen = /* @__PURE__ */ new Set();
  for (const s of r.scenarios) {
    if (seen.has(s.name)) d.error(file, `Requirement "${r.name}" has duplicate scenario "${s.name}"`, s.line);
    seen.add(s.name);
    if (!s.hasTrigger) d.warn(file, `Scenario "${s.name}" has no **WHEN** or **GIVEN** step`, s.line);
    if (!s.hasOutcome) d.warn(file, `Scenario "${s.name}" has no **THEN** step`, s.line);
  }
}
function validateSpecText(text2, file) {
  const d = new Diags();
  const spec = parseSpec(text2);
  if (!spec.title) d.error(file, 'Spec is missing a "# <Title>" heading');
  if (!spec.hasPurpose) d.warn(file, 'Spec is missing a "## Purpose" section');
  else if ((spec.purpose ?? "").length < MIN_PURPOSE || /^TBD\b/i.test(spec.purpose ?? "")) {
    d.warn(file, `Purpose is too brief or a placeholder (min ${MIN_PURPOSE} characters)`);
  }
  if (!spec.hasRequirementsSection) d.error(file, 'Spec is missing a "## Requirements" section');
  else if (spec.requirements.length === 0) d.warn(file, "Spec has no requirements");
  const seen = /* @__PURE__ */ new Map();
  for (const r of spec.requirements) {
    const prev = seen.get(r.key);
    if (prev !== void 0) d.error(file, `Duplicate requirement "${r.key}" (first at line ${prev})`, r.line);
    else seen.set(r.key, r.line);
    checkRequirement(r, file, d);
  }
  return d;
}
function validateDeltaText(text2, file, mainText, capability) {
  const d = new Diags();
  const delta = parseDelta(text2);
  const ops = delta.added.length + delta.modified.length + delta.removed.length + delta.renamed.length;
  if (ops === 0) {
    d.error(file, "Delta spec has no ADDED, MODIFIED, REMOVED or RENAMED requirements");
  }
  for (const s of delta.unknownSections) {
    d.warn(file, `Unknown section "## ${s.name}" is ignored by merge`, s.line);
  }
  for (const r of [...delta.added, ...delta.modified]) checkRequirement(r, file, d);
  for (const r of delta.removed) {
    if (!r.reason) d.error(file, `REMOVED requirement "${r.name}" needs a **Reason**`, r.line);
    if (!r.migration) d.error(file, `REMOVED requirement "${r.name}" needs a **Migration**`, r.line);
  }
  if (mainText === null) {
    if (!delta.purpose) d.warn(file, `New capability "${capability}" should start with a "## Purpose" section`);
    else if (delta.purpose.length < MIN_PURPOSE) {
      d.warn(file, `Purpose for new capability "${capability}" is too brief (min ${MIN_PURPOSE} characters)`);
    }
  } else if (delta.purpose) {
    d.warn(file, "## Purpose in a delta for an existing capability is ignored; edit the main spec instead");
  }
  const merge = applyDelta(mainText, text2, capability);
  for (const e of merge.errors) d.error(file, `merge: ${e}`);
  if (merge.ok && merge.text) {
    const merged = validateSpecText(merge.text, `${file} (merged result)`);
    for (const e of merged.errors) d.error(e.file, e.message);
  }
  return d;
}

