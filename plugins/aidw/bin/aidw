    if (!inside2(project, file)) return null;
    if (input.agent_type) {
      const name = input.agent_type.split(":").pop() ?? "";
      const same = (a, b) => a.toLowerCase() === b.toLowerCase();
      if (same((0, import_node_path19.basename)(file), PLAN_REVIEW_RECORD) && same((0, import_node_path19.dirname)((0, import_node_path19.dirname)(file)), p.changes)) {
        return deny("plan-review.yaml is the CLI's record of the plan review; only `aidw plan-review` writes it");
      }
      if (same((0, import_node_path19.basename)(file), CONSULT_RECORD2) && same((0, import_node_path19.dirname)((0, import_node_path19.dirname)(file)), p.changes)) {
        return deny("consultations.yaml is the CLI's record of Consultations; only `aidw consult` writes it");
      }
