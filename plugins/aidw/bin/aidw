var MOCK_VIEWPORTS = [
  { name: "desktop", width: 1440, height: 900, mobile: false },
  { name: "phone", width: 390, height: 844, mobile: true }
];
var MOCK_THEMES = ["light", "dark"];
function planShots(dir) {
  if (!(0, import_node_fs36.existsSync)(dir) || !(0, import_node_fs36.statSync)(dir).isDirectory()) throw new OpError(`mock shots: ${dir} is not a folder`);
  const pages = (0, import_node_fs36.readdirSync)(dir).filter((f) => f.endsWith(".html")).sort();
  if (!pages.length) throw new OpError(`mock shots: no .html file in ${dir}`);
  const shots = [];
  for (const page of pages) {
    for (const viewport of MOCK_VIEWPORTS) {
      for (const theme of MOCK_THEMES) {
        shots.push({ page, viewport, theme, file: (0, import_node_path41.join)("shots", `${page.replace(/\.html$/, "")}-${viewport.name}-${theme}.png`) });
      }
    }
  }
  return shots;
}
function takeShots(req, self, execPath = process.execPath) {
  const r = (0, import_node_child_process8.spawnSync)(execPath, [self, SHOTS_WORKER, JSON.stringify(req)], { encoding: "utf8", timeout: 18e4 });
  const line = (r.stdout ?? "").trim().split("\n").pop() ?? "";
  try {
    return JSON.parse(line);
  } catch {
    throw new OpError(`mock shots: the screenshot process failed${r.stderr ? `: ${r.stderr.trim().split("\n").slice(-3).join(" ")}` : ""}`);
  }
}
var SHOTS_WORKER = "__mock-shots-worker";
var TYPES = {
  ".html": "text/html; charset=utf-8",
  ".css": "text/css; charset=utf-8",
  ".js": "text/javascript; charset=utf-8",
  ".svg": "image/svg+xml",
