var UNIT = { ms: 1, s: 1e3, sec: 1e3, second: 1e3, seconds: 1e3, m: MINUTE, min: MINUTE, minute: MINUTE, minutes: MINUTE, h: 60 * MINUTE, hour: 60 * MINUTE, hours: 60 * MINUTE };
function waitMs(reason, attempt2, now9 = /* @__PURE__ */ new Date()) {
  const margin = MINUTE;
  const rel2 = /(?:retry[- ]after|try again in|again in|resets? in|wait)\D{0,4}(\d+(?:\.\d+)?)\s*(ms|s|sec|seconds?|m|min|minutes?|h|hours?)\b/i.exec(reason);
  if (rel2) {
    const unit = UNIT[rel2[2].toLowerCase()] ?? 1e3;
    return { ms: Math.round(Number(rel2[1]) * unit) + margin, why: `the error says ${rel2[0].trim()}` };
  }
  const epoch = /reset\w*\D{0,20}(1\d{9})\b/i.exec(reason);
  if (epoch) {
    const ms = Number(epoch[1]) * 1e3 - now9.getTime();
    if (ms > 0) return { ms: ms + margin, why: `the limit resets at ${new Date(Number(epoch[1]) * 1e3).toISOString()}` };
  }
  const clock = /resets?\s+(?:at\s+)?(\d{1,2})(?::(\d{2}))?\s*(am|pm)?\b/i.exec(reason);
  if (clock && (clock[2] !== void 0 || clock[3] !== void 0)) {
    let h = Number(clock[1]);
    const m = Number(clock[2] ?? 0);
    const ap = clock[3]?.toLowerCase();
    if (ap === "pm" && h < 12) h += 12;
    if (ap === "am" && h === 12) h = 0;
    if (h < 24 && m < 60) {
      const at = new Date(now9);
      at.setHours(h, m, 0, 0);
      if (at.getTime() <= now9.getTime()) at.setDate(at.getDate() + 1);
      return { ms: at.getTime() - now9.getTime() + margin, why: `the limit resets at ${at.toLocaleTimeString()}` };
    }
  }
  const minutes = BACKOFF_MINUTES[Math.min(attempt2, BACKOFF_MINUTES.length - 1)];
  return { ms: minutes * MINUTE, why: `no reset time given: backoff ${minutes} min` };
}
function archived(p, id) {
