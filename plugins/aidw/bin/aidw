    status: "closed",
    closed_at: at2,
    hash,
    package: version,
    changed,
    ...o.summary?.trim() ? { summary: o.summary.trim() } : {},
    scenarios: { removed: removed.map((s) => ({ scenario: s, reason: reasons[s] })), added, changed: changedScenarios },
    requirements,
    ...scopeReason ? { scope_reason: scopeReason } : {},
    contracts,
    tasks: taskDiff,
    rerun: order,
    reset
  };
  const list22 = loadDeviations(change);
  list22[list22.findIndex((x) => x.id === d.id)] = closed;
  saveDeviations(change, list22);
  return finishDeviations(p, id) ?? closed;
}
function finishDeviations(p, id) {
  let change = loadChange(p, id);
  const all2 = loadDeviations(change);
  const at = all2.map((d2) => d2.status).lastIndexOf("closed");
  const d = all2[at];
  if (!d || d.finished || !d.hash) return null;
  const approval = change.data.approval ?? {};
  if (approval.hash === d.previous && computeApprovalHash(p, change, void 0, { version: d.package ?? packageVersionOf(change) }).hash === d.hash) {
    const history = Array.isArray(approval.history) ? approval.history : [];
    const entry = { deviation: d.id, previous: d.previous, hash: d.hash, reason: d.reason, roles: d.roles, files: d.changed ?? [], at: d.closed_at ?? now7() };
    change.doc.setIn(["approval", "hash"], d.hash);
    change.doc.setIn(["approval", "history"], change.doc.createNode([...history, entry]));
    saveChange(change);
    change = loadChange(p, id);
  }
  if (change.data.approval?.hash !== d.hash) return null;
  rerunTasks(p, id, d.reset ?? [], `Deviation ${d.id} (${d.roles.join(", ")}) changed ${(d.changed ?? []).join(", ")}; runs again`);
  if (d.consultation) {
    const c = loadConsultations(loadChange(p, id)).find((x) => x.id === d.consultation);
    if (c && c.deviation !== "recorded") deviationRecorded(p, id, d.consultation, d);
  }
  const fresh = loadDeviations(loadChange(p, id));
  const i = fresh.findIndex((x) => x.id === d.id);
  const done = { ...d, finished: true };
  fresh[i] = done;
  saveDeviations(loadChange(p, id), fresh);
  return done;
}
function abandonDeviation(p, id) {
  const change = loadChange(p, id);
  const all2 = loadDeviations(change);
  const at = all2.findIndex((d2) => d2.status === "open");
  if (at < 0) throw new OpError(`change "${id}" has no open Deviation`);
  const d = all2[at];
  const dir = snapshotDir(change, d.id);
  const tasksRel = rel(p, (0, import_node_path48.join)(change.dir, "tasks.yaml"));
  for (const f of d.files) {
    const abs = (0, import_node_path48.join)(p.project, f);
    const copy = (0, import_node_path48.join)(dir, "files", f);
    if (d.before[f] === null) (0, import_node_fs43.rmSync)(abs, { force: true });
    else if (f === tasksRel && (0, import_node_fs43.existsSync)(copy)) (0, import_node_fs43.writeFileSync)(abs, restorePlanned((0, import_node_fs43.readFileSync)(copy, "utf8"), readText(abs)));
    else if ((0, import_node_fs43.existsSync)(copy)) {
      (0, import_node_fs43.mkdirSync)((0, import_node_path48.dirname)(abs), { recursive: true });
      (0, import_node_fs43.copyFileSync)(copy, abs);
    }
  }
  const done = { ...d, status: "abandoned", closed_at: now7() };
  all2[at] = done;
  saveDeviations(change, all2);
  if (d.consultation) deviationAbandoned(p, id, d.consultation, d.id);
  return done;
}
function restorePlanned(approvedText2, currentText) {
  const approvedTasks = parseTasks(approvedText2).tasks;
  const current = currentText === null ? [] : parseTasks(currentText).tasks;
  const byId = new Map(current.filter((t) => t && typeof t.id === "string").map((t) => [t.id, t]));
  const out = approvedTasks.map((t) => {
    const now0 = byId.get(t.id);
    const copy = { ...t };
    if (now0) for (const k of RUNTIME_FIELDS) k in now0 ? copy[k] = now0[k] : delete copy[k];
    return copy;
  });
  const ids = new Set(approvedTasks.map((t) => t.id));
  for (const t of current) if (t && !ids.has(t.id) && ADDED_ORIGINS.includes(String(t.origin))) out.push(t);
  let top = {};
  try {
    const data = import_yaml22.default.parse(currentText ?? approvedText2);
    if (data && typeof data === "object" && !Array.isArray(data)) top = data;
  } catch {
    top = {};
  }
  return import_yaml22.default.stringify({ ...top, tasks: out });
}
function markNotBuilt(p, id, taskId, reason, cause = "envelope") {
  if (!reason.trim()) throw new OpError('say why it is not built (--reason "...")');
  const tf = loadTasks(p, id);
  const i = tf.tasks.findIndex((t2) => t2.id === taskId);
  if (i < 0) throw new OpError(`change "${id}" has no task ${taskId}`);
  const t = tf.tasks[i];
  if (statusOf4(t) === "done") throw new OpError(`task ${taskId} is done; reopen it first if what it built lies outside the grants`);
  if (statusOf4(t) === "not_built") throw new OpError(`task ${taskId} is already not built`);
  const marked = [];
  const mark = (j, why, c) => {
    setField(tf, j, "status", "not_built");
    setField(tf, j, "not_built", tf.doc.createNode({ cause: c, reason: why, at: now7() }));
    setField(tf, j, "notes", why);
    marked.push(tf.tasks[j].id);
  };
  mark(i, reason.trim(), cause);
  for (let grew = true; grew; ) {
    grew = false;
    tf.tasks.forEach((x, j) => {
      if (marked.includes(x.id) || ["done", "not_built"].includes(statusOf4(x))) return;
      const dep = list6(x.depends_on).find((y) => marked.includes(y));
      if (!dep) return;
      mark(j, `depends on ${dep}, which is not built`, "dependency");
      grew = true;
    });
  }
  saveTasksDoc(tf);
  return marked;
}

// src/conflict.ts
var import_node_fs44 = require("node:fs");
var import_node_path49 = require("node:path");
var list7 = (v) => Array.isArray(v) ? v.map(String) : [];
var now8 = () => (/* @__PURE__ */ new Date()).toISOString();
var MARKER = /^(?:<{7}|>{7}|\|{7})(?: |$)/m;
var TOOLING_TYPES2 = /* @__PURE__ */ new Set(["build", "ci", "chore"]);
var ENV_FILE2 = /(^|\/)\.env(?:\.(?!example$)[\w.-]+)?$/;
function openConflict(p, id, taskId, phase) {
  const tf = loadTasks(p, id);
  requireExecuting(p, tf.change);
  const i = tf.tasks.findIndex((x) => x.id === taskId);
  const t = tf.tasks[i];
  if (!t) throw new OpError(`task "${taskId}" not found in ${id}/tasks.yaml`);
  const c = t.conflict && typeof t.conflict === "object" && !Array.isArray(t.conflict) ? t.conflict : null;
  if (t.status !== "conflict" || !c) throw new OpError(`task ${taskId} is "${String(t.status ?? "pending")}"; it has no open merge conflict`);
  if (c.phase !== phase) {
    throw new OpError(
      phase === "open" ? `the conflict of ${taskId} is already resolved and waits for the review of the merge: \`aidw brief ${taskId} --for merge-review\`` : `the conflict of ${taskId} is not resolved yet: \`aidw brief ${taskId} --for conflict\`, then \`aidw resolve ${taskId}\``
    );
  }
  const dir = taskDir(p, t);
  if (dir === p.project || !(0, import_node_fs44.existsSync)(dir)) throw new OpError(`task ${taskId} has no worktree to resolve the conflict in (${String(t.worktree)})`);
  const partners = list7(c.with).map((x) => tf.tasks.find((y) => y.id === x) ?? { id: x });
  return { tf, i, t, c, dir, partners };
}
var mergeInProgress = (dir) => git(dir, ["rev-parse", "-q", "--verify", "MERGE_HEAD"]).ok;
function taskLines(t) {
  return [
    `### ${t.id}: ${String(t.title ?? "")}`,
    "",
    `- Role: ${String(t.role ?? "?")}`,
    `- Scenarios: ${list7(t.scenarios).length ? list7(t.scenarios).map((s) => `\`${s}\``).join(", ") : "(none: verified by its verify commands only)"}`,
    `- Touches: ${list7(t.touches).map((g) => `\`${g}\``).join(", ") || "(none)"}`,
    `- Verify: ${list7(t.verify).map((v) => `\`${v}\``).join(", ") || "(none)"}`,
    ""
  ];
}
function writeBrief2(p, id, name, text2) {
  const dir = (0, import_node_path49.join)(p.run, "briefs", id);
  (0, import_node_fs44.mkdirSync)(dir, { recursive: true });
  const path = (0, import_node_path49.join)(dir, name);
  (0, import_node_fs44.writeFileSync)(path, text2.replace(/\n{3,}/g, "\n\n"));
  return path;
}
function buildConflictBrief(p, id, taskId) {
  let o = openConflict(p, id, taskId, "open");
  const changeBranch = git(p.project, ["branch", "--show-current"]).out || "HEAD";
  let onto = typeof o.c.onto === "string" ? o.c.onto : null;
  if (!onto) {
    const tip = git(o.dir, ["rev-parse", "HEAD"]).out;
    if (mergeInProgress(o.dir)) {
      onto = git(o.dir, ["rev-parse", "MERGE_HEAD"]).out;
    } else {
      onto = headCommit(p.project);
      if (!onto) throw new OpError("the Change Branch has no commit to merge");
      const m = git(o.dir, ["merge", "--no-ff", "--no-commit", "-q", onto]);
      if (!m.ok && !mergeInProgress(o.dir)) {
        const why = `the Change Branch could not be merged into the worktree of ${taskId} (${(m.err || m.out).split("\n")[0]})`;
        dropConflictTask(p, id, taskId, why);
        throw new OpError(`${why}; ${taskId} was dropped and reruns sequentially on the latest code`);
      }
    }
    const unmerged = git(o.dir, ["diff", "--name-only", "--diff-filter=U"]).out.split("\n").filter(Boolean);
    const conflictFiles = unmerged.length ? unmerged : list7(o.c.files);
    const partners2 = conflictPartners(p, taskId, typeof o.t.base === "string" ? o.t.base : null, conflictFiles);
    const from = onto;
    const binary = conflictFiles.filter((f) => /^-\t-\t/.test(git(o.dir, ["diff", "--numstat", from, "HEAD", "--", f]).out));
    setField(o.tf, o.i, "conflict", { ...o.c, with: partners2, files: conflictFiles, onto, tip, branch: changeBranch });
    saveTasksDoc(o.tf);
    updateConflict(o.tf.change, taskId, { with: partners2, files: conflictFiles });
    if (binary.length) {
      const why = `binary file in the conflict (${binary.join(", ")}): no marker shows both sides`;
      dropConflictTask(p, id, taskId, why);
      throw new OpError(`${why}; ${taskId} was dropped and reruns sequentially on the latest code`);
    }
    o = openConflict(p, id, taskId, "open");
  }
  const { t, c, dir, partners } = o;
  const files = list7(c.files);
  const branch = String(t.branch ?? "");
  const text2 = [
    `# Conflict brief: ${taskId} - ${String(t.title ?? "")}`,
    "",
    `Change \`${id}\` \xB7 a merge conflict between tasks of one Wave`,
    "",
    "You are the integration Role in a fresh context. You did not write either side. Two tasks ran side by side, each in its",
    "own **Task Worktree**; both passed their checks and their reviews, but their work meets in the same files, so the second",
    "merge into the **Change Branch** conflicts. Resolve the conflict so that **both** tasks' behaviour holds. This is not a split-Slice task: follow this brief.",
    "",
    "## The tasks",
    "",
    `- **${taskId}** is the task being merged, built on branch \`${branch}\` in the worktree below.`,
    partners.length ? `- ${partners.map((x) => `**${x.id}**`).join(", ")} ${partners.length > 1 ? "are" : "is"} already merged into the Change Branch \`${changeBranch}\` (commit \`${onto.slice(0, 12)}\`).` : `- The other side is the Change Branch \`${changeBranch}\` (commit \`${onto.slice(0, 12)}\`): no task commit changed these files.`,
    "",
    ...taskLines(t),
    ...partners.flatMap(taskLines),
    "## Conflicting files",
    "",
    ...files.map((f) => `- \`${f}\``),
    "",
    "## Where",
    "",
    `aidw merged \`${changeBranch}\` (\`${onto.slice(0, 12)}\`) into \`${branch}\` in the Task Worktree \`${dir}\` and stopped at the conflicts. \`cd\` there and work only there; never edit the main checkout \`${p.project}\` nor the worktree's own \`.aidw/\`. \`git diff\` shows the conflicting hunks; \`git log --oneline ${onto.slice(0, 12)} -5\` and \`git log --oneline HEAD -5\` show each side's commits.`,
    "",
    "## Rules",
    "",
    "- Remove every conflict marker. Keep what each task added: combine both sides, do not pick one and drop the other.",
    "- Change only what the conflict needs, in the conflicting files (and a test that must follow them). Do not redesign either task.",
    "- Do not run `git add`, `git commit`, `git merge --abort` or any other git write: aidw commits the merge after its checks.",
    "- Do not delete, skip or weaken a test of either task to get green.",
    "- Run the verify commands of both tasks above in the worktree and make them pass.",
    "",
    "## Done when",
    "",
    `No conflict marker is left, both tasks' verify commands pass in the worktree, and every scenario of both still has its test. aidw then runs both tasks' checks again (\`aidw resolve ${taskId}\`) and an independent reviewer reviews the merge; if any of that fails, ${taskId}'s work is dropped and it is built again on the latest code.`,
    "Reply in at most 5 lines: each file and how the two sides were combined. If the two tasks cannot both hold (they contradict each other), say so and leave the markers: that is a plan problem.",
    ""
  ].join("\n");
  return { path: writeBrief2(p, id, `${taskId}.conflict.md`, text2), text: text2 };
}
function resolveConflict(p, id, taskId, opts = {}) {
  const o = openConflict(p, id, taskId, "open");
  const { tf, t, c, dir, partners } = o;
  const onto = typeof c.onto === "string" ? c.onto : null;
  if (!onto) throw new OpError(`the merge of ${taskId} was not started: run \`aidw brief ${taskId} --for conflict\` and spawn the integration Role first`);
  const files = list7(c.files);
  const withIds = partners.map((x) => x.id);
  const base2 = { ok: false, task: taskId, with: withIds, files, resolution: null, checks: [] };
  const evidenceFile = (0, import_node_path49.join)(tf.change.dir, "evidence", `merge-${taskId}.json`);
  const record = (r) => {
    (0, import_node_fs44.mkdirSync)((0, import_node_path49.join)(tf.change.dir, "evidence"), { recursive: true });
    (0, import_node_fs44.writeFileSync)(evidenceFile, `${JSON.stringify({ at: now8(), onto, ...r }, null, 2)}
`);
    return { ...r, evidence: rel(p, evidenceFile) };
  };
  const fail = (reason, r = base2) => {
    const out = record({ ...r, ok: false, reason });
    dropConflictTask(p, id, taskId, `merge conflict not resolved: ${reason}`);
    return out;
  };
  if (mergeInProgress(dir)) {
    const add = git(dir, ["add", "-A", "--", ".", ":(exclude).aidw"]);
    if (!add.ok) return fail(`git add in the worktree failed: ${add.err}`);
    const junk2 = stagedJunk(dir);
    if (junk2.length) return fail(junkMessage(junk2));
    const leaked = stagedSecrets(dir);
    if (leaked.length) return fail(secretsMessage(leaked));
    const left = git(dir, ["diff", "--name-only", "--diff-filter=U"]).out;
    if (left) return fail(`files are still unmerged: ${left.split("\n").join(", ")}`);
    const commit = git(dir, ["commit", "-q", "--no-edit"]);
    if (!commit.ok) return fail(`the merge commit failed: ${(commit.err || commit.out).split("\n")[0]}`);
  } else if (!git(dir, ["merge-base", "--is-ancestor", onto, "HEAD"]).ok) {
    return fail("the merge of the Change Branch is no longer in the worktree (was it aborted?)");
  } else {
    const dirty = git(dir, ["status", "--porcelain", "--", ".", ":(exclude).aidw"]).out;
    if (dirty) return fail(`the worktree has changes that are not in the merge commit: ${dirty.split("\n").map((l) => l.slice(3)).join(", ")}`);
  }
  const resolution = headCommit(dir);
  if (!resolution) return fail("the worktree has no commit");
  const taskSide = typeof c.tip === "string" && c.tip ? c.tip : git(dir, ["rev-parse", `${resolution}^1`]).out || onto;
  const sides = [.../* @__PURE__ */ new Set([taskSide, onto])];
  const changedBy = new Map(sides.map((side) => [side, git(dir, ["diff", "--name-only", side, resolution]).out.split("\n").filter(Boolean)]));
  const touched = [...new Set([...changedBy.values()].flat())];
  const marked = touched.filter((f) => {
    const file = (0, import_node_path49.join)(dir, f);
    if (!(0, import_node_fs44.existsSync)(file)) return false;
    const text2 = (0, import_node_fs44.readFileSync)(file);
    return !text2.includes(0) && MARKER.test(text2.toString("utf8"));
  });
  if (marked.length) return fail(`conflict markers are left in ${marked.join(", ")}`);
  const junk = touched.filter((f) => isGeneratedPath(f) || ENV_FILE2.test(f));
  if (junk.length) return fail(junkMessage(junk));
  const isTooling = (x) => typeof x.type === "string" && TOOLING_TYPES2.has(x.type);
  const ownChanges = isTooling(t) && typeof t.base === "string" ? git(dir, ["diff", "--name-only", t.base, taskSide]).out.split("\n") : [];
  const toolingPartners = new Set(partners.filter(isTooling).map((x) => x.id));
  const exempt = (f) => {
    if (files.includes(f) || ownChanges.includes(f)) return true;
    if (!toolingPartners.size) return false;
    const log = git(dir, ["log", "--format=%B", `${taskSide}..${onto}`, "--", f]).out;
    return [...log.matchAll(/^Task: (\S+)$/gm)].some((m) => toolingPartners.has(m[1]));
  };
  const guards = sides.map((side) => {
    const changed = changedBy.get(side) ?? [];
    const tamper = tamperEvidence(dir, side, changed, { isTest: (f) => TEST_FILE.test(f), removesTests: false });
    const raw = configEvidence(dir, side, changed, "feat");
    const config = raw ? { locked: raw.locked.filter((f) => !exempt(f)), watched: [...raw.watched, ...raw.locked.filter(exempt)] } : null;
    const secrets = secretsInChanges(dir, side, changed) ?? [];
    const packages = packageEvidence(dir, side, changed);
    const problems = [
      ...tamperProblems(tamper),
      ...config?.locked.length ? [`check configuration changed: ${config.locked.join(", ")}`] : [],
      ...secrets.length ? [secretsProblem(secrets)] : [],
      ...packageProblems(packages)
    ];
    return { side, changed, problems, ...tamper ? { tamper } : {}, ...config ? { config } : {}, ...secrets.length ? { secrets } : {}, ...packages ? { packages } : {} };
  });
  const guarded = { ...base2, resolution, guards };
  const problem = guards.flatMap((x) => x.problems)[0];
  if (problem) return fail(problem, guarded);
  const runner2 = opts.runner ?? retryingShellRunner;
  const checks = [t, ...partners].map((x) => {
    const found = findScenarioTests(dir, list7(x.scenarios));
    const missing = Object.entries(found).filter(([, where]) => where.length === 0).map(([s]) => s);
    const runs = [];
    for (const command of list7(x.verify)) {
      const started = Date.now();
      const r = runner2(command, dir, opts.timeoutMs ?? 30 * 60 * 1e3);
      runs.push({ command, ms: Date.now() - started, ...r });
      if (r.exit !== 0) break;
    }
    return { task: x.id, missing_scenarios: missing, runs, ok: missing.length === 0 && runs.every((r) => r.exit === 0) };
  });
  const refused = checks.flatMap((x) => x.runs).find((r) => r.exit !== 0 && !r.timedOut && ENVIRONMENT_FAILURE.test(r.tail));
  if (refused) {
    const why = `environment: \`${refused.command}\` was refused by the machine (${ENVIRONMENT_FAILURE.exec(refused.tail)?.[0]}), not by the code`;
    return record({ ...guarded, checks, ok: false, blocked: true, reason: why });
  }
  const result = { ...guarded, checks };
  const bad = checks.find((x) => !x.ok);
  if (bad) {
    const failed = bad.runs.find((r) => r.exit !== 0);
    const why = failed ? `${bad.task}: \`${failed.command}\`${failed.timedOut ? " timed out" : ` exited ${failed.exit}`} on the resolved code` : `${bad.task}: no test names scenario ${bad.missing_scenarios.join(", ")} on the resolved code`;
    return fail(why, result);
  }
  const configFiles = [...new Set(guards.flatMap((x) => [...x.config?.locked ?? [], ...x.config?.watched ?? []]))];
  setField(tf, o.i, "conflict", { ...c, phase: "review", resolution, ...configFiles.length ? { config: configFiles } : {} });
  setField(tf, o.i, "notes", `merge conflict resolved by integration (${resolution?.slice(0, 8)}); both tasks' checks pass; the merge waits for its review`);
  saveTasksDoc(tf);
  return { ...record({ ...result, ok: true }) };
}
function buildMergeReviewBrief(p, id, taskId) {
  const { t, c, dir, partners, tf } = openConflict(p, id, taskId, "review");
  const onto = String(c.onto ?? "");
  const resolution = String(c.resolution ?? "HEAD");
  const files = list7(c.files);
  const verdictFile2 = (0, import_node_path49.join)(p.run, `review-${taskId}.md`);
  (0, import_node_fs44.rmSync)(verdictFile2, { force: true });
  const text2 = [
    `# Merge review brief: ${taskId} - ${String(t.title ?? "")}`,
    "",
    `Change \`${id}\` \xB7 the review of a merge conflict the integration Role resolved`,
    "",
    "You are an independent reviewer in a fresh context. You wrote neither task nor the resolution. You may read files and run read-only commands (tests included); you cannot edit anything.",
    "",
    `Two tasks of one Wave changed the same files. ${taskId} was reviewed and passed on its own; its merge into the change branch conflicted with ${partners.length ? partners.map((x) => x.id).join(", ") : "the change branch"}. The integration Role resolved it, and aidw ran the checks of both tasks again on the result: they pass. Judge only the resolution.`,
    "",
    "## The tasks",
    "",
    ...taskLines(t),
    ...partners.flatMap(taskLines),
    "## What to review",
    "",
    `- Work in the worktree \`${dir}\`; the resolution is the merge commit \`${resolution}\`.`,
    `- \`git show --cc ${resolution}\`: the hunks where the resolution differs from both sides.`,
    `- \`git diff ${onto.slice(0, 12)} ${resolution} -- ${files.join(" ")}\`: the conflicting files against the change branch.`,
    `- Conflicting files: ${files.map((f) => `\`${f}\``).join(", ")}.`,
    ...list7(c.config).length ? [`- Configuration of the checks this merge changes against one side: ${list7(c.config).map((f) => `\`${f}\``).join(", ")}. Read the diff of each: a lowered threshold, a removed rule or a narrower include that neither task made is a \`fix\`.`] : [],
    `- Checks of both tasks on the resolved code: \`${rel(p, (0, import_node_path49.join)(tf.change.dir, "evidence", `merge-${taskId}.json`))}\`; ${taskId}'s own evidence: \`${rel(p, (0, import_node_path49.join)(tf.change.dir, evidenceRel(taskId)))}\`.`,
    "",
    "## Checklist",
    "",
    "1. Each conflicting file keeps what **both** tasks added: nothing of either side was dropped or silently rewritten.",
    "2. The resolution changes nothing beyond what the conflict needs.",
    "3. No test of either task was deleted, skipped or weakened, and every scenario of both still has a test that asserts its THEN outcome.",
    "",
    "## Verdict",
    "",
    "Your verdict starts with exactly one line: `VERDICT: pass` or `VERDICT: fix`.",
    "For `fix`, follow with numbered blocking issues: file, problem. A `fix` drops the resolution and the task is built again on the latest code, so use it only for a real loss or breakage.",
    `**Write the whole verdict to \`${verdictFile2}\` with the Write tool** (the only file you may write), then reply with just its first line.`,
    ""
  ].join("\n");
  return { path: writeBrief2(p, id, `${taskId}.merge-review.md`, text2), text: text2 };
}

// src/cli.ts
function reviewLine(r, verdict, notes) {
  return `${r.task}: review ${r.verdict} -> ${r.status}${r.commit ? ` (commit ${r.commit.slice(0, 8)})` : ""}${r.warning ? `
  warning: ${r.warning}` : ""}${r.conflict ? `
  merge conflict (${r.conflict}): ${r.status === "conflict" ? "the integration Role resolves it" : "the task reruns sequentially"}` : ""}${verdict === "pass" && !notes.trim() ? "\n  note: no reviewer reply recorded; pass it with --notes-file so its non-blocking remarks reach the handoff" : ""}
`;
}
function compactNote(cwd, env) {
  const dir = findProject({ cwd, env });
  if (!dir) return null;
  const p = pathsFor(dir);
  const active = [];
  for (const id of listChangeIds(p)) {
    try {
      const st = stateOf(loadChange(p, id));
      if (st && !["draft", "delivered", "archived"].includes(st)) active.push(`${id}=${st}`);
    } catch {
    }
  }
  if (!active.length) return null;
  let next = "";
  try {
    const id = active[0].split("=")[0];
    next = ` Next: ${nextText(nextAction(p, id))}.`;
  } catch {
  }
  return `AIDW (context was compacted): ${active.join(", ")}.${next} All progress is in .aidw/ and git; run \`aidw status\` before acting, and \`/aidw:resume\` if the run was interrupted.`;
}
function changeTasks(p) {
  const out = [];
  for (const base2 of [p.changes, p.archive]) {
    if (!(0, import_node_fs45.existsSync)(base2)) continue;
    for (const d of (0, import_node_fs45.readdirSync)(base2)) {
      const text2 = readText((0, import_node_path50.join)(base2, d, "tasks.yaml"));
      if (text2 !== null) out.push(parseTasks(text2).tasks);
    }
  }
  return out;
}
function consultText(n) {
  const asker = `${n.from} (${n.task ?? `stage ${n.stage}`})`;
  const step = n.step === "answer" ? `consultation ${n.consultation}: ${asker} asks ${n.to}; spawn aidw:${n.to} with: Consultation brief: ${n.brief}. Read it and answer as it says. (If you already spawned it and it has not replied, wait for it.) Then \`aidw consult answer ${n.consultation}\`` : n.step === "record" ? `consultation ${n.consultation}: ${n.to} wrote its answer; run \`aidw consult answer ${n.consultation}\` (do not spawn it again)` : n.step === "deviation" ? `consultation ${n.consultation} needs a Deviation: ${n.to} could not answer without changing what was approved. Read its answer, then \`aidw deviation open --role <the Role that wrote the file> --files <the approved files it names> --reason "<why>" --consultation ${n.consultation}\` (ADR-0014; the user is not asked). If nothing approved has to change after all, resume the asker: \`aidw consult resume ${n.consultation}\`` : `consultation ${n.consultation} is ${n.status}: resume ${asker} with \`aidw consult resume ${n.consultation}\``;
  return n.meanwhile ? `${step}. Meanwhile, in the same message: ${nextText(n.meanwhile)}` : step;
}
function deviationText(n) {
  const roles = [...new Set(Object.values(n.authors))];
  const step = `Deviation ${n.deviation} is open (${Object.entries(n.authors).map(([f, r]) => `${f}: ${r}`).join(", ")}): spawn ${roles.map((r) => `aidw:${r}`).join(" and ")} with: Deviation brief: ${n.brief}. Read it and change only your files under its three rules. (If you already spawned it and it has not replied, wait.) Then \`aidw deviation close\` (add --remove-reason "..." when an approved scenario was removed and the author said why)`;
  return n.meanwhile ? `${step}. Meanwhile, in the same message: ${nextText(n.meanwhile)}` : step;
}
function nextText(n) {
  if (n.action === "deviation") return deviationText(n);
  return n.action === "implement" ? `implement ${n.task} (${n.reason}): ${n.title}${n.reason === "interrupted" ? " (if an implementer you spawned for it has not reported yet, it is still running: wait for it, do not spawn another)" : ""}` : n.action === "review" ? `review ${n.task}: ${n.title}` : n.action === "resolve" ? `resolve the merge conflict of ${n.task} with ${n.with.join(", ") || "the change branch"} (${n.files.join(", ")}): \`aidw brief ${n.task} --for conflict\`, spawn aidw:integration with the brief, then \`aidw resolve ${n.task}\`` : n.action === "review-merge" ? `review the merge of ${n.task} with ${n.with.join(", ") || "the change branch"}: \`aidw brief ${n.task} --for merge-review\`, spawn ${AGENTS.taskReview} with the brief, then \`aidw verdict ${n.task}\`` : n.action === "consult" ? consultText(n) : n.action === "triage" ? `triage ${n.task} (${n.reason}): \`aidw brief ${n.task} --for triage\`, spawn ${AGENTS.triage} with the brief, then \`aidw triage ${n.task}\`` : n.action === "escalate" ? `escalate: ${n.reason}` : n.action === "wave" ? `wave of ${n.tasks.length}: ${n.tasks.map((x) => `${x.task} (${x.title})`).join(", ")}` : n.action === "integrate" ? `integrate ${n.tasks.join(", ")}: run \`aidw integrate\` on the merged code` : `complete: all ${n.done} task(s) done`;
}
function nextLine(p, id) {
  try {
    return `NEXT: ${nextText(nextAction(p, id))}
`;
  } catch {
    return "";
  }
}
var REVIEWER_PROMPT = (path) => `Review brief: ${path}. Review the task and reply with the verdict.`;
var sessionEnd = (env, p, id) => {
  if (env.AIDW_RUNNER !== "1") return "";
  try {
    if (nextAction(p, id).action === "complete") return "";
  } catch {
    return "";
  }
  return "END THIS SESSION: one task is done and committed. The runner (`aidw run`) starts a fresh session for the next one, which costs far less than carrying this context on. Reply with one line and stop; call no more tools.\n";
};
