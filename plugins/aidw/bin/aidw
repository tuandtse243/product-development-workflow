function mergeWorktree(p, t, message) {
  const wt = taskDir(p, t);
  const branch = String(t.branch ?? "");
  if (!(0, import_node_fs22.existsSync)(wt) || !branch) throw new OpError(`task ${t.id} has no worktree to merge (${String(t.worktree)})`);
  const add = git(wt, ["add", "-A", "--", ".", ":(exclude).aidw"]);
  if (!add.ok) throw new OpError(`git add in the worktree of ${t.id} failed: ${add.err}`);
  const junk = stagedJunk(wt);
  if (junk.length) {
    git(wt, ["reset", "-q"]);
    throw new OpError(`${t.id}: ${junkMessage(junk)}`);
  }
  const leaked = stagedSecrets(wt);
  if (leaked.length) {
    git(wt, ["reset", "-q"]);
    throw new OpError(`${t.id}: ${secretsMessage(leaked)}`);
  }
  if (!git(wt, ["diff", "--cached", "--quiet"]).ok) {
    const c = git(wt, ["commit", "-q", "-m", message]);
    if (!c.ok) throw new OpError(`commit in the worktree of ${t.id} failed: ${c.err || c.out}`);
  }
  const m = git(p.project, ["merge", "--no-ff", "--no-commit", "-q", branch]);
  if (m.ok) return { ok: true };
  const files = git(p.project, ["diff", "--name-only", "--diff-filter=U"]).out.split("\n").filter(Boolean);
  git(p.project, ["merge", "--abort"]);
  return { ok: false, conflict: (m.out || m.err || files.join("\n")).split("\n").slice(0, 8).join("; "), files };
}
function conflictPartners(p, taskId, base2, files) {
  if (!base2 || !files.length) return [];
  const log = git(p.project, ["log", "--format=%B", `${base2}..HEAD`, "--", ...files]);
  if (!log.ok) return [];
  const ids = [...log.out.matchAll(/^Task: (\S+)$/gm)].map((m) => m[1]);
  return [...new Set(ids)].filter((x) => x !== taskId);
}
var conflictsFile = (change) => (0, import_node_path27.join)(change.dir, "conflicts.yaml");
var CONFLICTS_HEADER = "# Merge conflicts between tasks of a Wave (written by aidw). Each names the tasks whose work met in the same\n# files. The Technical Planner reads it when it plans: list those files in the touches of every task that\n# changes them, or chain the tasks with depends_on, so they never run side by side again.\n";
function readConflicts(change) {
  const text2 = readText(conflictsFile(change));
  if (text2 === null) return [];
  try {
    const data = import_yaml13.default.parse(text2);
    return Array.isArray(data?.conflicts) ? data.conflicts : [];
  } catch {
    return [];
  }
}
function writeConflicts(change, records) {
  (0, import_node_fs22.writeFileSync)(conflictsFile(change), `${CONFLICTS_HEADER}${import_yaml13.default.stringify({ conflicts: records })}`);
}
function recordConflict(change, entry) {
  writeConflicts(change, [...readConflicts(change), { at: now3(), ...entry, outcome: "open" }]);
}
function updateConflict(change, taskId, patch) {
  const records = readConflicts(change);
  const last = records.map((r) => r.task).lastIndexOf(taskId);
  if (last < 0) return;
  records[last] = { ...records[last], ...patch };
  writeConflicts(change, records);
}
function closeConflict(change, taskId, outcome, reason) {
  const records = readConflicts(change);
  const last = records.map((r) => r.task).lastIndexOf(taskId);
  if (last < 0) return;
  records[last] = { ...records[last], outcome, ...reason ? { reason: reason.slice(0, 300) } : {} };
  writeConflicts(change, records);
}
var integrationFile = (change) => (0, import_node_path27.join)(change.dir, "evidence", "integration.json");
function integrationRuns(change) {
  const f = integrationFile(change);
  if (!(0, import_node_fs22.existsSync)(f)) return [];
  try {
    return JSON.parse((0, import_node_fs22.readFileSync)(f, "utf8")).runs ?? [];
  } catch {
    return [];
  }
}
function lastPassAt(change) {
  return integrationRuns(change).filter((r) => r.ok).at(-1)?.at ?? "";
}
function pendingIntegration(change, tasks) {
  const since = lastPassAt(change);
  return tasks.filter((t) => statusOf2(t) === "done" && typeof t.merged_at === "string" && t.merged_at > since);
}
function integrate(p, id, deps) {
  const change = loadChange(p, id);
  const tf = deps.loadTasks(p, id);
  const covered = pendingIntegration(change, tf.tasks);
  if (!covered.length) return { ok: true, tasks: [], runs: [], summary: "nothing merged since the last integration verify" };
  const code = deps.quality?.layers.find((l) => l.name === "code");
  const commands = [.../* @__PURE__ */ new Set([...code ? [...code.setup, ...code.run] : [], ...covered.flatMap((t) => list3(t.verify))])];
  const runs = [];
  for (const command of commands) {
    const started = Date.now();
    const r = deps.runner(command, p.project, deps.timeoutMs ?? 30 * 60 * 1e3);
    runs.push({ command, ms: Date.now() - started, ...r });
    if (r.exit !== 0) break;
  }
  const failed = runs.find((r) => r.exit !== 0);
  const ok = !failed && runs.length === commands.length;
  const record = { at: now3(), head: headCommit(p.project), ok, tasks: covered.map((t) => t.id), runs };
  const history = integrationRuns(change);
  const write = () => {
    (0, import_node_fs22.mkdirSync)((0, import_node_path27.join)(change.dir, "evidence"), { recursive: true });
    (0, import_node_fs22.writeFileSync)(integrationFile(change), `${JSON.stringify({ runs: [...history, record] }, null, 2)}
`);
  };
  if (ok) {
    write();
    return { ok, tasks: record.tasks, runs, summary: `wave ${record.tasks.join(", ")} integrates: ${commands.length} command(s) pass on the merged code` };
  }
  const since = lastPassAt(change);
  const failures = history.filter((r) => !r.ok && r.at > since).length + 1;
  const max = deps.quality?.maxFixRounds ?? 3;
  if (failures > max) {
    write();
    transition(p, id, "escalated", { reason: `integration verify of ${record.tasks.join(", ")} still failing after ${failures - 1} fix round(s)` });
    return { ok: false, tasks: record.tasks, runs, escalated: true, summary: `integration verify failed; fix rounds exhausted (${failures - 1}/${max}): escalated` };
  }
  const n = tf.tasks.filter((t) => t.origin === "integration").length + 1;
  const taskId = `I${String(n).padStart(2, "0")}`;
  const problem = failed ? `Integration verify after merging ${record.tasks.join(", ")} failed: \`${failed.command}\`${failed.timedOut ? " timed out" : ` exited ${failed.exit}`}.
Each task passed on its own; the merged code does not. Find the interaction between the tasks.

${failed.tail}` : "Integration verify did not complete.";
  tf.doc.get("tasks").add(
    tf.doc.createNode({ id: taskId, title: `Fix the integration of ${record.tasks.join(", ")}`, role: defaultTaskRole(), origin: "integration", depends_on: [], touches: ["**"], verify: commands, problem, status: "pending" })
  );
  deps.save(tf);
  record.fixTask = taskId;
  write();
  return { ok: false, tasks: record.tasks, runs, fixTask: taskId, summary: `integration verify failed: fix task ${taskId} added (round ${failures}/${max})` };
}
function linkDependencies(p, dir) {
  const source = (0, import_node_path27.join)(p.project, "node_modules");
  const target = (0, import_node_path27.join)(dir, "node_modules");
  if (!(0, import_node_fs22.existsSync)(source) || (0, import_node_fs22.existsSync)(target) || isSymlink(target)) return;
  try {
    (0, import_node_fs22.symlinkSync)(source, target, "dir");
  } catch {
    return;
  }
  const ex = git(p.project, ["rev-parse", "--path-format=absolute", "--git-path", "info/exclude"]);
  if (!ex.ok || !ex.out) return;
  const text2 = (0, import_node_fs22.existsSync)(ex.out) ? (0, import_node_fs22.readFileSync)(ex.out, "utf8") : "";
  if (!/^\/?node_modules\/?$/m.test(text2)) {
    (0, import_node_fs22.mkdirSync)((0, import_node_path27.join)(ex.out, ".."), { recursive: true });
    (0, import_node_fs22.writeFileSync)(ex.out, `${text2}${text2 && !text2.endsWith("\n") ? "\n" : ""}node_modules
`);
  }
}
var isSymlink = (f) => {
  try {
    return (0, import_node_fs22.lstatSync)(f).isSymbolicLink();
  } catch {
    return false;
  }
};

// src/guards.ts
function transitionGuard(p, id, target) {
  const change = loadChange(p, id);
  if (workflowIdOf(p, change) === "audit") return target === "delivered" ? auditReady(p, id) : null;
  if (target === "executing") {
    const text2 = readText(qualityFile(change));
    const q = text2 === null ? null : parseQuality(text2, "quality.yaml").config;
    const why = q ? installGuard(p, id, q.layers.flatMap((l) => [...l.setup, ...l.run])) : null;
    if (why) return why;
  }
  if (!("deploying" in machineOf(p, change).transitions)) return null;
  if (target === "verifying") {
    const open = loadTasks(p, id).tasks.filter((t) => !["done", "not_built"].includes(String(t.status ?? "pending")));
    if (open.length) return `"verifying" needs every task done; open: ${open.map((t) => `${t.id} (${String(t.status ?? "pending")})`).join(", ")}`;
    const merged = pendingIntegration(loadChange(p, id), loadTasks(p, id).tasks);
    if (merged.length) return `"verifying" needs the last wave integrated: run \`aidw integrate\` (merged: ${merged.map((t) => t.id).join(", ")})`;
  }
  if (target === "converging") {
    const q = qualityPassed(p, id);
    if (!q.ok) return `"converging" needs every quality layer passing on the current code; run \`aidw verify\` (pending: ${q.pending.join(", ")})`;
  }
  if (target === "deploying") {
    const c = convergePassed(p, id);
    if (!c.ok) return `"deploying" needs a passing converge on the current code: ${c.reason}`;
  }
  if (target === "delivered") {
    const d = lastDeploy(loadChange(p, id));
    if (!d?.ok) return `"delivered" needs a successful \`aidw deploy\`${d ? ` (last: ${d.error ?? "failed"})` : ""}`;
  }
  return null;
}

