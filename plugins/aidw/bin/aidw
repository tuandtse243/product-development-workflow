function newChange(p, id, opts) {
  if (!CHANGE_ID.test(id)) throw new OpError(`change id "${id}" must be kebab-case (e.g. 2026-11-08-booking-app)`);
  if (opts.inputType && !INPUT_TYPES.includes(opts.inputType)) {
    throw new OpError(`unknown input type "${opts.inputType}" (expected ${INPUT_TYPES.join(", ")})`);
  }
  if (opts.workflow && opts.workflows && !opts.workflows.includes(opts.workflow)) throw new OpError(`unknown workflow "${opts.workflow}" (expected ${opts.workflows.join(", ")})`);
  const dir = changeDir(p, id);
  if ((0, import_node_fs26.existsSync)(dir)) throw new OpError(`change "${id}" already exists`);
  const title = opts.title ?? id;
  (0, import_node_fs26.mkdirSync)((0, import_node_path31.join)(dir, "specs"), { recursive: true });
  (0, import_node_fs26.writeFileSync)(
    (0, import_node_path31.join)(dir, "change.yaml"),
    [
      "schema: 1",
      `id: ${id}`,
      `title: ${JSON.stringify(title)}`,
      `input_type: ${opts.inputType ?? "null"}`,
      ...opts.workflow ? [`workflow: ${opts.workflow}`] : [],
      "state: draft",
      `created_at: ${now4()}`,
      `skip_specs: ${opts.skipSpecs === true}`,
      ...opts.scopeRound ? ["scope_round: true"] : [],
      "approval: null",
      "run:",
      "  paused: null",
      ""
    ].join("\n")
  );
  (0, import_node_fs26.writeFileSync)((0, import_node_path31.join)(dir, "intake.md"), INTAKE(title));
  (0, import_node_fs26.writeFileSync)((0, import_node_path31.join)(dir, "stages.yaml"), "done: []\n");
  (0, import_node_fs26.writeFileSync)((0, import_node_path31.join)(dir, "analysis.md"), ANALYSIS(title, projectKind(p) === "brownfield", opts.scopeRound === true));
  recordBaseline(p);
  return dir;
}
var ANALYSIS = (title, brownfield = false, scopeRound2 = false) => `# Analysis: ${title}

