function resolveGlob(project, glob) {
  const segs = glob.split("/");
  const firstWild = segs.findIndex((s) => /[*?{]/.test(s));
  const prefix = firstWild < 0 ? segs.slice(0, -1) : segs.slice(0, firstWild);
  const dir = (0, import_node_path32.join)(project, ...prefix);
  return walkFiles(dir).map((f) => rel({ project }, f)).filter((f) => matchesAny([glob], f));
}
function layerArtifacts(p, layer) {
  const out = /* @__PURE__ */ new Set();
