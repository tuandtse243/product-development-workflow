function ensureWorktree(p, id, taskId, base2) {
  const dir = worktreeDir(p, id, taskId);
  const branch = branchName(id, taskId);
  if ((0, import_node_fs22.existsSync)((0, import_node_path27.join)(dir, ".git"))) {
    linkDependencies(p, dir);
    return { dir: rel(p, dir), branch, created: false };
  }
  git(p.project, ["worktree", "prune"]);
  (0, import_node_fs22.mkdirSync)((0, import_node_path27.join)(dir, ".."), { recursive: true });
  const hasBranch = git(p.project, ["rev-parse", "--verify", "-q", `refs/heads/${branch}`]).ok;
  const r = hasBranch ? git(p.project, ["worktree", "add", "-q", dir, branch]) : git(p.project, ["worktree", "add", "-q", "-b", branch, dir, base2]);
  if (!r.ok) {
    if (!hasBranch) git(p.project, ["branch", "-q", "-D", branch]);
    throw new OpError(`could not create the worktree for ${taskId}: ${r.err || r.out}`);
  }
  linkDependencies(p, dir);
  return { dir: rel(p, dir), branch, created: true };
}
function removeWorktree(p, worktree, branch) {
