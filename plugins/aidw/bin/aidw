function packageManager(dir, pkg) {
  const field = typeof pkg?.packageManager === "string" ? pkg.packageManager.split("@")[0] : "";
  if (field === "pnpm" || field === "npm" || field === "yarn" || field === "bun") return field;
  if ((0, import_node_fs24.existsSync)((0, import_node_path29.join)(dir, "pnpm-lock.yaml"))) return "pnpm";
  if ((0, import_node_fs24.existsSync)((0, import_node_path29.join)(dir, "yarn.lock"))) return "yarn";
  if ((0, import_node_fs24.existsSync)((0, import_node_path29.join)(dir, "bun.lockb")) || (0, import_node_fs24.existsSync)((0, import_node_path29.join)(dir, "bun.lock"))) return "bun";
  if ((0, import_node_fs24.existsSync)((0, import_node_path29.join)(dir, "package-lock.json")) || pkg) return "npm";
  return null;
}
function pmCommands(pm) {
  switch (pm) {
    case "pnpm":
      return { script: (s) => `pnpm ${s}`, exec: (b) => `pnpm exec ${b}` };
    case "yarn":
      return { script: (s) => `yarn ${s}`, exec: (b) => `yarn ${b}` };
    case "bun":
      return { script: (s) => `bun run ${s}`, exec: (b) => `bunx ${b}` };
    default:
      return { script: (s) => s === "test" ? "npm test" : `npm run ${s}`, exec: (b) => `npx ${b}` };
  }
}
