      const file = (0, import_node_path47.join)(c.dir, f);
      parts.push((0, import_node_fs42.existsSync)(file) ? (0, import_node_crypto7.createHash)("sha1").update((0, import_node_fs42.readFileSync)(file, "utf8").replace(ISO_TIME, "")).digest("hex").slice(0, 12) : "-");
    }
