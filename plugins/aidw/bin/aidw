var DECISION = /^\s*[-*]\s+\**(D\d+)\**\s*:\s*(\S.*)$/;
function decisionsToHonor(analysis) {
  const s = sections(analysis).find((x) => x.name.toLowerCase() === "decisions to honor");
  if (!s) return [];
  return s.body.split(/\r?\n/).map((l) => DECISION.exec(l)).filter((m) => m !== null).map((m) => `${m[1]}: ${m[2].trim()}`);
}
var STACK_SOURCES = ["client", "ai", "fallback"];
var DESIGN_MODES = ["existing", "claude_design", "ai_design", "hybrid"];
var reqId = (capability, name) => `${capability}/${slugify(name)}`;
var scenarioId = (capability, req, scenario) => `${reqId(capability, req)}/${slugify(scenario)}`;
function indexSpec(capability, text2, into) {
  for (const r of parseSpec(text2).requirements) {
    into.requirements.add(reqId(capability, r.name));
    for (const s of r.scenarios) into.scenarios.add(scenarioId(capability, r.name, s.name));
  }
}
function mainSpecIds(p) {
  const ids = { requirements: /* @__PURE__ */ new Set(), scenarios: /* @__PURE__ */ new Set() };
  for (const f of walkFiles(p.specs)) {
    const cap = capabilityOf(p.specs, f);
    if (cap) indexSpec(cap, (0, import_node_fs31.readFileSync)(f, "utf8"), ids);
  }
  return ids;
}
function idsAfterChange(p, id) {
  const ids = { requirements: /* @__PURE__ */ new Set(), scenarios: /* @__PURE__ */ new Set() };
  const changed = { requirements: /* @__PURE__ */ new Set(), scenarios: /* @__PURE__ */ new Set() };
  const { specs, deltas } = specsAfterChange(p, id);
  for (const [cap, text2] of specs) indexSpec(cap, text2, ids);
  for (const [cap, deltaText] of deltas) {
    const delta = parseDelta(deltaText);
    for (const r of [...delta.added, ...delta.modified]) {
      changed.requirements.add(reqId(cap, r.name));
      for (const s of r.scenarios) changed.scenarios.add(scenarioId(cap, r.name, s.name));
    }
  }
  return { ids, changed };
}
function specsAfterChange(p, id) {
  const change = loadChange(p, id);
  const specs = /* @__PURE__ */ new Map();
  const deltas = /* @__PURE__ */ new Map();
  const files = deltaFiles(p, change, new Diags());
  const touched = new Set(files.map((d) => d.capability));
  for (const f of walkFiles(p.specs)) {
    const cap = capabilityOf(p.specs, f);
    if (cap && !touched.has(cap)) specs.set(cap, (0, import_node_fs31.readFileSync)(f, "utf8"));
  }
  for (const df of files) {
    const deltaText = (0, import_node_fs31.readFileSync)(df.file, "utf8");
    deltas.set(df.capability, deltaText);
    const merged = applyDelta(readText(df.mainFile), deltaText, df.capability);
    specs.set(df.capability, merged.ok && merged.text ? merged.text : readText(df.mainFile) ?? "");
  }
  return { specs, deltas };
}
function requirementsAfterChange(p, id) {
