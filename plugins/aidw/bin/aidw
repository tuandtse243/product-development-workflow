function detachRun(p, argv, env) {
  const running = runnerPid(p);
  if (running) throw new Error(`a runner is already running here (pid ${running}); stop it with \`aidw run --stop\``);
  (0, import_node_fs42.mkdirSync)(p.run, { recursive: true });
  const log = (0, import_node_path47.join)(p.run, "runner.log");
