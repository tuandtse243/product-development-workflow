// src/tasks.ts
var TASK_STATUSES = ["pending", "running", "review", "done", "failed", "blocked", "escalated", "conflict", "not_built"];
var RUNTIME_FIELDS = [
  "status",
  "attempts",
  "evidence",
  "started_at",
  "finished_at",
  "notes",
  "base",
  // S8 parallel waves: the task's git worktree and branch, its merge time, and the fallback to sequential
  "worktree",
  "branch",
  "merged_at",
  "sequential",
  // re-approval keeps done work: the plan the task was finished against
  "plan_sha",
  // the one triage of a task that ran out of attempts: { cause, at }
  "triage",
  // T7: an open merge conflict of a wave task, resolved by the integration Role: { with, files, at, phase, onto?, resolution? }
  "conflict",
  // ADR-0013: the Agent-run counter, raised on every new attempt and never reset; the Consultation budget counts per run
  "runs",
  // D10: why a task is not built: { cause, reason, at }
  "not_built"
];
var DEFAULT_MAX_ATTEMPTS = 3;
var ADDED_ORIGINS = ["converge", "quality", "integration"];
function parseTasks(text2) {
  let data;
  try {
    data = import_yaml3.default.parse(text2);
  } catch (e) {
    return { tasks: [], error: `not valid YAML: ${e.message}` };
  }
  const list8 = data?.tasks;
  if (!Array.isArray(list8)) return { tasks: [], error: 'expected a top-level "tasks:" list' };
  return { tasks: list8 };
}
var isStrList = (v) => Array.isArray(v) && v.every((x) => typeof x === "string");
function validateTasksText(text2, file) {
  const d = new Diags();
  const { tasks, error } = parseTasks(text2);
  if (error) {
    d.error(file, error);
    return d;
  }
  if (tasks.length === 0) d.error(file, "tasks list is empty");
  const ids = /* @__PURE__ */ new Set();
  for (const [i, t] of tasks.entries()) {
    const where = typeof t?.id === "string" ? `task ${t.id}` : `task #${i + 1}`;
    if (!t || typeof t !== "object") {
      d.error(file, `${where} is not a mapping`);
      continue;
    }
    if (typeof t.id !== "string" || !t.id) d.error(file, `${where} has no id`);
    else if (ids.has(t.id)) d.error(file, `duplicate task id "${t.id}"`);
    else ids.add(t.id);
    if (typeof t.title !== "string" || !t.title) d.error(file, `${where} has no title`);
    if (typeof t.role !== "string" || !t.role) d.error(file, `${where} has no role`);
    if (!isStrList(t.touches) || t.touches.length === 0) d.error(file, `${where} needs a non-empty "touches" list of file globs`);
    if (!isStrList(t.verify) || t.verify.length === 0) d.error(file, `${where} needs a non-empty "verify" list`);
    if (t.depends_on !== void 0 && !isStrList(t.depends_on)) d.error(file, `${where}: "depends_on" must be a list of task ids`);
    if (t.skills !== void 0 && !isStrList(t.skills)) d.error(file, `${where}: "skills" must be a list of vendored skill names`);
    if (t.removes_tests !== void 0 && typeof t.removes_tests !== "boolean") d.error(file, `${where}: "removes_tests" must be true or false`);
    if (t.max_attempts !== void 0 && !(Number.isInteger(t.max_attempts) && Number(t.max_attempts) >= 1)) {
      d.error(file, `${where}: "max_attempts" must be a positive integer`);
    }
    if (t.scope !== void 0 && !(typeof t.scope === "string" && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(t.scope))) d.error(file, `${where}: "scope" must be a kebab-case capability name (the scope of the commit)`);
    const tp = typeProblem(t);
    if (tp) d.error(file, `${where} ${tp}`);
    if (t.risk !== void 0 && t.risk !== "normal" && t.risk !== "high") d.error(file, `${where}: "risk" must be normal or high`);
    if (t.status !== void 0 && !TASK_STATUSES.includes(String(t.status))) {
      d.error(file, `${where}: unknown status "${String(t.status)}" (expected ${TASK_STATUSES.join(", ")})`);
    }
  }
  for (const t of tasks) {
    for (const dep of isStrList(t?.depends_on) ? t.depends_on : []) {
      if (!ids.has(dep)) d.error(file, `task ${t.id} depends on unknown task "${dep}"`);
      if (dep === t.id) d.error(file, `task ${t.id} depends on itself`);
    }
  }
  const cycle = findCycle(tasks);
  if (cycle) d.error(file, `dependency cycle: ${cycle.join(" -> ")}`);
  return d;
}
function findCycle(tasks) {
  const deps = /* @__PURE__ */ new Map();
  for (const t of tasks) if (typeof t?.id === "string") deps.set(t.id, isStrList(t.depends_on) ? t.depends_on : []);
  const state = /* @__PURE__ */ new Map();
  const stack = [];
  const visit = (id) => {
    if (state.get(id) === 2) return null;
    if (state.get(id) === 1) return [...stack.slice(stack.indexOf(id)), id];
    state.set(id, 1);
    stack.push(id);
    for (const dep of deps.get(id) ?? []) {
      if (!deps.has(dep)) continue;
      const c = visit(dep);
      if (c) return c;
    }
    stack.pop();
    state.set(id, 2);
    return null;
  };
  for (const id of deps.keys()) {
    const c = visit(id);
    if (c) return c;
  }
  return null;
}
function canonicalTasks(text2) {
  const { tasks, error } = parseTasks(text2);
  if (error) return text2.replace(/\r\n?/g, "\n");
  const planned2 = tasks.filter((t) => !ADDED_ORIGINS.includes(String(t?.origin))).map((t) => {
    const copy = { ...t };
    for (const f of RUNTIME_FIELDS) delete copy[f];
    return copy;
  });
  return stableStringify(planned2);
}
function planSha(t) {
  const copy = { ...t };
  for (const f of RUNTIME_FIELDS) delete copy[f];
  return (0, import_node_crypto2.createHash)("sha256").update(stableStringify(copy)).digest("hex").slice(0, 16);
}
function stableStringify(v) {
  if (Array.isArray(v)) return `[${v.map(stableStringify).join(",")}]`;
  if (v && typeof v === "object") {
    const obj2 = v;
    return `{${Object.keys(obj2).sort().map((k) => `${JSON.stringify(k)}:${stableStringify(obj2[k])}`).join(",")}}`;
  }
  return JSON.stringify(v) ?? "null";
}

