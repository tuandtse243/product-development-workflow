  ].join("\n");
}
function qualityMd(p, change, tasks) {
  const text2 = readText(qualityFile(change)) ?? "";
  const { config } = parseQuality(text2, "quality.yaml");
  const summary = readSummary(change);
  const conv = lastConverge(change);
  const deploy2 = lastDeploy(change);
  const out = [`# Quality report: ${String(change.data.title ?? change.id)}`, ""];
  out.push("## Layers", "", "| Layer | Status | Last run | Fix rounds | Commands | Review |", "|---|---|---|---|---|---|");
  for (const l of config?.layers ?? []) {
    const r = summary.layers[l.name];
    const rounds = tasks.filter((t) => t.origin === "quality" && t.layer === l.name).length;
    const review = l.review ? `${l.review} reviewer: ${r?.review ? `${r.review.verdict} (${r.review.at})` : "no verdict"}` : "-";
    const cmds = [...l.setup, ...l.run].map((c) => `\`${c}\``).join("<br>") || "(review only)";
    out.push(`| ${l.name} | ${r?.status ?? "not run"} | ${r?.at ?? "-"} | ${rounds} | ${cell(cmds)} | ${cell(review)} |`);
  }
  out.push("");
  const absent = (n) => !config?.layers.some((l) => l.name === n);
  const notRun = [
    ...EXPECTED_LAYERS.filter(absent).map((n) => `layer "${n}" was not in the approved quality profile (see the Analysis for why)`),
    ...RECOMMENDED_LAYERS.filter(absent).map((n) => `layer "${n}" was not in the approved quality profile: nothing here covers it`),
    ...Object.entries(summary.layers).flatMap(([n, r]) => r.missing_reports?.length ? [`layer "${n}": declared report(s) missing: ${r.missing_reports.join(", ")}`] : [])
  ];
  out.push("## Not covered", "", ...notRun.length ? notRun.map((m) => `- ${m}`) : ["Nothing beyond the layers above."], "");
  const fixes = tasks.filter((t) => t.origin === "quality");
  out.push("## Quality fix history", "");
  if (!fixes.length) out.push("No layer failed.");
  for (const t of fixes) {
    const first = String(t.problem ?? "").split("\n")[0] ?? "";
    out.push(`- ${t.id} (${statusOf(t)}, ${String(t.attempts ?? 0)} attempt(s)): ${first}`);
  }
  out.push("");
  out.push("## Scenarios (converge)", "");
  if (!conv) out.push("Converge did not run.");
  else {
    out.push(
      conv.mode === "junit" ? "Evidence: passing test cases in the layers' JUnit reports, on the delivered code." : "Evidence: **presence only** (no JUnit reports configured): a non-skipped test names each scenario and every layer passed. A test that names a scenario but asserts the wrong thing would not be caught here; the per-task reviewer checked the assertions.",
      "",
      "| Scenario | Status | Evidence |",
      "|---|---|---|",
      ...Object.entries(conv.scenarios).map(([s, r]) => `| \`${s}\` | ${r.status} | ${cell(r.where.slice(0, 3).join("; ") || "-")} |`)
    );
  }
  out.push("");
  const remark = (notes) => cell(notes.slice(notes.search(/non-blocking/i)).replace(/^non-blocking:?\s*/i, ""));
  const nonBlocking = [
    ...tasks.flatMap(
      (t) => (readEvidence(change, t.id)?.reviews ?? []).filter((r) => r.verdict === "pass" && /non-blocking/i.test(r.notes)).map((r) => `- ${t.id}: ${remark(r.notes)}`)
    ),
    ...Object.entries(summary.layers).flatMap(([n, r]) => r.review?.verdict === "pass" && /non-blocking/i.test(r.review.notes) ? [`- layer ${n}: ${remark(r.review.notes)}`] : [])
  ];
  out.push("## Reviewer remarks (non-blocking)", "", ...nonBlocking.length ? nonBlocking : ["None recorded."], "");
  out.push("## Deploy", "", deployLine(deploy2), "");
  return out.join("\n");
}
function deployLine(d) {
  if (!d) return "Not deployed.";
  if (d.skipped) return `No deployment (target \`${d.target}\`).`;
  return d.ok ? `Preview: ${d.url} (smoke checks passed, ${d.at}).` : `Failed: ${d.error ?? "unknown"}.`;
}
function decisionsMd(p) {
  const adrs = walkFiles(p.decisions).filter((f) => f.endsWith(".md")).map((f) => {
    const title = ((0, import_node_fs19.readFileSync)(f, "utf8").match(/^#\s+(.+)$/m)?.[1] ?? "").trim();
    return `- \`${rel(p, f)}\`${title ? `: ${title}` : ""}`;
  });
  return ["# Decisions", "", "Architecture decision records of the project (see also `## Architecture` in the Analysis).", "", ...adrs.length ? adrs : ["No ADRs."], ""].join("\n");
}
function screenshots(change) {
  const dir = (0, import_node_path24.join)(deliveryDir(change), "screenshots");
  return (0, import_node_fs19.existsSync)(dir) ? (0, import_node_fs19.readdirSync)(dir).filter((f) => IMAGE2.test(f)).sort() : [];
}
function seedScreenshots(p, id, change, tasks) {
  const target = (0, import_node_path24.join)(deliveryDir(change), "screenshots");
  if (screenshots(change).length) return [];
  const copied = [];
  const rank = (f) => (/desktop/i.test(f) ? 0 : 2) + (/dark/i.test(f) ? 1 : 0);
  for (const t of tasks.filter((x) => touchesUi(x) && statusOf(x) === "done")) {
    const dir = shotsDir(p, id, String(t.id));
    if (!(0, import_node_fs19.existsSync)(dir)) continue;
    const files = (0, import_node_fs19.readdirSync)(dir).filter((f) => /\.png$/i.test(f)).map((f) => ({ f, at: (0, import_node_fs19.statSync)((0, import_node_path24.join)(dir, f)).mtimeMs })).sort((a, b) => rank(a.f) - rank(b.f) || b.at - a.at).slice(0, 2);
    for (const { f } of files) {
      const name = `${String(copied.length + 1).padStart(2, "0")}-${String(t.id)}-${f}`;
      (0, import_node_fs19.copyFileSync)((0, import_node_path24.join)(dir, f), (0, import_node_path24.join)(target, name));
      copied.push(name);
    }
  }
  return copied;
}
function needsScreenshots(tasks) {
  return tasks.some((t) => touchesUi(t));
}
var SCRIPT_CALL = /\b(npm|pnpm|yarn|bun)\s+(?:run\s+)?([a-z0-9][\w:.-]*)/gi;
var PM_BUILTINS = new Set(
  "install i add remove rm uninstall update up upgrade ci init create exec dlx x link unlink publish pack audit outdated why list ls config cache info view login logout version help store prune rebuild dedupe import patch patch-commit env setup global bin root run test start".split(" ")
);
function staleReadmeCommands(project) {
  const readme = readText((0, import_node_path24.join)(project, "README.md"));
  const pkgText = readText((0, import_node_path24.join)(project, "package.json"));
  if (readme === null || pkgText === null) return [];
  let scripts = {};
  try {
    scripts = JSON.parse(pkgText).scripts ?? {};
  } catch {
    return [];
  }
  const out = /* @__PURE__ */ new Set();
  for (const m of readme.matchAll(SCRIPT_CALL)) {
    const pm = m[1].toLowerCase();
    const name = m[2];
    const explicitRun = /\srun\s/.test(m[0]);
    if (!explicitRun && (name === "test" || name === "start")) {
      if (!(name in scripts)) out.add(m[0]);
      continue;
    }
    if (!explicitRun && (pm === "npm" || PM_BUILTINS.has(name))) continue;
    if (!(name in scripts)) out.add(m[0]);
  }
  return [...out];
}
function checkDelivery(p, id) {
  const change = loadChange(p, id);
  const d = new Diags();
  const dir = deliveryDir(change);
  const where = (f) => rel(p, (0, import_node_path24.join)(dir, f));
  for (const f of ["README.md", "quality-report.md", "tasks.md", "decisions.md", "handoff.md"]) {
    if (!(0, import_node_fs19.existsSync)((0, import_node_path24.join)(dir, f))) d.error(where(f), "missing; run `aidw deliver`");
  }
  const handoff = readText((0, import_node_path24.join)(dir, "handoff.md"));
  if (handoff !== null) {
    const secs = sections(handoff);
    for (const name of HANDOFF_SECTIONS) {
      const s = secs.find((x) => x.name.toLowerCase() === name.toLowerCase());
      if (!s) d.error(where("handoff.md"), `missing section "## ${name}"`);
      else if (!s.body.trim()) d.error(where("handoff.md"), `section "## ${name}" is empty`, s.line);
    }
    handoff.split(/\r?\n/).forEach((l, i) => {
      if (l.includes(PLACEHOLDER2)) d.error(where("handoff.md"), `unresolved ${PLACEHOLDER2} placeholder`, i + 1);
    });
    const env = secs.find((x) => x.name.toLowerCase() === "environment");
    if (env && !env.body.includes(PLACEHOLDER2) && !/^\s*none\b/im.test(env.body) && !(0, import_node_fs19.existsSync)((0, import_node_path24.join)(p.project, ".env.example"))) {
      d.error(rel(p, (0, import_node_path24.join)(p.project, ".env.example")), 'missing: the handoff lists environment variables, so ship a .env.example (or write "None" under ## Environment)');
    }
  }
  if (needsScreenshots(loadTasks(p, id).tasks) && screenshots(change).length === 0) {
    d.error(where("screenshots/"), "no screenshots (png, jpg, webp) of the main flows; this change has UI tasks");
  }
  if (!lastConverge(change)?.ok) d.error(where("quality-report.md"), "converge has not passed");
  if (!(0, import_node_fs19.existsSync)((0, import_node_path24.join)(p.project, "README.md"))) d.warn("README.md", "the project has no README: write one (what it is, run locally, tests, preview URL)");
  for (const c of staleReadmeCommands(p.project)) {
    d.error("README.md", `\`${c}\` calls a script that package.json does not define; update the README to the commands that work`);
  }
  return d;
}
function deliver(p, id, opts = {}) {
  const change = loadChange(p, id);
  if (stateOf(change) !== "delivered") throw new OpError(`change "${id}" is "${String(change.data.state)}"; aidw deliver runs in state delivered`);
  loadQuality(p, change);
  const dir = deliveryDir(change);
  const written = [];
  let createdHandoff = false;
  if (!opts.check) {
    const tasks = loadTasks(p, id).tasks;
    (0, import_node_fs19.mkdirSync)((0, import_node_path24.join)(dir, "screenshots"), { recursive: true });
    for (const f of seedScreenshots(p, id, change, tasks)) written.push(rel(p, (0, import_node_path24.join)(dir, "screenshots", f)));
    const write = (name, text2) => {
      (0, import_node_fs19.writeFileSync)((0, import_node_path24.join)(dir, name), text2);
      written.push(rel(p, (0, import_node_path24.join)(dir, name)));
    };
    write("quality-report.md", qualityMd(p, change, tasks));
    write("tasks.md", tasksMd(p, change, tasks));
    write("decisions.md", decisionsMd(p));
    if (!(0, import_node_fs19.existsSync)((0, import_node_path24.join)(dir, "handoff.md"))) {
      (0, import_node_fs19.writeFileSync)((0, import_node_path24.join)(dir, "handoff.md"), HANDOFF(String(change.data.title ?? id)));
      createdHandoff = true;
    }
    write("README.md", readmeMd(p, change, tasks));
  }
  return { dir: rel(p, dir), written, created_handoff: createdHandoff, screenshots: screenshots(change).length, diags: checkDelivery(p, id) };
}
function readmeMd(p, change, tasks) {
  const deploy2 = lastDeploy(change);
  const shots = screenshots(change);
  const done = tasks.filter((t) => statusOf(t) === "done").length;
  const summary = readSummary(change);
  const layers = Object.entries(summary.layers).map(([n, r]) => `${n} ${r.status}`).join(", ") || "none";
  const conv = lastConverge(change);
  const env = (0, import_node_fs19.existsSync)((0, import_node_path24.join)(p.project, ".env.example"));
  return [
    `# Delivery: ${String(change.data.title ?? change.id)}`,
    "",
    `Change \`${change.id}\` \xB7 ${done}/${tasks.length} tasks done \xB7 quality: ${layers} \xB7 scenarios: ${conv ? `${Object.values(conv.scenarios).filter((r) => r.status === "pass").length}/${Object.keys(conv.scenarios).length} passing (${conv.mode})` : "not converged"}`,
    "",
    "## Deploy",
    "",
    deployLine(deploy2),
    "",
    "## Contents",
    "",
    "- [handoff.md](handoff.md): overview, run locally, environment, deploy, usage, known issues, next steps",
    "- [quality-report.md](quality-report.md): every layer with evidence, what failed and what was not covered",
    "- [tasks.md](tasks.md): plan and task status, attempts, reviews, commits",
    "- [decisions.md](decisions.md): architecture decision records",
    `- [screenshots/](screenshots/): ${shots.length ? shots.join(", ") : "none"}`,
    "- [../analysis.md](../analysis.md): the approved Analysis (scope, stack, design, plan, permissions, risks)",
    `- \`.env.example\` at the project root: ${env ? "yes" : "no"}`,
    "",
    "Evidence behind every line: `../evidence/` (per task, per quality layer, converge, deploy).",
    ""
  ].join("\n");
}

// src/audit.ts
var import_node_fs20 = require("node:fs");
var import_node_path25 = require("node:path");
var SEVERITIES = ["critical", "high", "medium", "low"];
var lensFile = (p, lens) => (0, import_node_path25.join)(p.run, `audit-${lens}.md`);
var reportFile = (change) => (0, import_node_path25.join)(change.dir, "audit-report.md");
function lensRoles(w) {
  return w.stages.find((s) => s.lenses)?.lenses ?? {};
}
function chosenLenses(p, id) {
  return answerOf(loadChange(p, id), "audit-lenses");
}
function parseLens(text2, lens, file) {
  const d = new Diags();
  const lines = text2.replace(/\r\n?/g, "\n").split("\n");
  if ((lines[0] ?? "").trim() !== `LENS: ${lens}`) d.error(file, `the first line must be exactly "LENS: ${lens}"`);
  const section2 = (name) => {
    const at = lines.findIndex((l) => l.trim().toLowerCase() === `## ${name}`);
    if (at < 0) return null;
    const rest = lines.slice(at + 1);
    const end = rest.findIndex((l) => /^##\s/.test(l));
    return (end < 0 ? rest : rest.slice(0, end)).map((l) => l.trim()).filter(Boolean);
  };
  const findings = [];
  const body = section2("findings");
  if (!body) d.error(file, 'missing section "## Findings"');
  else if (!(body.length === 1 && /^none\.?$/i.test(body[0]))) {
    for (const l of body) {
      const m = /^- \[(critical|high|medium|low)\]\s+(\S.*)$/i.exec(l);
      if (m) findings.push({ severity: m[1].toLowerCase(), lens, text: m[2].trim() });
      else d.error(file, `"${l.slice(0, 60)}" must be "- [critical|high|medium|low] <where>: <problem>", or the section says None`);
    }
    if (!findings.length && !d.errors.length) d.error(file, '"## Findings" is empty: list findings or write None');
  }
  const notCovered = section2("not covered");
  if (!notCovered) d.error(file, 'missing section "## Not covered" (what the review could not look at, or None)');
  return { findings, notCovered: (notCovered ?? []).filter((l) => !/^none\.?$/i.test(l)), diags: d };
}
function buildAuditBrief(p, id, lens, role) {
  const change = loadChange(p, id);
  const intake = readText((0, import_node_path25.join)(change.dir, "intake.md")) ?? "";
  const out = lensFile(p, lens);
  (0, import_node_fs20.rmSync)(out, { force: true });
  const focus = {
    security: "authorization on every path, input handling, secrets, data access and exposure, dependencies with known problems",
    "code-quality": "correctness, error handling, duplication and needless complexity, tests that do not test, conventions of the constitution",
    ui: "compliance with the design tokens and direction, responsive layout, empty/loading/error states, accessibility"
  };
  const text2 = [
    `# Audit brief: ${lens} - ${String(change.data.title ?? id)}`,
    "",
    `Change \`${id}\` \xB7 lens \`${lens}\` \xB7 Role ${role}`,
    "",
    "You are an independent reviewer in a fresh context. You audit the code as it is today. You may read files and run read-only commands; you change nothing, and you do not fix what you find.",
    "",
    "## What to audit",
    "",
    `Focus: ${focus[lens] ?? lens}.`,
    "",
    "The request (scope of the audit):",
    "",
    "```markdown",
    intake.trim() || "(empty: audit the whole project)",
    "```",
    "",
    "Read first when they exist: `.aidw/constitution.md`, `.aidw/architecture/overview.md`, `.aidw/specs/`, `.aidw/design/`.",
    "",
    "## Answer",
    "",
    `**Write the whole answer to \`${out}\` with the Write tool** (the only file you may write), in this exact shape, then reply with just its first line:`,
    "",
    "```markdown",
    `LENS: ${lens}`,
    "## Findings",
    "- [critical|high|medium|low] <file or area>: <what is wrong, and why it matters>",
    "## Not covered",
    "- <what you could not look at, and why> (or None)",
    "```",
    "",
    'One bullet per finding, most serious first. Severity: critical = exploitable or data loss now; high = breaks a requirement or a real user flow; medium = wrong or fragile but contained; low = polish. Be concrete: a finding with no file or evidence is not a finding. Write `None` under Findings only if you found nothing. Under Findings write only findings: no "checked and clean" notes and no sub-headings (a clean area is not a finding; say what you did not look at under Not covered).',
    ""
  ].join("\n");
  const dir = (0, import_node_path25.join)(p.run, "briefs", id);
  (0, import_node_fs20.mkdirSync)(dir, { recursive: true });
  const path = (0, import_node_path25.join)(dir, `audit-${lens}.md`);
  (0, import_node_fs20.writeFileSync)(path, text2);
  return { path, text: text2 };
}
function compileReport(p, id, write = true) {
  const change = loadChange(p, id);
  const d = new Diags();
  const lenses = chosenLenses(p, id);
  if (!lenses) {
    d.error(rel(p, (0, import_node_path25.join)(change.dir, "decisions.yaml")), 'no lenses decided: run `aidw decide audit-lenses <lens,lens> --reason "..."`');
    return { path: reportFile(change), findings: [], diags: d };
  }
  const all2 = [];
  const notCovered = [];
  for (const lens of lenses) {
    const file = lensFile(p, lens);
    if (!(0, import_node_fs20.existsSync)(file)) {
      d.error(rel(p, file), `the "${lens}" review has not written its answer yet`);
      continue;
    }
    const parsed = parseLens((0, import_node_fs20.readFileSync)(file, "utf8"), lens, rel(p, file));
    d.add(parsed.diags);
    all2.push(...parsed.findings);
    notCovered.push(...parsed.notCovered.map((l) => `- [${lens}] ${l.replace(/^- /, "")}`));
  }
  if (d.errors.length) return { path: reportFile(change), findings: [], diags: d };
  const order = (s) => SEVERITIES.indexOf(s);
  const sorted = all2.map((f, i) => ({ f, i })).sort((a, b) => order(a.f.severity) - order(b.f.severity) || a.i - b.i).map((x) => x.f);
  const findings = sorted.map((f, i) => ({ ...f, id: `F-${String(i + 1).padStart(2, "0")}` }));
  const counts = SEVERITIES.map((s) => `${findings.filter((f) => f.severity === s).length} ${s}`).join(", ");
  const text2 = [
    `# Audit report: ${String(change.data.title ?? id)}`,
    "",
    `Change \`${id}\` \xB7 lenses: ${lenses.join(", ")} \xB7 ${findings.length} finding(s): ${counts}`,
    "",
    "## Findings",
    "",
    ...findings.length ? SEVERITIES.flatMap((s) => {
      const group = findings.filter((f) => f.severity === s);
      return group.length ? [`### ${s[0].toUpperCase()}${s.slice(1)}`, "", ...group.map((f) => `- ${f.id} [${f.lens}] ${f.text}`), ""] : [];
    }) : ["None.", ""],
    "## Not covered",
    "",
    ...notCovered.length ? notCovered : ["- None"],
    "",
    "## Next",
    "",
    "Pick the findings to act on (`aidw audit picks <id> F-01,F-02`); each pick becomes the request of a new bugfix or feature change.",
    ""
  ].join("\n");
  if (write) (0, import_node_fs20.writeFileSync)(reportFile(change), text2);
  return { path: reportFile(change), findings, diags: d };
}
function pickFindings(p, id, picks) {
  const report = readText(reportFile(loadChange(p, id))) ?? "";
  const byId = /* @__PURE__ */ new Map();
  for (const l of report.split("\n")) {
    const m = /^- (F-\d+) (\[.+)$/.exec(l);
    if (m) byId.set(m[1], m[2]);
  }
  const missing = picks.filter((x) => !byId.has(x));
  const text2 = [`Act on these findings of the audit ${id}:`, "", ...picks.filter((x) => byId.has(x)).map((x) => `- ${x} ${byId.get(x)}`), ""].join("\n");
  return { text: text2, missing };
}
function auditReady(p, id) {
  const r = compileReport(p, id, false);
  if (r.diags.errors.length) return `"delivered" needs every audit lens answered: ${r.diags.errors[0].message}`;
  if (!(0, import_node_fs20.existsSync)(r.path)) return `"delivered" needs the report: run \`aidw audit report\` first`;
  return null;
}

// src/installcheck.ts
var import_node_child_process3 = require("node:child_process");
var import_node_fs21 = require("node:fs");
var import_node_path26 = require("node:path");
var interactiveShell = (command, cwd, timeoutMs) => {
  const shell = process.env.SHELL && (0, import_node_fs21.existsSync)(process.env.SHELL) ? process.env.SHELL : "/bin/sh";
  const args = /\/(zsh|bash)$/.test(shell) ? ["-ic", command] : ["-c", command];
  const r = (0, import_node_child_process3.spawnSync)(shell, args, { cwd, encoding: "utf8", timeout: timeoutMs, stdio: ["ignore", "pipe", "pipe"] });
  return { ok: r.status === 0 && !r.error, out: `${r.stdout ?? ""}${r.stderr ?? ""}`.trim(), timedOut: r.error?.code === "ETIMEDOUT" };
};
var runner = interactiveShell;
var installRunner = () => runner;
var PACKAGE_MANAGERS = ["pnpm", "npm", "yarn", "bun"];
var PROBE_PACKAGE = "is-number@7.0.0";
function packageManagerOf(commands) {
  for (const c of commands) {
    const first = c.trim().split(/\s+/).find((w) => !/^[A-Za-z_][A-Za-z0-9_]*=/.test(w))?.replace(/^["'(]+/, "");
    if (first && PACKAGE_MANAGERS.includes(first)) return first;
    if (first === "npx") return "npm";
  }
  return null;
}
var probeCommand = (pm) => pm === "pnpm" ? `pnpm add --ignore-scripts ${PROBE_PACKAGE}` : pm === "yarn" ? `yarn add --ignore-scripts ${PROBE_PACKAGE}` : pm === "bun" ? `bun add --ignore-scripts ${PROBE_PACKAGE}` : `npm install --ignore-scripts --no-audit --no-fund --no-package-lock ${PROBE_PACKAGE}`;
var recordFile2 = (p) => (0, import_node_path26.join)(p.run, "install-probe.json");
var probeDir = (p) => (0, import_node_path26.join)(p.run, "install-probe");
var lastProbe = (p) => {
  try {
    const r = JSON.parse((0, import_node_fs21.readFileSync)(recordFile2(p), "utf8"));
    return r.status && r.pm && typeof r.at === "string" ? r : null;
  } catch {
    return null;
  }
};
function lastLine(out) {
  const lines = out.split("\n").map((l) => l.trim()).filter((l) => l && !/job control|no controlling tty|tty process group|^\[?\d+\]? +\d+$/i.test(l));
  return (lines[lines.length - 1] ?? "no output").slice(0, 240);
}
var sleep = (ms) => {
  if (ms > 0) Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
};
function probeInstall(p, pm, run2, o = {}) {
  const tries = o.tries ?? 3;
  const dir = probeDir(p);
  (0, import_node_fs21.rmSync)(dir, { recursive: true, force: true });
  (0, import_node_fs21.mkdirSync)(dir, { recursive: true });
  (0, import_node_fs21.writeFileSync)((0, import_node_path26.join)(dir, "package.json"), `${JSON.stringify({ name: "aidw-install-probe", private: true, version: "0.0.0" })}
`);
  let result = null;
  let last = "";
  try {
    for (let i = 1; i <= tries && !result; i++) {
      const r = run2(probeCommand(pm), dir, o.timeoutMs ?? 9e4);
      if (r.ok) {
        result = { status: i === 1 ? "ok" : "flaky", pm, attempts: i, tries, at: (/* @__PURE__ */ new Date()).toISOString(), detail: i === 1 ? `${pm} installed a test package` : `${pm} installed a test package on try ${i} of ${tries}: a package scanner or the network is slow here, so an install may need a retry` };
      } else {
        last = r.timedOut ? `no answer within ${Math.round((o.timeoutMs ?? 9e4) / 1e3)} s` : lastLine(r.out);
        if (i < tries) sleep(o.pauseMs ?? Number(process.env.AIDW_INSTALL_PAUSE_MS ?? 5e3));
      }
    }
  } finally {
    (0, import_node_fs21.rmSync)(dir, { recursive: true, force: true });
  }
  result ??= { status: "fail", pm, attempts: tries, tries, at: (/* @__PURE__ */ new Date()).toISOString(), detail: last };
  (0, import_node_fs21.mkdirSync)(p.run, { recursive: true });
  (0, import_node_fs21.writeFileSync)(recordFile2(p), `${JSON.stringify(result, null, 2)}
`);
  return result;
}
function installStatus(p, pm, run2, o = {}) {
  const last = lastProbe(p);
  const age = (o.now ?? Date.now()) - (last ? Date.parse(last.at) : 0);
  if (!o.fresh && last && last.pm === pm && last.status !== "fail" && age >= 0 && age < (o.maxAgeMs ?? 30 * 6e4)) return last;
  return probeInstall(p, pm, run2, o);
}
function installProblem(r, id) {
  return [
    `packages cannot be installed from here: \`${r.pm}\` failed ${r.tries} of ${r.tries} tries (${r.detail}).`,
    "This is the machine, not the code: no implementer can fix it, so do not start the build (or spawn another implementer) until it passes.",
    "Usual causes: a package security scanner (for example safe-chain) that times out downloading its list, a registry or proxy that is not reachable, a sandbox that denies the command.",
    `Fix it once, then check in about ten seconds with \`aidw doctor${id ? ` ${id}` : ""} --fresh\`: allow the install command outside the sandbox (/sandbox: \`excludedCommands\` or \`allowUnsandboxedCommands\`; when a command rewriter such as rtk prefixes it, allow the prefixed form too, \`rtk ${r.pm} install *\`), or warm the scanner's cache by running \`${r.pm} install\` once in your own terminal.`,
    `Shortest way out: run the build in your own terminal with \`aidw run${id ? ` ${id}` : ""} --detach\`; it runs in auto mode, where a command this sandbox blocks is run again outside it without waiting for you.`,
    "To skip this check, set AIDW_SKIP_INSTALL_CHECK=1."
  ].join(" ");
}
function installGuard(p, id, layerCommands, env = process.env, run2 = runner) {
  if (env.AIDW_SKIP_INSTALL_CHECK === "1") return null;
  const pm = packageManagerOf(layerCommands);
  if (!pm || (0, import_node_fs21.existsSync)((0, import_node_path26.join)(p.project, "node_modules"))) return null;
  const r = installStatus(p, pm, run2);
  return r.status === "fail" ? `"executing" refused: ${installProblem(r, id)}` : null;
}

// src/parallel.ts
var import_node_child_process4 = require("node:child_process");
var import_node_fs22 = require("node:fs");
var import_node_path27 = require("node:path");
var import_yaml13 = __toESM(require_dist(), 1);

// src/secrets.ts
var RULES = [
  { kind: "private key", re: /-----BEGIN (?:[A-Z]+ )?PRIVATE KEY-----/ },
  { kind: "AWS access key", re: /\b(?:AKIA|ASIA)[0-9A-Z]{16}\b/ },
  { kind: "GitHub token", re: /\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{60,})\b/ },
  { kind: "Anthropic API key", re: /\bsk-ant-[A-Za-z0-9_-]{20,}/ },
  { kind: "OpenAI API key", re: /\bsk-(?:proj-)?[A-Za-z0-9_-]{40,}/ },
  { kind: "Stripe live key", re: /\b[sr]k_live_[A-Za-z0-9]{16,}/ },
  { kind: "Stripe webhook secret", re: /\bwhsec_[A-Za-z0-9]{24,}/ },
  { kind: "Slack token", re: /\bxox[abprs]-[A-Za-z0-9-]{10,}/ },
  { kind: "Google API key", re: /\bAIza[0-9A-Za-z_-]{35}\b/ },
  { kind: "npm token", re: /\bnpm_[A-Za-z0-9]{36}\b/ },
  { kind: "SendGrid key", re: /\bSG\.[A-Za-z0-9_-]{22}\.[A-Za-z0-9_-]{43}\b/ },
  { kind: "Supabase service key", re: /\bsb_secret_[A-Za-z0-9_-]{20,}/ },
  { kind: "database URL with a password", re: /\b(?:postgres(?:ql)?|mysql|mongodb(?:\+srv)?|redis|amqps?):\/\/[^\s:@/"']+:(?!\$|<|\{|password\b|postgres\b|secret\b|example\b|changeme\b|root\b|test\b|user\b|pass\b)[^\s@/"']{8,}@(?!(?:localhost|127\.0\.0\.1|db|postgres|mongo|redis|mysql)(?:[:/?"'\s]|$))/i }
];
var ALLOW = /gitleaks:allow/;
var BINARY = /\.(?:png|jpe?g|gif|webp|ico|pdf|woff2?|ttf|zip|gz|lockb)$/i;
function scanLine(text2) {
  if (ALLOW.test(text2)) return null;
  return RULES.find((r) => r.re.test(text2))?.kind ?? null;
}
function secretsInChanges(dir, base2, changed) {
  if (changed === null) return null;
  const out = [];
  for (const file of changed) {
    if (BINARY.test(file)) continue;
    for (const { line, text: text2 } of addedLines(dir, base2, file)) {
      const kind = scanLine(text2);
      if (kind) out.push({ kind, file, line });
    }
  }
  return out;
}
function stagedSecrets(cwd) {
  const r = git(cwd, ["diff", "--cached", "-U0", "--no-color"]);
  if (!r.ok) return [];
  const out = [];
  let file = "";
  let n = 0;
  for (const l of r.out.split("\n")) {
    if (l.startsWith("+++ ")) file = l.slice(4).replace(/^b\//, "");
    else if (l.startsWith("@@")) n = Number(/\+(\d+)/.exec(l)?.[1] ?? 0);
    else if (l.startsWith("+")) {
      const kind = BINARY.test(file) ? null : scanLine(l.slice(1));
      if (kind) out.push({ kind, file, line: n });
      n++;
    }
  }
  return out;
}
var secretsProblem = (found) => `credential in the code: ${found.slice(0, 5).map((f) => `${f.kind} at ${f.file}:${f.line}`).join(", ")}${found.length > 5 ? `, and ${found.length - 5} more` : ""}`;
var secretsMessage = (found) => `refusing to commit: ${secretsProblem(found)}. Read it from an environment variable and put only its name in .env.example; a key that was real must also be revoked. A line that only looks like a key (a documented example) can carry the comment \`gitleaks:allow\`.`;

// src/touches.ts
function staticPrefix(glob) {
  const segs = glob.trim().replace(/^\.\//, "").replace(/\/+$/, "").split("/").filter(Boolean);
  const out = [];
  for (const s of segs) {
    if (/[*?{[]/.test(s)) break;
    out.push(s);
  }
  return out;
}
function globsOverlap(a, b) {
  const pa = staticPrefix(a);
  const pb = staticPrefix(b);
  for (let i = 0; i < Math.min(pa.length, pb.length); i++) if (pa[i] !== pb[i]) return false;
  return true;
}
var touchesOverlap = (a, b) => a.some((x) => b.some((y) => globsOverlap(x, y)));

// src/parallel.ts
var list3 = (v) => Array.isArray(v) ? v.map(String) : [];
var statusOf2 = (t) => String(t.status ?? "pending");
var now3 = () => (/* @__PURE__ */ new Date()).toISOString();
var BROWSER_VERIFY2 = /\b(playwright|cypress|e2e)\b/i;
var drivesBrowser = (t) => list3(t.verify).some((v) => BROWSER_VERIFY2.test(v)) || touchesUi(t);
var mustRunAlone = (t) => t.risk === "high" || t.sequential === true || list3(t.touches).some((g) => staticPrefix(g).length === 0);
function planWave(tasks, max) {
  const byId = new Map(tasks.map((t) => [t.id, t]));
  const ready = tasks.filter((t) => statusOf2(t) === "pending" && list3(t.depends_on).every((d) => statusOf2(byId.get(d) ?? { id: d }) === "done"));
  const first = ready[0];
  if (!first) return [];
  const wave = [first];
  if (mustRunAlone(first)) return wave;
  for (const t of ready.slice(1)) {
    if (wave.length >= max) break;
    if (mustRunAlone(t)) continue;
    if (wave.some((w) => touchesOverlap(list3(w.touches), list3(t.touches)))) continue;
    if (drivesBrowser(t) && wave.some(drivesBrowser)) continue;
    wave.push(t);
  }
  return wave;
}
function planWaveBeside(tasks, max, busy) {
  if (busy.some(mustRunAlone)) return [];
  const room = max - busy.length;
  if (room <= 0) return [];
  const byId = new Map(tasks.map((t) => [t.id, t]));
  const ready = tasks.filter((t) => statusOf2(t) === "pending" && list3(t.depends_on).every((d) => statusOf2(byId.get(d) ?? { id: d }) === "done"));
  const wave = [];
  for (const t of ready) {
    if (wave.length >= room) break;
    if (mustRunAlone(t)) continue;
    const all2 = [...busy, ...wave];
    if (all2.some((w) => touchesOverlap(list3(w.touches), list3(t.touches)))) continue;
    if (drivesBrowser(t) && all2.some(drivesBrowser)) continue;
    wave.push(t);
  }
  return wave;
}
