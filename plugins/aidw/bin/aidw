var PLAN_REVIEW = "plan-review";
var MAX_FIX_ROUNDS = 2;
var MAX_REVIEWS = MAX_FIX_ROUNDS + 1;
var CHECKLIST = [
  "every approved scenario has a task that really delivers it",
  "no task outside the approved scope",
  "the architecture and the plan follow the constitution",
  "no needless complexity: nothing the scenarios do not need"
];
var AREAS = ["architecture", "constitution", "contracts", "test-plan", "quality"];
var verdictFile = (p, id) => (0, import_node_path30.join)(p.run, `review-plan-${id}.md`);
var roundsFile = (change) => (0, import_node_path30.join)(change.dir, "plan-review.yaml");
var digestOf = (text2) => `sha256:${(0, import_node_crypto5.createHash)("sha256").update(text2.replace(/\r\n/g, "\n")).digest("hex")}`;
var outcomeOf = (r) => r.verdict === "pass" ? "pass" : r.round >= MAX_REVIEWS ? "carried" : "fix";
