// src/decisions.ts
var import_node_fs18 = require("node:fs");
var import_node_path20 = require("node:path");
var import_yaml10 = __toESM(require_dist(), 1);
var DECISIONS_FILE = "decisions.yaml";
var DecisionError = class extends Error {
};
var decisionsPath = (change) => (0, import_node_path20.join)(change.dir, DECISIONS_FILE);
function readDecisions(change) {
  const file = decisionsPath(change);
  if (!(0, import_node_fs18.existsSync)(file)) return {};
  try {
    const data = import_yaml10.default.parse((0, import_node_fs18.readFileSync)(file, "utf8"));
    return data && typeof data === "object" && !Array.isArray(data) ? data : {};
  } catch {
    return {};
  }
}
var answersOf = (r) => Array.isArray(r.answer) ? r.answer.map(String) : [String(r.answer)];
function workflowOfChange(p, change, pluginRoot2) {
  const id = workflowIdOf(p, change);
  const w = loadWorkflow(pluginRoot2, id);
  if (!w) throw new DecisionError(`the workflow "${id}" of change "${change.id}" was not found in the plugin`);
  return w;
}
function recordDecision(p, id, decisionId, raw, reason, pluginRoot2) {
  const change = loadChange(p, id);
  const w = workflowOfChange(p, change, pluginRoot2);
  const decision = w.decisions.find((x) => x.id === decisionId);
  if (!decision) throw new DecisionError(`workflow "${w.id}" has no decision "${decisionId}" (it has: ${w.decisions.map((x) => x.id).join(", ") || "none"})`);
  const state = change.data.state;
  if (typeof state === "string" && machineOf(p, change).approvalRequired.has(state)) {
    throw new DecisionError(`the package of "${id}" is approved: decisions are frozen with it. Escalate and go back to analyzing to change one`);
  }
  if (!reason.trim()) throw new DecisionError('a decision needs a reason (--reason "...")');
  const answers = raw.split(",").map((a) => a.trim()).filter(Boolean);
  if (!answers.length) throw new DecisionError(`answer with one of: ${decision.options.join(", ")}`);
  if (!decision.multiple && answers.length > 1) throw new DecisionError(`"${decision.id}" takes exactly one answer; got ${answers.length}`);
  const bad = answers.filter((a) => !decision.options.includes(a));
  if (bad.length) throw new DecisionError(`"${bad.join(", ")}" is not an answer of "${decision.id}" (options: ${decision.options.join(", ")})`);
  const recorded = { answer: decision.multiple ? [...new Set(answers)] : answers[0], reason: reason.trim(), by: decision.decide, at: (/* @__PURE__ */ new Date()).toISOString() };
  const all2 = readDecisions(change);
  all2[decision.id] = recorded;
  (0, import_node_fs18.writeFileSync)(decisionsPath(change), import_yaml10.default.stringify(all2));
  return { decision, recorded };
}
function checkDecisions(p, change, pluginRoot2) {
  const d = new Diags();
  let w;
  try {
    w = workflowOfChange(p, change, pluginRoot2);
  } catch {
    return d;
  }
  const file = rel(p, decisionsPath(change));
  const all2 = readDecisions(change);
  for (const x of w.decisions) {
    const r = all2[x.id];
    if (!r) {
      if (x.required) d.error(file, `decision "${x.id}" (${x.decide}) is required before approval: aidw decide ${x.id} <${x.options.join("|")}> --reason "..."`);
      continue;
    }
    const bad = answersOf(r).filter((a) => !x.options.includes(a));
    if (bad.length) d.error(file, `decision "${x.id}": "${bad.join(", ")}" is not one of ${x.options.join(", ")}`);
  }
  for (const k of Object.keys(all2)) if (!w.decisions.some((x) => x.id === k)) d.warn(file, `decision "${k}" is not a decision of the "${w.id}" workflow`);
  return d;
}
var answerOf = (change, decisionId) => {
  const r = readDecisions(change)[decisionId];
  return r ? answersOf(r) : null;
};

// src/audit.ts
var SEVERITIES = ["critical", "high", "medium", "low"];
var lensFile = (p, lens) => (0, import_node_path21.join)(p.run, `audit-${lens}.md`);
var reportFile = (change) => (0, import_node_path21.join)(change.dir, "audit-report.md");
function lensRoles(w) {
  return w.stages.find((s) => s.lenses)?.lenses ?? {};
}
function chosenLenses(p, id) {
  return answerOf(loadChange(p, id), "audit-lenses");
}
function parseLens(text, lens, file) {
  const d = new Diags();
  const lines = text.replace(/\r\n?/g, "\n").split("\n");
  if ((lines[0] ?? "").trim() !== `LENS: ${lens}`) d.error(file, `the first line must be exactly "LENS: ${lens}"`);
  const section = (name) => {
    const at = lines.findIndex((l) => l.trim().toLowerCase() === `## ${name}`);
    if (at < 0) return null;
    const rest = lines.slice(at + 1);
    const end = rest.findIndex((l) => /^##\s/.test(l));
    return (end < 0 ? rest : rest.slice(0, end)).map((l) => l.trim()).filter(Boolean);
  };
  const findings = [];
  const body = section("findings");
  if (!body) d.error(file, 'missing section "## Findings"');
  else if (!(body.length === 1 && /^none\.?$/i.test(body[0]))) {
    for (const l of body) {
      const m = /^- \[(critical|high|medium|low)\]\s+(\S.*)$/i.exec(l);
      if (m) findings.push({ severity: m[1].toLowerCase(), lens, text: m[2].trim() });
      else d.error(file, `"${l.slice(0, 60)}" must be "- [critical|high|medium|low] <where>: <problem>", or the section says None`);
    }
    if (!findings.length && !d.errors.length) d.error(file, '"## Findings" is empty: list findings or write None');
  }
  const notCovered = section("not covered");
  if (!notCovered) d.error(file, 'missing section "## Not covered" (what the review could not look at, or None)');
  return { findings, notCovered: (notCovered ?? []).filter((l) => !/^none\.?$/i.test(l)), diags: d };
}
function buildAuditBrief(p, id, lens, role) {
  const change = loadChange(p, id);
  const intake = readText((0, import_node_path21.join)(change.dir, "intake.md")) ?? "";
  const out = lensFile(p, lens);
  const focus = {
    security: "authorization on every path, input handling, secrets, data access and exposure, dependencies with known problems",
    "code-quality": "correctness, error handling, duplication and needless complexity, tests that do not test, conventions of the constitution",
    ui: "compliance with the design tokens and direction, responsive layout, empty/loading/error states, accessibility"
  };
  const text = [
    `# Audit brief: ${lens} - ${String(change.data.title ?? id)}`,
    "",
    `Change \`${id}\` \xB7 lens \`${lens}\` \xB7 Role ${role}`,
    "",
    "You are an independent reviewer in a fresh context. You audit the code as it is today. You may read files and run read-only commands; you change nothing, and you do not fix what you find.",
    "",
    "## What to audit",
    "",
    `Focus: ${focus[lens] ?? lens}.`,
    "",
    "The request (scope of the audit):",
    "",
    "```markdown",
    intake.trim() || "(empty: audit the whole project)",
    "```",
    "",
    "Read first when they exist: `.aidw/constitution.md`, `.aidw/architecture/overview.md`, `.aidw/specs/`, `.aidw/design/`.",
    "",
    "## Answer",
    "",
    `**Write the whole answer to \`${out}\` with the Write tool** (the only file you may write), in this exact shape, then reply with just its first line:`,
    "",
    "```markdown",
    `LENS: ${lens}`,
    "## Findings",
    "- [critical|high|medium|low] <file or area>: <what is wrong, and why it matters>",
    "## Not covered",
    "- <what you could not look at, and why> (or None)",
    "```",
    "",
    "One bullet per finding, most serious first. Severity: critical = exploitable or data loss now; high = breaks a requirement or a real user flow; medium = wrong or fragile but contained; low = polish. Be concrete: a finding with no file or evidence is not a finding. Write `None` under Findings only if you found nothing.",
    ""
  ].join("\n");
  const dir = (0, import_node_path21.join)(p.run, "briefs", id);
  (0, import_node_fs19.mkdirSync)(dir, { recursive: true });
  const path = (0, import_node_path21.join)(dir, `audit-${lens}.md`);
  (0, import_node_fs19.writeFileSync)(path, text);
  return { path, text };
}
function compileReport(p, id) {
  const change = loadChange(p, id);
  const d = new Diags();
  const lenses = chosenLenses(p, id);
  if (!lenses) {
    d.error(rel(p, (0, import_node_path21.join)(change.dir, "decisions.yaml")), 'no lenses decided: run `aidw decide audit-lenses <lens,lens> --reason "..."`');
    return { path: reportFile(change), findings: [], diags: d };
  }
  const all2 = [];
  const notCovered = [];
  for (const lens of lenses) {
    const file = lensFile(p, lens);
    if (!(0, import_node_fs19.existsSync)(file)) {
      d.error(rel(p, file), `the "${lens}" review has not written its answer yet`);
      continue;
    }
    const parsed = parseLens((0, import_node_fs19.readFileSync)(file, "utf8"), lens, rel(p, file));
    d.add(parsed.diags);
    all2.push(...parsed.findings);
    notCovered.push(...parsed.notCovered.map((l) => `- [${lens}] ${l.replace(/^- /, "")}`));
  }
  if (d.errors.length) return { path: reportFile(change), findings: [], diags: d };
  const order = (s) => SEVERITIES.indexOf(s);
  const sorted = all2.map((f, i) => ({ f, i })).sort((a, b) => order(a.f.severity) - order(b.f.severity) || a.i - b.i).map((x) => x.f);
  const findings = sorted.map((f, i) => ({ ...f, id: `F-${String(i + 1).padStart(2, "0")}` }));
  const counts = SEVERITIES.map((s) => `${findings.filter((f) => f.severity === s).length} ${s}`).join(", ");
  const text = [
    `# Audit report: ${String(change.data.title ?? id)}`,
    "",
    `Change \`${id}\` \xB7 lenses: ${lenses.join(", ")} \xB7 ${findings.length} finding(s): ${counts}`,
    "",
    "## Findings",
    "",
    ...findings.length ? SEVERITIES.flatMap((s) => {
      const group = findings.filter((f) => f.severity === s);
      return group.length ? [`### ${s[0].toUpperCase()}${s.slice(1)}`, "", ...group.map((f) => `- ${f.id} [${f.lens}] ${f.text}`), ""] : [];
    }) : ["None.", ""],
    "## Not covered",
    "",
    ...notCovered.length ? notCovered : ["- None"],
    "",
    "## Next",
    "",
    "Pick the findings to act on (`aidw audit picks <id> F-01,F-02`); each pick becomes the request of a new bugfix or feature change.",
    ""
  ].join("\n");
  (0, import_node_fs19.writeFileSync)(reportFile(change), text);
  return { path: reportFile(change), findings, diags: d };
}
function pickFindings(p, id, picks) {
  const report = readText(reportFile(loadChange(p, id))) ?? "";
  const byId = /* @__PURE__ */ new Map();
  for (const l of report.split("\n")) {
    const m = /^- (F-\d+) (\[.+)$/.exec(l);
    if (m) byId.set(m[1], m[2]);
  }
  const missing = picks.filter((x) => !byId.has(x));
  const text = [`Act on these findings of the audit ${id}:`, "", ...picks.filter((x) => byId.has(x)).map((x) => `- ${x} ${byId.get(x)}`), ""].join("\n");
  return { text, missing };
}
function auditReady(p, id) {
  const r = compileReport(p, id);
  if (r.diags.errors.length) return `"delivered" needs every audit lens answered: ${r.diags.errors[0].message}`;
  return null;
}

// src/guards.ts
function transitionGuard(p, id, target) {
  const change = loadChange(p, id);
  if (workflowIdOf(p, change) === "audit") return target === "delivered" ? auditReady(p, id) : null;
  if (target === "awaiting_scope_approval") {
    const d = checkBrief(change);
    if (d.errors.length) return `"awaiting_scope_approval" needs the product brief: ${d.errors[0].message}`;
  }
  if (target === "awaiting_approval") {
    const why = scopeGuard(change);
    if (why) return `"awaiting_approval" refused: ${why}`;
  }
  if (!("deploying" in machineOf(p, change).transitions)) return null;
  if (target === "verifying") {
    const open = loadTasks(p, id).tasks.filter((t) => String(t.status ?? "pending") !== "done");
    if (open.length) return `"verifying" needs every task done; open: ${open.map((t) => `${t.id} (${String(t.status ?? "pending")})`).join(", ")}`;
    const merged = pendingIntegration(loadChange(p, id), loadTasks(p, id).tasks);
    if (merged.length) return `"verifying" needs the last wave integrated: run \`aidw integrate\` (merged: ${merged.map((t) => t.id).join(", ")})`;
  }
  if (target === "converging") {
    const q = qualityPassed(p, id);
    if (!q.ok) return `"converging" needs every quality layer passing on the current code; run \`aidw verify\` (pending: ${q.pending.join(", ")})`;
  }
  if (target === "deploying") {
    const c = convergePassed(p, id);
    if (!c.ok) return `"deploying" needs a passing converge on the current code: ${c.reason}`;
  }
  if (target === "delivered") {
    const d = lastDeploy(loadChange(p, id));
    if (!d?.ok) return `"delivered" needs a successful \`aidw deploy\`${d ? ` (last: ${d.error ?? "failed"})` : ""}`;
  }
  return null;
}

