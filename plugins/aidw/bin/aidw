var SKELETON_DIRS = ["requirements", "specs", "domain", "architecture", "decisions", "design", "changes", "archive", "run"];
function initProject(projectDir) {
  const p = pathsFor(projectDir);
  if ((0, import_node_fs7.existsSync)(p.aidw)) throw new OpError(`${rel(p, p.aidw)}/ already exists; refusing to overwrite`);
  const created = [];
  const write = (file, content) => {
    (0, import_node_fs7.mkdirSync)((0, import_node_path8.dirname)(file), { recursive: true });
    (0, import_node_fs7.writeFileSync)(file, content);
    created.push(rel(p, file));
  };
  write(p.projectYaml, PROJECT_YAML((0, import_node_path8.basename)(projectDir)));
  write(p.constitution, CONSTITUTION);
  write((0, import_node_path8.join)(p.aidw, ".gitignore"), "run/\n");
  for (const d of SKELETON_DIRS) {
    const keep = (0, import_node_path8.join)(p.aidw, d, ".gitkeep");
    if (d !== "run") write(keep, "");
    else (0, import_node_fs7.mkdirSync)((0, import_node_path8.join)(p.aidw, d), { recursive: true });
  }
  return { created, paths: p };
}
var INPUT_TYPES = ["idea", "prd", "upwork_jd", "client_request", "codebase"];
var INTAKE = (title) => `# Intake: ${title}

## Input type

<idea | prd | upwork_jd | client_request | codebase>

## Source

<paste or link the original request; keep the client's wording>

## Client constraints

- Stack required by the client: <none | ...>
- Deadline / budget / other: <...>
`;
function newChange(p, id, opts) {
  if (!CHANGE_ID.test(id)) throw new OpError(`change id "${id}" must be kebab-case (e.g. 2026-11-08-booking-app)`);
  if (opts.inputType && !INPUT_TYPES.includes(opts.inputType)) {
    throw new OpError(`unknown input type "${opts.inputType}" (expected ${INPUT_TYPES.join(", ")})`);
  }
  const dir = changeDir(p, id);
  if ((0, import_node_fs7.existsSync)(dir)) throw new OpError(`change "${id}" already exists`);
  const title = opts.title ?? id;
  (0, import_node_fs7.mkdirSync)((0, import_node_path8.join)(dir, "specs"), { recursive: true });
  (0, import_node_fs7.writeFileSync)(
    (0, import_node_path8.join)(dir, "change.yaml"),
    [
      "schema: 1",
      `id: ${id}`,
      `title: ${JSON.stringify(title)}`,
      `input_type: ${opts.inputType ?? "null"}`,
      "state: draft",
      `created_at: ${now()}`,
      "skip_specs: false",
      "approval: null",
      "run:",
      "  paused: null",
      ""
    ].join("\n")
  );
  (0, import_node_fs7.writeFileSync)((0, import_node_path8.join)(dir, "intake.md"), INTAKE(title));
  (0, import_node_fs7.writeFileSync)((0, import_node_path8.join)(dir, "analysis.md"), ANALYSIS(title));
  recordBaseline(p);
  return dir;
}
var ANALYSIS = (title) => `# Analysis: ${title}

## Summary

${PLACEHOLDER}: one page the user can review in minutes - goal, scope, the 5-10 key decisions, and the risks and assumptions that need their attention.

## Requirements and scope

${PLACEHOLDER}: in scope, out of scope, assumptions. Link .aidw/requirements/<change>.md.

## Domain

${PLACEHOLDER}: key entities and business rules. Link .aidw/domain/model.md.

## Stack

Source: ${PLACEHOLDER} (client | ai | fallback)

${PLACEHOLDER}: chosen stack and why. If outside the familiar stack pool, say why.

## Design

Mode: ${PLACEHOLDER} (existing | claude_design | ai_design | hybrid)

${PLACEHOLDER}: design references, bundle, or AI design direction.

## Architecture

${PLACEHOLDER}: architecture overview and new ADRs. Link .aidw/architecture/overview.md.

## Specs

${PLACEHOLDER}: capabilities added or changed, number of requirements and scenarios.

## Plan

${PLACEHOLDER}: number of tasks and waves, what can run in parallel, which agents are needed.

## Quality profile

${PLACEHOLDER}: quality layers that run (code, unit, integration, e2e, ui-ux, a11y, security, performance, review) and their thresholds.

## Deploy strategy

${PLACEHOLDER}: local | preview | staging | production (production always asks first).

## Permissions

${PLACEHOLDER}: one bullet per tier-2 resource requested (free cloud resources, preview deploys), or "None".

## Risks and assumptions

${PLACEHOLDER}: what could go wrong and what was assumed.

## Appendix: discovery Q&A

${PLACEHOLDER}: the grilling rounds, questions and answers.
`;
function readinessCheck(p, id, asState) {
  const d = checkChange(p, id, asState ? { asState } : {});
  d.add(analyzeChange(p, id));
  return d;
}
function approve(p, id) {
  const change = loadChange(p, id);
  const state = stateOf(change);
  if (state !== "awaiting_approval") {
    throw new OpError(`change "${id}" is in state "${String(change.data.state)}"; only "awaiting_approval" can be approved`);
  }
  const d = readinessCheck(p, id);
  if (d.errors.length) throw new OpError(`change "${id}" has validation errors; fix them before approving`, d);
  const { hash, files } = computeApprovalHash(p, change);
  change.doc.set("approval", change.doc.createNode({ hash, at: now(), by: "user" }));
  change.doc.set("state", "approved");
  saveChange(change);
  return { hash, files };
}
function transition(p, id, to, opts) {
  const change = loadChange(p, id);
  const from = stateOf(change);
  if (!from) throw new OpError(`change "${id}" has an unknown state "${String(change.data.state)}"`);
  let target;
  if (to === "resume") {
    if (from !== "paused") throw new OpError(`change "${id}" is not paused`);
    const back = change.data.run?.paused?.from;
    if (!back || !RESUMABLE.includes(back)) {
      throw new OpError(`change "${id}" has no valid paused.from state to resume to`);
    }
    target = back;
  } else {
    if (to === "approved") throw new OpError("use `aidw approve` to approve a change");
    if (to === "archived") throw new OpError("use `aidw archive` to archive a change");
    if (!TRANSITIONS[from].includes(to)) {
      const allowed = TRANSITIONS[from].join(", ") || "none";
      throw new OpError(`cannot go from "${from}" to "${to}" (allowed: ${allowed})`);
    }
    target = to;
  }
  if (POST_APPROVAL.has(target) && target !== "escalated") {
    const a = approvalStatus(p, change);
    if (a.status !== "valid") {
      throw new OpError(
        a.status === "none" ? `"${target}" requires an approval` : "approval drift: the approved Analysis package changed; go back to analyzing (via escalated) and approve again"
      );
    }
  }
  if (target === "awaiting_approval") {
    const d = readinessCheck(p, id, target);
    if (d.errors.length) throw new OpError("Analysis package is not ready for approval", d);
  }
  if (target === "paused") {
    change.doc.setIn(["run", "paused"], change.doc.createNode({ from, reason: opts.reason ?? "unspecified", at: now() }));
  } else if (from === "paused") {
    change.doc.setIn(["run", "paused"], null);
  }
  if (target === "analyzing" && from !== "intake") {
    change.doc.set("approval", null);
  }
  change.doc.set("state", target);
  saveChange(change);
  return { from, to: target };
}
function planMerge(p, id) {
  const change = loadChange(p, id);
  const d = new Diags();
  const files = deltaFiles(p, change, d);
  const results = [];
  for (const df of files) {
    const r = applyDelta(readText(df.mainFile), (0, import_node_fs7.readFileSync)(df.file, "utf8"), df.capability);
    if (!r.ok || !r.text) {
      for (const e of r.errors) d.error(rel(p, df.file), e);
      continue;
    }
    results.push({ capability: df.capability, file: df.mainFile, created: r.created, summary: r.summary, text: r.text });
  }
  if (d.errors.length) throw new OpError(`merge of change "${id}" failed; nothing was written`, d);
  return results;
}
function writeMerge(merges) {
  for (const m of merges) {
    (0, import_node_fs7.mkdirSync)((0, import_node_path8.dirname)(m.file), { recursive: true });
    (0, import_node_fs7.writeFileSync)(m.file, m.text);
  }
}
function archiveChange(p, id) {
  const change = loadChange(p, id);
  if (stateOf(change) !== "delivered") {
    throw new OpError(`change "${id}" is in state "${String(change.data.state)}"; only "delivered" changes can be archived`);
  }
  const d = checkChange(p, id);
  if (d.errors.length) throw new OpError(`change "${id}" has validation errors; nothing was archived`, d);
  const merges = planMerge(p, id);
  const date = now().slice(0, 10);
  const name = /^\d{4}-\d{2}-\d{2}-/.test(id) ? id : `${date}-${id}`;
  const target = (0, import_node_path8.join)(p.archive, name);
  if ((0, import_node_fs7.existsSync)(target)) throw new OpError(`archive target ${rel(p, target)} already exists`);
  writeMerge(merges);
  change.doc.set("state", "archived");
  change.doc.set("archived_at", now());
  saveChange(change);
  (0, import_node_fs7.mkdirSync)(p.archive, { recursive: true });
  (0, import_node_fs7.renameSync)(change.dir, target);
  return { target, merges };
}
function projectStatus(p, only) {
  let capabilities = 0;
  let requirements = 0;
  for (const f of walkFiles(p.specs)) {
    if (!capabilityOf(p.specs, f)) continue;
    capabilities++;
    requirements += parseSpec((0, import_node_fs7.readFileSync)(f, "utf8")).requirements.length;
  }
  const ids = only ? [only] : listChangeIds(p);
  const changes = ids.map((id) => {
    try {
      const c = loadChange(p, id);
      const tasksText = readText((0, import_node_path8.join)(c.dir, "tasks.yaml"));
      let tasks = null;
      if (tasksText !== null) {
        const byStatus = {};
        const list = parseTasks(tasksText).tasks;
        for (const t of list) {
          const s = String(t?.status ?? "pending");
          byStatus[s] = (byStatus[s] ?? 0) + 1;
        }
        tasks = { total: list.length, done: byStatus.done ?? 0, byStatus };
      }
      const paused = c.data.run?.paused ?? null;
      return {
        id,
        ...typeof c.data.title === "string" ? { title: c.data.title } : {},
        state: String(c.data.state),
        approval: approvalStatus(p, c).status,
        tasks,
        paused,
        deltas: deltaFiles(p, c, new Diags()).length
      };
    } catch (e) {
      if (e instanceof ChangeError) {
        return { id, state: "?", approval: "none", tasks: null, paused: null, deltas: 0, error: e.message };
      }
      throw e;
    }
  });
  return { project: p.project, engineVersion: VERSION, specs: { capabilities, requirements }, changes };
}
function assertProject(p) {
  if (!isDir(p.aidw)) throw new OpError(`no .aidw/ in ${p.project}; run \`aidw init\``);
}

// src/cli.ts
var HELP = `aidw ${VERSION} - deterministic core of the AI Fullstack Autonomous Development Workflow

Usage: aidw <command> [args] [--json] [--root <dir>]

  init                                   create .aidw/ in the current directory (or --root)
  change new <id> [--title T] [--input-type ${INPUT_TYPES.join("|")}]
  status [<id>]                          project and change status
  validate [<id>] [--strict]             validate specs and changes (all when no id)
  approve <id>                           approve the Analysis package (hashes it)
  approval check <id>                    exit 1 when the approved package drifted
  transition <id> <state|resume> [--reason R]
  merge <id> [--write]                   merge delta specs into .aidw/specs (dry run by default)
  archive <id>                           merge deltas and move a delivered change to archive/
  analyze [<id>]                         pre-gate consistency checks (analysis.md, task coverage)
  ids [<id>]                             requirement and scenario ids (after applying the change)
  vendor-path <upstream>/<skill>         absolute path of a vendored SKILL.md (e.g. pocock/grilling)
  plugin-path <path>                     absolute path of a plugin file (e.g. profiles/stack-pool.md)
  gate                                   PreToolUse hook: reads hook JSON on stdin
  backstop                               Stop hook: reads hook JSON on stdin
  version

States: ${STATES.join(", ")}
Exit codes: 0 ok, 1 failed check or refused operation, 2 usage error
`;
var VALUE_FLAGS = /* @__PURE__ */ new Set(["root", "title", "input-type", "reason"]);
function parseArgs(argv) {
  const pos = [];
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith("--")) {
      pos.push(a);
      continue;
    }
    const eq = a.indexOf("=");
    const name = eq > 0 ? a.slice(2, eq) : a.slice(2);
    if (eq > 0) flags[name] = a.slice(eq + 1);
    else if (VALUE_FLAGS.has(name)) {
      const v = argv[i + 1];
      if (v === void 0 || v.startsWith("--")) throw new UsageError(`--${name} needs a value`);
      flags[name] = v;
      i++;
    } else flags[name] = true;
  }
  return { pos, flags };
}
var UsageError = class extends Error {
};
function pluginRoot(env) {
  if (env.AIDW_PLUGIN_ROOT) return env.AIDW_PLUGIN_ROOT;
  if (typeof __dirname !== "undefined") return (0, import_node_path9.join)(__dirname, "..");
  if (env.CLAUDE_PLUGIN_ROOT) return env.CLAUDE_PLUGIN_ROOT;
  return (0, import_node_path9.join)(process.cwd(), "plugins", "aidw");
}
function fmtDiag(d) {
  const where = d.line ? `${d.file}:${d.line}` : d.file;
  return `${d.level === "error" ? "ERROR" : "WARN "}  ${where}  ${d.message}`;
}
function str(v) {
  return typeof v === "string" ? v : void 0;
}
function run(argv, env, cwd, io) {
  let args;
  try {
    args = parseArgs(argv);
  } catch (e) {
    io.err(`aidw: ${e.message}
`);
    return 2;
  }
  const json = args.flags.json === true;
  const [cmd2, ...rest] = args.pos;
  const emit = (data, text) => io.out(json ? `${JSON.stringify(data, null, 2)}
` : text);
  const diagsJson = (d) => ({ errors: d.errors, warnings: d.warnings });
  const printDiags = (d) => d.items.map(fmtDiag).join("\n") + (d.items.length ? "\n" : "");
  const project = () => {
    const dir = findProject({ root: str(args.flags.root), cwd, env });
    if (!dir) throw new OpError("no .aidw/ found in this directory or its parents; run `aidw init`");
    const p = pathsFor(dir);
    assertProject(p);
    return p;
  };
  const need = (v, what) => {
    if (!v) throw new UsageError(`missing ${what}`);
    return v;
  };
  try {
    switch (cmd2) {
      case void 0:
      case "help":
      case "--help":
        io.out(HELP);
        return args.pos.length === 0 && !args.flags.help ? 2 : 0;
      case "version":
        emit({ version: VERSION }, `${VERSION}
`);
        return 0;
      case "gate": {
        io.out(runGate(io.stdin?.() ?? "", env));
        return 0;
      }
      case "backstop": {
        io.out(runBackstop(io.stdin?.() ?? "", env));
        return 0;
      }
      case "vendor-path": {
        const ref = need(rest[0], "<upstream>/<skill>");
        if (!/^[a-z0-9-]+\/[a-z0-9-]+$/.test(ref)) throw new UsageError(`invalid vendored skill "${ref}"`);
        const file = (0, import_node_path9.join)(pluginRoot(env), "vendor", ...ref.split("/"), "SKILL.md");
        if (!(0, import_node_fs8.existsSync)(file)) throw new OpError(`vendored skill "${ref}" not found at ${file}`);
        emit({ path: file }, `${file}
`);
        return 0;
      }
      case "plugin-path": {
        const ref = need(rest[0], "relative path inside the plugin");
        if (!/^[A-Za-z0-9._-]+(\/[A-Za-z0-9._-]+)*$/.test(ref) || ref.split("/").includes("..")) {
          throw new UsageError(`invalid plugin path "${ref}"`);
        }
        const file = (0, import_node_path9.join)(pluginRoot(env), ...ref.split("/"));
        if (!(0, import_node_fs8.existsSync)(file)) throw new OpError(`"${ref}" not found in the plugin (${file})`);
        emit({ path: file }, `${file}
`);
        return 0;
      }
      case "analyze": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const d = analyzeChange(p, id);
        const summary = `${d.errors.length ? "FAILED" : "OK"}: ${d.errors.length} error(s), ${d.warnings.length} warning(s)
`;
        emit({ ok: d.errors.length === 0, id, ...diagsJson(d) }, printDiags(d) + summary);
        return d.errors.length ? 1 : 0;
      }
      case "ids": {
        const p = project();
        const id = rest[0] ?? (listChangeIds(p).length === 1 ? listChangeIds(p)[0] : void 0);
        let requirements;
        let scenarios;
        let changed;
        if (id) {
          const r = idsAfterChange(p, id);
          requirements = [...r.ids.requirements].sort();
          scenarios = [...r.ids.scenarios].sort();
          changed = { requirements: [...r.changed.requirements].sort(), scenarios: [...r.changed.scenarios].sort() };
        } else {
          const all = mainSpecIds(p);
          requirements = [...all.requirements].sort();
          scenarios = [...all.scenarios].sort();
        }
        const mark = (x, set) => set?.includes(x) ? "* " : "  ";
        const text = [
          `requirements${id ? ` (after ${id}; * = changed)` : ""}`,
          ...requirements.map((r) => `${mark(r, changed?.requirements)}${r}`),
          "scenarios",
          ...scenarios.map((s) => `${mark(s, changed?.scenarios)}${s}`)
        ].join("\n");
        emit({ change: id ?? null, requirements, scenarios, changed: changed ?? null }, `${text}
`);
        return 0;
      }
      case "init": {
        const dir = str(args.flags.root) ?? cwd;
        const { created } = initProject(dir);
        emit({ ok: true, created }, `initialized .aidw/ (${created.length} files)
`);
        return 0;
      }
      case "change": {
        if (rest[0] !== "new") throw new UsageError("usage: aidw change new <id>");
        const p = project();
        const id = need(rest[1], "change id");
        const dir = newChange(p, id, { title: str(args.flags.title), inputType: str(args.flags["input-type"]) });
        emit({ ok: true, id, dir: rel(p, dir) }, `created change ${id} at ${rel(p, dir)}
`);
        return 0;
      }
      case "status": {
        const p = project();
        const s = projectStatus(p, rest[0]);
        const lines = [
          `project  ${s.project}`,
          `specs    ${s.specs.capabilities} capabilities, ${s.specs.requirements} requirements`,
          s.changes.length ? "changes" : "changes  (none)",
          ...s.changes.map((c) => {
            if (c.error) return `  ${c.id}  ERROR ${c.error}`;
            const tasks = c.tasks ? `tasks ${c.tasks.done}/${c.tasks.total}` : "no tasks";
            const paused = c.paused ? `  paused(${c.paused.reason ?? "?"})` : "";
            const appr = c.approval === "drift" ? "APPROVAL DRIFT" : `approval ${c.approval}`;
            return `  ${c.id}  [${c.state}]  ${appr}  ${tasks}  deltas ${c.deltas}${paused}`;
          })
        ];
        emit(s, `${lines.join("\n")}
`);
        return 0;
      }
      case "validate": {
        const p = project();
        const d = new Diags();
        const checkOne = (id) => {
          d.add(checkChange(p, id));
          try {
            const state = loadChange(p, id).data.state;
            if (isState(state) && NEEDS_ANALYSIS.has(state)) d.add(analyzeChange(p, id));
          } catch {
          }
        };
        if (rest[0]) checkOne(rest[0]);
        else {
          d.add(checkSpecs(p));
          for (const id of listChangeIds(p)) checkOne(id);
        }
        const strict = args.flags.strict === true;
        const failed = d.failed(strict);
        const summary = `${failed ? "FAILED" : "OK"}: ${d.errors.length} error(s), ${d.warnings.length} warning(s)${strict ? " (strict)" : ""}
`;
        emit({ ok: !failed, strict, ...diagsJson(d) }, printDiags(d) + summary);
        return failed ? 1 : 0;
      }
      case "approve": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const { hash, files } = approve(p, id);
        emit({ ok: true, id, hash, files }, `approved ${id}
  ${hash}
  covers ${files.length} file(s)
`);
        return 0;
      }
      case "approval": {
        if (rest[0] !== "check") throw new UsageError("usage: aidw approval check <id>");
        const p = project();
        const id = resolveChangeId(p, rest[1]);
        const c = loadChange(p, id);
        const a = approvalStatus(p, c);
        const files = computeApprovalHash(p, c).files;
        emit(
          { ok: a.status === "valid", id, ...a, files },
          a.status === "valid" ? `approval valid for ${id}
` : a.status === "none" ? `${id} has no approval
` : `APPROVAL DRIFT for ${id}
  approved ${a.expected}
  current  ${a.actual}
`
        );
        return a.status === "valid" ? 0 : 1;
      }
      case "transition": {
        const p = project();
        const id = need(rest[0], "change id");
        const to = need(rest[1], "target state");
        const r = transition(p, id, to, { reason: str(args.flags.reason) });
        emit({ ok: true, id, ...r }, `${id}: ${r.from} -> ${r.to}
`);
        return 0;
      }
      case "merge": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const merges = planMerge(p, id);
        const write = args.flags.write === true;
        if (write) writeMerge(merges);
        const lines = merges.map((m) => {
          const s = m.summary;
          const parts = [
            s.added.length && `+${s.added.length} added`,
            s.modified.length && `~${s.modified.length} modified`,
            s.removed.length && `-${s.removed.length} removed`,
            s.renamed.length && `${s.renamed.length} renamed`
          ].filter(Boolean);
          return `  ${m.capability}${m.created ? " (new)" : ""}: ${parts.join(", ") || "no changes"}`;
        });
        emit(
          { ok: true, id, written: write, merges: merges.map(({ text: _t, file, ...m }) => ({ ...m, file: rel(p, file) })) },
          `${write ? "merged" : "dry run (use --write to apply)"}: ${id}
${lines.join("\n")}
`
        );
        return 0;
      }
      case "archive": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const { target, merges } = archiveChange(p, id);
        emit(
          { ok: true, id, archived: rel(p, target), capabilities: merges.map((m) => m.capability) },
          `archived ${id} -> ${rel(p, target)} (${merges.length} capability spec(s) updated)
`
        );
        return 0;
      }
      default:
        throw new UsageError(`unknown command "${cmd2}"`);
    }
  } catch (e) {
    if (e instanceof UsageError) {
      io.err(`aidw: ${e.message}

${HELP}`);
      return 2;
    }
    if (e instanceof OpError || e instanceof ChangeError) {
      const d = e instanceof OpError ? e.diags : void 0;
      if (json) io.out(`${JSON.stringify({ ok: false, error: e.message, ...d ? diagsJson(d) : {} }, null, 2)}
`);
      else io.err(`aidw: ${e.message}
${d ? printDiags(d) : ""}`);
      return 1;
    }
    throw e;
  }
}
if (typeof require !== "undefined" && require.main === module) {
  process.exitCode = run(process.argv.slice(2), process.env, process.cwd(), {
    out: (s) => process.stdout.write(s),
    err: (s) => process.stderr.write(s),
    stdin: () => {
      try {
        return (0, import_node_fs8.readFileSync)(0, "utf8");
      } catch {
        return "";
      }
    }
  });
}
