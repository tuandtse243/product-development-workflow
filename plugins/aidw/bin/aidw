// src/artifacts.ts
var import_node_fs8 = require("node:fs");
var import_node_path9 = require("node:path");
var import_yaml5 = __toESM(require_dist(), 1);
var ARTIFACT_VALIDATORS = ["aidw validate", "aidw analyze", "aidw plan", "none"];
var NAME = /^[a-z0-9]+(-[a-z0-9]+)*$/;
var isRecord3 = (v) => !!v && typeof v === "object" && !Array.isArray(v);
var artifactsFile = (root) => (0, import_node_path9.join)(root, "artifacts.yaml");
function loadArtifacts(root) {
  const file = artifactsFile(root);
  if (!(0, import_node_fs8.existsSync)(file)) return null;
  const data = import_yaml5.default.parse((0, import_node_fs8.readFileSync)(file, "utf8"));
  return isRecord3(data) ? data : {};
}
function checkArtifacts(root) {
  const d = new Diags();
  const af = "artifacts.yaml";
  let registry;
  try {
    registry = loadArtifacts(root);
  } catch (e) {
    d.error(af, `not valid YAML: ${e.message}`);
    return d;
  }
  if (registry === null) {
    d.error(af, "not found");
    return d;
  }
  if (!(0, import_node_fs8.existsSync)((0, import_node_path9.join)(root, "roster.yaml"))) return d;
  const roster = loadRoster(root);
  const names = Object.keys(registry);
  if (names.length === 0) d.error(af, "the registry is empty");
  const byPath = /* @__PURE__ */ new Map();
  for (const name of names) {
    const e = registry[name];
    if (!NAME.test(name)) d.error(af, `artifact name "${name}" must be lower-case kebab-case`);
    if (!isRecord3(e)) {
      d.error(af, `artifact ${name} is not a mapping`);
      continue;
    }
    if (typeof e.path !== "string" || !e.path.trim()) d.error(af, `artifact ${name}: path is required`);
    else if (e.path.startsWith("/") || e.path.includes("\\") || e.path.split("/").includes("..")) {
      d.error(af, `artifact ${name}: path "${e.path}" must stay inside .aidw/ (relative, no "..")`);
    } else byPath.set(e.path, [...byPath.get(e.path) ?? [], name]);
    if (Array.isArray(e.owner)) d.error(af, `artifact ${name}: exactly one Role owns an artifact, not a list`);
    else if (typeof e.owner !== "string" || !e.owner) d.error(af, `artifact ${name}: owner is required`);
    else if (!(e.owner in roster.roles)) d.error(af, `artifact ${name}: owner "${e.owner}" is not in roster.yaml`);
    if (!ARTIFACT_VALIDATORS.includes(e.validate)) {
      d.error(af, `artifact ${name}: validate must be one of ${ARTIFACT_VALIDATORS.map((v) => `"${v}"`).join(", ")}`);
    }
    if (e.part !== void 0 && (typeof e.part !== "string" || !e.part.trim())) d.error(af, `artifact ${name}: part must be a non-empty text`);
  }
  for (const [path, sharing] of byPath) {
    if (sharing.length < 2) continue;
    const parts = sharing.map((n) => registry[n]?.part);
    if (parts.some((p) => typeof p !== "string" || !p.trim())) d.error(af, `${sharing.join(", ")} share the path "${path}": each needs a "part" saying which part it is`);
    else if (new Set(parts).size !== parts.length) d.error(af, `${sharing.join(", ")} share the path "${path}" with the same part`);
  }
  const owned = (id) => names.filter((n) => registry[n]?.owner === id);
  for (const id of Object.keys(roster.roles)) {
    const file = `roles/${id}/role.md`;
    const path = (0, import_node_path9.join)(roleDir(root, id), "role.md");
    if (!(0, import_node_fs8.existsSync)(path)) continue;
    const header2 = parseRoleText((0, import_node_fs8.readFileSync)(path, "utf8"))?.header;
    if (!header2) continue;
    const lists = { reads: [], writes: [] };
    for (const key of ["reads", "writes"]) {
      const raw = header2[key];
      if (raw === void 0) continue;
      if (!Array.isArray(raw) || !raw.every((x) => typeof x === "string")) {
        d.error(file, `${key} must be a list of artifact names from artifacts.yaml`);
        continue;
      }
      lists[key] = raw;
      for (const a of lists[key]) if (!(a in registry)) d.error(file, `${key}: "${a}" is not an artifact in artifacts.yaml`);
      if (new Set(lists[key]).size !== lists[key].length) d.error(file, `${key} lists an artifact twice`);
    }
    for (const a of lists.writes) {
      const owner = registry[a]?.owner;
      if (owner && owner !== id) d.error(file, `writes: "${a}" is owned by ${owner}; a Role writes only the artifacts it owns`);
    }
    for (const a of owned(id)) {
      if (!lists.writes.includes(a)) d.warn(file, `owns "${a}" but does not list it under writes`);
    }
  }
  return d;
}

// src/workflow.ts
var GATES = ["approval", "approval-auto", "scope-approval", "production-deploy"];
var PROJECT_KINDS = ["greenfield", "brownfield", "request"];
var COMMAND_TRANSITIONS = [
  ["awaiting_approval", "approved"],
  ["awaiting_scope_approval", "analyzing"],
  // `aidw approve` approves the scope
  ["delivered", "archived"]
];
var isRecord4 = (v) => !!v && typeof v === "object" && !Array.isArray(v);
var strings = (v) => Array.isArray(v) ? v.map(String) : [];
var KEBAB = /^[a-z][a-z0-9]*(-[a-z0-9]+)*$/;
var workflowsDir = (root) => (0, import_node_path10.join)(root, "workflows");
function workflowIds(root) {
  const dir = workflowsDir(root);
  return (0, import_node_fs9.existsSync)(dir) ? (0, import_node_fs9.readdirSync)(dir).filter((n) => n.endsWith(".yaml")).map((n) => n.slice(0, -5)).sort() : [];
}
function loadWorkflow(root, id) {
  const file = (0, import_node_path10.join)(workflowsDir(root), `${id}.yaml`);
  if (!(0, import_node_fs9.existsSync)(file)) return null;
  let data;
  try {
    data = import_yaml6.default.parse((0, import_node_fs9.readFileSync)(file, "utf8"));
  } catch {
    return null;
  }
  if (!isRecord4(data)) return null;
  const stages = (Array.isArray(data.stages) ? data.stages : []).filter(isRecord4).map(
    (s) => ({
      id: String(s.id ?? ""),
      title: String(s.title ?? ""),
      states: strings(s.states),
      roles: strings(s.roles),
      reads: strings(s.reads),
      writes: strings(s.writes),
      ...typeof s.gate === "string" ? { gate: s.gate } : {},
      ...isRecord4(s.boundary) ? { boundary: s.boundary } : {},
      ...isRecord4(s.lenses) ? { lenses: Object.fromEntries(Object.entries(s.lenses).map(([k, v]) => [k, String(v)])) } : {},
      ...isRecord4(s.agents) ? { agents: s.agents } : {}
    })
  );
  return {
    id: String(data.id ?? ""),
    description: String(data.description ?? ""),
    applies_to: data.applies_to,
    existing: strings(data.existing),
    scope_gate: data.scope_gate === true,
    interrupts: strings(data.interrupts),
    machine: parseMachine(String(data.id ?? ""), data),
    decisions: (Array.isArray(data.decisions) ? data.decisions : []).filter(isRecord4).map(
      (x) => ({
        id: String(x.id ?? ""),
        decide: String(x.decide ?? ""),
        options: strings(x.options),
        multiple: x.multiple === true,
        stage: String(x.stage ?? ""),
        required: x.required === true
      })
    ),
    stages
  };
}
function checkWorkflows(root) {
  const d = new Diags();
  const ids = workflowIds(root);
  if (!ids.length) {
    d.error("workflows/", "no workflow files");
    return d;
  }
  if (!(0, import_node_fs9.existsSync)((0, import_node_path10.join)(root, "roster.yaml")) || !(0, import_node_fs9.existsSync)((0, import_node_path10.join)(root, "artifacts.yaml"))) return d;
  let registry = null;
  try {
    registry = loadArtifacts(root);
  } catch {
    return d;
  }
  if (!registry) return d;
  const roster = loadRoster(root);
  const written = /* @__PURE__ */ new Set();
  const kinds = /* @__PURE__ */ new Map();
  for (const id of ids) {
    const file = `workflows/${id}.yaml`;
    const w = loadWorkflow(root, id);
    if (!w) {
      d.error(file, "not valid YAML or not a mapping");
      continue;
    }
    if (w.id !== id) d.error(file, `id "${w.id}" must equal the file name "${id}"`);
    if (!w.description.trim()) d.error(file, "description is required");
    if (!PROJECT_KINDS.includes(w.applies_to)) d.error(file, `applies_to must be ${PROJECT_KINDS.join(" or ")}`);
    else if (w.applies_to !== "request" && kinds.has(w.applies_to)) d.error(file, `${kinds.get(w.applies_to)} already serves ${w.applies_to} projects: one Workflow per project kind`);
    else kinds.set(w.applies_to, id);
    if (!w.machine) d.error(file, '"transitions:" (state -> states it may move to), "approval_required:" and "analysis_required:" (lists of states) are required');
    if (!w.stages.length) {
      d.error(file, "no stages");
      continue;
    }
    for (const a of w.existing) if (!(a in registry)) d.error(file, `existing: "${a}" is not an artifact in artifacts.yaml`);
    for (const s of w.interrupts) if (!isState(s)) d.error(file, `interrupts: "${String(s)}" is not a state`);
    const available = new Set(w.existing);
    const seen = /* @__PURE__ */ new Set();
    const covered = new Set(w.interrupts);
    let approvals = 0;
    let approvalAt = -1;
    w.stages.forEach((s, i) => {
      const at = `${file}: stage ${s.id || `#${i + 1}`}`;
      if (!KEBAB.test(s.id)) d.error(file, `stage #${i + 1}: id "${s.id}" must be lower-case kebab-case`);
      else if (seen.has(s.id)) d.error(file, `stage id "${s.id}" appears twice`);
      seen.add(s.id);
      if (!s.title.trim()) d.error(file, `${at}: title is required`);
      if (!s.states.length) d.error(file, `${at}: states is required`);
      for (const st of s.states) {
        if (!isState(st)) d.error(file, `${at}: "${String(st)}" is not a state`);
        else covered.add(st);
      }
      for (const r of s.roles) if (!(r in roster.roles)) d.error(file, `${at}: role "${r}" is not in roster.yaml`);
      for (const a of s.writes) {
        const owner = registry[a]?.owner;
        if (!registry[a]) d.error(file, `${at}: writes "${a}", which is not an artifact in artifacts.yaml`);
        else if (!s.roles.includes(owner)) d.error(file, `${at}: writes "${a}", owned by ${String(owner)}, who is not one of the stage's roles`);
        written.add(a);
      }
      for (const a of s.writes) available.add(a);
      for (const a of s.reads) {
        if (!registry[a]) d.error(file, `${at}: reads "${a}", which is not an artifact in artifacts.yaml`);
        else if (!available.has(a)) d.error(file, `${at}: reads "${a}", which no earlier stage writes`);
      }
      if (s.gate !== void 0 && !GATES.includes(s.gate)) d.error(file, `${at}: gate must be ${GATES.join(" or ")}`);
      if (s.gate === "approval" || s.gate === "approval-auto") {
        approvals++;
        approvalAt = i;
      }
      if (s.gate === "approval-auto") checkBoundary(d, file, at, s, ids);
      else if (s.boundary) d.error(file, `${at}: boundary belongs to a stage with gate: approval-auto`);
      if (s.agents) checkAgents(d, file, at, s, roster.roles);
      if (s.lenses) {
        const lensDecision = w.decisions.find((x) => x.id === "audit-lenses");
        if (!lensDecision) d.error(file, `${at}: lenses need a decision "audit-lenses" whose options are the lenses`);
        else if (JSON.stringify(Object.keys(s.lenses).sort()) !== JSON.stringify([...lensDecision.options].sort())) d.error(file, `${at}: lenses (${Object.keys(s.lenses).join(", ")}) must be exactly the options of the decision audit-lenses (${lensDecision.options.join(", ")})`);
        for (const [lens, role] of Object.entries(s.lenses)) if (!s.roles.includes(role)) d.error(file, `${at}: lens ${lens} is reviewed by ${role}, who is not one of the stage's roles`);
      }
    });
    const m = w.machine;
    const seenDecisions = /* @__PURE__ */ new Set();
    for (const x of w.decisions) {
      const where = `${file}: decision ${x.id || "?"}`;
      if (!KEBAB.test(x.id)) d.error(file, `decision id "${x.id}" must be lower-case kebab-case`);
      else if (seenDecisions.has(x.id)) d.error(file, `decision id "${x.id}" appears twice`);
      seenDecisions.add(x.id);
      if (!(x.decide in roster.roles)) d.error(file, `${where}: decide "${x.decide}" is not a role in roster.yaml`);
      else if (registry[`decision-${x.id}`]?.owner !== x.decide) d.error(file, `${where}: the artifact "decision-${x.id}" must exist in artifacts.yaml and be owned by ${x.decide}`);
      if (x.options.length < 2 || new Set(x.options).size !== x.options.length || !x.options.every((o) => KEBAB.test(o))) d.error(file, `${where}: options must be at least two distinct kebab-case answers`);
      if (!w.stages.some((s) => s.id === x.stage)) d.error(file, `${where}: stage "${x.stage}" is not a stage of this workflow`);
    }
    const scopeStages = w.stages.filter((s) => s.gate === "scope-approval");
    if (scopeStages.length > 1) d.error(file, "at most one stage has gate: scope-approval");
    if (w.scope_gate !== (scopeStages.length === 1)) d.error(file, "scope_gate: true and a stage with gate: scope-approval go together");
    if (approvals > 1) d.error(file, `at most one stage has gate: approval or approval-auto (found ${approvals})`);
    if (m) {
      if (approvals === 0 && m.approvalRequired.size) d.error(file, "approval_required lists states, but no stage has gate: approval or approval-auto");
      if (approvals === 1 && !m.approvalRequired.size) d.error(file, "a stage has an approval gate, so approval_required must list the states that need it");
      const fromGate = new Set(w.interrupts);
      w.stages.forEach((s, i) => i >= approvalAt && approvalAt >= 0 && s.states.forEach((st) => fromGate.add(st)));
      for (const st of m.approvalRequired) if (!fromGate.has(st)) d.error(file, `approval_required: "${st}" is a state before the approval stage, or no stage covers it`);
      const mentioned = new Set(statesOf(m));
      for (const st of m.analysisRequired) if (!mentioned.has(st)) d.error(file, `analysis_required: "${st}" is not a state of this workflow's transitions`);
      for (const [from, to] of Object.entries(m.transitions)) for (const x of to ?? []) if (!mentioned.has(x)) d.error(file, `transitions: "${from}" -> "${x}", but "${x}" has no entry of its own`);
      for (const st of mentioned) if (!covered.has(st)) d.error(file, `no stage covers the state "${st}"`);
      for (const st of covered) if (!mentioned.has(st)) d.error(file, `a stage covers the state "${st}", which is not in the transitions`);
    }
    const path = w.stages.flatMap((s) => s.states);
    for (let i = 1; w.machine && i < path.length; i++) {
      const from = path[i - 1];
      const to = path[i];
      if (from === to || !isState(from) || !isState(to)) continue;
      const allowed = (w.machine.transitions[from] ?? []).includes(to) || COMMAND_TRANSITIONS.some(([a, b]) => a === from && b === to);
      if (!allowed) d.error(file, `the stages go from state "${from}" to "${to}", which its transitions do not allow`);
    }
  }
  for (const a of Object.keys(registry)) {
    if (!written.has(a)) d.warn("artifacts.yaml", `artifact "${a}" is written by no workflow stage`);
  }
  return d;
}
function checkAgents(d, file, at, s, roles) {
  const a = s.agents ?? {};
  const expect = {
    implement: AGENTS.implement.replace(/^aidw:/, ""),
    review: AGENTS.taskReview.replace(/^aidw:/, ""),
    triage: AGENTS.triage.replace(/^aidw:/, ""),
    ui: AGENTS.layerReview.ui.replace(/^aidw:/, ""),
    security: AGENTS.layerReview.security.replace(/^aidw:/, "")
  };
  const got = { implement: a.implement, review: a.review, triage: a.triage, ui: a["layer-review"]?.ui, security: a["layer-review"]?.security };
  for (const k of Object.keys(expect)) {
    if (got[k] !== expect[k]) d.error(file, `${at}: agents ${k} is "${String(got[k])}" but the CLI spawns "${expect[k]}" (the build stage of workflows/product.yaml)`);
    else if (!(expect[k] in roles)) d.error(file, `${at}: agent "${expect[k]}" is not in roster.yaml`);
  }
}
function checkBoundary(d, file, at, s, workflows) {
  const b = s.boundary;
  if (!b) return void d.error(file, `${at}: gate approval-auto needs a boundary (max_tasks, migrations, spec_changes, reclassify_to)`);
  if (!Number.isInteger(b.max_tasks) || b.max_tasks < 1) d.error(file, `${at}: boundary.max_tasks must be a positive integer`);
  if (typeof b.migrations !== "boolean" || typeof b.spec_changes !== "boolean") d.error(file, `${at}: boundary.migrations and boundary.spec_changes must be true (allowed) or false`);
  if (typeof b.reclassify_to !== "string" || !workflows.includes(b.reclassify_to)) d.error(file, `${at}: boundary.reclassify_to must name a workflow file (${workflows.join(", ")})`);
}

// src/boundary.ts
var MIGRATION = /(^|\/)migrations?(\/|$)|\.sql$/i;
function boundaryExceeded(p, id, b) {
  const change = loadChange(p, id);
  const tasks = parseTasks(readText((0, import_node_path11.join)(change.dir, "tasks.yaml")) ?? "").tasks.filter((t) => t.origin === void 0 || t.origin === "plan");
  const out = [];
  if (tasks.length > b.max_tasks) out.push(`the plan has ${tasks.length} tasks (at most ${b.max_tasks})`);
  if (!b.migrations) {
    const m = tasks.filter((t) => (Array.isArray(t.touches) ? t.touches : []).some((g) => MIGRATION.test(String(g))));
    if (m.length) out.push(`${m.map((t) => t.id).join(", ")} change a database migration`);
  }
  if (!b.spec_changes) {
    const specs = walkFiles((0, import_node_path11.join)(change.dir, "specs")).filter((f) => f.endsWith("spec.md"));
    if (specs.length) out.push(`it changes behavior written in a spec (${specs.length} delta spec file(s))`);
  }
  return out;
}
function boundaryOf(pluginRoot2, workflow) {
