  if (f === lower(p.constitution) || FROZEN_PROJECT_DIRS(p).some((d) => insideAnyCase(d, file))) return frozen.length > 0;
  for (const id of frozen) {
    try {
      if (baseSpecFiles(p, loadChange(p, id)).some((b) => lower(b) === f)) return true;
    } catch {
    }
    const dir = lower((0, import_node_path19.join)(p.changes, id));
    if (!inside2(dir, f)) continue;
    const r = (0, import_node_path19.relative)(dir, f).split(import_node_path19.sep).join("/");
