function mergeDanger(p, id, tasks, base2, head) {
  const out = [];
  for (const t of tasks.filter((x) => x.breaking === true)) out.push(`Breaking change: ${t.id} ${String(t.title ?? "")}`);
  const files = git(p.project, ["diff", "--name-only", `${base2}...${head}`, "--", ".", ":(exclude).aidw"]);
