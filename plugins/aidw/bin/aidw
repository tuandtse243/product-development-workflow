var OpError = class extends Error {
  constructor(message, diags) {
    super(message);
    this.diags = diags;
  }
};
var now = () => (/* @__PURE__ */ new Date()).toISOString();
var RESUMABLE = Object.keys(TRANSITIONS).filter((s) => TRANSITIONS[s].includes("paused"));
var PROJECT_YAML = (name) => `# aidw project configuration
schema: 1
