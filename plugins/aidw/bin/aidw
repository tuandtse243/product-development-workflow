var VALUE_FLAGS = /* @__PURE__ */ new Set(["role", "files", "consultation", "remove-reason", "scope-reason", "summary", "cause", "task", "session", "last", "root", "title", "input-type", "workflow", "reason", "change", "for", "notes", "notes-file", "timeout", "layer", "permission-mode", "max-runs", "claude", "model", "case", "runs", "text", "lang", "weights", "to", "done"]);
function parseArgs(argv) {
  const pos = [];
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith("--")) {
      pos.push(a);
      continue;
    }
    const eq = a.indexOf("=");
    const name = eq > 0 ? a.slice(2, eq) : a.slice(2);
    if (eq > 0) flags[name] = a.slice(eq + 1);
    else if (VALUE_FLAGS.has(name)) {
      const v = argv[i + 1];
      if (v === void 0 || v.startsWith("--")) throw new UsageError(`--${name} needs a value`);
      flags[name] = v;
      i++;
    } else flags[name] = true;
  }
  return { pos, flags };
}
var UsageError = class extends Error {
};
function addBinToPath(env) {
  const file = env.CLAUDE_ENV_FILE;
  if (!file) return false;
  const bin = (0, import_node_path50.join)(pluginRoot(env), "bin");
  if (bin.includes("'")) return false;
  const line = `export PATH="$PATH":'${bin}'`;
  const current = (0, import_node_fs45.existsSync)(file) ? (0, import_node_fs45.readFileSync)(file, "utf8") : "";
  if (current.split("\n").includes(line)) return false;
  (0, import_node_fs45.appendFileSync)(file, `${current && !current.endsWith("\n") ? "\n" : ""}${line}
`);
  return true;
}
function logHook(env, hook, input, output) {
  const file = env.AIDW_HOOK_LOG;
  if (!file) return;
  try {
    let parsed = input;
    try {
      parsed = JSON.parse(input);
    } catch {
    }
    (0, import_node_fs45.appendFileSync)(file, `${JSON.stringify({ at: (/* @__PURE__ */ new Date()).toISOString(), hook, input: parsed, output: output || null })}
`);
  } catch {
  }
}
function fmtDiag(d) {
  const where = d.line ? `${d.file}:${d.line}` : d.file;
  return `${d.level === "error" ? "ERROR" : "WARN "}  ${where}  ${d.message}`;
}
function str(v) {
  return typeof v === "string" ? v : void 0;
}
function run(argv, env, cwd, io) {
  let args;
  const dashdash = argv.indexOf("--");
  const passthrough = dashdash >= 0 ? argv.slice(dashdash + 1) : [];
  if (dashdash >= 0) argv = argv.slice(0, dashdash);
  try {
    args = parseArgs(argv);
  } catch (e) {
    io.err(`aidw: ${e.message}
`);
    return 2;
  }
  const json = args.flags.json === true;
  const [cmd2, ...rest] = args.pos;
  const emit = (data, text2) => io.out(json ? `${JSON.stringify(data, null, 2)}
` : text2);
  const diagsJson = (d) => ({ errors: d.errors, warnings: d.warnings });
  const printDiags = (d) => d.items.map(fmtDiag).join("\n") + (d.items.length ? "\n" : "");
  const project = () => {
    const dir = findProject({ root: str(args.flags.root), cwd, env });
    if (!dir) throw new OpError("no .aidw/ found in this directory or its parents; run `aidw init`");
    const p = pathsFor(dir);
    assertProject(p);
    for (const id of listChangeIds(p)) {
      try {
        finishDeviations(p, id);
      } catch {
      }
    }
    if (env === process.env) {
      for (const [k, v] of Object.entries(browserEnv(p))) if (!process.env[k]) process.env[k] = v;
    }
    return p;
  };
  const need = (v, what) => {
    if (!v) throw new UsageError(`missing ${what}`);
    return v;
  };
  try {
    switch (cmd2) {
      case void 0:
      case "help":
      case "--help":
        io.out(HELP);
        return args.pos.length === 0 && !args.flags.help ? 2 : 0;
      case "session-start": {
        try {
          addBinToPath(env);
        } catch {
        }
        try {
          const stdin = io.stdin?.() ?? "";
          const where = hookCwd(stdin, cwd);
          let source = "";
          try {
            source = String(JSON.parse(stdin).source ?? "");
          } catch {
          }
          const notes = [offBranchNote(where, env), source === "compact" ? compactNote(where, env) : null].filter(Boolean);
          if (notes.length) io.out(`${notes.join("\n")}
`);
        } catch {
        }
        return 0;
      }
      case "version":
        emit({ version: VERSION }, `${VERSION}
`);
        return 0;
      case "gate": {
        const input = io.stdin?.() ?? "";
        const out = runGate(input, env);
        logHook(env, cmd2, input, out);
        io.out(out);
        return 0;
      }
      case "backstop": {
        const input = io.stdin?.() ?? "";
        const out = runBackstop(input, env);
        logHook(env, cmd2, input, out);
        io.out(out);
        return 0;
      }
      case "stop-failure": {
        const input = io.stdin?.() ?? "";
        logHook(env, cmd2, input, "");
        try {
          runStopFailure(input, env);
        } catch {
        }
        return 0;
      }
      case "next": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const n = nextAction(p, id);
        emit({ change: id, ...n }, `${nextText(n)}
`);
        return 0;
      }
      case "task": {
        if (rest[0] !== "start" && rest[0] !== "retry" && rest[0] !== "reopen") throw new UsageError("usage: aidw task start|retry|reopen <task>");
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        if (rest[0] === "reopen") {
          const r2 = reopenTask(p, id, need(rest[1], "task id"), { revert: args.flags.revert === true });
          emit(
            { ok: true, change: id, ...r2 },
            `${r2.task} reopened (pending, fresh attempt budget; quality results dropped)${r2.reverted ? `; its commit ${r2.reverted.slice(0, 8)} was reverted` : ""}
${r2.dependents.length ? `WARNING: done task(s) ${r2.dependents.join(", ")} depend on it; reopen them too if they relied on the old code
` : ""}`
          );
          return 0;
        }
        if (rest[0] === "retry") {
          const r2 = retryTask(p, id, need(rest[1], "task id"));
          emit({ ok: true, change: id, ...r2 }, `${r2.task}: retry granted (fresh attempt budget)
`);
          return 0;
        }
        const r = startTask(p, id, need(rest[1], "task id"), { worktree: args.flags.worktree === true });
        const brief = buildBrief(p, id, r.task, "implement", (0, import_node_path50.join)(pluginRoot(env), "library", "vendor"));
        const agent = agentForTask(pluginRoot(env), r.role);
        emit(
          { ok: true, change: id, ...r, agent, brief: brief.path },
          `${r.task} running: attempt ${r.attempt} of ${r.maxAttempts}${r.resumed ? " (resumed)" : ""}${r.base ? `, base ${r.base.slice(0, 8)}` : ""}${r.worktree ? `, worktree ${r.worktree}` : ""}
brief ${brief.path}
SPAWN ${agent} with: Task brief: ${brief.path}. Read it and implement the task.
`
        );
        return 0;
      }
      case "brief":
      case "skills": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const taskId = need(rest[0], "task id");
        const kind = str(args.flags.for) ?? "implement";
        if (kind === "triage" && cmd2 === "brief") {
          const tb = buildTriageBrief(p, id, taskId);
          emit({ change: id, task: taskId, for: kind, path: tb.path }, `${tb.path}
SPAWN ${AGENTS.triage} with: Triage brief: ${tb.path}. Read it and write your answer as it says.
Then: aidw triage ${taskId}
`);
          return 0;
        }
        if (kind === "conflict" && cmd2 === "brief") {
          const cb = buildConflictBrief(p, id, taskId);
          emit({ change: id, task: taskId, for: kind, path: cb.path }, `${cb.path}
SPAWN aidw:integration with: Conflict brief: ${cb.path}. Read it and resolve the conflict.
Then: aidw resolve ${taskId}
`);
          return 0;
        }
        if (kind === "merge-review" && cmd2 === "brief") {
          const mb = buildMergeReviewBrief(p, id, taskId);
          emit({ change: id, task: taskId, for: kind, path: mb.path }, `${mb.path}
SPAWN ${AGENTS.taskReview} with: Merge review brief: ${mb.path}. Review the merge and reply with the verdict.
Then: aidw verdict ${taskId}
`);
          return 0;
        }
        if (kind !== "implement" && kind !== "review") throw new UsageError('--for must be "implement" or "review" (or "triage", "conflict", "merge-review" for brief)');
        const b = buildBrief(p, id, taskId, kind, (0, import_node_path50.join)(pluginRoot(env), "library", "vendor"));
        if (cmd2 === "skills") {
          emit({ change: id, task: taskId, for: kind, skills: b.skills }, b.skills.map((s) => `${s.path}  # ${s.reason}
`).join(""));
        } else {
          emit({ change: id, task: taskId, for: kind, path: b.path, skills: b.skills }, `${b.path}
`);
        }
        return 0;
      }
      case "checkpoint": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const timeout = str(args.flags.timeout);
        if (timeout !== void 0 && !(Number(timeout) > 0)) throw new UsageError("--timeout must be a number of seconds");
        const r = checkpoint(p, id, need(rest[0], "task id"), timeout ? { timeoutMs: Number(timeout) * 1e3 } : {});
        const lines = [
          `${r.ok ? "PASS" : r.status === "blocked" ? "BLOCKED (environment)" : "FAIL"} ${r.task} -> ${r.status === "blocked" ? "running, no attempt used" : r.status}  (evidence ${r.evidence})`,
          ...Object.entries(r.scenarios).map(([s, locs]) => `  ${locs.length ? "ok     " : "MISSING"} ${s}${locs.length ? `  ${locs[0]}` : ""}`),
          ...r.verify.map((v) => `  ${v.exit === 0 ? "ok     " : "FAILED "} ${v.command}  (${Math.round(v.ms / 1e3)}s${v.timedOut ? ", timed out" : ""})`),
          ...r.outside_touches.length ? [`  outside touches: ${r.outside_touches.join(", ")}`] : [],
          ...r.design ? [`  design: ${r.design.screenshots.length} fresh screenshot(s), ${r.design.hardcoded_colors.length} stray color(s)`] : [],
          ...r.problems.map((x) => `  PROBLEM ${x}`)
        ];
        const failed = r.verify.find((v) => v.exit !== 0);
        let after = "";
        let reviewBrief;
        if (r.ok) {
          const auto = autoReview(p, id, r.task, r.changed_files);
          if (auto) {
            after = `review ${auto.task}: auto-passed (converge tests, or a layer fix its own reviewer judges again)${auto.commit ? ` (commit ${auto.commit.slice(0, 8)})` : ""}
${nextLine(p, id)}${sessionEnd(env, p, id)}`;
          } else {
            reviewBrief = buildBrief(p, id, r.task, "review", (0, import_node_path50.join)(pluginRoot(env), "library", "vendor")).path;
            after = `review brief ${reviewBrief}
SPAWN ${AGENTS.taskReview} with: ${REVIEWER_PROMPT(reviewBrief)}
Then: aidw verdict ${r.task}
`;
          }
        } else if (r.status === "blocked") {
          after = `NEXT: the machine refused a check, not the code. Run \`aidw checkpoint ${r.task} --change ${id}\` once more outside the sandbox (dangerouslyDisableSandbox: true); if it is blocked again, escalate with this line. Do not start a new attempt or spawn the implementer again.
`;
        } else {
          after = nextLine(p, id);
        }
        emit({ change: id, ...r, ...reviewBrief ? { review_brief: reviewBrief } : {} }, `${lines.join("\n")}
${failed ? `
--- ${failed.command} (tail)
${failed.tail}
` : ""}${after}`);
        return r.ok ? 0 : 1;
      }
      case "verify": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const timeout = str(args.flags.timeout);
        if (timeout !== void 0 && !(Number(timeout) > 0)) throw new UsageError("--timeout must be a number of seconds");
        const r = verify(p, id, {
          ...str(args.flags.layer) ? { layer: str(args.flags.layer) } : {},
          fresh: args.flags.fresh === true,
          ...timeout ? { timeoutMs: Number(timeout) * 1e3 } : {},
          vendorDir: (0, import_node_path50.join)(pluginRoot(env), "library", "vendor")
        });
        const lines = r.layers.map((l) => {
          const bad = l.runs.find((x) => x.exit !== 0);
          const mark = l.status === "pass" ? "ok     " : l.status === "fail" ? "FAILED " : l.status === "review" ? "REVIEW " : l.reused ? "ok     " : "skipped";
          return `  ${mark} ${l.name}${l.reused ? "  (passed earlier on this commit; --fresh reruns it)" : ""}${bad ? `  (${bad.command}${bad.timedOut ? ", timed out" : `, exit ${bad.exit}`})` : ""}`;
        });
        const failed = r.layers.find((l) => l.status === "fail")?.runs.find((x) => x.exit !== 0);
        const a = r.awaitingReview;
        const group = r.awaitingReviews ?? (a ? [a] : []);
        const reviewer = (x) => `
${group.length > 1 ? `  layer  ${x.layer}
` : ""}  agent  ${x.agent}
  brief  ${x.brief}
  prompt Layer review brief: ${x.brief}. Review the layer and reply with the verdict.
`;
        emit(
          { change: id, ...r },
          `${r.ok ? "PASS" : a ? "REVIEW" : "FAIL"}: ${r.summary}
${lines.join("\n")}
${failed ? `
--- ${failed.command} (tail)
${failed.tail}
` : ""}${group.map(reviewer).join("")}${group.length > 1 ? `
NEXT: spawn these ${group.length} reviewers in one message, one subagent each with its prompt; when each returns, run \`aidw layer-review <layer> --change ${id}\` for it, then \`aidw verify\` again
` : ""}`
        );
        return r.ok ? 0 : 1;
      }
      case "layer-review": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const layer = need(rest[0], "layer name");
        let verdict = rest[1];
        let notesFile = str(args.flags["notes-file"]);
        if (verdict === void 0 || verdict === "auto") {
          notesFile = notesFile ?? (0, import_node_path50.join)(p.run, `layer-review-${layer}.md`);
          if (!(0, import_node_fs45.existsSync)(notesFile)) throw new OpError(`no verdict file at ${notesFile}: the reviewer did not write it. Spawn a fresh reviewer, or save its reply there and run this again`);
          const parsed = parseVerdict((0, import_node_fs45.readFileSync)(notesFile, "utf8"));
          if (!parsed) throw new OpError(`${notesFile} does not start with "VERDICT: pass" or "VERDICT: fix"; spawn a fresh reviewer once more`);
          verdict = parsed;
        }
        if (verdict !== "pass" && verdict !== "fix") throw new UsageError('verdict must be "pass" or "fix"');
        const notes = notesFile ? (0, import_node_fs45.readFileSync)(notesFile, "utf8") : str(args.flags.notes) ?? "";
        if (verdict === "fix" && !notes.trim()) throw new UsageError("a fix verdict needs --notes or --notes-file");
        const r = recordLayerReview(p, id, layer, verdict, notes);
        emit(
          { ok: !r.escalated, change: id, ...r },
          `${r.layer}: ${r.kind} review ${r.verdict} -> ${r.summary}${verdict === "pass" && !notes.trim() ? "\n  note: no reviewer reply recorded; pass it with --notes-file so its non-blocking remarks reach the handoff" : ""}
`
        );
        return r.escalated ? 1 : 0;
      }
      case "cost": {
        const p = project();
        const prefix = str(args.flags.session);
        const last = str(args.flags.last);
        if (last !== void 0 && !(Number.isInteger(Number(last)) && Number(last) >= 1)) throw new UsageError("--last must be a positive integer");
        let sessions = readSessions(p.project, env);
        if (prefix) sessions = sessions.filter((s) => s.id.startsWith(prefix));
        if (last) sessions = sessions.slice(-Number(last));
        const saved = changeTasks(p).map((t) => parallelSavings(t)).filter((x) => x !== null);
        const serial = saved.reduce((n, s) => n + s.serialMs, 0);
        const wall = saved.reduce((n, s) => n + s.wallMs, 0);
        const parallel = saved.length ? `
parallel waves: ${saved.reduce((n, s) => n + s.wave, 0)} task(s) took ${Math.round(wall / 6e4)} min of wall time instead of ${Math.round(serial / 6e4)} min one after another (${serial ? Math.round((1 - wall / serial) * 100) : 0}% faster); tokens per task are the same
` : "";
        emit({ project: p.project, sessions, parallel: saved }, formatCost(sessions) + parallel);
        return 0;
      }
      case "run": {
        const background = args.flags.detach === true || args.flags.stop === true || args.flags.status === true;
        if (env.CLAUDECODE === "1" && env.AIDW_RUNNER !== "1" && !background) {
          throw new OpError("`aidw run` starts Claude Code headless in a loop; run it in your own terminal, or in the background from here with `! aidw run <id> --detach`");
        }
        const p = project();
        if (args.flags.stop === true) {
          const pid = stopRunner(p);
          emit({ stopped: pid }, pid ? `stopped the background runner (pid ${pid}); run the same command again to continue
` : "no background runner is running here\n");
          return 0;
        }
        if (args.flags.status === true) {
          const pid = runnerPid(p);
          emit({ running: pid }, pid ? `runner running (pid ${pid}); follow it: tail -f .aidw/run/runner.log
` : "no background runner is running here\n");
          return 0;
        }
        const id = resolveChangeId(p, rest[0]);
        if (args.flags.detach === true) {
          const strip = argv.filter((a) => a !== "--detach");
          const d = detachRun(p, [...strip, ...dashdash >= 0 ? ["--", ...passthrough] : []], env);
          emit({ change: id, ...d }, `runner started in the background (pid ${d.pid}) for ${id}.
Follow it: tail -f ${d.log}
Status: aidw run --status   Stop: aidw run --stop   (it also stops by itself when it needs you)
`);
          return 0;
        }
        const maxRuns = str(args.flags["max-runs"]);
        if (maxRuns !== void 0 && !(Number.isInteger(Number(maxRuns)) && Number(maxRuns) >= 1)) throw new UsageError("--max-runs must be a positive integer");
        let startedBrowser = false;
        const r = runLoop(p, id, {
          ...str(args.flags.claude) ? { claude: str(args.flags.claude) } : {},
          ...str(args.flags["permission-mode"]) ? { permissionMode: str(args.flags["permission-mode"]) } : {},
          ...maxRuns ? { maxRuns: Number(maxRuns) } : {},
          ...args.flags["keep-mcp"] === true ? { keepMcp: true } : {},
          // The runner runs outside the sandbox that wraps each session, so it hosts the test browser for them.
          prepare: () => {
            if (usesOwnBrowser(env, p)) return null;
            const qtext = readText(qualityFile(loadChange(p, id)));
            const config = qtext === null ? null : parseQuality(qtext, "quality.yaml").config;
            if (!config || !drivesBrowser2(config)) return null;
            try {
              const b = startBrowser(p, { env });
              if (env === process.env) Object.assign(process.env, browserEnv(p));
              if (b.started) {
                startedBrowser = true;
                if (!json) io.out(`[aidw run] test browser started at ${b.record?.url} for the sessions to connect to
`);
              }
              return null;
            } catch (e) {
              return `the test browser could not start, even outside a session: ${e.message}`;
            }
          },
          onFinish: (outcome) => {
            if (startedBrowser && outcome === "archived") stopBrowser(p);
          },
          preflight: () => {
            const bad = doctor(p, id, env, void 0, { run: installRunner() }).filter((c) => c.status === "fail");
            return bad.length ? `fix this first, then run the same command again: ${bad.map((c) => `${c.name}: ${c.detail}`).join("; ")}` : null;
          },
          extraArgs: passthrough,
          env,
          // Detached: stdout already is runner.log, and the runner appends each line with a timestamp itself.
          log: json || env.AIDW_RUN_DETACHED === "1" ? () => {
          } : (line) => io.out(`[aidw run] ${line}
`)
        });
        emit({ change: id, ...r }, `${r.outcome === "archived" ? "DONE" : "STOPPED"} (${r.outcome}) after ${r.runs} session(s), ${r.waits} wait(s): ${r.message}
`);
        return r.outcome === "archived" ? 0 : r.outcome === "escalated" || r.outcome === "needs_user" ? 2 : 1;
      }
      case "integrate": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const r = integrateChange(p, id);
        const failed = r.runs.find((x) => x.exit !== 0);
        emit(
          { change: id, ...r },
          `${r.ok ? "PASS" : "FAIL"}: ${r.summary}
${r.runs.map((x) => `  ${x.exit === 0 ? "ok     " : "FAILED "} ${x.command}`).join("\n")}
${failed ? `
--- ${failed.command} (tail)
${failed.tail}
` : ""}`
        );
        return r.ok ? 0 : 1;
      }
      case "converge": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const r = converge(p, id);
        const lines = Object.entries(r.scenarios).map(([s, x]) => `  ${x.status === "pass" ? "ok     " : x.status.toUpperCase().padEnd(7)} ${s}${x.where[0] ? `  ${x.where[0]}` : ""}`);
        emit({ change: id, ...r }, `${r.ok ? "PASS" : "GAPS"} (${r.mode}): ${r.summary}
${lines.join("\n")}
`);
        return r.ok ? 0 : 1;
      }
      case "deliver": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const r = deliver(p, id, { check: args.flags.check === true });
        const ok = r.diags.errors.length === 0;
        const head = args.flags.check === true ? "" : `${r.dir}: wrote ${r.written.length} file(s)${r.created_handoff ? ", created handoff.md skeleton" : ""}, ${r.screenshots} screenshot(s)
`;
        emit(
          { ok, change: id, dir: r.dir, written: r.written, created_handoff: r.created_handoff, screenshots: r.screenshots, ...diagsJson(r.diags) },
          `${head}${printDiags(r.diags)}${ok ? "delivery package complete" : "INCOMPLETE: fix the items above"}
`
        );
        return ok ? 0 : 1;
      }
      case "deploy": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const r = deploy(p, id);
        const text2 = r.skipped ? `deploy skipped: target "${r.target}" (recorded)
` : r.ok ? `deployed ${r.url}
${r.smoke.map((s) => `  ok      smoke ${s.command}`).join("\n")}
` : `DEPLOY FAILED: ${r.error}
${r.url ? `  url ${r.url}
` : ""}
${[...r.runs, ...r.smoke].find((x) => x.exit !== 0)?.tail ?? r.runs[0]?.tail ?? ""}
`;
        emit({ change: id, ...r }, text2);
        return r.ok ? 0 : 1;
      }
      case "first-deploy": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const r = firstDeploy(p, id, args.flags.yes === true);
        emit({ change: id, ...r }, `${r.ran ? `${r.ok ? "DEPLOYED" : "FAILED"} (${r.command})
` : ""}${r.output}
${r.ok && r.ran ? "Previews work from now on: run aidw deploy.\n" : ""}`);
        return r.ok ? 0 : 1;
      }
      case "review": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const taskId = need(rest[0], "task id");
        const verdict = need(rest[1], "verdict (pass|fix)");
        if (verdict !== "pass" && verdict !== "fix") throw new UsageError('verdict must be "pass" or "fix"');
        const notesFile = str(args.flags["notes-file"]);
        const notes = notesFile ? (0, import_node_fs45.readFileSync)(notesFile, "utf8") : str(args.flags.notes) ?? "";
        if (verdict === "fix" && !notes.trim()) throw new UsageError("a fix verdict needs --notes or --notes-file");
        const r = recordReview(p, id, taskId, verdict, notes, { commit: args.flags["no-commit"] !== true });
        emit(
          { ok: true, change: id, ...r },
          `${reviewLine(r, verdict, notes)}${nextLine(p, id)}${r.status === "done" ? sessionEnd(env, p, id) : ""}`
        );
        return 0;
      }
      case "resolve": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const taskId = need(rest[0], "task id");
        const r = resolveConflict(p, id, taskId);
        const lines = r.checks.flatMap((c) => [
          ...c.missing_scenarios.map((s) => `  MISSING ${c.task} ${s}`),
          ...c.runs.map((x) => `  ${x.exit === 0 ? "ok     " : "FAILED "} ${c.task} ${x.command}`)
        ]);
        let after = nextLine(p, id);
        if (r.blocked) after = `NEXT: the machine refused a check, not the code. Run \`aidw resolve ${taskId} --change ${id}\` once more outside the sandbox (dangerouslyDisableSandbox: true); if it is blocked again, escalate with this line.
`;
        if (r.ok) {
          const mb = buildMergeReviewBrief(p, id, taskId);
          after = `review brief ${mb.path}
SPAWN ${AGENTS.taskReview} with: Merge review brief: ${mb.path}. Review the merge and reply with the verdict.
Then: aidw verdict ${taskId}
`;
        }
        emit(
          { change: id, ...r },
          `${r.ok ? "RESOLVED" : r.blocked ? "BLOCKED (environment)" : "DROPPED"} ${taskId}: ${r.ok ? `merge ${String(r.resolution).slice(0, 8)}; both tasks' checks pass` : r.blocked ? `${r.reason}; nothing dropped, the conflict stays open` : `${r.reason}; the task reruns sequentially on the latest code`}
${lines.length ? `${lines.join("\n")}
` : ""}${after}`
        );
        return r.ok ? 0 : 1;
      }
      case "triage": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const taskId = need(rest[0], "task id");
        const file = str(args.flags["notes-file"]) ?? triageFile(p, taskId);
        if (!(0, import_node_fs45.existsSync)(file)) throw new OpError(`no triage answer at ${file}: the Agent did not write it. Spawn it once more with \`aidw brief ${taskId} --for triage\``);
        const r = recordTriage(p, id, taskId, (0, import_node_fs45.readFileSync)(file, "utf8"));
        const first = r.diagnosis.split("\n").find((l) => l.trim()) ?? "";
        const line = r.outcome === "retry" ? `${r.task} triaged: the cause is the implementation. One further attempt is granted with the diagnosis in its brief: ${first}
` : r.cause === "environment" ? `${r.task} triaged: the cause is the environment, so it escalated. What the user must fix: ${first}
(full diagnosis: ${rel(p, file)})
` : `${r.task} triaged: the cause is the ${r.cause}, so it escalated: the approved package would change and the user decides. ${first}
(full diagnosis: ${rel(p, file)})
`;
        emit({ ok: true, change: id, ...r }, `${line}${nextLine(p, id)}`);
        return 0;
      }
      case "verdict": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const taskId = need(rest[0], "task id");
        const file = str(args.flags["notes-file"]) ?? (0, import_node_path50.join)(p.run, `review-${taskId}.md`);
        if (!(0, import_node_fs45.existsSync)(file)) throw new OpError(`no verdict file at ${file}: the reviewer did not write it. Spawn a fresh reviewer, or save its reply there and run this again`);
        const notes = (0, import_node_fs45.readFileSync)(file, "utf8");
        const verdict = parseVerdict(notes);
        if (!verdict) throw new OpError(`${file} does not start with "VERDICT: pass" or "VERDICT: fix"; spawn a fresh reviewer once more, and if it is still unclear record it with \`aidw review ${taskId} fix --notes-file\``);
        const r = recordReview(p, id, taskId, verdict, notes, { commit: args.flags["no-commit"] !== true });
        emit(
          { ok: true, change: id, ...r },
          `${reviewLine(r, verdict, notes)}${nextLine(p, id)}${r.status === "done" ? sessionEnd(env, p, id) : ""}`
        );
        return 0;
      }
      case "vendor-path": {
        const ref = need(rest[0], "<upstream>/<skill>");
        if (!/^[a-z0-9-]+\/[a-z0-9-]+$/.test(ref)) throw new UsageError(`invalid vendored skill "${ref}"`);
        const file = skillPath((0, import_node_path50.join)(pluginRoot(env), "library", "vendor"), ref);
        if (!(0, import_node_fs45.existsSync)(file)) throw new OpError(`skill "${ref}" not found at ${file}`);
        emit({ path: file }, `${file}
`);
        return 0;
      }
      case "diff-coverage": {
        const p = project();
        const report = need(rest[0], "LCOV report file (e.g. coverage/lcov.info)");
        const min = args.flags.min === void 0 ? 80 : Number(args.flags.min);
        if (!Number.isFinite(min) || min < 0 || min > 100) throw new UsageError("--min must be a number from 0 to 100");
        const file = (0, import_node_path50.resolve)(p.project, report);
        if (!(0, import_node_fs45.existsSync)(file)) throw new OpError(`no coverage report at ${report}: run the tests with an lcov reporter first`);
        const open = listChangeIds(p).flatMap((id) => loadTasks(p, id).tasks.map((t) => typeof t.base === "string" ? t.base : null));
        const base2 = typeof args.flags.base === "string" ? args.flags.base : open.find((b) => b) ?? trunkBase(p.project);
        if (!base2) throw new OpError("no base commit to compare with: pass --base <ref>");
        const c = diffCoverage(p.project, base2, (0, import_node_fs45.readFileSync)(file, "utf8"));
        emit(c, `${coverageReport(c, min)}
`);
        return c.percent >= min ? 0 : 1;
      }
      case "plugin-path": {
        const ref = need(rest[0], "relative path inside the plugin");
        if (!/^[A-Za-z0-9._-]+(\/[A-Za-z0-9._-]+)*$/.test(ref) || ref.split("/").includes("..")) {
          throw new UsageError(`invalid plugin path "${ref}"`);
        }
        const found = resolvePluginFile(pluginRoot(env), ref);
        if (!("file" in found)) {
          const hint = found.suggestions.length ? ` Did you mean: ${found.suggestions.map((s) => `\`aidw plugin-path ${s}\``).join(", ")}?` : "";
          throw new OpError(`"${ref}" not found in the plugin (${found.tried}).${hint}`);
        }
        const file = found.file;
        emit({ path: file }, `${file}
`);
        return 0;
      }
      case "eval": {
        const root = pluginRoot(env);
        const runs = args.flags.runs === void 0 ? 1 : Number(args.flags.runs);
        if (!Number.isInteger(runs) || runs < 1 || runs > 10) throw new OpError("--runs takes a whole number from 1 to 10");
        let results;
        try {
          results = runCases(root, rest[0], str(args.flags.case), (io.modelExec ?? claudeExec)(str(args.flags.model)), (r) => io.err(`  ... ${r.role}/${r.name}: ${r.error ? "ERROR" : r.pass ? "pass" : "fail"}${r.runs ? ` (${r.runs.passed}/${r.runs.total})` : ""}
`), runs);
        } catch (e) {
          throw new OpError(e.message);
        }
        const ok = results.every((r) => r.pass);
        emit({ ok, results }, printResults(results, args.flags.answers === true));
        return ok ? 0 : 1;
      }
      case "roster": {
        const root = pluginRoot(env);
        const written = args.flags.write === true ? writeAgents(root) : [];
        const d = checkRoster(root);
        d.add(checkArtifacts(root));
        d.add(checkWorkflows(root));
        d.add(checkEvals(root));
        const table = d.errors.length ? "" : rosterTable(root);
        const summary = `${d.errors.length ? "FAILED" : "OK"}: ${d.errors.length} error(s), ${d.warnings.length} warning(s)
`;
        emit(
          { ok: d.errors.length === 0, written, ...diagsJson(d) },
          `${table}${written.length ? `wrote agents/: ${written.join(", ")}
` : ""}${printDiags(d)}${summary}`
        );
        return d.errors.length ? 1 : 0;
      }
      case "analyze": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const d = analyzeChange(p, id);
        const summary = `${d.errors.length ? "FAILED" : "OK"}: ${d.errors.length} error(s), ${d.warnings.length} warning(s)
`;
        emit({ ok: d.errors.length === 0, id, ...diagsJson(d) }, printDiags(d) + summary);
        return d.errors.length ? 1 : 0;
      }
      case "ids": {
        const p = project();
        const id = rest[0] ?? (listChangeIds(p).length === 1 ? listChangeIds(p)[0] : void 0);
        let requirements;
        let scenarios;
        let changed;
        if (id) {
          const r = idsAfterChange(p, id);
          requirements = [...r.ids.requirements].sort();
          scenarios = [...r.ids.scenarios].sort();
          changed = { requirements: [...r.changed.requirements].sort(), scenarios: [...r.changed.scenarios].sort() };
        } else {
          const all2 = mainSpecIds(p);
          requirements = [...all2.requirements].sort();
          scenarios = [...all2.scenarios].sort();
        }
        const mark = (x, set) => set?.includes(x) ? "* " : "  ";
        const text2 = [
          `requirements${id ? ` (after ${id}; * = changed)` : ""}`,
          ...requirements.map((r) => `${mark(r, changed?.requirements)}${r}`),
          "scenarios",
          ...scenarios.map((s) => `${mark(s, changed?.scenarios)}${s}`)
        ].join("\n");
        emit({ change: id ?? null, requirements, scenarios, changed: changed ?? null }, `${text2}
`);
        return 0;
      }
      case "init": {
        const dir = str(args.flags.root) ?? cwd;
        const { created, detection: d } = initProject(dir);
        emit(
          { ok: true, created, detection: d },
          `initialized .aidw/ (${created.length} files): ${d.kind}
${d.kind === "brownfield" ? `${d.signals.map((s) => `  signal  ${s}
`).join("")}${Object.entries(d.stack).map(([k, v]) => `  stack   ${k}: ${v}
`).join("")}  (recorded in .aidw/project.yaml; the existing stack is kept)
` : ""}${d.warnings.map((w) => `  WARNING ${w}
`).join("")}`
        );
        return 0;
      }
      case "plan": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const tasks = parseTasks(readText((0, import_node_path50.join)(loadChange(p, id).dir, "tasks.yaml")) ?? "").tasks;
        const shape = planShape(tasks);
        emit({ change: id, ...shape, summary: planSummary(tasks), advice: planAdvice(tasks) }, `${planSummary(tasks)}
${planAdvice(tasks).map((a) => `  advice: ${a}
`).join("")}`);
        return 0;
      }
      case "pr": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const base2 = str(args.flags.base);
        if (args.flags.create === true) {
          const r = createPr(p, id, { ...base2 ? { base: base2 } : {}, draft: args.flags.draft === true });
          emit({ ok: true, change: id, url: r.url, title: r.plan.title }, `pull request opened: ${r.url}
`);
          return 0;
        }
        const plan = planPr(p, id, base2 ? { base: base2 } : {});
        emit({ ok: true, change: id, title: plan.title, head: plan.head, base: plan.base, body: plan.body, commands: plan.commands }, `title: ${plan.title}

${plan.body}
To open it (asks first): aidw pr --create [--base <branch>] [--draft]
`);
        return 0;
      }
      case "browser": {
        const p = project();
        const sub = rest[0];
        if (sub === "start") {
          const r = startBrowser(p, { headed: args.flags.headed === true, env });
          emit({ ok: true, started: r.started, ...r.record }, `${r.started ? "started" : "already running"}: ${r.record?.url} (${r.browser}, pid ${r.record?.pid}, ${r.record?.headless ? "headless" : "headed"})
layers get it as E2E_CDP_URL and E2E_CDP_PORT; for your own shell: export E2E_CDP_URL=$(aidw browser url)
`);
          return 0;
        }
        if (sub === "status") {
          const s = browserStatus(p);
          emit({ ok: s.running, ...s }, s.running ? `running: ${s.record?.url} (${s.browser}, pid ${s.record?.pid})
` : s.record ? `not running: ${s.stale}
` : "no test browser: run `aidw browser start`\n");
          return s.running ? 0 : 1;
        }
        if (sub === "url") {
          const s = browserStatus(p);
          if (!s.running || !s.record) throw new OpError("no test browser is running: run `aidw browser start`");
          emit({ url: s.record.url, port: s.record.port }, `${s.record.url}
`);
          return 0;
        }
        if (sub === "stop") {
          const result = stopBrowser(p);
          if (result === "denied") throw new OpError("the test browser is running but this session may not stop it (the sandbox blocks signalling it): run `aidw browser stop` in your own terminal");
          emit({ ok: true, stopped: result === "stopped" }, result === "stopped" ? "test browser stopped\n" : "no test browser was running\n");
          return 0;
        }
        throw new UsageError("browser needs start, status, url or stop");
      }
      case "mock": {
        const sub = rest[0];
        if (sub === "font") {
          const family = need(rest.slice(1).join(" ").trim() || void 0, "font family");
          const weights = str(args.flags.weights)?.split(",").map((w) => Number(w.trim()));
          if (weights?.some((w) => !Number.isInteger(w))) throw new UsageError("--weights takes numbers, for example 400,700");
          const to = (0, import_node_path50.resolve)(cwd, str(args.flags.to) ?? (0, import_node_path50.join)(project().design, "mock", "fonts"));
          const f = fetchFont(family, { weights, italic: args.flags.italic === true, to });
          emit({ ok: true, ...f, dir: to }, `${f.family} ${f.version} (${f.license}): ${f.files.length} file(s) in ${to}${f.cached ? `, ${f.cached} from cache` : ""}
link ${f.css} from the mock's CSS (@import url("fonts/${f.css}")) and use font-family: "${f.family}"
`);
          return 0;
        }
        if (sub === "shots") {
          const dir = (0, import_node_path50.resolve)(cwd, need(rest[1], "mock folder"));
          const s = browserStatus(project());
          if (!s.running || !s.record) throw new OpError("mock shots need the test browser: run `aidw browser start` (outside the sandbox if it is refused)");
          const self = typeof __filename !== "undefined" ? __filename : (0, import_node_path50.join)(pluginRoot(env), "bin", "aidw");
          const r = takeShots({ dir, cdp: s.record.url, full: args.flags.full === true }, self);
          emit({ ok: r.errors.length === 0, dir, ...r }, `${r.written.length} screenshot(s) in ${(0, import_node_path50.join)(dir, "shots")}
${r.errors.map((e) => `failed: ${e}
`).join("")}`);
          return r.errors.length ? 1 : 0;
        }
        throw new UsageError("mock needs font or shots");
      }
      case "doctor": {
        const p = project();
        let id = rest[0] ?? null;
        if (!id) {
          try {
            id = resolveChangeId(p, void 0);
          } catch {
            id = null;
          }
        }
        const checks = doctor(p, id, env, void 0, { run: installRunner(), fresh: args.flags.fresh === true });
        emit({ ok: !checks.some((c) => c.status === "fail"), change: id, checks }, doctorText(checks));
        return checks.some((c) => c.status === "fail") ? 1 : 0;
      }
      case "detect": {
        const dir = findProject({ root: str(args.flags.root), cwd, env }) ?? str(args.flags.root) ?? cwd;
        const d = detectProject(dir);
        const text2 = [
          `${d.kind}${d.packageManager || d.pythonTool ? ` (${d.packageManager ?? d.pythonTool})` : ""}${d.languages.length ? `, ${d.languages.join(", ")}` : ""}`,
          ...d.signals.map((s) => `  signal  ${s}`),
          ...Object.entries(d.stack).map(([k, v]) => `  stack   ${k}: ${v}`),
          ...packsFor(pluginRoot(env), d.stack, "fullstack").concat(packsFor(pluginRoot(env), d.stack, "frontend"), packsFor(pluginRoot(env), d.stack, "backend")).filter((k, i, a) => a.findIndex((x) => x.id === k.id) === i).map((k) => `  pack    ${k.id} (read by ${k.roles.join(", ")})`),
          ...d.layers.map((l) => `  layer   ${l.name}: ${l.run.join(" && ")}`),
          ...d.warnings.map((w) => `  WARNING ${w}`)
        ];
        emit(d, `${text2.join("\n")}
`);
        return 0;
      }
      case "baseline": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const file = createBaseline(p, id, need(rest[0], "capability"));
        emit({ ok: true, change: id, file: rel(p, file) }, `wrote baseline skeleton ${rel(p, file)}: describe the current behavior, then aidw analyze ${id}
`);
        return 0;
      }
      case "change": {
        if (rest[0] !== "new") throw new UsageError("usage: aidw change new <id>");
        const p = project();
        const id = need(rest[1], "change id");
        const wf = str(args.flags.workflow);
        const dir = newChange(p, id, { title: str(args.flags.title), inputType: str(args.flags["input-type"]), scopeRound: loadWorkflow(pluginRoot(env), wf ?? defaultWorkflowId(p))?.scope_round === true, ...wf ? { workflow: wf, workflows: workflowIds(pluginRoot(env)), skipSpecs: boundaryOf(pluginRoot(env), wf)?.spec_changes === false } : {} });
        emit({ ok: true, id, dir: rel(p, dir) }, `created change ${id} at ${rel(p, dir)}
`);
        return 0;
      }
      case "status": {
        const p = project();
        const s = projectStatus(p, rest[0]);
        const lines = [
          `project  ${s.project}`,
          `specs    ${s.specs.capabilities} capabilities, ${s.specs.requirements} requirements`,
          s.changes.length ? "changes" : "changes  (none)",
          ...s.changes.map((c) => {
            if (c.error) return `  ${c.id}  ERROR ${c.error}`;
            const tasks = c.tasks ? `tasks ${c.tasks.done}/${c.tasks.total}` : "no tasks";
            const paused = c.paused ? `  paused(${c.paused.reason ?? "?"})` : "";
            const appr = c.approval === "drift" ? "APPROVAL DRIFT" : `approval ${c.approval}`;
            const dev = c.deviation ? `
    Deviation ${c.deviation.id} open (${c.deviation.roles.join(", ")}): ${c.deviation.files.join(", ")}` : "";
            return `  ${c.id}  [${c.state}]  ${appr}  ${tasks}  deltas ${c.deltas}${paused}${dev}`;
          })
        ];
        emit(s, `${lines.join("\n")}
`);
        return 0;
      }
      case "validate": {
        const p = project();
        const d = new Diags();
        const checkOne = (id) => {
          d.add(checkChange(p, id));
          try {
            const c = loadChange(p, id);
            if (isState(c.data.state) && machineOf(p, c).analysisRequired.has(c.data.state)) d.add(analyzeChange(p, id));
          } catch {
          }
        };
        if (rest[0]) checkOne(rest[0]);
        else {
          d.add(checkSpecs(p));
          for (const id of listChangeIds(p)) checkOne(id);
        }
        const strict = args.flags.strict === true;
        const failed = d.failed(strict);
        const summary = `${failed ? "FAILED" : "OK"}: ${d.errors.length} error(s), ${d.warnings.length} warning(s)${strict ? " (strict)" : ""}
`;
        emit({ ok: !failed, strict, ...diagsJson(d) }, printDiags(d) + summary);
        return failed ? 1 : 0;
      }
      case "decide": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const name = need(rest[0], "decision id");
        try {
          const r = recordDecision(p, id, name, need(rest[1], "answer"), str(args.flags.reason) ?? "", pluginRoot(env));
          emit({ ok: true, change: id, decision: name, ...r.recorded }, `${id}: ${name} = ${[r.recorded.answer].flat().join(", ")} (${r.decision.decide}): ${r.recorded.reason}
`);
          return 0;
        } catch (e) {
          if (e instanceof DecisionError) throw new OpError(e.message);
          throw e;
        }
      }
      case "audit": {
        const p = project();
        const sub = need(rest[0], "brief | report | picks");
        const id = resolveChangeId(p, str(args.flags.change));
        const c = loadChange(p, id);
        const w = workflowOfChange(p, c, pluginRoot(env));
        const roles = lensRoles(w);
        if (!Object.keys(roles).length) throw new OpError(`change "${id}" runs under the "${w.id}" workflow, which is not an audit`);
        if (sub === "brief") {
          const lens = need(rest[1], "lens");
          const chosen = chosenLenses(p, id);
          if (!chosen) throw new OpError('no lenses decided: run `aidw decide audit-lenses <lens,lens> --reason "..."` first');
          if (!chosen.includes(lens)) throw new OpError(`lens "${lens}" was not decided for this audit (decided: ${chosen.join(", ")})`);
          const role = roles[lens];
          const b = buildAuditBrief(p, id, lens, role);
          emit({ change: id, lens, agent: `aidw:${role}`, brief: b.path }, `${b.path}
SPAWN aidw:${role} with: Audit brief: ${b.path}. Read it and write your answer as it says.
`);
          return 0;
        }
        if (sub === "report") {
          const r = compileReport(p, id);
          const ok = r.diags.errors.length === 0;
          emit({ ok, change: id, report: ok ? rel(p, r.path) : null, findings: r.findings, ...diagsJson(r.diags) }, ok ? `${rel(p, r.path)}: ${r.findings.length} finding(s)
` : `${printDiags(r.diags)}INCOMPLETE: every decided lens must answer
`);
          return ok ? 0 : 1;
        }
        if (sub === "picks") {
          const picks = need(rest[1], "finding ids, e.g. F-01,F-03").split(",").map((x) => x.trim().toUpperCase()).filter(Boolean);
          const r = pickFindings(p, id, picks);
          if (r.missing.length) throw new OpError(`no such finding: ${r.missing.join(", ")} (see the report: aidw audit report)`);
          emit({ ok: true, change: id, picks, request: r.text }, r.text);
          return 0;
        }
        throw new UsageError("usage: aidw audit brief <lens> | report | picks <F-01,F-02>");
      }
      case "page": {
        const p = project();
        const sub = need(rest[0], "render | answers | audit | triage");
        const lang = str(args.flags.lang);
        const gateExtras = (id) => {
          const c = loadChange(p, id);
          const all2 = readDecisions(c);
          const points = workflowOfChange(p, c, pluginRoot(env)).decisions.map((x) => {
            const r = all2[x.id];
            return r ? `**${x.id}**: ${[r.answer].flat().join(", ")} (${r.reason || "no reason recorded"})` : `**${x.id}**: open (${x.options.join(" | ")})`;
          });
          const tasks = parseTasks(readText((0, import_node_path50.join)(c.dir, "tasks.yaml")) ?? "").tasks;
          return [
            ...points.length ? [{ id: "decision-points", title: "Decision Points", body: "", points, html: "" }] : [],
            ...tasks.length ? [{ id: "plan", title: "Plan", body: planSummary(tasks), points: [], html: "" }] : [],
            ...[grantsSection(p, c)].filter((x) => x !== null)
          ];
        };
        const load2 = (name) => {
          if (!PAGE_NAME.test(name)) throw new UsageError(`invalid page name "${name}": lowercase letters, digits and "-"`);
          const source = readText(pageDataFile(p, name));
          if (source === null) throw new OpError(`no page data at ${rel(p, pageDataFile(p, name))}: write it first (aidw plugin-path library/decision-pages.md says how)`);
          const first = parsePage(name, source);
          const gateId = first.page.layout === "gate" && first.page.change ? resolveChangeId(p, first.page.change) : null;
          const lead = (id) => {
            const c = loadChange(p, id);
            return [openFindingsSection(p, c, workflowOfChange(p, c, pluginRoot(env))), unansweredSection(c)].filter((x) => x !== null);
          };
          const r = gateId ? parsePage(name, source, gateExtras(gateId), lead(gateId)) : first;
          if (r.problems.length) throw new OpError(`the data of page "${name}" (${rel(p, pageDataFile(p, name))}) has ${r.problems.length} problem(s):
${r.problems.map((x) => `  - ${x}`).join("\n")}
Fix the file and render again.`);
          return r.page;
        };
        const save = (name, data) => {
          (0, import_node_fs45.mkdirSync)(pagesDir(p), { recursive: true });
          (0, import_node_fs45.writeFileSync)(pageDataFile(p, name), typeof data === "string" ? data : (0, import_yaml23.stringify)(data));
        };
        const show = (name) => {
          const page = load2(name);
          const file = pageHtmlFile(p, name);
          (0, import_node_fs45.writeFileSync)(file, renderPage(page));
          const url = (0, import_node_url.pathToFileURL)(file).href;
          emit(
            { ok: true, page: name, version: page.version, layout: page.layout, file, url },
            `Decision Page: ${url}
${pageSummary(page)}
SHOW the user that link and one or two lines on what the page asks, nothing more: they choose on the page, press the copy button and paste the text here.
NEXT: when they paste it, run \`aidw page answers ${name} --text "<the pasted text>"\` before recording anything.
`
          );
          return 0;
        };
        if (sub === "render") {
          const name = need(rest[1], "page name");
          if (args.flags.stdin === true) {
            if (!PAGE_NAME.test(name)) throw new UsageError(`invalid page name "${name}": lowercase letters, digits and "-"`);
            save(name, io.stdin?.() ?? "");
          }
          return show(name);
        }
        if (sub === "answers") {
          const name = need(rest[1], "page name");
          const page = load2(name);
          const pasted = str(args.flags.text) ?? io.stdin?.() ?? "";
          const a = parseAnswers(page, pasted);
          emit(
            { page: name, ...a },
            a.ok ? `OK ${name}: the answer matches the page. Record it word for word:
${answersText(page, a)}` : `REFUSED ${name}: ${a.problems.length} problem(s)
${a.problems.map((x) => `  - ${x}`).join("\n")}
Ask the user about exactly these; do not guess an answer for them.
`
          );
          return a.ok ? 0 : 1;
        }
        if (sub === "audit") {
          const id = resolveChangeId(p, str(args.flags.change));
          const r = compileReport(p, id, false);
          if (r.diags.errors.length) throw new OpError("the audit report is not complete: run `aidw audit report` first", r.diags);
          if (!r.findings.length) throw new OpError("the audit has no findings: there is nothing to pick");
          const name = `audit-${id}`.toLowerCase().replace(/[^a-z0-9-]/g, "-").slice(0, 64);
          save(
            name,
            picksData({
              title: lang === "vi" ? `Audit ${id}: ch\u1ECDn ph\xE1t hi\u1EC7n c\u1EA7n s\u1EEDa` : `Audit ${id}: pick the findings to fix`,
              intro: lang === "vi" ? `B\xE1o c\xE1o \u0111\u1EA7y \u0111\u1EE7: ${rel(p, r.path)}. C\xE1c ph\xE1t hi\u1EC7n \u0111\u01B0\u1EE3c ch\u1ECDn s\u1EBD th\xE0nh m\u1ED9t y\xEAu c\u1EA7u s\u1EEDa.` : `Full report: ${rel(p, r.path)}. The findings you pick become one fix request.`,
              ...lang ? { lang } : {},
              kind: "audit",
              items: r.findings.map((f) => {
                const [head, ...more] = f.text.trim().split("\n");
                return { key: f.id, title: (head ?? "").slice(0, 200), group: f.severity, tag: f.lens, detail: more.join("\n").trim().slice(0, 1200), recommend: f.severity === "critical" || f.severity === "high" };
              })
            })
          );
          return show(name);
        }
        if (sub === "triage") {
          const taskId = need(rest[1], "task id");
          const file = str(args.flags["notes-file"]) ?? triageFile(p, taskId);
          const diagnosis = readText(file);
          if (diagnosis === null) throw new OpError(`no triage diagnosis at ${rel(p, file)}: this task was not triaged, so put the decision to the user in the chat`);
          const cause = /^CAUSE:\s*(\S+)/m.exec(diagnosis)?.[1] ?? "unknown";
          const name = `triage-${taskId}`.toLowerCase().replace(/[^a-z0-9-]/g, "-");
          save(name, triageData({ task: taskId, cause, diagnosis, ...lang ? { lang } : {} }));
          return show(name);
        }
        throw new UsageError("usage: aidw page render <name> [--stdin] | answers <name> [--text T] | audit | triage <task>");
      }
      case "decisions": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const c = loadChange(p, id);
        const w = workflowOfChange(p, c, pluginRoot(env));
        const all2 = readDecisions(c);
        const rows2 = w.decisions.map((x) => ({ id: x.id, decide: x.decide, options: x.options, required: x.required, recorded: all2[x.id] ?? null }));
        emit(
          { change: id, workflow: w.id, decisions: rows2 },
          rows2.length ? `${rows2.map((r) => `${r.id.padEnd(20)} ${r.recorded ? `${[r.recorded.answer].flat().join(", ")}: ${r.recorded.reason}` : `(open: ${r.options.join(" | ")}${r.required ? ", required" : ""})`}`).join("\n")}
` : `workflow ${w.id} has no decision points
`
        );
        return 0;
      }
      case "plan-review": {
        const p = project();
        const id = resolveChangeId(p, rest[0] ?? str(args.flags.change));
        if (args.flags.brief === true) {
          const b = buildPlanReviewBrief(p, id, pluginRoot(env));
          emit({ change: id, round: b.round, agent: "aidw:code-reviewer", brief: b.path }, `${b.path}
SPAWN aidw:code-reviewer with: Plan review brief: ${b.path}. Read it and write your verdict as it says.
NEXT: when it replies, \`aidw plan-review ${id}\`
`);
          return 0;
        }
        const r = recordPlanReview(p, id, pluginRoot(env));
        const findings = r.round.findings.map((f, i) => `  ${i + 1}. [item ${f.item}] ${f.target}: ${f.text} -> ${r.fixers[i]}
`).join("");
        const head = r.outcome === "pass" ? `plan review round ${r.round.round}: pass
` : r.outcome === "carried" ? `plan review round ${r.round.round}: fix; the ${MAX_FIX_ROUNDS} fix rounds are used up: ${r.round.findings.length} finding(s) stay open and go to the top of the gate page
${findings}` : `plan review round ${r.round.round}: fix (${r.round.findings.length} finding(s)); fix round ${r.round.round} of ${MAX_FIX_ROUNDS}
${findings}`;
        const next = r.outcome === "fix" ? `NEXT: give each finding to the Role named after it (spawn it again with its findings; do it yourself for what you wrote), run \`aidw analyze ${id}\` until it is clean, then \`aidw plan-review ${id} --brief\` and spawn aidw:code-reviewer again
` : `NEXT: \`aidw transition ${id} awaiting_approval\`, then present the gate page
`;
        emit({ ok: true, change: id, round: r.round.round, verdict: r.round.verdict, outcome: r.outcome, findings: r.round.findings.map((f, i) => ({ ...f, fixer: r.fixers[i] })) }, head + next);
        return 0;
      }
      case "stages": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const finished = str(args.flags.done);
        if (finished) recordStageDone(p, id, finished, pluginRoot(env));
        const v = stagesView(p, id, pluginRoot(env));
        const pending = pendingConsultation(loadChange(p, id));
        const asking = pending ? `NEXT: ${consultNextText(p, id, pending)}; the other stages carry on meanwhile
` : "";
        const rows2 = v.ready.length || v.done.length ? [...v.done.map((s) => `  done   ${s}`), ...v.ready.map((s) => `  ${v.group.includes(s) ? "now  " : "ready"}  ${s.id}`)] : [];
        emit(
          { ...v, ...finished ? { recorded: finished } : {}, ...pending ? { consultation: pending } : {}, ready: v.ready.map((s) => ({ id: s.id, title: s.title, roles: s.roles })), group: v.group.map((s) => ({ id: s.id, title: s.title, roles: s.roles, reads: s.reads, writes: s.writes, ...s.gate ? { gate: s.gate } : {}, ...s.browser ? { browser: true } : {} })) },
          `${finished ? `recorded ${finished} as done
` : ""}${v.workflow} (${v.state}), parallel.max ${v.max}
${rows2.join("\n")}${rows2.length ? "\n" : ""}${asking}${stagesNext(v)}
`
        );
        return 0;
      }
      case "consult": {
        const p = project();
        const sub = rest[0];
        if (sub === "answer" || sub === "resume") {
          const id2 = resolveChangeId(p, str(args.flags.change));
          const cid = need(rest[1], "consultation id (C01)");
          if (sub === "answer") {
            const r3 = recordAnswer(p, id2, cid, pluginRoot(env));
            const c3 = r3.consultation;
            const route = c3.status === "needs-deviation" ? `ROUTE: after the Approval Gate this goes to the Role that wrote the approved Artifact, as a Deviation (ADR-0014); the user is not asked. Read the answer, then: aidw deviation open --role <author> --files <approved files> --reason "<why>" --consultation ${cid}
` : c3.status === "unanswered" ? `ROUTE: before the gate the asker records it as an open question in its Artifact, which the Approval Gate shows.
` : "";
            emit({ ok: true, change: id2, ...r3 }, `${cid} ${c3.outcome} -> ${c3.status}
resume brief ${r3.resume}
${route}${c3.status === "needs-deviation" ? "Then, once the Deviation is closed" : "Then"}: aidw consult resume ${cid}
`);
            return 0;
          }
          const r2 = resumeConsultation(p, id2, cid);
          const c2 = r2.consultation;
          const after = c2.task ? `Then, when it reports: aidw checkpoint ${c2.task}` : `Then, when it reports: continue stage ${c2.stage} (\`aidw stages\`)`;
          emit(
            { ok: true, change: id2, ...r2 },
            `${cid} resumed: ${c2.from} continues ${c2.task ?? `stage ${c2.stage}`}
resume brief ${r2.resume}
If the Agent that asked is still running in this session, continue it with SendMessage: "Consultation ${cid} is answered: ${(0, import_node_path50.join)(p.changes, id2, c2.answer)}. Read it and continue." Otherwise:
SPAWN ${r2.agent} with: Resume brief: ${r2.resume}. Read it and continue the work.
${after}
`
          );
          return 0;
        }
        const file = need(sub, "request file (.aidw/changes/<id>/consult/<name>.request.md)");
        const abs = (0, import_node_path50.resolve)(cwd, file);
        const id = resolveChangeId(p, changeOfRequest(p, abs, str(args.flags.change)));
        const r = requestConsultation(p, id, abs, pluginRoot(env));
        const c = r.consultation;
        emit(
          { ok: true, change: id, ...r },
          `${c.id} recorded: ${c.from} (${c.task ?? `stage ${c.stage}`}) asks ${c.to}
brief ${r.brief}
SPAWN ${r.agent} with: Consultation brief: ${r.brief}. Read it and answer as it says.
Then: aidw consult answer ${c.id}
Meanwhile the other tasks or stages carry on.
`
        );
        return 0;
      }
      case "deviation": {
        const p = project();
        const sub = rest[0];
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[1]);
        if (sub === "open") {
          const files = (str(args.flags.files) ?? "").split(",").map((f) => f.trim()).filter(Boolean);
          const consultation = str(args.flags.consultation);
          const task = str(args.flags.task);
          const r = openDeviationFor(p, id, {
            role: need(str(args.flags.role), "--role <the Role that wrote the files>[,<another>]"),
            files,
            reason: str(args.flags.reason) ?? "",
            ...consultation ? { consultation } : {},
            ...task ? { task } : {},
            pluginRoot: pluginRoot(env),
            cwd
          });
          const d = r.deviation;
          emit(
            { ok: true, change: id, deviation: d, brief: r.brief },
            `${d.id} open: ${d.files.map((f) => `${f} (${d.authors[f]})`).join(", ")}
brief ${r.brief}
${d.roles.map((role) => `SPAWN aidw:${role} with: Deviation brief: ${r.brief}. Read it and change only your files under its three rules.`).join("\n")}
Then: aidw deviation close
`
          );
          return 0;
        }
        if (sub === "close") {
          const removeReason = str(args.flags["remove-reason"]);
          const scopeReason = str(args.flags["scope-reason"]);
          const summary = str(args.flags.summary);
          const d = closeDeviation(p, id, { ...removeReason ? { removeReason } : {}, ...scopeReason ? { scopeReason } : {}, ...summary ? { summary } : {}, pluginRoot: pluginRoot(env) });
          const lines = [
            `${d.id} recorded: ${d.roles.join(", ")} changed ${(d.changed ?? []).join(", ")}`,
            `  approval ${d.previous} -> ${d.hash}`,
            ...d.scenarios?.removed.length ? [`  approved scenario(s) removed: ${d.scenarios.removed.map((x) => `${x.scenario} (${x.reason})`).join(", ")}`] : [],
            ...d.requirements?.added.length ? [`  requirement(s) added: ${d.requirements.added.join(", ")} (${d.scope_reason})`] : [],
            ...d.scenarios?.added.length ? [`  scenario(s) added: ${d.scenarios.added.join(", ")}`] : [],
            ...(d.contracts ?? []).map((c) => `  ${c.file}: ${c.class}${c.changes.length ? ` (${c.changes.slice(0, 5).join("; ")}${c.changes.length > 5 ? `; and ${c.changes.length - 5} more` : ""})` : ""}`),
            ...d.tasks?.added.length ? [`  task(s) added: ${d.tasks.added.join(", ")}`] : [],
            `  run again: ${d.rerun?.length ? d.rerun.join(", ") : "none"}${d.reset?.length ? ` (reset to pending: ${d.reset.join(", ")})` : ""}`,
            ...d.consultation ? [`  ${d.consultation}: deviation recorded; resume the asker: aidw consult resume ${d.consultation}`] : []
          ];
          emit({ ok: true, change: id, deviation: d }, `${lines.join("\n")}
${nextLine(p, id)}`);
          return 0;
        }
        if (sub === "abandon") {
          const d = abandonDeviation(p, id);
          emit({ ok: true, change: id, deviation: d }, `${d.id} abandoned: ${d.files.join(", ")} put back as approved
${nextLine(p, id)}`);
          return 0;
        }
        if (sub === "list") {
          const all2 = loadDeviations(loadChange(p, id));
          emit({ change: id, deviations: all2 }, all2.length ? `${all2.map((d) => `${d.id} ${d.status} ${d.roles.join(", ")}: ${d.files.join(", ")} (${d.reason})`).join("\n")}
` : `no Deviations in ${id}
`);
          return 0;
        }
        throw new UsageError("usage: aidw deviation open|close|abandon|list [<id>]");
      }
      case "not-built": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const cause = str(args.flags.cause) ?? "envelope";
        if (cause !== "envelope" && cause !== "environment") throw new UsageError("--cause is envelope (outside what the user granted) or environment (a missing key, the network)");
        const marked = markNotBuilt(p, id, need(rest[0], "task id"), str(args.flags.reason) ?? "", cause);
        emit({ ok: true, change: id, not_built: marked }, `not built: ${marked.join(", ")}
${nextLine(p, id)}`);
        return 0;
      }
      case "approve": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const auto = args.flags.auto === true;
        const { hash, files, by } = approve(p, id, auto ? { auto: { pluginRoot: pluginRoot(env) } } : {});
        const { kept, reopened } = reconcileDoneTasks(p, id);
        const root = pluginRoot(env);
        const route = buildRoute(id, tasksLeft(p, id), (0, import_node_path50.join)(root, "bin", "aidw"), installedOutside(root, p.project) ? void 0 : root);
        emit(
          { ok: true, id, hash, files, kept, reopened, route },
          `approved ${id}${by === "user" ? "" : ` by ${by}`}
  ${hash}
  covers ${files.length} file(s)
${kept.length ? `  done work kept: ${kept.join(", ")}
` : ""}${reopened.length ? `  edited tasks run again: ${reopened.join(", ")}
` : ""}${route.next}
`
        );
        return 0;
      }
      case "approval": {
        if (rest[0] !== "check") throw new UsageError("usage: aidw approval check <id>");
        const p = project();
        const id = resolveChangeId(p, rest[1]);
        const c = loadChange(p, id);
        const a = approvalStatus(p, c);
        const files = computeApprovalHash(p, c).files;
        emit(
          { ok: a.status === "valid", id, ...a, files },
          a.status === "valid" ? `approval valid for ${id}
` : a.status === "none" ? `${id} has no approval
` : `APPROVAL DRIFT for ${id}
  approved ${a.expected}
  current  ${a.actual}
`
        );
        return a.status === "valid" ? 0 : 1;
      }
      case "transition": {
        const p = project();
        const id = need(rest[0], "change id");
        const to = need(rest[1], "target state");
        const r = transition(p, id, to, { reason: str(args.flags.reason), pluginRoot: pluginRoot(env) });
        emit({ ok: true, id, ...r }, `${id}: ${r.from} -> ${r.to}${r.commit ? ` (committed .aidw/ ${r.commit.slice(0, 8)})` : ""}
${(r.notes ?? []).map((n) => `  ${n}
`).join("")}`);
        return 0;
      }
      case "merge": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const merges = planMerge(p, id);
        const write = args.flags.write === true;
        if (write) writeMerge(merges);
        const lines = merges.map((m) => {
          const s = m.summary;
          const parts = [
            s.added.length && `+${s.added.length} added`,
            s.modified.length && `~${s.modified.length} modified`,
            s.removed.length && `-${s.removed.length} removed`,
            s.renamed.length && `${s.renamed.length} renamed`
          ].filter(Boolean);
          return `  ${m.capability}${m.created ? " (new)" : ""}: ${parts.join(", ") || "no changes"}`;
        });
        emit(
          { ok: true, id, written: write, merges: merges.map(({ text: _t, file, ...m }) => ({ ...m, file: rel(p, file) })) },
          `${write ? "merged" : "dry run (use --write to apply)"}: ${id}
${lines.join("\n")}
`
        );
        return 0;
      }
      case "archive": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const { target, merges, commit } = archiveChange(p, id);
        const alsoCommitted = commit ? git(p.project, ["show", "--name-only", "--format=", commit]).out.split("\n").filter((f) => f && !f.startsWith(".aidw/")) : [];
        emit(
          { ok: true, id, archived: rel(p, target), capabilities: merges.map((m) => m.capability), commit: commit ?? null, also_committed: alsoCommitted },
          `archived ${id} -> ${rel(p, target)} (${merges.length} capability spec(s) updated)${commit ? `, committed ${commit.slice(0, 8)}` : ""}
${alsoCommitted.length ? `also committed with it: ${alsoCommitted.join(", ")}
` : ""}`
        );
        return 0;
      }
      default:
        throw new UsageError(`unknown command "${cmd2}"`);
    }
  } catch (e) {
    if (e instanceof UsageError) {
      io.err(`aidw: ${e.message}

${HELP}`);
      return 2;
    }
    if (e instanceof OpError || e instanceof ChangeError || e instanceof BrowserError) {
      const d = e instanceof OpError ? e.diags : void 0;
      if (json) io.out(`${JSON.stringify({ ok: false, error: e.message, ...d ? diagsJson(d) : {} }, null, 2)}
`);
      else io.err(`aidw: ${e.message}
${d ? printDiags(d) : ""}`);
      return 1;
    }
    throw e;
  }
}
if (typeof require !== "undefined" && require.main === module && process.argv[2] === SHOTS_WORKER) {
  runShotsWorker(JSON.parse(process.argv[3] ?? "{}")).then((r) => process.stdout.write(`${JSON.stringify(r)}
`)).catch((e) => {
    process.stderr.write(`${e.message}
`);
    process.exitCode = 1;
  });
} else if (typeof require !== "undefined" && require.main === module) {
  process.exitCode = run(process.argv.slice(2), process.env, process.cwd(), {
    out: (s) => process.stdout.write(s),
    err: (s) => process.stderr.write(s),
    stdin: () => {
      try {
        return (0, import_node_fs45.readFileSync)(0, "utf8");
      } catch {
        return "";
      }
    }
  });
}
// Annotate the CommonJS export names for ESM import in node:
0 && (module.exports = {
  addBinToPath,
  parseArgs,
  pluginRoot,
  run
});
