function renderQuestion(q, page, l) {
  const kind = q.options.length ? q.multi ? l.many : l.one : l.open;
  const head = `<header><span class="eyebrow">${esc(q.id)} \xB7 ${kind}${q.optional ? ` \xB7 ${l.optional}` : ""}${page.role ? ` \xB7 ${esc(page.role)}` : ""}</span><h2>${inline(q.title)}</h2>${q.body ? `<p>${inline(q.body)}</p>` : ""}</header>`;
  const example = q.example ? `<p class="eg"><b>${l.example}:</b> ${inline(q.example)}</p>` : "";
  const why = q.why ? `<p class="why"><b>${l.why}:</b> ${inline(q.why)}</p>` : "";
  if (!q.options.length) {
    return `<section class="q" data-q="${esc(q.id)}" data-kind="open">${head}${example}${free(q.html)}${why}<textarea id="a-${esc(q.id)}" placeholder="${l.answer}">${esc(q.suggest)}</textarea></section>`;
  }
  const cards = q.options.map((o) => {
    const rec = q.recommend.includes(o.key);
    const lines = [...o.pros.map((x) => `<li class="p">${inline(x)}</li>`), ...o.cons.map((x) => `<li class="m">${inline(x)}</li>`)].join("");
    const facts = q.criteria.length ? `<dl class="facts">${q.criteria.map((c) => `<dt>${esc(c)}</dt><dd>${inline(o.facts[c] ?? "")}</dd>`).join("")}</dl>` : "";
    return `<label class="opt"><span class="top"><input type="${q.multi ? "checkbox" : "radio"}" name="q-${esc(q.id)}" id="q-${esc(q.id)}-${esc(o.key)}" value="${esc(o.key)}"${rec ? " checked" : ""}><span class="name">${inline(o.name)}</span></span>${rec ? `<span class="badge">${l.rec}</span>` : ""}${o.summary ? `<span class="sum">${inline(o.summary)}</span>` : ""}${lines ? `<ul class="pm">${lines}</ul>` : ""}${free(o.html)}${facts}</label>`;
  }).join("");
  return `<section class="q" data-q="${esc(q.id)}" data-kind="choice">${head}${example}${free(q.html)}<div class="opts">${cards}</div>${why}<textarea id="n-${esc(q.id)}" placeholder="${l.note}"></textarea></section>`;
}
function renderPicks(page, l) {
  const groups = [];
  for (const it of page.items) if (!groups.includes(it.group)) groups.push(it.group);
  return groups.map((g, gi) => {
    const items = page.items.filter((it) => it.group === g);
    const cards = items.map(
      (it) => `<label class="opt item"><input type="checkbox" data-pick data-g="${gi}" id="p-${esc(it.key)}" value="${esc(it.key)}"${it.recommend ? " checked" : ""}><div><span class="head"><span class="key">${esc(it.key)}</span><span class="name">${inline(it.title)}</span>${it.tag ? `<span class="tag">${esc(it.tag)}</span>` : ""}${it.recommend ? `<span class="badge">${l.rec}</span>` : ""}</span>${it.detail ? `<span class="detail">${inline(it.detail)}</span>` : ""}${free(it.html)}</div></label>`
    ).join("");
    return `<section class="group"><header><h2>${esc(g || l.other)} <span class="key">(${items.length})</span></h2><label class="all"><input type="checkbox" data-group="${gi}" id="g-${gi}">${l.group} ${esc(g || l.other)}</label></header>${cards}</section>`;
  }).join("");
}
function renderGate(page, l) {
  const sections2 = page.sections.map(
    (s) => `<section class="sec" data-sec="${esc(s.id)}"><h2>${inline(s.title)}</h2>${s.body ? `<p>${inline(s.body)}</p>` : ""}${s.points.length ? `<ul>${s.points.map((x) => `<li>${inline(x)}</li>`).join("")}</ul>` : ""}${free(s.html)}<div class="mark"><label><input type="radio" name="s-${esc(s.id)}" id="s-${esc(s.id)}-ok" value="ok">${l.ok}</label><label><input type="radio" name="s-${esc(s.id)}" id="s-${esc(s.id)}-change" value="change">${l.change}</label></div><textarea id="n-${esc(s.id)}" placeholder="${l.changeNote}"></textarea></section>`
  ).join("");
  return `<button type="button" class="quiet" id="allok">${l.allOk}</button>${sections2}`;
}
var SCRIPT = `
(function(){
var P=__PAGE__,out=document.getElementById("out"),btn=document.getElementById("copy");
function one(s){return (s||"").replace(/\\s*\\n\\s*/g," / ").trim()}
function note(el){var t=el.querySelector("textarea");return t?one(t.value):""}
function build(){
  var L=["aidw page "+P.name+" "+P.version];
  document.querySelectorAll("[data-q]").forEach(function(s){
    var id=s.getAttribute("data-q"),n=note(s);
    if(s.getAttribute("data-kind")==="open"){L.push(id+": > "+n);return}
    var k=[].map.call(s.querySelectorAll("input:checked"),function(i){return i.value});
    L.push(id+": "+k.join(", ")+(n?" | note: "+n:""));
  });
  if(P.layout==="picks"){
    var k=[].map.call(document.querySelectorAll("input[data-pick]:checked"),function(i){return i.value});
    L.push("picks: "+(k.join(", ")||"none"));
  }
  document.querySelectorAll("[data-sec]").forEach(function(s){
    var c=s.querySelector("input:checked"),n=note(s);
    L.push(s.getAttribute("data-sec")+": "+(c?c.value:"")+(n?" | note: "+n:""));
  });
  var g=one(document.getElementById("general").value);
  if(g)L.push("note: "+g);
  return L.join("\\n");
}
function show(){out.textContent=build()}
document.addEventListener("input",show);
document.addEventListener("change",function(e){
  var t=e.target;
