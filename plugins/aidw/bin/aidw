var IMPLEMENTER_PROTECTED = /(?:^|\/)\.aidw(?:$|\/(?!run\/(?:worktrees\/[^/]+\/[^/]+\/(?!\.aidw(?:\/|$))|shots\/|report-[\w.-]+\.md$)))|(?:^|\/)(?:run|\.\.)\/(?:(?:layer-)?review-[^/]*\.md|audit-[^/]*\.md)$|(?:^|\/)plan-review\.yaml$/i;
var WORD_SKIP = /* @__PURE__ */ new Set(["sudo", "env", "time", "command", "builtin", "nohup", "nice", "exec", "xargs"]);
function writeTargets(command) {
  const out = [];
  if (firstMatch(INLINE_CODE, maskQuoted(command))) out.push(...command.match(/[^\s"'()\x60,;=<>|&]+/g) ?? []);
  for (const seg of shellSegments(command)) {
    const words = [];
    for (let i = 0; i < seg.length; i++) {
      const w = seg[i];
      if (w === ">" || w === ">>") {
        if (seg[i + 1] !== void 0) out.push(seg[++i]);
      } else if (w === "<") i++;
      else words.push(w);
    }
    let k = 0;
    while (k < words.length) {
      const w = words[k];
      if (/^[A-Za-z_]\w*=/.test(w)) k++;
      else if (WORD_SKIP.has(w)) {
        k++;
        while (k < words.length && words[k].startsWith("-")) k++;
      } else if (w === "timeout") k += 2;
      else break;
    }
    const name = (words[k] ?? "").split("/").pop()?.toLowerCase() ?? "";
    const args = words.slice(k + 1);
    const plain = args.filter((a) => !a.startsWith("-"));
    const t = args.findIndex((a) => a === "-t" || a === "--target-directory");
    if (["cp", "mv", "ln", "install", "rsync"].includes(name)) {
      if (t >= 0 && args[t + 1]) out.push(args[t + 1]);
      else if (plain.length) out.push(plain[plain.length - 1]);
    } else if (["tee", "rm", "rmdir", "touch", "mkdir", "chmod", "chown", "truncate", "unlink"].includes(name)) out.push(...plain);
    else if (name === "sed" && args.some((a) => /^(?:-[a-zA-Z]*i|--in-place)/.test(a))) out.push(...plain);
    else if (name === "find" && args.includes("-delete")) out.push(...args.slice(0, Math.max(0, args.findIndex((a) => a.startsWith("-")))));
    else if (name === "dd") out.push(...args.filter((a) => a.startsWith("of=")).map((a) => a.slice(3)));
    else if (name === "tar" || name === "unzip") out.push(...args.filter((_, j) => args[j - 1] === "-C" || args[j - 1] === "-d"));
  }
  return out;
}
function shellSegments(command) {
  const segs = [];
  let words = [];
  let cur = "";
  let has = false;
  const flush = () => {
    if (has) words.push(cur);
    cur = "";
    has = false;
  };
  const end = () => {
    flush();
    if (words.length) segs.push(words);
    words = [];
  };
  for (let i = 0; i < command.length; i++) {
    const c = command[i];
    if (c === "\\" && i + 1 < command.length) {
      cur += command[++i];
      has = true;
    } else if (c === "'" || c === '"') {
      const close = c === "'" ? command.indexOf("'", i + 1) : closingDoubleQuote(command, i + 1);
      const stop = close < 0 ? command.length : close;
      cur += command.slice(i + 1, stop);
      has = true;
      i = stop;
    } else if (c === ">" || c === "<") {
      if (/^\d+$/.test(cur) || cur === "&") {
        cur = "";
        has = false;
      }
      flush();
      const two = c === ">" && command[i + 1] === ">";
      if (two) i++;
      if (c === ">" && command[i + 1] === "|") i++;
      if (c === ">" && command[i + 1] === "&") {
        i++;
        while (/\d|-/.test(command[i + 1] ?? "")) i++;
        continue;
      }
      words.push(two ? ">>" : c);
    } else if (c === "&" && command[i + 1] === ">") {
      flush();
      cur = "&";
      has = false;
    } else if (/[;&|()\n\x60]/.test(c)) end();
    else if (c === " " || c === "	") flush();
    else {
      cur += c;
      has = true;
    }
  }
  end();
  return segs;
}
var ODD_CHARACTER = /(?![ \t])[\s\p{Cc}\p{Cf}]/u;
function firstMatch(rules, text2) {
  return rules.find((r) => r.re.test(text2));
}
