function shellWords(cmd2) {
  if (/[\n\r`$\\]/.test(cmd2) || ODD_CHARACTER.test(cmd2)) return null;
  const words = [];
  let cur = "";
  let has = false;
  let quote = null;
  for (const c of cmd2) {
    if (quote) {
      if (c === quote) quote = null;
      else cur += c;
      continue;
    }
    if (c === "'" || c === '"') {
      quote = c;
      has = true;
    } else if (c === " " || c === "	") {
      if (has) words.push(cur);
      cur = "";
      has = false;
    } else if (/[;&|<>(){}*?[\]~!#]/.test(c)) return null;
    else {
      cur += c;
      has = true;
    }
  }
  if (quote) return null;
  if (has) words.push(cur);
  return words;
}
function splitFlags(words, valued, bool) {
  const flags = {};
  const args = [];
  for (let i = 0; i < words.length; i++) {
    const w = words[i];
    if (!w.startsWith("-")) {
      args.push(w);
      continue;
    }
    const eq = w.indexOf("=");
    const name = eq > 0 ? w.slice(0, eq) : w;
    if (valued[name]) {
      const v = eq > 0 ? w.slice(eq + 1) : words[++i];
      if (v === void 0 || flags[valued[name]] !== void 0) return null;
      flags[valued[name]] = v;
    } else if (bool[name] && eq < 0) flags[bool[name]] = true;
    else return null;
  }
  return { flags, args };
}
function aidwBinPaths(env) {
  return ["aidw", (0, import_node_path13.join)(bundledRoot() ?? pluginRoot(env), "bin", "aidw"), ...env.CLAUDE_PLUGIN_ROOT ? [(0, import_node_path13.join)(env.CLAUDE_PLUGIN_ROOT, "bin", "aidw")] : []];
}
function requestOf(cmd2, env) {
  const w = shellWords(cmd2);
  if (!w) return null;
  if (w[0] === "git" && w[1] === "push") {
    const o = splitFlags(w.slice(2), {}, { "-u": "u", "--set-upstream": "u" });
    if (!o || o.args.length !== 2) return null;
    return { kind: "push", remote: o.args[0], ref: o.args[1] };
  }
  if (w[0] === "gh" && w[1] === "pr" && w[2] === "create") {
    const o = splitFlags(
      w.slice(3),
      { "--base": "base", "-B": "base", "--head": "head", "-H": "head", "--title": "title", "-t": "title", "--body": "body", "-b": "body", "--body-file": "bodyFile", "-F": "bodyFile", "--repo": "repo", "-R": "repo" },
      { "--draft": "draft", "-d": "draft", "--fill": "fill", "-f": "fill" }
    );
    if (!o || o.args.length || typeof o.flags.base !== "string" || typeof o.flags.head !== "string") return null;
    const str2 = (v) => typeof v === "string" ? v : null;
    return { kind: "pr", base: o.flags.base, head: o.flags.head, repo: str2(o.flags.repo), bodyFile: str2(o.flags.bodyFile) };
  }
  if (w[0] && aidwBinPaths(env).includes(w[0]) && w[1] === "pr") {
    const o = splitFlags(w.slice(2), { "--change": "change", "--base": "base" }, { "--create": "create", "--draft": "draft", "--json": "json" });
    if (!o || o.flags.create !== true || o.args.length > 1) return null;
    const id = typeof o.flags.change === "string" ? o.flags.change : o.args[0];
    if (!id || o.args.length && typeof o.flags.change === "string") return null;
    return { kind: "aidw-pr", id, base: typeof o.flags.base === "string" ? o.flags.base : null };
  }
  return null;
}
