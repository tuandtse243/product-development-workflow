      if (req.kind === "aidw-pr" && req.id === id && (req.base ?? b.base) === b.base && (recorded === void 0 || recorded === null || recorded === b.branch)) return `pushing ${b.branch} to ${b.remote} and its pull request against ${b.base} were ${by}`;
    } catch {
    }
  }
  return null;
}

