}
var profileDir = (p, home = (0, import_node_os.homedir)()) => (0, import_node_path27.join)(home, ".aidw-chrome", (0, import_node_crypto4.createHash)("sha1").update(p.project).digest("hex").slice(0, 10));
function usableProfile(p, home, tmp) {
  for (const dir of [profileDir(p, home), (0, import_node_path27.join)(tmp, "aidw-chrome", (0, import_node_crypto4.createHash)("sha1").update(p.project).digest("hex").slice(0, 10))]) {
    try {
      (0, import_node_fs25.mkdirSync)(dir, { recursive: true });
      return dir;
    } catch {
    }
  }
  throw new BrowserError("cannot create a browser profile under the home directory or the temp directory");
}
var CHROME_CANDIDATES = [
  "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
  "/Applications/Chromium.app/Contents/MacOS/Chromium",
  "/usr/bin/google-chrome",
  "/usr/bin/google-chrome-stable",
  "/usr/bin/chromium",
  "/usr/bin/chromium-browser"
];
var realBrowserDeps = {
  probe: (url) => {
    const r = (0, import_node_child_process4.spawnSync)("curl", ["-sS", "-m", "3", `${url}/json/version`], { encoding: "utf8", timeout: 6e3 });
    if (r.status !== 0) return null;
    try {
      const b = JSON.parse(r.stdout).Browser;
      return typeof b === "string" ? b : null;
    } catch {
      return null;
    }
  },
  launch: (bin, args, log) => {
    const fd = (0, import_node_fs25.openSync)(log, "w");
    try {
      const child = (0, import_node_child_process4.spawn)(bin, args, { detached: true, stdio: ["ignore", fd, fd] });
      let failed = false;
      child.on("error", () => {
        failed = true;
      });
      child.unref();
      return failed ? null : child.pid ?? null;
    } finally {
      (0, import_node_fs25.closeSync)(fd);
    }
  },
  alive: (pid) => {
    try {
      process.kill(pid, 0);
      return true;
    } catch (e) {
      return e.code === "EPERM";
    }
  },
  kill: (pid) => {
    try {
      process.kill(pid, "SIGTERM");
      return true;
    } catch (e) {
      return e.code !== "EPERM";
    }
  },
  sleep: (ms) => void Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms),
  chrome: (env) => env.AIDW_CHROME ? env.AIDW_CHROME : CHROME_CANDIDATES.find((c) => (0, import_node_fs25.existsSync)(c)) ?? null,
  home: (0, import_node_os.homedir)()
};
var BrowserError = class extends Error {
};
function browserStatus(p, deps = realBrowserDeps) {
  const record = readBrowser(p);
  if (!record) return { running: false, record: null };
  const browser = deps.probe(record.url);
  if (browser) return { running: true, record, browser };
  return { running: false, record, stale: deps.alive(record.pid) ? `pid ${record.pid} is alive but ${record.url} does not answer` : `pid ${record.pid} has exited` };
}
function activePort(profile) {
  try {
    const first = (0, import_node_fs25.readFileSync)((0, import_node_path27.join)(profile, "DevToolsActivePort"), "utf8").split("\n")[0] ?? "";
    const n = Number(first.trim());
    return Number.isInteger(n) && n > 0 ? n : null;
  } catch {
    return null;
  }
}
function startBrowser(p, opts = {}, deps = realBrowserDeps) {
  const current = browserStatus(p, deps);
  if (current.running) return { ...current, started: false };
  const bin = deps.chrome(opts.env ?? process.env);
  if (!bin) throw new BrowserError("no Chrome found: install Google Chrome or Chromium, or set AIDW_CHROME to its binary");
  const profile = usableProfile(p, deps.home, deps.tmp ?? (0, import_node_os.tmpdir)());
  try {
    (0, import_node_fs25.rmSync)((0, import_node_path27.join)(profile, "DevToolsActivePort"), { force: true });
  } catch {
  }
  if (current.record && deps.alive(current.record.pid)) {
    if (!deps.kill(current.record.pid)) throw new BrowserError(`pid ${current.record.pid} is still running but does not answer, and this session may not stop it: run \`aidw browser stop\` in your own terminal`);
  }
  const headless = !opts.headed;
  const args = [
    "--remote-debugging-port=0",
    "--remote-debugging-address=127.0.0.1",
    `--user-data-dir=${profile}`,
    "--no-first-run",
    "--no-default-browser-check",
    ...headless ? ["--headless=new"] : [],
    "about:blank"
  ];
  const log = (0, import_node_path27.join)(profile, "chrome.log");
  const pid = deps.launch(bin, args, log);
  if (pid === null) throw new BrowserError(`could not start ${bin}: the sandbox may block launching a browser; run \`aidw browser start\` in your own terminal`);
  const deadline = (opts.timeoutMs ?? 2e4) / 250;
  for (let i = 0; i < deadline; i++) {
    const port = activePort(profile);
    if (port) {
      const url = `http://127.0.0.1:${port}`;
      const browser = deps.probe(url);
      if (browser) {
        const record = { port, url, pid, profile, headless, started_at: (/* @__PURE__ */ new Date()).toISOString() };
        (0, import_node_fs25.mkdirSync)(p.run, { recursive: true });
        (0, import_node_fs25.writeFileSync)(browserFile(p), `${JSON.stringify(record, null, 2)}
`);
        return { running: true, record, browser, started: true };
      }
    }
    if (!deps.alive(pid)) break;
    deps.sleep(250);
  }
  if (deps.alive(pid)) deps.kill(pid);
  throw new BrowserError(`Chrome did not open a debugging port.${whyChromeFailed(log)} Run \`aidw browser start\` in your own terminal (profile ${profile}, log ${log}).`);
}
function whyChromeFailed(log) {
  let text = "";
  try {
    text = (0, import_node_fs25.readFileSync)(log, "utf8");
  } catch {
    return "";
  }
  if (/Permission denied|Operation not permitted|bootstrap_check_in/.test(text)) return " The sandbox of this session does not let Chrome start (macOS denies it registering its processes).";
  if (/ProcessSingleton|profile directory/.test(text)) return " Another Chrome is using this profile: close it.";
  const last = text.split("\n").map((l) => l.trim()).filter(Boolean).pop();
  return last ? ` Chrome said: ${last.slice(0, 160)}` : "";
}
function stopBrowser(p, deps = realBrowserDeps) {
  const record = readBrowser(p);
  if (!record) return "none";
  if (deps.alive(record.pid) && !deps.kill(record.pid)) return "denied";
  (0, import_node_fs25.rmSync)(browserFile(p), { force: true });
  try {
    (0, import_node_fs25.rmSync)((0, import_node_path27.join)(record.profile, "DevToolsActivePort"), { force: true });
  } catch {
  }
  return "stopped";
}

// src/evals.ts
var import_node_fs26 = require("node:fs");
var import_node_path28 = require("node:path");
function loadEvalCases(root, id) {
  const d = new Diags();
  const dir = (0, import_node_path28.join)(roleDir(root, id), "evals");
  const cases = [];
  if (!(0, import_node_fs26.existsSync)(dir)) return { cases, diags: d };
  for (const f of (0, import_node_fs26.readdirSync)(dir).filter((n) => n.endsWith(".md")).sort()) {
    const file = `roles/${id}/evals/${f}`;
    const text = (0, import_node_fs26.readFileSync)((0, import_node_path28.join)(dir, f), "utf8");
    const head = /^---\ncase: ([a-z0-9-]+)\n---\n/.exec(text);
    if (!head) {
      d.error(file, "a case starts with a front matter `case: <name>` (kebab-case)");
      continue;
    }
    if (head[1] !== f.slice(0, -3)) d.error(file, `case "${head[1]}" must equal the file name "${f.slice(0, -3)}"`);
    const section = (name) => {
      const m = new RegExp(`^## ${name}\\n([\\s\\S]*?)(?=^## |$(?![\\s\\S]))`, "m").exec(text);
      return m ? m[1].trim() : null;
    };
    const input = section("Input");
    const criteria = section("Criteria");
    if (!input) d.error(file, 'missing or empty "## Input" (the situation the Agent is given)');
    if (criteria === null) d.error(file, 'missing "## Criteria"');
    const bullets = (criteria ?? "").split("\n").map((l) => l.trim()).filter(Boolean);
    const bad = bullets.filter((l) => !/^- must( not)? \S/.test(l));
    for (const l of bad) d.error(file, `criterion "${l.slice(0, 50)}" must be a bullet starting "- must" or "- must not"`);
    if (criteria !== null && !bullets.length) d.error(file, '"## Criteria" has no bullets');
    cases.push({ name: head[1], file, input: input ?? "", criteria: bullets.filter((l) => /^- must( not)? \S/.test(l)).map((l) => l.slice(2)) });
  }
  return { cases, diags: d };
}
function checkEvals(root) {
  const d = new Diags();
  if (!(0, import_node_fs26.existsSync)((0, import_node_path28.join)(root, "roster.yaml"))) return d;
  const roster = loadRoster(root);
  for (const [id, e] of Object.entries(roster.roles)) {
    if (!(0, import_node_fs26.existsSync)((0, import_node_path28.join)(roleDir(root, id), "role.md"))) continue;
    const r = loadEvalCases(root, id);
    d.add(r.diags);
    if (e?.status === "active" && r.cases.length === 0) d.error(`roles/${id}/evals`, "an active Role ships at least one eval case (roles/<id>/evals/<case>.md)");
  }
  return d;
}

// src/pause.ts
function runStopFailure(stdin, env) {
  let input = {};
  try {
    input = JSON.parse(stdin);
  } catch {
  }
  const project = findProject({ cwd: input.cwd ?? process.cwd(), env });
  if (!project) return [];
  const p = pathsFor(project);
  const details = typeof input.error_details === "string" && input.error_details.trim() ? `: ${input.error_details.trim()}` : "";
  const reason = `${String(input.error ?? input.error_type ?? "stop_failure")}${details}`.slice(0, 200);
  const paused = [];
  for (const id of listChangeIds(p)) {
    try {
      const change = loadChange(p, id);
      const state = stateOf(change);
      if (state && (machineOf(p, change).transitions[state] ?? []).includes("paused")) {
        transition(p, id, "paused", { reason });
        paused.push(id);
      }
    } catch {
    }
  }
  return paused;
}

