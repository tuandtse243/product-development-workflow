var CONSTITUTION = `# Constitution

Project-wide engineering principles. Every agent reads this file before working.
It is part of the approved Analysis package: changing it after approval is drift.

## Principles

- <principle>

## Stack and conventions

- <stack profile, coding standards, folder conventions>
`;
var SKELETON_DIRS = ["requirements", "specs", "domain", "architecture", "decisions", "design", "changes", "archive", "run"];
function projectYaml(name, det) {
  const base = PROJECT_YAML(name).replace("schema: 1\n", `schema: 1
kind: ${det.kind} # greenfield | brownfield (aidw detect)
`);
  if (det.kind === "greenfield") return base;
  const doc = import_yaml11.default.parseDocument(base);
  doc.setIn(["stack", "source"], "client");
  doc.setIn(["stack", "items"], doc.createNode(det.stack));
  doc.setIn(["stack", "reason"], "existing project: aidw keeps the stack it finds and does not migrate it (Q9)");
  doc.set(
    "detected",
    doc.createNode({
      package_manager: det.packageManager,
      languages: det.languages,
      signals: det.signals,
      suggested_layers: Object.fromEntries(det.layers.map((l) => [l.name, l.run]))
    })
  );
  return String(doc);
}
function initProject(projectDir) {
  const p = pathsFor(projectDir);
  if ((0, import_node_fs20.existsSync)(p.aidw)) throw new OpError(`${rel(p, p.aidw)}/ already exists; refusing to overwrite`);
  const detection = detectProject(projectDir);
  const created = [];
  const write = (file, content) => {
    (0, import_node_fs20.mkdirSync)((0, import_node_path22.dirname)(file), { recursive: true });
    (0, import_node_fs20.writeFileSync)(file, content);
    created.push(rel(p, file));
  };
  write(p.projectYaml, projectYaml((0, import_node_path22.basename)(projectDir), detection));
  write(p.constitution, CONSTITUTION);
  write((0, import_node_path22.join)(p.aidw, ".gitignore"), "run/\n");
  for (const d of SKELETON_DIRS) {
    const keep = (0, import_node_path22.join)(p.aidw, d, ".gitkeep");
    if (d !== "run") write(keep, "");
    else (0, import_node_fs20.mkdirSync)((0, import_node_path22.join)(p.aidw, d), { recursive: true });
  }
  return { created, paths: p, detection };
}
var PRE_APPROVAL = /* @__PURE__ */ new Set(["draft", "intake", "analyzing"]);
function createBaseline(p, id, capability) {
  if (!capability.split("/").every((s) => KEBAB_SEGMENT.test(s))) throw new OpError(`capability "${capability}" must be kebab-case segments (e.g. billing or billing/invoices)`);
  const change = loadChange(p, id);
  const state = String(change.data.state);
  if (!PRE_APPROVAL.has(state)) throw new OpError(`change "${id}" is "${state}"; baseline specs are written during the Analysis (draft, intake, analyzing)`);
  const file = (0, import_node_path22.join)(p.specs, ...capability.split("/"), "spec.md");
  if ((0, import_node_fs20.existsSync)(file)) throw new OpError(`${rel(p, file)} already exists; a capability gets its baseline once`);
  const head = headCommit(p.project);
  const title = capability.split("/").at(-1).split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" ");
  (0, import_node_fs20.mkdirSync)((0, import_node_path22.dirname)(file), { recursive: true });
  (0, import_node_fs20.writeFileSync)(
    file,
    `# ${title}

<!-- aidw:baseline: current behavior of the existing code${head ? ` at ${head.slice(0, 12)}` : ""}, written for change ${id}.
Describe what the code does TODAY (read the code and its tests), not what it should do. Changes go in the change's delta specs. -->

## Purpose

${PLACEHOLDER2}: what this capability does today, in one or two sentences.

## Requirements

### Requirement: ${PLACEHOLDER2} one current behavior
The system SHALL ${PLACEHOLDER2}.

#### Scenario: ${PLACEHOLDER2} observed case
- **WHEN** ${PLACEHOLDER2}
- **THEN** ${PLACEHOLDER2}
`
  );
  return file;
}
var INPUT_TYPES = ["idea", "prd", "upwork_jd", "client_request", "codebase"];
var INTAKE = (title) => `# Intake: ${title}

## Input type

<idea | prd | upwork_jd | client_request | codebase>

## Source

<paste or link the original request; keep the client's wording>

## Client constraints

- Stack required by the client: <none | ...>
- Deadline / budget / other: <...>
`;
function newChange(p, id, opts) {
  if (!CHANGE_ID.test(id)) throw new OpError(`change id "${id}" must be kebab-case (e.g. 2026-11-08-booking-app)`);
  if (opts.inputType && !INPUT_TYPES.includes(opts.inputType)) {
    throw new OpError(`unknown input type "${opts.inputType}" (expected ${INPUT_TYPES.join(", ")})`);
  }
  if (opts.workflow && opts.workflows && !opts.workflows.includes(opts.workflow)) throw new OpError(`unknown workflow "${opts.workflow}" (expected ${opts.workflows.join(", ")})`);
  const dir = changeDir(p, id);
  if ((0, import_node_fs20.existsSync)(dir)) throw new OpError(`change "${id}" already exists`);
  const title = opts.title ?? id;
  (0, import_node_fs20.mkdirSync)((0, import_node_path22.join)(dir, "specs"), { recursive: true });
  (0, import_node_fs20.writeFileSync)(
    (0, import_node_path22.join)(dir, "change.yaml"),
    [
      "schema: 1",
      `id: ${id}`,
      `title: ${JSON.stringify(title)}`,
      `input_type: ${opts.inputType ?? "null"}`,
      ...opts.workflow ? [`workflow: ${opts.workflow}`] : [],
      "state: draft",
      `created_at: ${now4()}`,
      `skip_specs: ${opts.skipSpecs === true}`,
      ...opts.scopeGate ? ["scope_gate: true", "scope_approval: null"] : [],
      "approval: null",
      "run:",
      "  paused: null",
      ""
    ].join("\n")
  );
  (0, import_node_fs20.writeFileSync)((0, import_node_path22.join)(dir, "intake.md"), INTAKE(title));
  if (opts.scopeGate) (0, import_node_fs20.writeFileSync)((0, import_node_path22.join)(dir, BRIEF_FILE), BRIEF_TEMPLATE(title));
  (0, import_node_fs20.writeFileSync)((0, import_node_path22.join)(dir, "analysis.md"), ANALYSIS(title, projectKind(p) === "brownfield"));
  recordBaseline(p);
  return dir;
}
var ANALYSIS = (title, brownfield = false) => `# Analysis: ${title}

## Summary

Size: normal (small | normal: small is a bugfix or tweak, at most 3 tasks, see /aidw:start step 1c)

${PLACEHOLDER2}: one page the user can review in minutes - goal, scope, the 5-10 key decisions, and the risks and assumptions that need their attention.

## Decisions to honor

${PLACEHOLDER2}: the concrete choices the code must keep, one per line as "- D1: <decision>" (names, keys, formats,
tools, libraries, conventions, limits). Implementers stop and report instead of deviating; reviewers check them.
Write "None" only if there are none.

## Requirements and scope

${PLACEHOLDER2}: in scope, out of scope, assumptions. Link .aidw/requirements/<change>.md.
${brownfield ? `
## Existing system

${PLACEHOLDER2}: brownfield assessment. What exists (stack from project.yaml, structure, main flows), conventions
the change follows, the health baseline (which existing checks pass or fail today), the capabilities this change
touches and their baseline specs (aidw baseline <capability>), and what must not change.
` : ""}
## Domain

${PLACEHOLDER2}: key entities and business rules. Link .aidw/domain/model.md.

## Stack

Source: ${PLACEHOLDER2} (client | ai | fallback)

${PLACEHOLDER2}: chosen stack and why. If outside the familiar stack pool, say why.

## Design

Mode: ${PLACEHOLDER2} (existing | claude_design | ai_design | hybrid)

${PLACEHOLDER2}: design references, bundle, or AI design direction. UI work also needs .aidw/design/tokens.yaml.

## Architecture

${PLACEHOLDER2}: architecture overview and new ADRs. Link .aidw/architecture/overview.md.

