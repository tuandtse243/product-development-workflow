var VALUE_FLAGS = /* @__PURE__ */ new Set(["session", "last", "root", "title", "input-type", "workflow", "reason", "change", "for", "notes", "notes-file", "timeout", "layer", "permission-mode", "max-runs", "claude"]);
function parseArgs(argv) {
  const pos = [];
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith("--")) {
      pos.push(a);
      continue;
    }
    const eq = a.indexOf("=");
    const name = eq > 0 ? a.slice(2, eq) : a.slice(2);
    if (eq > 0) flags[name] = a.slice(eq + 1);
    else if (VALUE_FLAGS.has(name)) {
      const v = argv[i + 1];
      if (v === void 0 || v.startsWith("--")) throw new UsageError(`--${name} needs a value`);
      flags[name] = v;
      i++;
    } else flags[name] = true;
  }
  return { pos, flags };
}
var UsageError = class extends Error {
};
function addBinToPath(env) {
  const file = env.CLAUDE_ENV_FILE;
  if (!file) return false;
  const bin = (0, import_node_path33.join)(pluginRoot(env), "bin");
  if (bin.includes("'")) return false;
  const line = `export PATH="$PATH":'${bin}'`;
  const current = (0, import_node_fs31.existsSync)(file) ? (0, import_node_fs31.readFileSync)(file, "utf8") : "";
  if (current.split("\n").includes(line)) return false;
  (0, import_node_fs31.appendFileSync)(file, `${current && !current.endsWith("\n") ? "\n" : ""}${line}
`);
  return true;
}
function logHook(env, hook, input, output) {
  const file = env.AIDW_HOOK_LOG;
  if (!file) return;
  try {
    let parsed = input;
    try {
      parsed = JSON.parse(input);
    } catch {
    }
    (0, import_node_fs31.appendFileSync)(file, `${JSON.stringify({ at: (/* @__PURE__ */ new Date()).toISOString(), hook, input: parsed, output: output || null })}
`);
  } catch {
  }
}
function fmtDiag(d) {
  const where = d.line ? `${d.file}:${d.line}` : d.file;
  return `${d.level === "error" ? "ERROR" : "WARN "}  ${where}  ${d.message}`;
}
function str(v) {
  return typeof v === "string" ? v : void 0;
}
function run(argv, env, cwd, io) {
  let args;
  const dashdash = argv.indexOf("--");
  const passthrough = dashdash >= 0 ? argv.slice(dashdash + 1) : [];
  if (dashdash >= 0) argv = argv.slice(0, dashdash);
  try {
    args = parseArgs(argv);
  } catch (e) {
    io.err(`aidw: ${e.message}
`);
    return 2;
  }
  const json = args.flags.json === true;
  const [cmd2, ...rest] = args.pos;
  const emit = (data, text) => io.out(json ? `${JSON.stringify(data, null, 2)}
` : text);
  const diagsJson = (d) => ({ errors: d.errors, warnings: d.warnings });
  const printDiags = (d) => d.items.map(fmtDiag).join("\n") + (d.items.length ? "\n" : "");
  const project = () => {
    const dir = findProject({ root: str(args.flags.root), cwd, env });
    if (!dir) throw new OpError("no .aidw/ found in this directory or its parents; run `aidw init`");
    const p = pathsFor(dir);
    assertProject(p);
    if (env === process.env) {
      for (const [k, v] of Object.entries(browserEnv(p))) if (!process.env[k]) process.env[k] = v;
    }
    return p;
  };
  const need = (v, what) => {
    if (!v) throw new UsageError(`missing ${what}`);
    return v;
  };
  try {
    switch (cmd2) {
      case void 0:
      case "help":
      case "--help":
        io.out(HELP);
        return args.pos.length === 0 && !args.flags.help ? 2 : 0;
      case "session-start": {
        try {
          addBinToPath(env);
        } catch {
        }
        try {
          const stdin = io.stdin?.() ?? "";
          const where = hookCwd(stdin, cwd);
          let source = "";
          try {
            source = String(JSON.parse(stdin).source ?? "");
          } catch {
          }
          const notes = [offBranchNote(where, env), source === "compact" ? compactNote(where, env) : null].filter(Boolean);
          if (notes.length) io.out(`${notes.join("\n")}
`);
        } catch {
        }
        return 0;
      }
      case "version":
        emit({ version: VERSION }, `${VERSION}
`);
        return 0;
      case "gate": {
        const input = io.stdin?.() ?? "";
        const out = runGate(input, env);
        logHook(env, cmd2, input, out);
        io.out(out);
        return 0;
      }
      case "backstop": {
        const input = io.stdin?.() ?? "";
        const out = runBackstop(input, env);
        logHook(env, cmd2, input, out);
        io.out(out);
        return 0;
      }
      case "stop-failure": {
        const input = io.stdin?.() ?? "";
        logHook(env, cmd2, input, "");
        try {
          runStopFailure(input, env);
        } catch {
        }
        return 0;
      }
      case "next": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const n = nextAction(p, id);
        emit({ change: id, ...n }, `${nextText(n)}
`);
        return 0;
      }
      case "task": {
        if (rest[0] !== "start" && rest[0] !== "retry" && rest[0] !== "reopen") throw new UsageError("usage: aidw task start|retry|reopen <task>");
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        if (rest[0] === "reopen") {
          const r2 = reopenTask(p, id, need(rest[1], "task id"), { revert: args.flags.revert === true });
          emit(
            { ok: true, change: id, ...r2 },
            `${r2.task} reopened (pending, fresh attempt budget; quality results dropped)${r2.reverted ? `; its commit ${r2.reverted.slice(0, 8)} was reverted` : ""}
${r2.dependents.length ? `WARNING: done task(s) ${r2.dependents.join(", ")} depend on it; reopen them too if they relied on the old code
` : ""}`
          );
          return 0;
        }
        if (rest[0] === "retry") {
          const r2 = retryTask(p, id, need(rest[1], "task id"));
          emit({ ok: true, change: id, ...r2 }, `${r2.task}: retry granted (fresh attempt budget)
`);
          return 0;
        }
        const r = startTask(p, id, need(rest[1], "task id"), { worktree: args.flags.worktree === true });
        const brief = buildBrief(p, id, r.task, "implement", (0, import_node_path33.join)(pluginRoot(env), "library", "vendor"));
        const agent = agentForTask(pluginRoot(env), r.role);
        emit(
          { ok: true, change: id, ...r, agent, brief: brief.path },
          `${r.task} running: attempt ${r.attempt} of ${r.maxAttempts}${r.resumed ? " (resumed)" : ""}${r.base ? `, base ${r.base.slice(0, 8)}` : ""}${r.worktree ? `, worktree ${r.worktree}` : ""}
brief ${brief.path}
SPAWN ${agent} with: Task brief: ${brief.path}. Read it and implement the task.
`
        );
        return 0;
      }
      case "brief":
      case "skills": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const taskId = need(rest[0], "task id");
        const kind = str(args.flags.for) ?? "implement";
        if (kind === "triage" && cmd2 === "brief") {
          const tb = buildTriageBrief(p, id, taskId);
          emit({ change: id, task: taskId, for: kind, path: tb.path }, `${tb.path}
SPAWN ${AGENTS.triage} with: Triage brief: ${tb.path}. Read it and write your answer as it says.
Then: aidw triage ${taskId}
`);
          return 0;
        }
        if (kind !== "implement" && kind !== "review") throw new UsageError('--for must be "implement" or "review" (or "triage" for brief)');
        const b = buildBrief(p, id, taskId, kind, (0, import_node_path33.join)(pluginRoot(env), "library", "vendor"));
        if (cmd2 === "skills") {
          emit({ change: id, task: taskId, for: kind, skills: b.skills }, b.skills.map((s) => `${s.path}  # ${s.reason}
`).join(""));
        } else {
          emit({ change: id, task: taskId, for: kind, path: b.path, skills: b.skills }, `${b.path}
`);
        }
        return 0;
      }
      case "checkpoint": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const timeout = str(args.flags.timeout);
        if (timeout !== void 0 && !(Number(timeout) > 0)) throw new UsageError("--timeout must be a number of seconds");
        const r = checkpoint(p, id, need(rest[0], "task id"), timeout ? { timeoutMs: Number(timeout) * 1e3 } : {});
        const lines = [
          `${r.ok ? "PASS" : "FAIL"} ${r.task} -> ${r.status}  (evidence ${r.evidence})`,
          ...Object.entries(r.scenarios).map(([s, locs]) => `  ${locs.length ? "ok     " : "MISSING"} ${s}${locs.length ? `  ${locs[0]}` : ""}`),
          ...r.verify.map((v) => `  ${v.exit === 0 ? "ok     " : "FAILED "} ${v.command}  (${Math.round(v.ms / 1e3)}s${v.timedOut ? ", timed out" : ""})`),
          ...r.outside_touches.length ? [`  outside touches: ${r.outside_touches.join(", ")}`] : [],
          ...r.design ? [`  design: ${r.design.screenshots.length} fresh screenshot(s), ${r.design.hardcoded_colors.length} stray color(s)`] : [],
          ...r.problems.map((x) => `  PROBLEM ${x}`)
        ];
        const failed = r.verify.find((v) => v.exit !== 0);
        let after = "";
        let reviewBrief;
        if (r.ok) {
          const auto = autoReview(p, id, r.task, r.changed_files);
          if (auto) {
            after = `review ${auto.task}: auto-passed (converge tests, or a layer fix its own reviewer judges again)${auto.commit ? ` (commit ${auto.commit.slice(0, 8)})` : ""}
${nextLine(p, id)}${sessionEnd(env, p, id)}`;
          } else {
            reviewBrief = buildBrief(p, id, r.task, "review", (0, import_node_path33.join)(pluginRoot(env), "library", "vendor")).path;
            after = `review brief ${reviewBrief}
SPAWN ${AGENTS.taskReview} with: ${REVIEWER_PROMPT(reviewBrief)}
Then: aidw verdict ${r.task}
`;
          }
        } else {
          after = nextLine(p, id);
        }
        emit({ change: id, ...r, ...reviewBrief ? { review_brief: reviewBrief } : {} }, `${lines.join("\n")}
${failed ? `
--- ${failed.command} (tail)
${failed.tail}
` : ""}${after}`);
        return r.ok ? 0 : 1;
      }
      case "verify": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const timeout = str(args.flags.timeout);
        if (timeout !== void 0 && !(Number(timeout) > 0)) throw new UsageError("--timeout must be a number of seconds");
        const r = verify(p, id, {
          ...str(args.flags.layer) ? { layer: str(args.flags.layer) } : {},
          fresh: args.flags.fresh === true,
          ...timeout ? { timeoutMs: Number(timeout) * 1e3 } : {},
          vendorDir: (0, import_node_path33.join)(pluginRoot(env), "library", "vendor")
        });
        const lines = r.layers.map((l) => {
          const bad = l.runs.find((x) => x.exit !== 0);
          const mark = l.status === "pass" ? "ok     " : l.status === "fail" ? "FAILED " : l.status === "review" ? "REVIEW " : l.reused ? "ok     " : "skipped";
          return `  ${mark} ${l.name}${l.reused ? "  (passed earlier on this commit; --fresh reruns it)" : ""}${bad ? `  (${bad.command}${bad.timedOut ? ", timed out" : `, exit ${bad.exit}`})` : ""}`;
        });
        const failed = r.layers.find((l) => l.status === "fail")?.runs.find((x) => x.exit !== 0);
        const a = r.awaitingReview;
        emit(
          { change: id, ...r },
          `${r.ok ? "PASS" : a ? "REVIEW" : "FAIL"}: ${r.summary}
${lines.join("\n")}
${failed ? `
--- ${failed.command} (tail)
${failed.tail}
` : ""}${a ? `
  agent  ${a.agent}
  brief  ${a.brief}
  prompt Layer review brief: ${a.brief}. Review the layer and reply with the verdict.
` : ""}`
        );
        return r.ok ? 0 : 1;
      }
      case "layer-review": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const layer = need(rest[0], "layer name");
        let verdict = rest[1];
        let notesFile = str(args.flags["notes-file"]);
        if (verdict === void 0 || verdict === "auto") {
          notesFile = notesFile ?? (0, import_node_path33.join)(p.run, `layer-review-${layer}.md`);
          if (!(0, import_node_fs31.existsSync)(notesFile)) throw new OpError(`no verdict file at ${notesFile}: the reviewer did not write it. Spawn a fresh reviewer, or save its reply there and run this again`);
          const parsed = parseVerdict((0, import_node_fs31.readFileSync)(notesFile, "utf8"));
          if (!parsed) throw new OpError(`${notesFile} does not start with "VERDICT: pass" or "VERDICT: fix"; spawn a fresh reviewer once more`);
          verdict = parsed;
        }
        if (verdict !== "pass" && verdict !== "fix") throw new UsageError('verdict must be "pass" or "fix"');
        const notes = notesFile ? (0, import_node_fs31.readFileSync)(notesFile, "utf8") : str(args.flags.notes) ?? "";
        if (verdict === "fix" && !notes.trim()) throw new UsageError("a fix verdict needs --notes or --notes-file");
        const r = recordLayerReview(p, id, layer, verdict, notes);
        emit(
          { ok: !r.escalated, change: id, ...r },
          `${r.layer}: ${r.kind} review ${r.verdict} -> ${r.summary}${verdict === "pass" && !notes.trim() ? "\n  note: no reviewer reply recorded; pass it with --notes-file so its non-blocking remarks reach the handoff" : ""}
`
        );
        return r.escalated ? 1 : 0;
      }
      case "cost": {
        const p = project();
        const prefix = str(args.flags.session);
        const last = str(args.flags.last);
        if (last !== void 0 && !(Number.isInteger(Number(last)) && Number(last) >= 1)) throw new UsageError("--last must be a positive integer");
        let sessions = readSessions(p.project, env);
        if (prefix) sessions = sessions.filter((s) => s.id.startsWith(prefix));
        if (last) sessions = sessions.slice(-Number(last));
        const saved = changeTasks(p).map((t) => parallelSavings(t)).filter((x) => x !== null);
        const serial = saved.reduce((n, s) => n + s.serialMs, 0);
        const wall = saved.reduce((n, s) => n + s.wallMs, 0);
        const parallel = saved.length ? `
parallel waves: ${saved.reduce((n, s) => n + s.wave, 0)} task(s) took ${Math.round(wall / 6e4)} min of wall time instead of ${Math.round(serial / 6e4)} min one after another (${serial ? Math.round((1 - wall / serial) * 100) : 0}% faster); tokens per task are the same
` : "";
        emit({ project: p.project, sessions, parallel: saved }, formatCost(sessions) + parallel);
        return 0;
      }
      case "run": {
        const background = args.flags.detach === true || args.flags.stop === true || args.flags.status === true;
        if (env.CLAUDECODE === "1" && env.AIDW_RUNNER !== "1" && !background) {
          throw new OpError("`aidw run` starts Claude Code headless in a loop; run it in your own terminal, or in the background from here with `! aidw run <id> --detach`");
        }
        const p = project();
        if (args.flags.stop === true) {
          const pid = stopRunner(p);
          emit({ stopped: pid }, pid ? `stopped the background runner (pid ${pid}); run the same command again to continue
` : "no background runner is running here\n");
          return 0;
        }
        if (args.flags.status === true) {
          const pid = runnerPid(p);
          emit({ running: pid }, pid ? `runner running (pid ${pid}); follow it: tail -f .aidw/run/runner.log
` : "no background runner is running here\n");
          return 0;
        }
        const id = resolveChangeId(p, rest[0]);
        if (args.flags.detach === true) {
          const strip = argv.filter((a) => a !== "--detach");
          const d = detachRun(p, [...strip, ...dashdash >= 0 ? ["--", ...passthrough] : []], env);
          emit({ change: id, ...d }, `runner started in the background (pid ${d.pid}) for ${id}.
Follow it: tail -f ${d.log}
Status: aidw run --status   Stop: aidw run --stop   (it also stops by itself when it needs you)
`);
          return 0;
        }
        const maxRuns = str(args.flags["max-runs"]);
        if (maxRuns !== void 0 && !(Number.isInteger(Number(maxRuns)) && Number(maxRuns) >= 1)) throw new UsageError("--max-runs must be a positive integer");
        let startedBrowser = false;
        const r = runLoop(p, id, {
          ...str(args.flags.claude) ? { claude: str(args.flags.claude) } : {},
          ...str(args.flags["permission-mode"]) ? { permissionMode: str(args.flags["permission-mode"]) } : {},
          ...maxRuns ? { maxRuns: Number(maxRuns) } : {},
          ...args.flags["keep-mcp"] === true ? { keepMcp: true } : {},
          // The runner runs outside the sandbox that wraps each session, so it hosts the test browser for them.
          prepare: () => {
            if (env.E2E_CDP_URL) return null;
            const qtext = readText(qualityFile(loadChange(p, id)));
            const config = qtext === null ? null : parseQuality(qtext, "quality.yaml").config;
            if (!config || !drivesBrowser2(config)) return null;
            try {
              const b = startBrowser(p, { env });
              if (b.started) {
                startedBrowser = true;
                if (!json) io.out(`[aidw run] test browser started at ${b.record?.url} for the sessions to connect to
`);
              }
              return null;
            } catch (e) {
              return `the test browser could not start, even outside a session: ${e.message}`;
            }
          },
          onFinish: (outcome) => {
            if (startedBrowser && outcome === "archived") stopBrowser(p);
          },
          preflight: () => {
            const bad = doctor(p, id, env).filter((c) => c.status === "fail");
            return bad.length ? `fix this first, then run the same command again: ${bad.map((c) => `${c.name}: ${c.detail}`).join("; ")}` : null;
          },
          extraArgs: passthrough,
          env,
          log: json ? () => {
          } : (line) => io.out(`[aidw run] ${line}
`)
        });
        emit({ change: id, ...r }, `${r.outcome === "archived" ? "DONE" : "STOPPED"} (${r.outcome}) after ${r.runs} session(s), ${r.waits} wait(s): ${r.message}
`);
        return r.outcome === "archived" ? 0 : r.outcome === "escalated" || r.outcome === "needs_user" ? 2 : 1;
      }
      case "integrate": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const r = integrateChange(p, id);
        const failed = r.runs.find((x) => x.exit !== 0);
        emit(
          { change: id, ...r },
          `${r.ok ? "PASS" : "FAIL"}: ${r.summary}
${r.runs.map((x) => `  ${x.exit === 0 ? "ok     " : "FAILED "} ${x.command}`).join("\n")}
${failed ? `
--- ${failed.command} (tail)
${failed.tail}
` : ""}`
        );
        return r.ok ? 0 : 1;
      }
      case "converge": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const r = converge(p, id);
        const lines = Object.entries(r.scenarios).map(([s, x]) => `  ${x.status === "pass" ? "ok     " : x.status.toUpperCase().padEnd(7)} ${s}${x.where[0] ? `  ${x.where[0]}` : ""}`);
        emit({ change: id, ...r }, `${r.ok ? "PASS" : "GAPS"} (${r.mode}): ${r.summary}
${lines.join("\n")}
`);
        return r.ok ? 0 : 1;
      }
      case "deliver": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const r = deliver(p, id, { check: args.flags.check === true });
        const ok = r.diags.errors.length === 0;
        const head = args.flags.check === true ? "" : `${r.dir}: wrote ${r.written.length} file(s)${r.created_handoff ? ", created handoff.md skeleton" : ""}, ${r.screenshots} screenshot(s)
`;
        emit(
          { ok, change: id, dir: r.dir, written: r.written, created_handoff: r.created_handoff, screenshots: r.screenshots, ...diagsJson(r.diags) },
          `${head}${printDiags(r.diags)}${ok ? "delivery package complete" : "INCOMPLETE: fix the items above"}
`
        );
        return ok ? 0 : 1;
      }
      case "deploy": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const r = deploy(p, id);
        const text = r.skipped ? `deploy skipped: target "${r.target}" (recorded)
` : r.ok ? `deployed ${r.url}
${r.smoke.map((s) => `  ok      smoke ${s.command}`).join("\n")}
` : `DEPLOY FAILED: ${r.error}
${r.url ? `  url ${r.url}
` : ""}
${[...r.runs, ...r.smoke].find((x) => x.exit !== 0)?.tail ?? r.runs[0]?.tail ?? ""}
`;
        emit({ change: id, ...r }, text);
        return r.ok ? 0 : 1;
      }
      case "first-deploy": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const r = firstDeploy(p, id, args.flags.yes === true);
        emit({ change: id, ...r }, `${r.ran ? `${r.ok ? "DEPLOYED" : "FAILED"} (${r.command})
` : ""}${r.output}
${r.ok && r.ran ? "Previews work from now on: run aidw deploy.\n" : ""}`);
        return r.ok ? 0 : 1;
      }
      case "review": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const taskId = need(rest[0], "task id");
        const verdict = need(rest[1], "verdict (pass|fix)");
        if (verdict !== "pass" && verdict !== "fix") throw new UsageError('verdict must be "pass" or "fix"');
        const notesFile = str(args.flags["notes-file"]);
        const notes = notesFile ? (0, import_node_fs31.readFileSync)(notesFile, "utf8") : str(args.flags.notes) ?? "";
        if (verdict === "fix" && !notes.trim()) throw new UsageError("a fix verdict needs --notes or --notes-file");
        const r = recordReview(p, id, taskId, verdict, notes, { commit: args.flags["no-commit"] !== true });
        emit(
          { ok: true, change: id, ...r },
          `${reviewLine(r, verdict, notes)}${nextLine(p, id)}${r.status === "done" ? sessionEnd(env, p, id) : ""}`
        );
        return 0;
      }
      case "triage": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const taskId = need(rest[0], "task id");
        const file = str(args.flags["notes-file"]) ?? triageFile(p, taskId);
        if (!(0, import_node_fs31.existsSync)(file)) throw new OpError(`no triage answer at ${file}: the Agent did not write it. Spawn it once more with \`aidw brief ${taskId} --for triage\``);
        const r = recordTriage(p, id, taskId, (0, import_node_fs31.readFileSync)(file, "utf8"));
        const first = r.diagnosis.split("\n").find((l) => l.trim()) ?? "";
        const line = r.outcome === "retry" ? `${r.task} triaged: the cause is the implementation. One further attempt is granted with the diagnosis in its brief: ${first}
` : r.cause === "environment" ? `${r.task} triaged: the cause is the environment, so it escalated. What the user must fix: ${first}
(full diagnosis: ${rel(p, file)})
` : `${r.task} triaged: the cause is the ${r.cause}, so it escalated: the approved package would change and the user decides. ${first}
(full diagnosis: ${rel(p, file)})
`;
        emit({ ok: true, change: id, ...r }, `${line}${nextLine(p, id)}`);
        return 0;
      }
      case "verdict": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const taskId = need(rest[0], "task id");
        const file = str(args.flags["notes-file"]) ?? (0, import_node_path33.join)(p.run, `review-${taskId}.md`);
        if (!(0, import_node_fs31.existsSync)(file)) throw new OpError(`no verdict file at ${file}: the reviewer did not write it. Spawn a fresh reviewer, or save its reply there and run this again`);
        const notes = (0, import_node_fs31.readFileSync)(file, "utf8");
        const verdict = parseVerdict(notes);
        if (!verdict) throw new OpError(`${file} does not start with "VERDICT: pass" or "VERDICT: fix"; spawn a fresh reviewer once more, and if it is still unclear record it with \`aidw review ${taskId} fix --notes-file\``);
        const r = recordReview(p, id, taskId, verdict, notes, { commit: args.flags["no-commit"] !== true });
        emit(
          { ok: true, change: id, ...r },
          `${reviewLine(r, verdict, notes)}${nextLine(p, id)}${r.status === "done" ? sessionEnd(env, p, id) : ""}`
        );
        return 0;
      }
      case "vendor-path": {
        const ref = need(rest[0], "<upstream>/<skill>");
        if (!/^[a-z0-9-]+\/[a-z0-9-]+$/.test(ref)) throw new UsageError(`invalid vendored skill "${ref}"`);
        const file = (0, import_node_path33.join)(pluginRoot(env), "library", "vendor", ...ref.split("/"), "SKILL.md");
        if (!(0, import_node_fs31.existsSync)(file)) throw new OpError(`vendored skill "${ref}" not found at ${file}`);
        emit({ path: file }, `${file}
`);
        return 0;
      }
      case "plugin-path": {
        const ref = need(rest[0], "relative path inside the plugin");
        if (!/^[A-Za-z0-9._-]+(\/[A-Za-z0-9._-]+)*$/.test(ref) || ref.split("/").includes("..")) {
          throw new UsageError(`invalid plugin path "${ref}"`);
        }
        const file = (0, import_node_path33.join)(pluginRoot(env), ...ref.split("/"));
        if (!(0, import_node_fs31.existsSync)(file)) throw new OpError(`"${ref}" not found in the plugin (${file})`);
        emit({ path: file }, `${file}
`);
        return 0;
      }
      case "roster": {
        const root = pluginRoot(env);
        const written = args.flags.write === true ? writeAgents(root) : [];
        const d = checkRoster(root);
        d.add(checkArtifacts(root));
        d.add(checkWorkflows(root));
        d.add(checkEvals(root));
        const table = d.errors.length ? "" : rosterTable(root);
        const summary = `${d.errors.length ? "FAILED" : "OK"}: ${d.errors.length} error(s), ${d.warnings.length} warning(s)
`;
        emit(
          { ok: d.errors.length === 0, written, ...diagsJson(d) },
          `${table}${written.length ? `wrote agents/: ${written.join(", ")}
` : ""}${printDiags(d)}${summary}`
        );
        return d.errors.length ? 1 : 0;
      }
      case "analyze": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const d = analyzeChange(p, id);
        const summary = `${d.errors.length ? "FAILED" : "OK"}: ${d.errors.length} error(s), ${d.warnings.length} warning(s)
`;
        emit({ ok: d.errors.length === 0, id, ...diagsJson(d) }, printDiags(d) + summary);
        return d.errors.length ? 1 : 0;
      }
      case "ids": {
        const p = project();
        const id = rest[0] ?? (listChangeIds(p).length === 1 ? listChangeIds(p)[0] : void 0);
        let requirements;
        let scenarios;
        let changed;
        if (id) {
          const r = idsAfterChange(p, id);
          requirements = [...r.ids.requirements].sort();
          scenarios = [...r.ids.scenarios].sort();
          changed = { requirements: [...r.changed.requirements].sort(), scenarios: [...r.changed.scenarios].sort() };
        } else {
          const all2 = mainSpecIds(p);
          requirements = [...all2.requirements].sort();
          scenarios = [...all2.scenarios].sort();
        }
        const mark = (x, set) => set?.includes(x) ? "* " : "  ";
        const text = [
          `requirements${id ? ` (after ${id}; * = changed)` : ""}`,
          ...requirements.map((r) => `${mark(r, changed?.requirements)}${r}`),
          "scenarios",
          ...scenarios.map((s) => `${mark(s, changed?.scenarios)}${s}`)
        ].join("\n");
        emit({ change: id ?? null, requirements, scenarios, changed: changed ?? null }, `${text}
`);
        return 0;
      }
      case "init": {
        const dir = str(args.flags.root) ?? cwd;
        const { created, detection: d } = initProject(dir);
        emit(
          { ok: true, created, detection: d },
          `initialized .aidw/ (${created.length} files): ${d.kind}
${d.kind === "brownfield" ? `${d.signals.map((s) => `  signal  ${s}
`).join("")}${Object.entries(d.stack).map(([k, v]) => `  stack   ${k}: ${v}
`).join("")}  (recorded in .aidw/project.yaml; the existing stack is kept)
` : ""}${d.warnings.map((w) => `  WARNING ${w}
`).join("")}`
        );
        return 0;
      }
      case "plan": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const tasks = parseTasks(readText((0, import_node_path33.join)(loadChange(p, id).dir, "tasks.yaml")) ?? "").tasks;
        const shape = planShape(tasks);
        emit({ change: id, ...shape, summary: planSummary(tasks), advice: planAdvice(tasks) }, `${planSummary(tasks)}
${planAdvice(tasks).map((a) => `  advice: ${a}
`).join("")}`);
        return 0;
      }
      case "pr": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change) ?? rest[0]);
        const base = str(args.flags.base);
        if (args.flags.create === true) {
          const r = createPr(p, id, { ...base ? { base } : {}, draft: args.flags.draft === true });
          emit({ ok: true, change: id, url: r.url, title: r.plan.title }, `pull request opened: ${r.url}
`);
          return 0;
        }
        const plan = planPr(p, id, base ? { base } : {});
        emit({ ok: true, change: id, title: plan.title, head: plan.head, base: plan.base, body: plan.body, commands: plan.commands }, `title: ${plan.title}

${plan.body}
To open it (asks first): aidw pr --create [--base <branch>] [--draft]
`);
        return 0;
      }
      case "browser": {
        const p = project();
        const sub = rest[0];
        if (sub === "start") {
          const r = startBrowser(p, { headed: args.flags.headed === true, env });
          emit({ ok: true, started: r.started, ...r.record }, `${r.started ? "started" : "already running"}: ${r.record?.url} (${r.browser}, pid ${r.record?.pid}, ${r.record?.headless ? "headless" : "headed"})
layers get it as E2E_CDP_URL and E2E_CDP_PORT; for your own shell: export E2E_CDP_URL=$(aidw browser url)
`);
          return 0;
        }
        if (sub === "status") {
          const s = browserStatus(p);
          emit({ ok: s.running, ...s }, s.running ? `running: ${s.record?.url} (${s.browser}, pid ${s.record?.pid})
` : s.record ? `not running: ${s.stale}
` : "no test browser: run `aidw browser start`\n");
          return s.running ? 0 : 1;
        }
        if (sub === "url") {
          const s = browserStatus(p);
          if (!s.running || !s.record) throw new OpError("no test browser is running: run `aidw browser start`");
          emit({ url: s.record.url, port: s.record.port }, `${s.record.url}
`);
          return 0;
        }
        if (sub === "stop") {
          const result = stopBrowser(p);
          if (result === "denied") throw new OpError("the test browser is running but this session may not stop it (the sandbox blocks signalling it): run `aidw browser stop` in your own terminal");
          emit({ ok: true, stopped: result === "stopped" }, result === "stopped" ? "test browser stopped\n" : "no test browser was running\n");
          return 0;
        }
        throw new UsageError("browser needs start, status, url or stop");
      }
      case "doctor": {
        const p = project();
        let id = rest[0] ?? null;
        if (!id) {
          try {
            id = resolveChangeId(p, void 0);
          } catch {
            id = null;
          }
        }
        const checks = doctor(p, id, env);
        emit({ ok: !checks.some((c) => c.status === "fail"), change: id, checks }, doctorText(checks));
        return checks.some((c) => c.status === "fail") ? 1 : 0;
      }
      case "detect": {
        const dir = findProject({ root: str(args.flags.root), cwd, env }) ?? str(args.flags.root) ?? cwd;
        const d = detectProject(dir);
        const text = [
          `${d.kind}${d.packageManager ? ` (${d.packageManager})` : ""}${d.languages.length ? `, ${d.languages.join(", ")}` : ""}`,
          ...d.signals.map((s) => `  signal  ${s}`),
          ...Object.entries(d.stack).map(([k, v]) => `  stack   ${k}: ${v}`),
          ...packsFor(pluginRoot(env), d.stack, "fullstack").concat(packsFor(pluginRoot(env), d.stack, "frontend"), packsFor(pluginRoot(env), d.stack, "backend")).filter((k, i, a) => a.findIndex((x) => x.id === k.id) === i).map((k) => `  pack    ${k.id} (read by ${k.roles.join(", ")})`),
          ...d.layers.map((l) => `  layer   ${l.name}: ${l.run.join(" && ")}`),
          ...d.warnings.map((w) => `  WARNING ${w}`)
        ];
        emit(d, `${text.join("\n")}
`);
        return 0;
      }
      case "baseline": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const file = createBaseline(p, id, need(rest[0], "capability"));
        emit({ ok: true, change: id, file: rel(p, file) }, `wrote baseline skeleton ${rel(p, file)}: describe the current behavior, then aidw analyze ${id}
`);
        return 0;
      }
      case "change": {
        if (rest[0] !== "new") throw new UsageError("usage: aidw change new <id>");
        const p = project();
        const id = need(rest[1], "change id");
        const wf = str(args.flags.workflow);
        const dir = newChange(p, id, { title: str(args.flags.title), inputType: str(args.flags["input-type"]), ...wf ? { workflow: wf, workflows: workflowIds(pluginRoot(env)), skipSpecs: boundaryOf(pluginRoot(env), wf)?.spec_changes === false, scopeGate: loadWorkflow(pluginRoot(env), wf)?.scope_gate === true } : {} });
        emit({ ok: true, id, dir: rel(p, dir) }, `created change ${id} at ${rel(p, dir)}
`);
        return 0;
      }
      case "status": {
        const p = project();
        const s = projectStatus(p, rest[0]);
        const lines = [
          `project  ${s.project}`,
          `specs    ${s.specs.capabilities} capabilities, ${s.specs.requirements} requirements`,
          s.changes.length ? "changes" : "changes  (none)",
          ...s.changes.map((c) => {
            if (c.error) return `  ${c.id}  ERROR ${c.error}`;
            const tasks = c.tasks ? `tasks ${c.tasks.done}/${c.tasks.total}` : "no tasks";
            const paused = c.paused ? `  paused(${c.paused.reason ?? "?"})` : "";
            const appr = c.approval === "drift" ? "APPROVAL DRIFT" : `approval ${c.approval}`;
            return `  ${c.id}  [${c.state}]  ${appr}  ${tasks}  deltas ${c.deltas}${paused}`;
          })
        ];
        emit(s, `${lines.join("\n")}
`);
        return 0;
      }
      case "validate": {
        const p = project();
        const d = new Diags();
        const checkOne = (id) => {
          d.add(checkChange(p, id));
          try {
            const c = loadChange(p, id);
            if (isState(c.data.state) && machineOf(p, c).analysisRequired.has(c.data.state)) d.add(analyzeChange(p, id));
          } catch {
          }
        };
        if (rest[0]) checkOne(rest[0]);
        else {
          d.add(checkSpecs(p));
          for (const id of listChangeIds(p)) checkOne(id);
        }
        const strict = args.flags.strict === true;
        const failed = d.failed(strict);
        const summary = `${failed ? "FAILED" : "OK"}: ${d.errors.length} error(s), ${d.warnings.length} warning(s)${strict ? " (strict)" : ""}
`;
        emit({ ok: !failed, strict, ...diagsJson(d) }, printDiags(d) + summary);
        return failed ? 1 : 0;
      }
      case "decide": {
        const p = project();
        const id = resolveChangeId(p, str(args.flags.change));
        const name = need(rest[0], "decision id");
        try {
          const r = recordDecision(p, id, name, need(rest[1], "answer"), str(args.flags.reason) ?? "", pluginRoot(env));
          emit({ ok: true, change: id, decision: name, ...r.recorded }, `${id}: ${name} = ${[r.recorded.answer].flat().join(", ")} (${r.decision.decide}): ${r.recorded.reason}
`);
          return 0;
        } catch (e) {
          if (e instanceof DecisionError) throw new OpError(e.message);
          throw e;
        }
      }
      case "audit": {
        const p = project();
        const sub = need(rest[0], "brief | report | picks");
        const id = resolveChangeId(p, str(args.flags.change));
        const c = loadChange(p, id);
        const w = workflowOfChange(p, c, pluginRoot(env));
        const roles = lensRoles(w);
        if (!Object.keys(roles).length) throw new OpError(`change "${id}" runs under the "${w.id}" workflow, which is not an audit`);
        if (sub === "brief") {
          const lens = need(rest[1], "lens");
          const chosen = chosenLenses(p, id);
          if (!chosen) throw new OpError('no lenses decided: run `aidw decide audit-lenses <lens,lens> --reason "..."` first');
          if (!chosen.includes(lens)) throw new OpError(`lens "${lens}" was not decided for this audit (decided: ${chosen.join(", ")})`);
          const role = roles[lens];
          const b = buildAuditBrief(p, id, lens, role);
          emit({ change: id, lens, agent: `aidw:${role}`, brief: b.path }, `${b.path}
SPAWN aidw:${role} with: Audit brief: ${b.path}. Read it and write your answer as it says.
`);
          return 0;
        }
        if (sub === "report") {
          const r = compileReport(p, id);
          const ok = r.diags.errors.length === 0;
          emit({ ok, change: id, report: ok ? rel(p, r.path) : null, findings: r.findings, ...diagsJson(r.diags) }, ok ? `${rel(p, r.path)}: ${r.findings.length} finding(s)
` : `${printDiags(r.diags)}INCOMPLETE: every decided lens must answer
`);
          return ok ? 0 : 1;
        }
        if (sub === "picks") {
          const picks = need(rest[1], "finding ids, e.g. F-01,F-03").split(",").map((x) => x.trim().toUpperCase()).filter(Boolean);
          const r = pickFindings(p, id, picks);
          if (r.missing.length) throw new OpError(`no such finding: ${r.missing.join(", ")} (see the report: aidw audit report)`);
          emit({ ok: true, change: id, picks, request: r.text }, r.text);
          return 0;
        }
        throw new UsageError("usage: aidw audit brief <lens> | report | picks <F-01,F-02>");
      }
      case "decisions": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const c = loadChange(p, id);
        const w = workflowOfChange(p, c, pluginRoot(env));
        const all2 = readDecisions(c);
        const rows = w.decisions.map((x) => ({ id: x.id, decide: x.decide, options: x.options, required: x.required, recorded: all2[x.id] ?? null }));
        emit(
          { change: id, workflow: w.id, decisions: rows },
          rows.length ? `${rows.map((r) => `${r.id.padEnd(20)} ${r.recorded ? `${[r.recorded.answer].flat().join(", ")}: ${r.recorded.reason}` : `(open: ${r.options.join(" | ")}${r.required ? ", required" : ""})`}`).join("\n")}
` : `workflow ${w.id} has no decision points
`
        );
        return 0;
      }
      case "approve": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const auto = args.flags.auto === true;
        const { hash, files, by, scope } = approve(p, id, auto ? { auto: { pluginRoot: pluginRoot(env) } } : {});
        if (scope) {
          emit({ ok: true, id, hash, files, scope: true }, `scope approved ${id}
  ${hash}
  The change is back in analyzing: continue with the domain model, requirements and specs (step 3 of /aidw:start).
`);
          return 0;
        }
        const { kept, reopened } = reconcileDoneTasks(p, id);
        emit(
          { ok: true, id, hash, files, kept, reopened },
          `${scope ? "scope approved" : "approved"} ${id}${by === "user" ? "" : ` by ${by}`}
  ${hash}
  covers ${files.length} file(s)
${kept.length ? `  done work kept: ${kept.join(", ")}
` : ""}${reopened.length ? `  edited tasks run again: ${reopened.join(", ")}
` : ""}  cheapest build (about a quarter of the tokens): in your own terminal, ${(0, import_node_path33.join)(pluginRoot(env), "bin", "aidw")} run ${id} --permission-mode auto
`
        );
        return 0;
      }
      case "approval": {
        if (rest[0] !== "check") throw new UsageError("usage: aidw approval check <id>");
        const p = project();
        const id = resolveChangeId(p, rest[1]);
        const c = loadChange(p, id);
        const a = approvalStatus(p, c);
        const files = computeApprovalHash(p, c).files;
        emit(
          { ok: a.status === "valid", id, ...a, files },
          a.status === "valid" ? `approval valid for ${id}
` : a.status === "none" ? `${id} has no approval
` : `APPROVAL DRIFT for ${id}
  approved ${a.expected}
  current  ${a.actual}
`
        );
        return a.status === "valid" ? 0 : 1;
      }
      case "transition": {
        const p = project();
        const id = need(rest[0], "change id");
        const to = need(rest[1], "target state");
        const r = transition(p, id, to, { reason: str(args.flags.reason) });
        emit({ ok: true, id, ...r }, `${id}: ${r.from} -> ${r.to}${r.commit ? ` (committed .aidw/ ${r.commit.slice(0, 8)})` : ""}
${(r.notes ?? []).map((n) => `  ${n}
`).join("")}`);
        return 0;
      }
      case "merge": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const merges = planMerge(p, id);
        const write = args.flags.write === true;
        if (write) writeMerge(merges);
        const lines = merges.map((m) => {
          const s = m.summary;
          const parts = [
            s.added.length && `+${s.added.length} added`,
            s.modified.length && `~${s.modified.length} modified`,
            s.removed.length && `-${s.removed.length} removed`,
            s.renamed.length && `${s.renamed.length} renamed`
          ].filter(Boolean);
          return `  ${m.capability}${m.created ? " (new)" : ""}: ${parts.join(", ") || "no changes"}`;
        });
        emit(
          { ok: true, id, written: write, merges: merges.map(({ text: _t, file, ...m }) => ({ ...m, file: rel(p, file) })) },
          `${write ? "merged" : "dry run (use --write to apply)"}: ${id}
${lines.join("\n")}
`
        );
        return 0;
      }
      case "archive": {
        const p = project();
        const id = resolveChangeId(p, rest[0]);
        const { target, merges, commit } = archiveChange(p, id);
        const alsoCommitted = commit ? git(p.project, ["show", "--name-only", "--format=", commit]).out.split("\n").filter((f) => f && !f.startsWith(".aidw/")) : [];
        emit(
          { ok: true, id, archived: rel(p, target), capabilities: merges.map((m) => m.capability), commit: commit ?? null, also_committed: alsoCommitted },
          `archived ${id} -> ${rel(p, target)} (${merges.length} capability spec(s) updated)${commit ? `, committed ${commit.slice(0, 8)}` : ""}
${alsoCommitted.length ? `also committed with it: ${alsoCommitted.join(", ")}
` : ""}`
        );
        return 0;
      }
      default:
        throw new UsageError(`unknown command "${cmd2}"`);
    }
  } catch (e) {
    if (e instanceof UsageError) {
      io.err(`aidw: ${e.message}

${HELP}`);
      return 2;
    }
    if (e instanceof OpError || e instanceof ChangeError || e instanceof BrowserError) {
      const d = e instanceof OpError ? e.diags : void 0;
      if (json) io.out(`${JSON.stringify({ ok: false, error: e.message, ...d ? diagsJson(d) : {} }, null, 2)}
`);
      else io.err(`aidw: ${e.message}
${d ? printDiags(d) : ""}`);
      return 1;
    }
    throw e;
  }
}
if (typeof require !== "undefined" && require.main === module) {
  process.exitCode = run(process.argv.slice(2), process.env, process.cwd(), {
    out: (s) => process.stdout.write(s),
    err: (s) => process.stderr.write(s),
    stdin: () => {
      try {
        return (0, import_node_fs31.readFileSync)(0, "utf8");
      } catch {
        return "";
      }
    }
  });
}
// Annotate the CommonJS export names for ESM import in node:
0 && (module.exports = {
  addBinToPath,
  parseArgs,
  pluginRoot,
  run
});
