var ROLE_STATUSES = ["active", "planned"];
var RUN_MODES = ["interactive", "worker"];
var TIERS = ["deep", "standard", "fast"];
var ACCESS = ["write", "artifacts", "read-only"];
var ROLE_ID = /^[a-z][a-z0-9]*(-[a-z0-9]+)*$/;
var isRecord3 = (v) => !!v && typeof v === "object" && !Array.isArray(v);
var loadedAgents;
