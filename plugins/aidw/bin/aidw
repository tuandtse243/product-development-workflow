var isGeneratedPath = (f) => GENERATED_PATH.test(f);
function stagedJunk(cwd) {
  const r = git(cwd, ["diff", "--cached", "--name-only"]);
  return r.ok ? r.out.split("\n").filter((f) => JUNK_PATH.test(f)) : [];
}
var junkMessage = (files) => `refusing to commit dependency or build output (${files.slice(0, 3).join(", ")}${files.length > 3 ? ", ..." : ""}): the project has no .gitignore covering it. Add node_modules/, .next/, *.tsbuildinfo, next-env.d.ts, .env and the like to .gitignore, run \`git rm -r -q --cached <path>\` for anything already tracked, then retry`;
function headCommit(cwd) {
  const r = git(cwd, ["rev-parse", "--verify", "-q", "HEAD"]);
  return r.ok && r.out ? r.out : null;
}
function changedSince(cwd, base) {
  if (!isGitRepo(cwd)) return null;
  const files = /* @__PURE__ */ new Set();
  const diff = base ? git(cwd, ["diff", "--name-only", base]) : git(cwd, ["diff", "--name-only", "--cached"]);
  if (!diff.ok) return null;
  for (const f of diff.out.split("\n")) if (f) files.add(f);
  if (!base) {
    for (const f of git(cwd, ["diff", "--name-only"]).out.split("\n")) if (f) files.add(f);
  }
  for (const f of git(cwd, ["ls-files", "--others", "--exclude-standard"]).out.split("\n")) if (f) files.add(f);
  return [...files].sort();
}

// src/backstop.ts
function gitDirtyPaths(project) {
  try {
    const out = (0, import_node_child_process2.execFileSync)("git", ["status", "--porcelain=v1", "-z", "--untracked-files=all"], {
      cwd: project,
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"]
    });
    const paths = [];
    const entries = out.split("\0").filter(Boolean);
    for (let i = 0; i < entries.length; i++) {
      const e = entries[i];
      const status = e.slice(0, 2);
      paths.push(e.slice(3));
      if (status.startsWith("R") || status.startsWith("C")) i++;
    }
    return paths;
  } catch {
    return null;
  }
}
var baselineFile = (p) => (0, import_node_path8.join)(p.run, "baseline.json");
function recordBaseline(p, dirty = gitDirtyPaths(p.project)) {
  if (dirty === null) return;
  (0, import_node_fs7.mkdirSync)(p.run, { recursive: true });
  const previous = readBaseline(p);
  const merged = [.../* @__PURE__ */ new Set([...previous, ...dirty.filter((f) => !isAidw(f))])].sort();
  (0, import_node_fs7.writeFileSync)(baselineFile(p), `${JSON.stringify({ paths: merged }, null, 2)}
`);
}
function readBaseline(p) {
  const f = baselineFile(p);
  if (!(0, import_node_fs7.existsSync)(f)) return [];
  try {
    const data = JSON.parse((0, import_node_fs7.readFileSync)(f, "utf8"));
    return Array.isArray(data.paths) ? data.paths.map(String) : [];
  } catch {
    return [];
  }
}
var isAidw = (f) => f === AIDW_DIR || f.startsWith(`${AIDW_DIR}/`);
function unexpectedChanges(dirty, baseline) {
  const base = new Set(baseline);
  return dirty.filter((f) => !isAidw(f) && !base.has(f) && !isGeneratedPath(f)).sort();
}
function runBackstop(stdin, env, dirtyProvider = gitDirtyPaths) {
  let input = {};
  try {
    input = JSON.parse(stdin || "{}");
  } catch {
    return "";
  }
  const project = findProject({ cwd: input.cwd ?? process.cwd(), env });
  if (!project) return "";
  const p = pathsFor(project);
  const st = gateState(p);
  if (st.open) return "";
  const dirty = dirtyProvider(project);
  if (!dirty) return "";
  const unexpected = unexpectedChanges(dirty, readBaseline(p));
  if (!unexpected.length) return "";
  const list5 = unexpected.slice(0, 20).map((f) => `  - ${f}`).join("\n");
  const more = unexpected.length > 20 ? `
  ... and ${unexpected.length - 20} more` : "";
  const reason = `AIDW backstop: ${closedReason(st)} Yet these files outside ${AIDW_DIR}/ changed and are not explained by an aidw step:
${list5}${more}
Do not delete or revert anything yourself: some of these may be the user's own edits. Tell the user which of these you created or modified in this session and ask how to proceed. While the gate is closed, write only inside .aidw/.`;
  if (input.stop_hook_active) {
    return JSON.stringify({ systemMessage: reason });
  }
  return JSON.stringify({ decision: "block", reason });
}

