var read = (file) => (0, import_node_fs9.readFileSync)(file, "utf8");
function loadRoster(root) {
  const data = import_yaml6.default.parse(read(rosterFile(root)));
  const departments = isRecord3(data) && isRecord3(data.departments) ? data.departments : {};
  const roles = isRecord3(data) && isRecord3(data.roles) ? data.roles : {};
  return { departments, roles };
}
function parseRoleText(text2) {
  const m = /^---\n([\s\S]*?)\n---\n?([\s\S]*)$/.exec(text2);
  if (!m) return null;
  let header2;
  try {
    header2 = import_yaml6.default.parse(m[1] ?? "");
  } catch {
    return null;
  }
  return isRecord3(header2) ? { header: header2, body: (m[2] ?? "").trim() } : null;
}
function loadRole(root, id) {
  const file = (0, import_node_path11.join)(roleDir(root, id), "role.md");
  if (!(0, import_node_fs9.existsSync)(file)) return null;
  const parsed = parseRoleText(read(file));
  if (!parsed) return null;
  const h = parsed.header;
  const rulesFile = (0, import_node_path11.join)(roleDir(root, id), "rules.md");
  const includes = Array.isArray(h.includes) ? h.includes.map(String) : [];
  return {
    id: String(h.id ?? ""),
    description: String(h.description ?? ""),
    mode: h.mode,
    tier: h.tier,
    access: h.access,
    tools: Array.isArray(h.tools) ? h.tools.map(String) : [],
    ...typeof h.max_turns === "number" ? { max_turns: h.max_turns } : {},
    skills: skillIndex(h.skills),
    includes,
    consults: Array.isArray(h.consults) ? h.consults.map(String) : [],
    body: parsed.body,
    shared: includes.map((f) => (0, import_node_fs9.existsSync)((0, import_node_path11.join)(root, f)) ? read((0, import_node_path11.join)(root, f)).trim() : ""),
    rules: (0, import_node_fs9.existsSync)(rulesFile) ? read(rulesFile).trim() : ""
  };
}
function skillIndex(raw) {
  if (!Array.isArray(raw)) return [];
  return raw.flatMap((e) => isRecord3(e) ? Object.entries(e).map(([name, when]) => ({ name, when: String(when) })) : []);
}
function loadTiers(root, platform = "claude-code") {
  const file = (0, import_node_path11.join)(root, "tiers.yaml");
