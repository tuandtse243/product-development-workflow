var MIGRATION = /(^|\/)(migrations?|db\/migrate|drizzle|alembic\/versions|flyway|liquibase)(\/|$)|\.sql$/i;
var SCHEMA = /(^|\/)(prisma\/schema\.prisma|(db|database)\/schema(\.[a-z]+)?(\/.*)?)$/i;
var isDatabasePath = (glob) => MIGRATION.test(glob) || SCHEMA.test(glob);
var touchesDatabase = (globs) => globs.some(isDatabasePath);

// src/boundary.ts
function boundaryExceeded(p, id, b) {
  const change = loadChange(p, id);
  const tasks = parseTasks(readText((0, import_node_path21.join)(change.dir, "tasks.yaml")) ?? "").tasks.filter((t) => t.origin === void 0 || t.origin === "plan");
  const out = [];
  if (tasks.length > b.max_tasks) out.push(`the plan has ${tasks.length} tasks (at most ${b.max_tasks})`);
  if (!b.migrations) {
    const m = tasks.filter((t) => touchesDatabase((Array.isArray(t.touches) ? t.touches : []).map(String)));
    if (m.length) out.push(`${m.map((t) => t.id).join(", ")} change the database schema or a migration`);
  }
  if (!b.spec_changes) {
    const specs = walkFiles((0, import_node_path21.join)(change.dir, "specs")).filter((f) => f.endsWith("spec.md"));
    if (specs.length) out.push(`it changes behavior written in a spec (${specs.length} delta spec file(s))`);
  }
  return out;
}
function boundaryOf(pluginRoot2, workflow) {
  const w = loadWorkflow(pluginRoot2, workflow);
  return w?.stages.find((s) => s.gate === "approval-auto")?.boundary ?? null;
}

