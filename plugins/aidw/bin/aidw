  }
  if (c) {
    const step = c.status === "needs-deviation" && c.deviation === "pending" ? "deviation" : c.status !== "open" ? "resume" : (0, import_node_fs34.existsSync)((0, import_node_path39.join)(tf.change.dir, c.answer)) ? "record" : "answer";
    return {
      action: "consult",
      step,
      consultation: c.id,
      from: c.from,
      to: c.to,
      ...c.task ? { task: c.task } : {},
      ...c.stage ? { stage: c.stage } : {},
