var UI_GESTURE = /\b(clicks?|taps?|presses|pressed|selects?|opens?|toggles?|button|dialog|screen|page)\b|bấm|nhấn|chạm|chọn|nút\b|màn hình|màn\b/i;
var BROWSER_VERIFY_RE = /\b(playwright|cypress|e2e)\b/i;
function scenarioWhens(raw) {
  const out = /* @__PURE__ */ new Map();
  let name = "";
  for (const line of raw.split("\n")) {
    const h = /^####\s+Scenario:\s*(.+?)\s*$/.exec(line);
    if (h) name = h[1];
    else if (name && /\*\*WHEN\*\*/.test(line)) out.set(name, line);
  }
  return out;
}
function uiScenarioAdvice(p, id, tasks, d, tf) {
  const { deltas } = specsAfterChange(p, id);
  for (const [cap, text2] of deltas) {
    const delta = parseDelta(text2);
    for (const r of [...delta.added, ...delta.modified]) {
      for (const [name, when] of scenarioWhens(r.raw)) {
        if (!UI_GESTURE.test(when)) continue;
        const sid = scenarioId(cap, r.name, name);
        const owners = tasks.filter((t) => Array.isArray(t.scenarios) && t.scenarios.map(String).includes(sid));
        const reachesUi = owners.some((t) => touchesUi(t) || Array.isArray(t.verify) && t.verify.some((v) => BROWSER_VERIFY_RE.test(String(v))));
        if (owners.length && !reachesUi) {
          d.warn(tf, `scenario "${sid}" is triggered from the UI ("${when.replace(/^[-*\s]*\*\*WHEN\*\*\s*/, "").slice(0, 80)}") but task(s) ${owners.map((t) => t.id).join(", ")} touch no UI files and run no browser test: add the UI work to a task`);
        }
      }
    }
  }
}

