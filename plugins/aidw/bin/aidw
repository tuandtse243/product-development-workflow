var ADDY = (name) => `addy/${name}`;
var UI_TOUCH = /(^|\/)(components?|pages|views|layouts?|styles?|ui|public)(\/|$)|\.(tsx|jsx|vue|svelte|css|scss|html)\b|(^|\/)(src\/)?app\/(?!api\/)/;
var API_TOUCH = /(^|\/)(api|server|routes?|actions?|trpc|graphql|controllers?|services?|handlers?|middleware)(\/|\.|$)/;
var DATA_TOUCH = /(^|\/)(supabase|migrations?|prisma|drizzle|db|database|schema)(\/|\.|$)/;
var SECURITY_HINT = /\b(auth|login|logout|sign-?in|sign-?up|session|password|permissions?|roles?|rls|policy|policies|payments?|stripe|checkout|billing|webhooks?|middleware|admin|tokens?|secrets?)\b/i;
var BROWSER_VERIFY = /\b(playwright|cypress|e2e)\b/i;
var list = (v) => Array.isArray(v) ? v.map(String) : [];
function isSecuritySensitive(t) {
  if (t.risk === "high") return true;
  const text = [t.title ?? "", ...list(t.touches), ...list(t.specs), ...list(t.scenarios)].join(" ").replace(/[/_.-]/g, " ");
  return SECURITY_HINT.test(text);
}
function touchesUi(t) {
  return list(t.touches).some((g) => UI_TOUCH.test(g));
}
function selectSkills(t, kind, opts = {}) {
  const picks = [];
  const add = (name, reason) => {
    const id = name.includes("/") ? name : ADDY(name);
    if (!picks.some((p) => p.id === id)) picks.push({ id, reason });
  };
  const touches = list(t.touches);
  const role = String(t.role ?? "");
  if (kind === "review") {
    add("code-review-and-quality", "every review");
    if (isSecuritySensitive(t)) add("security-and-hardening", "security-sensitive task (risk or auth/payment/permissions)");
    return picks;
  }
  add("incremental-implementation", "core: every implementation task");
  add("test-driven-development", "core: tests per scenario before code");
  const ui = touchesUi(t) || role === "frontend-engineer";
  const api = touches.some((g) => API_TOUCH.test(g)) || role === "backend-engineer";
  const data = touches.some((g) => DATA_TOUCH.test(g)) || role === "database-engineer";
  if (ui) add("frontend-ui-engineering", "touches UI files");
  if (api) add("api-and-interface-design", "touches API or server code");
  else if (data) add("api-and-interface-design", "touches the data layer (schema is an interface)");
  if (isSecuritySensitive(t)) add("security-and-hardening", "security-sensitive task (risk or auth/payment/permissions)");
  if (list(t.verify).some((v) => BROWSER_VERIFY.test(v))) add("browser-testing-with-devtools", "verify runs browser/E2E tests");
  if (opts.retry) add("debugging-and-error-recovery", "previous attempt failed");
  if (t.origin === "quality") add("debugging-and-error-recovery", "fixing a failing quality layer");
  for (const s of list(t.skills)) add(s, "requested by the task (tasks.yaml skills:)");
  return picks;
}

// src/touches.ts
function staticPrefix(glob) {
  const segs = glob.trim().replace(/^\.\//, "").replace(/\/+$/, "").split("/").filter(Boolean);
  const out = [];
  for (const s of segs) {
    if (/[*?{[]/.test(s)) break;
    out.push(s);
  }
  return out;
}
function globsOverlap(a, b) {
  const pa = staticPrefix(a);
  const pb = staticPrefix(b);
  for (let i = 0; i < Math.min(pa.length, pb.length); i++) if (pa[i] !== pb[i]) return false;
  return true;
}
var touchesOverlap = (a, b) => a.some((x) => b.some((y) => globsOverlap(x, y)));

// src/parallel.ts
var list2 = (v) => Array.isArray(v) ? v.map(String) : [];
var statusOf = (t) => String(t.status ?? "pending");
var now = () => (/* @__PURE__ */ new Date()).toISOString();
var BROWSER_VERIFY2 = /\b(playwright|cypress|e2e)\b/i;
var drivesBrowser = (t) => list2(t.verify).some((v) => BROWSER_VERIFY2.test(v)) || touchesUi(t);
var mustRunAlone = (t) => t.risk === "high" || t.sequential === true || list2(t.touches).some((g) => staticPrefix(g).length === 0);
function planWave(tasks, max) {
  const byId = new Map(tasks.map((t) => [t.id, t]));
  const ready = tasks.filter((t) => statusOf(t) === "pending" && list2(t.depends_on).every((d) => statusOf(byId.get(d) ?? { id: d }) === "done"));
  const first = ready[0];
  if (!first) return [];
  const wave = [first];
  if (mustRunAlone(first)) return wave;
  for (const t of ready.slice(1)) {
    if (wave.length >= max) break;
    if (mustRunAlone(t)) continue;
    if (wave.some((w) => touchesOverlap(list2(w.touches), list2(t.touches)))) continue;
    if (drivesBrowser(t) && wave.some(drivesBrowser)) continue;
    wave.push(t);
  }
  return wave;
}
function parallelConfig(p, change) {
  if (!isGitRepo(p.project) || !headCommit(p.project)) return { ...DEFAULT_PARALLEL, max: 1 };
  const text = readText(qualityFile(change));
  if (text === null) return { ...DEFAULT_PARALLEL, max: 1 };
  return parseQuality(text, "quality.yaml").config?.parallel ?? { ...DEFAULT_PARALLEL, max: 1 };
}
var worktreesRoot = (p) => (0, import_node_path16.join)(p.run, "worktrees");
var worktreeDir = (p, id, taskId) => (0, import_node_path16.join)(worktreesRoot(p), id, taskId);
var branchName = (id, taskId) => `aidw/${id}.${taskId}`;
function taskDir(p, t) {
  return typeof t.worktree === "string" && t.worktree ? (0, import_node_path16.join)(p.project, t.worktree) : p.project;
}
function ensureWorktree(p, id, taskId, base) {
  const dir = worktreeDir(p, id, taskId);
  const branch = branchName(id, taskId);
  if ((0, import_node_fs14.existsSync)((0, import_node_path16.join)(dir, ".git"))) {
    linkDependencies(p, dir);
    return { dir: rel(p, dir), branch, created: false };
  }
  git(p.project, ["worktree", "prune"]);
  (0, import_node_fs14.mkdirSync)((0, import_node_path16.join)(dir, ".."), { recursive: true });
  const hasBranch = git(p.project, ["rev-parse", "--verify", "-q", `refs/heads/${branch}`]).ok;
  const r = hasBranch ? git(p.project, ["worktree", "add", "-q", dir, branch]) : git(p.project, ["worktree", "add", "-q", "-b", branch, dir, base]);
  if (!r.ok) throw new OpError(`could not create the worktree for ${taskId}: ${r.err || r.out}`);
  linkDependencies(p, dir);
  return { dir: rel(p, dir), branch, created: true };
}
function removeWorktree(p, worktree, branch) {
  if (worktree) {
    const dir = (0, import_node_path16.join)(p.project, worktree);
    git(p.project, ["worktree", "remove", "--force", dir]);
    if ((0, import_node_fs14.existsSync)(dir)) (0, import_node_fs14.rmSync)(dir, { recursive: true, force: true });
    git(p.project, ["worktree", "prune"]);
  }
  if (branch) git(p.project, ["branch", "-q", "-D", branch]);
}
function mergeWorktree(p, t, message) {
  const wt = taskDir(p, t);
  const branch = String(t.branch ?? "");
  if (!(0, import_node_fs14.existsSync)(wt) || !branch) throw new OpError(`task ${t.id} has no worktree to merge (${String(t.worktree)})`);
  const add = git(wt, ["add", "-A", "--", ".", ":(exclude).aidw"]);
  if (!add.ok) throw new OpError(`git add in the worktree of ${t.id} failed: ${add.err}`);
  const junk = stagedJunk(wt);
  if (junk.length) {
    git(wt, ["reset", "-q"]);
    throw new OpError(`${t.id}: ${junkMessage(junk)}`);
  }
  if (!git(wt, ["diff", "--cached", "--quiet"]).ok) {
    const c = git(wt, ["commit", "-q", "-m", message]);
    if (!c.ok) throw new OpError(`commit in the worktree of ${t.id} failed: ${c.err || c.out}`);
  }
  const m = git(p.project, ["merge", "--no-ff", "--no-commit", "-q", branch]);
  if (m.ok) return { ok: true };
  git(p.project, ["merge", "--abort"]);
  const files = git(p.project, ["diff", "--name-only", "--diff-filter=U"]).out;
  return { ok: false, conflict: (m.out || m.err || files).split("\n").slice(0, 8).join("; ") };
}
var integrationFile = (change) => (0, import_node_path16.join)(change.dir, "evidence", "integration.json");
function integrationRuns(change) {
  const f = integrationFile(change);
  if (!(0, import_node_fs14.existsSync)(f)) return [];
  try {
    return JSON.parse((0, import_node_fs14.readFileSync)(f, "utf8")).runs ?? [];
  } catch {
    return [];
  }
}
function lastPassAt(change) {
  return integrationRuns(change).filter((r) => r.ok).at(-1)?.at ?? "";
}
function pendingIntegration(change, tasks) {
  const since = lastPassAt(change);
  return tasks.filter((t) => statusOf(t) === "done" && typeof t.merged_at === "string" && t.merged_at > since);
}
function integrate(p, id, deps) {
  const change = loadChange(p, id);
  const tf = deps.loadTasks(p, id);
  const covered = pendingIntegration(change, tf.tasks);
  if (!covered.length) return { ok: true, tasks: [], runs: [], summary: "nothing merged since the last integration verify" };
  const code = deps.quality?.layers.find((l) => l.name === "code");
  const commands = [.../* @__PURE__ */ new Set([...code ? [...code.setup, ...code.run] : [], ...covered.flatMap((t) => list2(t.verify))])];
  const runs = [];
  for (const command of commands) {
    const started = Date.now();
    const r = deps.runner(command, p.project, deps.timeoutMs ?? 30 * 60 * 1e3);
    runs.push({ command, ms: Date.now() - started, ...r });
    if (r.exit !== 0) break;
  }
  const failed = runs.find((r) => r.exit !== 0);
  const ok = !failed && runs.length === commands.length;
  const record = { at: now(), head: headCommit(p.project), ok, tasks: covered.map((t) => t.id), runs };
  const history = integrationRuns(change);
  const write = () => {
    (0, import_node_fs14.mkdirSync)((0, import_node_path16.join)(change.dir, "evidence"), { recursive: true });
    (0, import_node_fs14.writeFileSync)(integrationFile(change), `${JSON.stringify({ runs: [...history, record] }, null, 2)}
`);
  };
  if (ok) {
    write();
    return { ok, tasks: record.tasks, runs, summary: `wave ${record.tasks.join(", ")} integrates: ${commands.length} command(s) pass on the merged code` };
  }
  const since = lastPassAt(change);
  const failures = history.filter((r) => !r.ok && r.at > since).length + 1;
  const max = deps.quality?.maxFixRounds ?? 3;
  if (failures > max) {
    write();
    transition(p, id, "escalated", { reason: `integration verify of ${record.tasks.join(", ")} still failing after ${failures - 1} fix round(s)` });
    return { ok: false, tasks: record.tasks, runs, escalated: true, summary: `integration verify failed; fix rounds exhausted (${failures - 1}/${max}): escalated` };
  }
  const n = tf.tasks.filter((t) => t.origin === "integration").length + 1;
  const taskId = `I${String(n).padStart(2, "0")}`;
  const problem = failed ? `Integration verify after merging ${record.tasks.join(", ")} failed: \`${failed.command}\`${failed.timedOut ? " timed out" : ` exited ${failed.exit}`}.
Each task passed on its own; the merged code does not. Find the interaction between the tasks.

${failed.tail}` : "Integration verify did not complete.";
  tf.doc.get("tasks").add(
    tf.doc.createNode({ id: taskId, title: `Fix the integration of ${record.tasks.join(", ")}`, role: DEFAULT_TASK_ROLE, origin: "integration", depends_on: [], touches: ["**"], verify: commands, problem, status: "pending" })
  );
  deps.save(tf);
  record.fixTask = taskId;
  write();
  return { ok: false, tasks: record.tasks, runs, fixTask: taskId, summary: `integration verify failed: fix task ${taskId} added (round ${failures}/${max})` };
}
function linkDependencies(p, dir) {
  const source = (0, import_node_path16.join)(p.project, "node_modules");
  const target = (0, import_node_path16.join)(dir, "node_modules");
  if (!(0, import_node_fs14.existsSync)(source) || (0, import_node_fs14.existsSync)(target) || isSymlink(target)) return;
  try {
    (0, import_node_fs14.symlinkSync)(source, target, "dir");
  } catch {
    return;
  }
  const ex = git(p.project, ["rev-parse", "--path-format=absolute", "--git-path", "info/exclude"]);
  if (!ex.ok || !ex.out) return;
  const text = (0, import_node_fs14.existsSync)(ex.out) ? (0, import_node_fs14.readFileSync)(ex.out, "utf8") : "";
  if (!/^\/?node_modules\/?$/m.test(text)) {
    (0, import_node_fs14.mkdirSync)((0, import_node_path16.join)(ex.out, ".."), { recursive: true });
    (0, import_node_fs14.writeFileSync)(ex.out, `${text}${text && !text.endsWith("\n") ? "\n" : ""}node_modules
`);
  }
}
var isSymlink = (f) => {
  try {
    return (0, import_node_fs14.lstatSync)(f).isSymbolicLink();
  } catch {
    return false;
  }
};

