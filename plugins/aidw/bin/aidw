// src/stages.ts
var import_node_fs28 = require("node:fs");
var import_node_path33 = require("node:path");
var import_yaml16 = __toESM(require_dist(), 1);
var overlaps = (a, b) => a.some((x) => b.includes(x));
var conflicts = (a, b) => overlaps(a.reads, b.writes) || overlaps(b.reads, a.writes) || overlaps(a.writes, b.writes);
var byName = (a) => a;
var DECISIONS_PATH = "changes/<id>/decisions.yaml";
var isFamily = (path) => /<(?!id>)[^>]+>|NNNN/.test(path);
function keyOfRegistry(registry) {
  return (a) => {
    const path = registry?.[a]?.path;
    if (typeof path !== "string" || path === DECISIONS_PATH) return `name:${a}`;
    if (path.startsWith("decisions/NNNN")) return "file:decisions/NNNN";
    return isFamily(path) ? `name:${a}` : `file:${path}`;
  };
}
var keyed = (x, keyOf) => ({ ...x, reads: x.reads.map(keyOf), writes: x.writes.map(keyOf) });
function pickGroup(ready, max) {
  const kind = ready.some((x) => x.kind === "review") ? "review" : "stage";
  const out = [];
  for (const x of ready) {
    if (out.length >= Math.max(1, max)) break;
    if (x.kind !== kind) continue;
    if (x.browser && out.some((y) => y.browser)) continue;
    if (out.some((y) => conflicts(x, y))) continue;
    out.push(x);
  }
  return out;
}
var ANALYSIS_STATES = ["draft", "intake", "analyzing", "awaiting_approval"];
var isApprovalGate = (s) => s.gate === "approval" || s.gate === "approval-auto";
function analysisStages(w) {
  return w.stages.filter((s) => isApprovalGate(s) || s.states.length > 0 && s.states.every((st) => ANALYSIS_STATES.includes(st)));
}
function blocker(stages, s, done, keyOf) {
  const i = stages.indexOf(s);
  const ks = keyed(s, keyOf);
  return stages.slice(0, i).find((e) => !done.has(e.id) && (e.gate !== void 0 || s.gate !== void 0 || conflicts(keyed(e, keyOf), ks)));
}
function readyStages(w, done, keyOf = byName) {
  const stages = analysisStages(w);
  return stages.filter((s) => !done.has(s.id) && !blocker(stages, s, done, keyOf));
}
var STAGES_FILE = "stages.yaml";
var stagesFile = (change) => (0, import_node_path33.join)(change.dir, STAGES_FILE);
function recordedDone(change) {
  const f = stagesFile(change);
  if (!(0, import_node_fs28.existsSync)(f)) return [];
  try {
    const data = import_yaml16.default.parse((0, import_node_fs28.readFileSync)(f, "utf8"));
    return Array.isArray(data?.done) ? data.done.map(String) : [];
  } catch {
    return [];
  }
}
function sectionBody(text2, heading) {
  const lines = text2.split("\n");
  const at = lines.findIndex((l) => l.trim() === heading.trim());
  if (at < 0) return null;
  const end = lines.findIndex((l, i) => i > at && /^## /.test(l));
  return lines.slice(at + 1, end < 0 ? void 0 : end).join("\n");
}
var filled = (text2) => text2 !== null && text2.trim() !== "" && !text2.includes("TODO(aidw)");
function artifactWritten(p, change, entry) {
  if (!entry || typeof entry.path !== "string" || isFamily(entry.path)) return null;
  if (entry.path === DECISIONS_PATH) {
    const key = String(entry.part ?? "").split(":")[0]?.trim() ?? "";
    return key !== "" && key in readDecisions(change);
  }
  const file = (0, import_node_path33.join)(p.aidw, ...entry.path.replace("<id>", change.id).split("/"));
  if (!(0, import_node_fs28.existsSync)(file)) return false;
  const text2 = (0, import_node_fs28.readFileSync)(file, "utf8");
  return filled(entry.part ? sectionBody(text2, entry.part) : text2);
}
function writtenStages(p, change, stages, registry) {
  return stages.filter((s) => s.gate === void 0 && s.writes.length > 0).filter((s) => {
    const known = s.writes.map((a) => artifactWritten(p, change, registry?.[a])).filter((x) => x !== null);
    return known.length > 0 && known.every(Boolean);
  }).map((s) => s.id);
}
function doneStages(w, change, p, registry = null) {
  const stages = analysisStages(w);
  const state = stateOf(change);
  const done = new Set(recordedDone(change).filter((id) => stages.some((s) => s.id === id)));
  const at = state ? stages.findIndex((s) => s.states.includes(state)) : -1;
  if (state && !ANALYSIS_STATES.includes(state)) for (const s of stages) done.add(s.id);
  else if (at > 0) for (const s of stages.slice(0, at)) done.add(s.id);
  if (p && state === "analyzing" && !(0, import_node_fs28.existsSync)(stagesFile(change))) for (const id of writtenStages(p, change, stages, registry)) done.add(id);
  const lastGate = stages.reduce((n, s, i) => s.gate !== void 0 && done.has(s.id) ? i : n, -1);
  if (lastGate > 0) for (const s of stages.slice(0, lastGate)) done.add(s.id);
  const review = stages.find((s) => s.writes.includes(PLAN_REVIEW));
  if (p && review && state === "analyzing") {
    let open;
    try {
      open = planReviewBlocker(p, change, w);
    } catch (e) {
      open = e.message;
    }
    if (open) done.delete(review.id);
    else done.add(review.id);
  }
  return done;
}
function parallelMax(change) {
  const f = qualityFile(change);
  if (!(0, import_node_fs28.existsSync)(f)) return DEFAULT_PARALLEL.max;
  return parseQuality((0, import_node_fs28.readFileSync)(f, "utf8"), f).config?.parallel.max ?? DEFAULT_PARALLEL.max;
}
var stageWork = (s, keyOf = byName) => keyed({ id: s.id, kind: "stage", reads: s.reads, writes: s.writes, browser: s.browser === true }, keyOf);
function registryOf(pluginRoot2) {
  try {
    return loadArtifacts(pluginRoot2);
  } catch {
    return null;
  }
}
function stagesView(p, id, pluginRoot2) {
  const change = loadChange(p, id);
  const w = workflowOfChange(p, change, pluginRoot2);
  const registry = registryOf(pluginRoot2);
  const keyOf = keyOfRegistry(registry);
  const done = doneStages(w, change, p, registry);
  const ready = readyStages(w, done, keyOf);
  const max = parallelMax(change);
  const picked = new Set(pickGroup(ready.map((s) => stageWork(s, keyOf)), max).map((x) => x.id));
  return {
    change: id,
    workflow: w.id,
    state: String(change.data.state ?? ""),
    max,
    done: analysisStages(w).filter((s) => done.has(s.id)).map((s) => s.id),
    ready,
    group: ready.filter((s) => picked.has(s.id))
  };
}
function recordStageDone(p, id, stageId, pluginRoot2) {
  const change = loadChange(p, id);
  const w = workflowOfChange(p, change, pluginRoot2);
  const stages = analysisStages(w);
  const s = stages.find((x) => x.id === stageId);
  if (!s) throw new OpError(`workflow "${w.id}" has no analysis stage "${stageId}" (it has: ${stages.map((x) => x.id).join(", ")})`);
  if (s.gate) throw new OpError(`stage "${stageId}" is a gate (${s.gate}): it is passed by \`aidw approve\`, not reported`);
  const registry = registryOf(pluginRoot2);
  const done = doneStages(w, change, p, registry);
  if (done.has(stageId)) return;
  const asking = stageConsultationsInFlight(change, stageId);
  if (asking.length) throw new OpError(`stage "${stageId}" has Consultation(s) in flight: ${asking.map((c) => `${c.id} (${c.status})`).join(", ")}; the stage is done after its asker resumed and finished`);
  const b = blocker(stages, s, done, keyOfRegistry(registry));
  if (b) throw new OpError(`stage "${stageId}" is not ready: it waits for ${b.id}`);
  const open = s.writes.includes(PLAN_REVIEW) ? planReviewBlocker(p, change, w) : null;
  if (open) throw new OpError(`stage "${stageId}" is done when its verdict is recorded (\`aidw plan-review ${id}\`); it still needs ${open}`);
  const all2 = [...recordedDone(change), stageId];
  (0, import_node_fs28.writeFileSync)(stagesFile(change), import_yaml16.default.stringify({ done: all2 }));
}
var label = (s) => `${s.id} (${s.title})`;
function stagesNext(v) {
  const report = (what) => `\`aidw stages --done ${what} --change ${v.change}\``;
  if (v.group.length === 0) return v.ready.length === 0 && v.done.length ? "NEXT: every analysis stage is done; continue with the next step of the workflow" : "NEXT: no analysis stage is ready";
  if (v.group.length === 1) {
    const s = v.group[0];
    if (s.writes.includes(PLAN_REVIEW)) return `NEXT: stage ${label(s)}: run \`aidw plan-review ${v.change} --brief\`, spawn aidw:${s.roles[0] ?? "code-reviewer"} with the brief, then record its verdict with \`aidw plan-review ${v.change}\` (it reports the stage)`;
    return `NEXT: stage ${label(s)}: roles ${s.roles.join(", ") || "none"}${s.gate ? `; gate ${s.gate}` : `; when it is done run ${report(s.id)}`}`;
  }
  return `NEXT: run these ${v.group.length} stages in parallel, one subagent each, all in one message: ${v.group.map(label).join(", ")}. When each returns, run ${report("<stage>")} for it`;
}

// src/quality.ts
var DEPLOY_TARGETS = ["none", "local", "preview"];
var DEFAULT_MAX_FIX_ROUNDS = 3;
var EXPECTED_LAYERS = ["code", "unit", "e2e"];
var RECOMMENDED_LAYERS = ["ui-ux", "a11y", "security", "performance"];
var REVIEW_KINDS = ["ui", "security", "performance"];
var DEFAULT_PARALLEL = { max: 3, setup: [] };
var isStrList2 = (v) => Array.isArray(v) && v.every((x) => typeof x === "string" && x.trim() !== "");
var isProjectRelative = (r) => !r.startsWith("/") && !r.split("/").includes("..");
var LAYER_NAME = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
var qualityFile = (change) => (0, import_node_path34.join)(change.dir, "quality.yaml");
function parseQuality(text2, file) {
  const d = new Diags();
  let data;
  try {
    data = import_yaml17.default.parse(text2) ?? {};
  } catch (e) {
    d.error(file, `not valid YAML: ${e.message}`);
    return { config: null, diags: d };
  }
  const layers = [];
  if (!Array.isArray(data.layers) || data.layers.length === 0) d.error(file, 'expected a non-empty "layers:" list');
  else {
    for (const [i, raw] of data.layers.entries()) {
      const l = raw ?? {};
      const where = typeof l.name === "string" ? `layer "${l.name}"` : `layer #${i + 1}`;
      if (typeof l.name !== "string" || !LAYER_NAME.test(l.name)) d.error(file, `${where} needs a kebab-case "name"`);
      else if (layers.some((x) => x.name === l.name)) d.error(file, `duplicate layer "${l.name}"`);
      const review = l.review === void 0 || l.review === null ? null : String(l.review);
      if (review !== null && !REVIEW_KINDS.includes(review)) {
        d.error(file, `${where}: "review" must be one of ${REVIEW_KINDS.join(", ")} (a reviewing Role exists for each)`);
      }
      if (l.run === void 0 && review !== null) {
      } else if (!isStrList2(l.run) || l.run.length === 0) d.error(file, `${where} needs a non-empty "run" list of commands${review ? "" : ' (or "review: ui|security|performance")'}`);
      if (l.setup !== void 0 && !isStrList2(l.setup)) d.error(file, `${where}: "setup" must be a list of commands`);
      if (l.reports !== void 0 && !(isStrList2(l.reports) && l.reports.every(isProjectRelative))) {
        d.error(file, `${where}: "reports" must be a list of project-relative JUnit XML paths`);
      }
      if (l.artifacts !== void 0 && !(isStrList2(l.artifacts) && l.artifacts.every(isProjectRelative))) {
        d.error(file, `${where}: "artifacts" must be a list of project-relative file globs`);
      }
      if (l.artifacts !== void 0 && review === null) d.warn(file, `${where}: "artifacts" only matter to a review layer; add "review:" or drop them`);
      layers.push({
        name: String(l.name),
        setup: isStrList2(l.setup) ? l.setup : [],
        run: isStrList2(l.run) ? l.run : [],
        reports: isStrList2(l.reports) ? l.reports : [],
        review,
        artifacts: isStrList2(l.artifacts) ? l.artifacts : []
      });
    }
    for (const name of EXPECTED_LAYERS) {
      if (!layers.some((l) => l.name === name)) d.warn(file, `no "${name}" layer; say in analysis.md why this project does not need it`);
    }
  }
  const permissions = [];
  if (data.permissions !== void 0 && data.permissions !== null) {
    if (!Array.isArray(data.permissions)) d.error(file, '"permissions" must be a list of tier-2 resource keys');
    else {
      for (const k of data.permissions) {
        if (typeof k === "string" && isTier2Resource(k)) permissions.push(k);
        else d.error(file, `unknown tier-2 resource "${String(k)}" (known: ${Object.keys(TIER2_RESOURCES).join(", ")})`);
      }
    }
  }
  const dep = data.deploy ?? {};
  const target = dep.target ?? "none";
  if (!DEPLOY_TARGETS.includes(String(target))) {
    d.error(file, `deploy.target must be one of ${DEPLOY_TARGETS.join(", ")} (production is tier 3 and never automatic)`);
  }
  const command = typeof dep.command === "string" && dep.command.trim() ? dep.command.trim() : null;
  if (dep.smoke !== void 0 && !isStrList2(dep.smoke)) d.error(file, '"deploy.smoke" must be a list of commands');
  if (target === "preview") {
    if (!command) d.error(file, 'deploy.target "preview" needs deploy.command');
    else {
      const tier3 = firstMatch(ASK_COMMANDS, command);
      const tier2 = firstMatch(TIER2_COMMANDS, command);
      if (tier3) d.error(file, `deploy.command ${tier3.why}: tier 3 is never automatic`);
      else if (!tier2) d.error(file, "deploy.command must be a recognized preview deploy (vercel deploy, netlify deploy) because it runs without asking");
      else if (!permissions.includes(tier2.resource)) d.error(file, `deploy.command needs "${tier2.resource}" in permissions`);
    }
  }
  const max = data.max_fix_rounds ?? DEFAULT_MAX_FIX_ROUNDS;
  if (!(Number.isInteger(max) && Number(max) >= 1)) d.error(file, '"max_fix_rounds" must be a positive integer');
  const par = data.parallel ?? {};
  if (data.parallel !== void 0 && (typeof data.parallel !== "object" || data.parallel === null || Array.isArray(data.parallel))) {
    d.error(file, '"parallel" must be a mapping with "max" and optional "setup"');
  }
  const parMax = par.max ?? DEFAULT_PARALLEL.max;
  if (!(Number.isInteger(parMax) && Number(parMax) >= 1 && Number(parMax) <= 10)) d.error(file, '"parallel.max" must be an integer from 1 to 10');
  if (par.setup !== void 0 && !isStrList2(par.setup)) d.error(file, '"parallel.setup" must be a list of commands');
  const grants = parseGrants(data.grants, file, d);
  if (d.errors.length) return { config: null, diags: d };
  return {
    config: {
      layers,
      deploy: { target, command, smoke: isStrList2(dep.smoke) ? dep.smoke : [] },
      permissions,
      maxFixRounds: Number(max),
      parallel: { max: Number(parMax), setup: isStrList2(par.setup) ? par.setup : [] },
      grants
    },
    diags: d
  };
}
function loadQuality(p, change) {
  const file = qualityFile(change);
  const text2 = readText(file);
  if (text2 === null) throw new OpError(`change "${change.id}" has no quality.yaml`);
  const { config, diags } = parseQuality(text2, rel(p, file));
  if (!config) throw new OpError(`quality.yaml of "${change.id}" is invalid`, diags);
  return config;
}
function grantedResources(p, ids, openStates) {
  const out = /* @__PURE__ */ new Set();
  for (const id of ids) {
    try {
      const c = loadChange(p, id);
      const state = stateOf(c);
      if (!state || !openStates.has(state) || approvalStatus(p, c).status !== "valid") continue;
      const text2 = approvedText(c, qualityFile(c));
      if (text2 === null) continue;
      for (const r of parseQuality(text2, "quality.yaml").config?.permissions ?? []) out.add(r);
    } catch {
    }
  }
  return out;
}
var qualityDir = (change) => (0, import_node_path34.join)(change.dir, "evidence", "quality");
