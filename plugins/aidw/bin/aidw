var DEFAULT_PARALLEL = { max: 3, setup: [] };
var isStrList2 = (v) => Array.isArray(v) && v.every((x) => typeof x === "string" && x.trim() !== "");
var isProjectRelative = (r) => !r.startsWith("/") && !r.split("/").includes("..");
var LAYER_NAME = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
var qualityFile = (change) => (0, import_node_path24.join)(change.dir, "quality.yaml");
function parseQuality(text, file) {
  const d = new Diags();
  let data;
  try {
    data = import_yaml12.default.parse(text) ?? {};
  } catch (e) {
    d.error(file, `not valid YAML: ${e.message}`);
    return { config: null, diags: d };
  }
  const layers = [];
  if (!Array.isArray(data.layers) || data.layers.length === 0) d.error(file, 'expected a non-empty "layers:" list');
  else {
    for (const [i, raw] of data.layers.entries()) {
      const l = raw ?? {};
      const where = typeof l.name === "string" ? `layer "${l.name}"` : `layer #${i + 1}`;
      if (typeof l.name !== "string" || !LAYER_NAME.test(l.name)) d.error(file, `${where} needs a kebab-case "name"`);
      else if (layers.some((x) => x.name === l.name)) d.error(file, `duplicate layer "${l.name}"`);
      const review = l.review === void 0 || l.review === null ? null : String(l.review);
      if (review !== null && !REVIEW_KINDS.includes(review)) {
        d.error(file, `${where}: "review" must be one of ${REVIEW_KINDS.join(", ")} (a reviewing Role exists for each)`);
      }
      if (l.run === void 0 && review !== null) {
      } else if (!isStrList2(l.run) || l.run.length === 0) d.error(file, `${where} needs a non-empty "run" list of commands${review ? "" : ' (or "review: ui|security")'}`);
      if (l.setup !== void 0 && !isStrList2(l.setup)) d.error(file, `${where}: "setup" must be a list of commands`);
      if (l.reports !== void 0 && !(isStrList2(l.reports) && l.reports.every(isProjectRelative))) {
        d.error(file, `${where}: "reports" must be a list of project-relative JUnit XML paths`);
      }
      if (l.artifacts !== void 0 && !(isStrList2(l.artifacts) && l.artifacts.every(isProjectRelative))) {
        d.error(file, `${where}: "artifacts" must be a list of project-relative file globs`);
      }
      if (l.artifacts !== void 0 && review === null) d.warn(file, `${where}: "artifacts" only matter to a review layer; add "review:" or drop them`);
      layers.push({
        name: String(l.name),
        setup: isStrList2(l.setup) ? l.setup : [],
        run: isStrList2(l.run) ? l.run : [],
        reports: isStrList2(l.reports) ? l.reports : [],
        review,
        artifacts: isStrList2(l.artifacts) ? l.artifacts : []
      });
    }
    for (const name of EXPECTED_LAYERS) {
      if (!layers.some((l) => l.name === name)) d.warn(file, `no "${name}" layer; say in analysis.md why this project does not need it`);
    }
  }
  const permissions = [];
  if (data.permissions !== void 0 && data.permissions !== null) {
    if (!Array.isArray(data.permissions)) d.error(file, '"permissions" must be a list of tier-2 resource keys');
    else {
      for (const k of data.permissions) {
        if (typeof k === "string" && isTier2Resource(k)) permissions.push(k);
        else d.error(file, `unknown tier-2 resource "${String(k)}" (known: ${Object.keys(TIER2_RESOURCES).join(", ")})`);
      }
    }
  }
  const dep = data.deploy ?? {};
  const target = dep.target ?? "none";
  if (!DEPLOY_TARGETS.includes(String(target))) {
    d.error(file, `deploy.target must be one of ${DEPLOY_TARGETS.join(", ")} (production is tier 3 and never automatic)`);
  }
  const command = typeof dep.command === "string" && dep.command.trim() ? dep.command.trim() : null;
  if (dep.smoke !== void 0 && !isStrList2(dep.smoke)) d.error(file, '"deploy.smoke" must be a list of commands');
  if (target === "preview") {
    if (!command) d.error(file, 'deploy.target "preview" needs deploy.command');
    else {
      const tier3 = firstMatch(ASK_COMMANDS, command);
      const tier2 = firstMatch(TIER2_COMMANDS, command);
      if (tier3) d.error(file, `deploy.command ${tier3.why}: tier 3 is never automatic`);
      else if (!tier2) d.error(file, "deploy.command must be a recognized preview deploy (vercel deploy, netlify deploy) because it runs without asking");
      else if (!permissions.includes(tier2.resource)) d.error(file, `deploy.command needs "${tier2.resource}" in permissions`);
    }
  }
  const max = data.max_fix_rounds ?? DEFAULT_MAX_FIX_ROUNDS;
  if (!(Number.isInteger(max) && Number(max) >= 1)) d.error(file, '"max_fix_rounds" must be a positive integer');
  const par = data.parallel ?? {};
  if (data.parallel !== void 0 && (typeof data.parallel !== "object" || data.parallel === null || Array.isArray(data.parallel))) {
    d.error(file, '"parallel" must be a mapping with "max" and optional "setup"');
  }
  const parMax = par.max ?? DEFAULT_PARALLEL.max;
  if (!(Number.isInteger(parMax) && Number(parMax) >= 1 && Number(parMax) <= 10)) d.error(file, '"parallel.max" must be an integer from 1 to 10');
  if (par.setup !== void 0 && !isStrList2(par.setup)) d.error(file, '"parallel.setup" must be a list of commands');
  if (d.errors.length) return { config: null, diags: d };
  return {
    config: {
      layers,
      deploy: { target, command, smoke: isStrList2(dep.smoke) ? dep.smoke : [] },
      permissions,
      maxFixRounds: Number(max),
      parallel: { max: Number(parMax), setup: isStrList2(par.setup) ? par.setup : [] }
    },
    diags: d
  };
}
function loadQuality(p, change) {
  const file = qualityFile(change);
  const text = readText(file);
  if (text === null) throw new OpError(`change "${change.id}" has no quality.yaml`);
  const { config, diags } = parseQuality(text, rel(p, file));
  if (!config) throw new OpError(`quality.yaml of "${change.id}" is invalid`, diags);
  return config;
}
function grantedResources(p, ids, openStates) {
  const out = /* @__PURE__ */ new Set();
  for (const id of ids) {
    try {
      const c = loadChange(p, id);
      const state = stateOf(c);
      if (!state || !openStates.has(state) || approvalStatus(p, c).status !== "valid") continue;
      const text = readText(qualityFile(c));
      if (text === null) continue;
      for (const r of parseQuality(text, "quality.yaml").config?.permissions ?? []) out.add(r);
    } catch {
    }
  }
  return out;
}
var qualityDir = (change) => (0, import_node_path24.join)(change.dir, "evidence", "quality");
var summaryFile = (change) => (0, import_node_path24.join)(qualityDir(change), "summary.json");
var deployFile = (change) => (0, import_node_path24.join)(change.dir, "evidence", "deploy.json");
var now5 = () => (/* @__PURE__ */ new Date()).toISOString();
function recordLayerResult(change, summary, name, result) {
  summary.layers[name] = result;
  writeJson(summaryFile(change), summary);
  appendHistory((0, import_node_path24.join)(qualityDir(change), `${name}.json`), result);
}
function resetQualitySummary(change) {
  writeJson(summaryFile(change), { layers: {} });
}
function readSummary(change) {
  const f = summaryFile(change);
  if (!(0, import_node_fs22.existsSync)(f)) return { layers: {} };
  try {
    return JSON.parse((0, import_node_fs22.readFileSync)(f, "utf8"));
  } catch {
    return { layers: {} };
  }
}
function writeJson(file, data) {
  (0, import_node_fs22.mkdirSync)((0, import_node_path24.join)(file, ".."), { recursive: true });
  (0, import_node_fs22.writeFileSync)(file, `${JSON.stringify(data, null, 2)}
`);
}
function codeChangedAt(tasks) {
  return tasks.reduce((m, t) => typeof t.finished_at === "string" && t.finished_at > m ? t.finished_at : m, "");
}
function isFresh(r, tasks, head) {
  if (!r) return false;
  if (r.at < codeChangedAt(tasks)) return false;
  return head === null || r.head === head;
}
function pendingLayers(p, id) {
  const change = loadChange(p, id);
  const config = loadQuality(p, change);
  const tasks = loadTasks(p, id).tasks;
  const summary = readSummary(change);
  const head = headCommit(p.project);
  const pending = config.layers.filter((l) => !(summary.layers[l.name]?.status === "pass" && isFresh(summary.layers[l.name], tasks, head))).map((l) => l.name);
  return { config, pending, summary };
}
var TESTCASE = /<testcase\b((?:[^>"']|"[^"]*"|'[^']*')*?)(?:\/>|>([\s\S]*?)<\/testcase>)/g;
var MAX_TESTS = 1e4;
function xmlAttr(attrs, name) {
  const m = attrs.match(new RegExp(`\\b${name}\\s*=\\s*"([^"]*)"`)) ?? attrs.match(new RegExp(`\\b${name}\\s*=\\s*'([^']*)'`));
  return decodeXml(m?.[1] ?? "");
}
function decodeXml(text) {
  return text.replace(/&quot;/g, '"').replace(/&apos;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&#(\d+);/g, (_, n) => String.fromCodePoint(Number(n))).replace(/&amp;/g, "&");
}
function parseJunit(xml) {
  const out = [];
  for (const m of xml.matchAll(TESTCASE)) {
    const attrs = m[1] ?? "";
    const body = m[2] ?? "";
    const name = [xmlAttr(attrs, "classname"), xmlAttr(attrs, "name")].filter(Boolean).join(" > ");
    const status = /<(failure|error)\b/.test(body) ? "fail" : /<skipped\b/.test(body) ? "skipped" : "pass";
    const tc = { name, status };
    if (status === "fail") {
      const f = /<(?:failure|error)\b((?:[^>"']|"[^"]*"|'[^']*')*?)(?:\/>|>([\s\S]*?)<\/(?:failure|error)>)/.exec(body);
      const text = `${xmlAttr(f?.[1] ?? "", "message")}
${decodeXml((f?.[2] ?? "").replace(/<!\[CDATA\[|\]\]>/g, ""))}`.trim();
      if (text) tc.message = text.replace(/\x1b\[[0-9;]*m/g, "").split("\n").slice(0, 12).join("\n").slice(0, 1200);
    }
    out.push(tc);
    if (out.length >= MAX_TESTS) break;
  }
  return out;
}
function readJunit(project, reports) {
  const tests = [];
  const missing = [];
  for (const r of reports) {
    const f = (0, import_node_path24.join)(project, ...r.split("/"));
    if (!(0, import_node_fs22.existsSync)(f)) {
      missing.push(r);
      continue;
    }
    tests.push(...parseJunit((0, import_node_fs22.readFileSync)(f, "utf8")));
  }
  return { tests, missing };
}
function runCommands(commands, cwd, timeoutMs, runner, env) {
  const runs = [];
  for (const command of commands) {
    const started = Date.now();
    const r = runner(command, cwd, timeoutMs, env);
    runs.push({ command, ms: Date.now() - started, ...r });
    if (r.exit !== 0) break;
  }
  return runs;
}
var failedRun = (runs) => runs.find((r) => r.exit !== 0);
function requireVerifying(p, id, what) {
  const change = loadChange(p, id);
  if (stateOf(change) !== "verifying") throw new OpError(`change "${id}" is "${String(change.data.state)}"; ${what} runs in state verifying`);
  if (approvalStatus(p, change).status !== "valid") throw new OpError(`approval drift in "${id}": escalate and re-approve`);
  return change;
}
var reviewAgent = (kind) => AGENTS.layerReview[kind];
function awaiting(layer, r) {
  return { layer: layer.name, kind: layer.review, agent: reviewAgent(layer.review), brief: r.brief ?? "", artifacts: r.artifacts ?? [] };
}
var awaitingSummary = (a) => `layer "${a.layer}" awaits its ${a.kind} review: spawn ${a.agent} with the brief ${a.brief}, then \`aidw layer-review ${a.layer} pass|fix --notes-file <reply>\``;
function verify(p, id, opts = {}) {
  const change = requireVerifying(p, id, "aidw verify");
  const { config, pending, summary } = pendingLayers(p, id);
  if (opts.layer && !config.layers.some((l) => l.name === opts.layer)) throw new OpError(`no layer "${opts.layer}" in quality.yaml`);
  const runner = opts.runner ?? retryingShellRunner;
  const timeoutMs = opts.timeoutMs ?? 30 * 60 * 1e3;
  const head = headCommit(p.project);
  const tasks = loadTasks(p, id).tasks;
  const outcomes = [];
  let failed;
  let review;
  for (const layer of config.layers) {
    const wanted = opts.layer ? layer.name === opts.layer : opts.fresh || pending.includes(layer.name);
    if (!wanted || failed || review) {
      const reused = !failed && !review && !opts.layer && !pending.includes(layer.name);
      outcomes.push({ name: layer.name, status: "skipped", runs: [], ...reused ? { reused: true } : {} });
      continue;
    }
    const prev = summary.layers[layer.name];
    if (layer.review && prev?.status === "review" && isFresh(prev, tasks, head) && !opts.fresh) {
      review = awaiting(layer, prev);
      outcomes.push({ name: layer.name, status: "review", runs: prev.runs });
      continue;
    }
    const runs = runCommands([...layer.setup, ...layer.run], p.project, timeoutMs, runner);
    let ok = runs.length === layer.setup.length + layer.run.length && !failedRun(runs);
    const result = { status: ok ? "pass" : "fail", at: now5(), head, runs };
    if (layer.reports.length) {
      const { tests, missing } = readJunit(p.project, layer.reports);
      result.tests = tests;
      if (missing.length) result.missing_reports = missing;
      if (missing.length && ok) {
        const list5 = missing.join(", ");
        ok = false;
        result.status = "fail";
        result.runs = [...runs, { command: `(declared report ${list5})`, ms: 0, exit: 1, timedOut: false, tail: `the command passed but wrote no JUnit report ${list5}: configure the test runner's JUnit reporter (Playwright: reporter [["list"], ["junit", { outputFile: process.env.PLAYWRIGHT_JUNIT_OUTPUT_NAME ?? "<file>" }]]; Vitest: --reporter=junit --outputFile.junit=<file>)` }];
      }
    }
    if (ok && layer.review) {
      const brief = buildLayerBrief(p, id, layer, runs, opts.vendorDir);
      result.status = "review";
      result.brief = rel(p, brief.path);
      result.artifacts = brief.artifacts;
      review = awaiting(layer, result);
    }
    recordLayerResult(change, summary, layer.name, result);
    outcomes.push({ name: layer.name, status: result.status, runs: result.runs });
    if (!ok) failed = layer;
  }
  if (review) return { ok: false, layers: outcomes, awaitingReview: review, summary: awaitingSummary(review) };
  if (!failed) {
    const left = pendingLayers(p, id).pending;
    const ok = left.length === 0;
    return { ok, layers: outcomes, summary: ok ? "all quality layers pass" : `layers still to run: ${left.join(", ")}` };
  }
  const bad = failedRun(summary.layers[failed.name]?.runs ?? []);
  const failing = (summary.layers[failed.name]?.tests ?? []).filter((t) => t.status === "fail");
  const cases = failing.length ? `Failing tests (from the JUnit report):
${failing.slice(0, 10).map((t) => `- ${t.name}${t.message ? `
${t.message.replace(/^/gm, "    ")}` : ""}`).join("\n")}${failing.length > 10 ? `
- ... and ${failing.length - 10} more` : ""}

Output tail:
` : "";
  const problem = bad ? `Quality layer "${failed.name}" failed: \`${bad.command}\`${bad.timedOut ? " timed out" : ` exited ${bad.exit}`}.

${cases}${bad.tail}` : `Quality layer "${failed.name}" did not complete.`;
  const fix = addFixTask(p, id, config, failed, problem);
  return { ok: false, layers: outcomes, failed: failed.name, ...fix };
}
function addFixTask(p, id, config, layer, problem) {
  const tf = loadTasks(p, id);
  const rounds = tf.tasks.filter((t) => t.origin === "quality" && t.layer === layer.name).length;
  if (rounds >= config.maxFixRounds) {
    transition(p, id, "escalated", { reason: `quality layer "${layer.name}" still failing after ${rounds} fix round(s)` });
    return { escalated: true, summary: `layer "${layer.name}" failed; fix rounds exhausted (${rounds}/${config.maxFixRounds}): escalated` };
  }
  const n = tf.tasks.filter((t) => t.origin === "quality").length + 1;
  const taskId = `Q${String(n).padStart(2, "0")}`;
  const task = {
    id: taskId,
    title: `Fix the ${layer.name} quality layer`,
    role: DEFAULT_TASK_ROLE,
    origin: "quality",
    layer: layer.name,
    depends_on: [],
    touches: ["**"],
    verify: [...layer.setup, ...layer.run],
    problem,
    status: "pending"
  };
  tf.doc.get("tasks").add(tf.doc.createNode(task));
  saveTasksDoc(tf);
  transition(p, id, "executing", {});
  return { fixTask: taskId, summary: `layer "${layer.name}" failed: fix task ${taskId} added (round ${rounds + 1}/${config.maxFixRounds}); change is executing again` };
}
function recordLayerReview(p, id, name, verdict, notes) {
  const change = requireVerifying(p, id, "aidw layer-review");
  const config = loadQuality(p, change);
  const layer = config.layers.find((l) => l.name === name);
  if (!layer) throw new OpError(`no layer "${name}" in quality.yaml`);
  if (!layer.review) throw new OpError(`layer "${name}" has no "review:" kind; only review layers take a verdict`);
  const summary = readSummary(change);
  const prev = summary.layers[name];
  const head = headCommit(p.project);
  if (prev?.status !== "review" || !isFresh(prev, loadTasks(p, id).tasks, head)) {
    throw new OpError(`layer "${name}" is not awaiting review on the current code; run \`aidw verify\` first`);
  }
  if (verdict === "fix" && !notes.trim()) throw new OpError("a fix verdict needs the reviewer's notes");
  const review = { verdict, notes: notes.trim(), at: now5() };
  recordLayerResult(change, summary, name, { ...prev, status: verdict === "pass" ? "pass" : "fail", at: review.at, review });
  if (verdict === "pass") {
    const left = pendingLayers(p, id).pending;
    return { layer: name, kind: layer.review, verdict, pending: left, summary: left.length ? `layer "${name}" passed its ${layer.review} review; layers still to run: ${left.join(", ")}` : `layer "${name}" passed its ${layer.review} review; all quality layers pass` };
  }
  const problem = `Quality layer "${name}" (${layer.review} review) asked for fixes. The reviewer's notes, verbatim:

${review.notes}`;
  return { layer: name, kind: layer.review, verdict, ...addFixTask(p, id, config, layer, problem) };
}
function appendHistory(file, entry) {
  let history = [];
  if ((0, import_node_fs22.existsSync)(file)) {
    try {
      const data = JSON.parse((0, import_node_fs22.readFileSync)(file, "utf8"));
      history = Array.isArray(data.runs) ? data.runs : [];
    } catch {
      history = [];
    }
  }
  writeJson(file, { runs: [...history, entry] });
}
function qualityPassed(p, id) {
  const { pending } = pendingLayers(p, id);
  return { ok: pending.length === 0, pending };
}
var URL_RE = /https:\/\/[^\s"'<>`)\]]+/g;
var JSON_URL = /"url"\s*:\s*"(https:\/\/[^"\s]+)"/;
var DASHBOARD_URL = /^https:\/\/(?:(?:www\.)?vercel\.com|app\.netlify\.com|supabase\.com)\//;
function deploy(p, id, opts = {}) {
  const change = loadChange(p, id);
  if (stateOf(change) !== "deploying") throw new OpError(`change "${id}" is "${String(change.data.state)}"; aidw deploy runs in state deploying`);
  if (approvalStatus(p, change).status !== "valid") throw new OpError(`approval drift in "${id}": escalate and re-approve`);
  const config = loadQuality(p, change);
  const runner = opts.runner ?? shellRunner;
  const timeoutMs = opts.timeoutMs ?? 20 * 60 * 1e3;
  const head = headCommit(p.project);
  const base = { at: now5(), target: config.deploy.target, head, runs: [], smoke: [] };
  let record;
  if (config.deploy.target !== "preview" || !config.deploy.command) {
    record = { ...base, ok: true, skipped: true, url: null };
  } else {
    const runs = runCommands([config.deploy.command], p.project, timeoutMs, runner);
    const failed = failedRun(runs);
    const url = deploymentUrl(runs[0]?.tail ?? "");
    recordBaseline(p);
    if (failed || !url) {
      record = { ...base, runs, ok: false, skipped: false, url, error: failed ? `deploy command exited ${failed.exit}${deployHint(failed.tail) ? `: ${deployHint(failed.tail)}` : ""}` : "no https URL in the deploy output" };
    } else {
      const smoke = runCommands(config.deploy.smoke, p.project, timeoutMs, runner, { AIDW_DEPLOY_URL: url });
      const smokeFailed = failedRun(smoke);
      record = { ...base, runs, smoke, url, ok: !smokeFailed, skipped: false, ...smokeFailed ? { error: `smoke check failed: ${smokeFailed.command}` } : {} };
    }
  }
  appendHistory(deployFile(change), record);
  return record;
}
var DEPLOY_HINTS = [
  {
    re: /"err" is out of range|persistAuthConfig|EPERM[^\n]*com\.vercel\.cli/,
    hint: "the Vercel CLI had to refresh its login token and the sandbox blocked writing its auth file. The user runs `vercel whoami` in their own terminal (outside Claude Code), then `aidw deploy` again."
  },
  {
    re: /fetch failed|ENOTFOUND|EAI_AGAIN|ECONNREFUSED|getaddrinfo/i,
    hint: "the sandbox blocked the network. The user allows the deploy host (for Vercel: vercel.com and *.vercel.com) in the sandbox network settings, or runs the command in their own terminal, then `aidw deploy` again."
  },
  {
    re: /STATIC_BUILD_NO_OUT_DIR|No Output Directory named/i,
    hint: 'Vercel does not know the framework: the project was linked before the app existed and was saved with preset "Other". Commit a vercel.json with {"framework": "nextjs"} (or the framework in use) and deploy again.'
  },
  {
    re: /first_deployment_production|has no deployments yet|first deployment is assigned to Production/i,
    hint: "a Vercel project's first deployment is always Production, and `--environment=preview` (or `vercel link`) does not change that. This is the user's decision (tier 3): either they run `aidw first-deploy --yes` in their own terminal (one public Production deployment, so only for non-sensitive data) and `aidw deploy` works after that, or the deploy target is set to none. Never use --prod yourself."
  },
  {
    re: /No existing credentials found|not logged in|vercel login/i,
    hint: "the Vercel CLI is not logged in. The user runs `vercel login` in their own terminal, then `aidw deploy` again."
  }
];
function deployHint(output) {
  return DEPLOY_HINTS.find((h) => h.re.test(output))?.hint ?? null;
}
function deploymentUrl(output) {
  const json = JSON_URL.exec(output);
  if (json) return json[1];
  const urls = [];
  for (const line of output.split("\n")) {
    if (/\balias(?:ed)?\b/i.test(line)) continue;
    for (const m of line.matchAll(URL_RE)) if (!DASHBOARD_URL.test(m[0])) urls.push(m[0]);
  }
  return urls.at(-1) ?? null;
}
function lastDeploy(change) {
  const f = deployFile(change);
  if (!(0, import_node_fs22.existsSync)(f)) return null;
  try {
    const runs = JSON.parse((0, import_node_fs22.readFileSync)(f, "utf8")).runs ?? [];
    return runs.at(-1) ?? null;
  } catch {
    return null;
  }
}

// src/check.ts
function deltaFiles(p, change, d) {
  const specsDir = (0, import_node_path25.join)(change.dir, "specs");
  const out = [];
  for (const f of walkFiles(specsDir)) {
    const cap = capabilityOf(specsDir, f);
    if (!cap) {
      if (f.endsWith(".md")) {
        d.error(rel(p, f), "delta specs must live at specs/<capability>/spec.md; this file is never merged");
      }
      continue;
    }
    const bad = cap.split("/").find((s) => !KEBAB_SEGMENT.test(s));
    if (bad) d.error(rel(p, f), `capability path segment "${bad}" must be kebab-case`);
    out.push({ capability: cap, file: f, mainFile: (0, import_node_path25.join)(p.specs, ...cap.split("/"), "spec.md") });
  }
  return out;
}
function checkSpecs(p) {
  const d = new Diags();
  for (const f of walkFiles(p.specs)) {
    const cap = capabilityOf(p.specs, f);
    if (!cap) {
      if (f.endsWith(".md")) d.warn(rel(p, f), "not a spec: specs must be named specs/<capability>/spec.md");
      continue;
    }
    d.add(validateSpecText((0, import_node_fs23.readFileSync)(f, "utf8"), rel(p, f)));
  }
  return d;
}
function checkChange(p, id, opts = {}) {
  const d = new Diags();
  let change;
  try {
    change = loadChange(p, id);
  } catch (e) {
    d.error(rel(p, (0, import_node_path25.join)(p.changes, id)), e.message);
    return d;
  }
  const meta = rel(p, change.file);
  if (!CHANGE_ID.test(id)) d.error(meta, `change id "${id}" must be kebab-case`);
  if (change.data.id !== id) d.error(meta, `id "${String(change.data.id)}" does not match folder name "${id}"`);
  const state = opts.asState ?? change.data.state;
  if (!isState(state)) {
    d.error(meta, `unknown state "${String(state)}"`);
    return d;
  }
  const deltas = deltaFiles(p, change, d);
  for (const df of deltas) {
    d.add(validateDeltaText((0, import_node_fs23.readFileSync)(df.file, "utf8"), rel(p, df.file), readText(df.mainFile), df.capability));
  }
  const tasksFile = (0, import_node_path25.join)(change.dir, "tasks.yaml");
  if ((0, import_node_fs23.existsSync)(tasksFile)) d.add(validateTasksText((0, import_node_fs23.readFileSync)(tasksFile, "utf8"), rel(p, tasksFile)));
  const qFile = (0, import_node_path25.join)(change.dir, "quality.yaml");
  if ((0, import_node_fs23.existsSync)(qFile)) d.add(parseQuality((0, import_node_fs23.readFileSync)(qFile, "utf8"), rel(p, qFile)).diags);
  const machine = machineOf(p, change);
  if (machine.analysisRequired.has(state)) {
    for (const name of ["intake.md", "analysis.md", "tasks.yaml", "quality.yaml"]) {
      if (!(0, import_node_fs23.existsSync)((0, import_node_path25.join)(change.dir, name))) d.error(meta, `state "${state}" requires ${name}`);
    }
    if (deltas.length === 0 && change.data.skip_specs !== true) {
      d.error(meta, `state "${state}" requires at least one delta spec, or skip_specs: true when no behavior changes`);
    }
  }
  if (machine.approvalRequired.has(state)) {
    const a = approvalStatus(p, change);
    if (a.status === "none") d.error(meta, `state "${state}" requires an approval; run \`aidw approve ${id}\``);
    if (a.status === "drift") {
      d.error(meta, "approval drift: the approved Analysis package changed after approval; re-run analysis and approve again");
    }
  }
  return d;
}

// src/plan.ts
var list4 = (v) => Array.isArray(v) ? v.map(String) : [];
var isPlanned = (t) => t.origin === void 0 || t.origin === "plan";
function planShape(all2) {
  const tasks = all2.filter(isPlanned);
  const byId = new Map(tasks.map((t) => [t.id, t]));
  const level = /* @__PURE__ */ new Map();
  const depth = (id, seen) => {
    const known = level.get(id);
    if (known !== void 0) return known;
    if (seen.has(id)) return 0;
    seen.add(id);
    const deps = list4(byId.get(id)?.depends_on).filter((d) => byId.has(d));
    const l = deps.length ? 1 + Math.max(...deps.map((d) => depth(d, seen))) : 0;
    level.set(id, l);
    return l;
  };
  for (const t of tasks) depth(t.id, /* @__PURE__ */ new Set());
  const levels = [];
  for (const t of tasks) (levels[level.get(t.id) ?? 0] ??= []).push(t.id);
  const independentPairs = [];
  for (const t of tasks) {
    for (const dep of list4(t.depends_on)) {
      const a = byId.get(dep);
      if (!a) continue;
      const ta = list4(a.touches);
      const tb = list4(t.touches);
      if (ta.length && tb.length && !touchesOverlap(ta, tb)) independentPairs.push({ task: t.id, on: dep });
    }
  }
  return {
    tasks: tasks.length,
    levels,
    width: Math.max(0, ...levels.map((l) => l.length)),
    independentPairs,
    catchAll: tasks.filter((t) => list4(t.touches).some((g) => staticPrefix(g).length === 0)).map((t) => t.id),
    highRisk: tasks.filter((t) => t.risk === "high").map((t) => t.id)
  };
}
function planSummary(all2) {
  const s = planShape(all2);
  return `${s.tasks} task(s) in ${s.levels.length} stage(s), widest stage ${s.width}: ${s.levels.map((l) => l.join("+")).join(" -> ")}`;
}
var MIN_TASKS = 4;
function planAdvice(all2) {
  const s = planShape(all2);
  if (s.tasks < MIN_TASKS) return [];
  const out = [];
  if (s.width === 1) {
    const pairs = s.independentPairs.slice(0, 4).map((p) => `${p.task} after ${p.on}`);
    out.push(
      `the ${s.tasks} tasks form one dependency chain, so none can run side by side (a wave). ` + (pairs.length ? `Their touches do not overlap for ${pairs.join(", ")}: if the later task does not need the earlier one's output, drop its depends_on. ` : "") + "Slice by vertical feature (API + UI + tests of one behavior) rather than by layer, so slices can be independent."
    );
  } else if (s.independentPairs.length && s.width < Math.ceil(s.tasks / 2)) {
    const pairs = s.independentPairs.slice(0, 4).map((p) => `${p.task} on ${p.on}`);
    out.push(`the plan runs at most ${s.width} task(s) at once; depends_on without overlapping touches: ${pairs.join(", ")}. Drop each one the later task does not truly need.`);
  }
  if (s.width > 1 && s.width <= 2 && s.tasks >= 6 && !out.length) {
    out.push(`the ${s.tasks} tasks run at most ${s.width} at once (stages: ${s.levels.map((l) => l.join("+")).join(" -> ")}). If a stage is a long single-task chain, check whether each depends_on is a real data dependency, and whether tasks share one big file (they then cannot overlap): slice by file ownership.`);
  }
  const planned = all2.filter(isPlanned);
  const counts = planned.map((t) => ({ id: t.id, n: list4(t.scenarios).length }));
  const total = counts.reduce((n, c) => n + c.n, 0);
  const heavy = counts.filter((c) => total >= 8 && c.n >= 8 && c.n / total >= 0.3);
  if (heavy.length) out.push(`task(s) ${heavy.map((c) => `${c.id} (${c.n} of ${total} scenarios)`).join(", ")} carry a third of the plan: they set the pace of their wave. Split each into slices that touch different files (for example list, create, edit and delete) so the pieces can run side by side.`);
  if (s.catchAll.length) out.push(`task(s) ${s.catchAll.join(", ")} touch "**", so they always run alone; list the folders they really change.`);
  return out;
}

// src/analyze.ts
var TITLE_ADVISED = 60;
var isPlanned2 = (t) => t.origin === void 0 || t.origin === "plan";
var ANALYSIS_SECTIONS = [
  "Summary",
