# Port the API listens on
PORT=3000
# Folder of the PGlite database; empty keeps it in memory
DATABASE_DIR=
# How long a session lasts, in hours
SESSION_TTL_HOURS=72
# Sender of outgoing mail
MAIL_FROM=no-reply@tracker.example
# Base URL of the payment provider's API
PAYMENTS_URL=https://payments.example
# Secret key of the payment provider (server only)
PAYMENTS_API_KEY=
